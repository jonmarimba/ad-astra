#!/bin/bash
# omniroute-model-sync — keeps qwen's and OpenCode's model pickers in sync with each other,
# sourced from OmniRoute's own live catalog as the single system of record. Built 2026-08-14
# after two separate incidents: (1) an earlier `omniroute setup-qwen` run silently wiped qwen's
# hand-curated model list (it writes a different, incompatible schema — see ambrosio's own
# comment on this), and (2) qwen and OpenCode's lists had drifted apart with no way to tell
# without diffing them by hand. This is a NEW, separate tool — it never touches ambrosio, and
# ambrosio never touches modelProviders, so the two can't step on each other.
#
# Scope, on purpose: only the `ollamacloud` provider in OmniRoute's catalog — that's the "new
# hot model dropped" domain this exists for. LM Studio / local models are ambrosio's job.
#
# Routing: new entries route THROUGH OmniRoute (baseUrl http://localhost:20128/v1), not direct
# to a local port — Jonathan's explicit preference (single system of record, log visibility).
#
# The model id used for routing comes from `omniroute api models get-api-models` — the real
# management "models getter" endpoint (Jonathan's term, and he's right: this is the documented
# way to get this, not something to derive/guess). It returns each model's actual `fullModel`
# id (e.g. "ollamacloud/gemma4:31b" — nothing like the display-name-derived tag guessing this
# script used at first) and an `available` boolean. First version of this script guessed a tag
# from the catalog's display name and verified it against `ollama show`; that missed 3 of 9
# ollamacloud models outright (Gemma, Nemotron, Qwen 3.5 — their real ids don't follow the
# lowercase-dashes-plus-":cloud" pattern at all) and, worse, an earlier iteration used the raw
# display name as the routing id and 404'd in production before being caught. Reading OmniRoute's
# own getter instead of pattern-matching fixes both.
#
# `available: false` on an entry means Jonathan has to flip it on himself in the OmniRoute web
# dashboard (Providers/Endpoints page) before it can route — the admin/enable endpoints need his
# own logged-in session, not the proxy API key this script runs with (confirmed live: the
# providers/logs management endpoints 401 against OMNIROUTE_API_KEY). This script surfaces those
# as a skip with an explicit "go enable this" message, never tries to force them.
#
# Context window size: omniroute's /v1/models endpoint now carries context_length for ollamacloud
# entries (verified 2026-08-15). The script reads it from there first, falling back to
# `ollama show <tag>` only if omniroute's entry is absent. Previous versions only used
# `ollama show`, which missed some models. NEVER copy-paste a context size from another model —
# that's how 8 of 10 entries ended up wrong on 2026-08-15 (the copy-paste bug Jonathan flagged).
#
# Additive only: never edits or removes an existing entry in either file, never touches the
# active `model` selection, never touches ambrosio, never touches anything outside the
# modelProviders.openai list (qwen) / omniroute.models map (OpenCode).
set -uo pipefail
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"

QW="${QWEN_SETTINGS:-$HOME/.qwen/settings.json}"
OC="${OPENCODE_SETTINGS:-$HOME/.config/opencode/opencode.jsonc}"
DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1

need(){ command -v "$1" >/dev/null || { echo "omniroute-model-sync: missing dependency '$1'" >&2; exit 1; }; }
need omniroute
need ollama
need python3
need jq

[ -f "$QW" ] || { echo "omniroute-model-sync: qwen settings not found at $QW" >&2; exit 1; }
[ -f "$OC" ] || { echo "omniroute-model-sync: opencode settings not found at $OC" >&2; exit 1; }

TMP="$(mktemp -d -t omniroute-model-sync)"
trap 'rm -rf "$TMP"' EXIT

echo "omniroute-model-sync: fetching live ollamacloud models from OmniRoute's own getter (get-api-models)..."
# omniroute prints its own "Loaded env from ..." banner lines to STDOUT ahead of the real JSON
# (confirmed live — they're not on stderr, `2>/dev/null` alone doesn't strip them), so trim
# everything before the actual '{' that starts the JSON object.
omniroute --output json api models get-api-models 2>/dev/null | sed -n '/^{/,$p' \
  | python3 -c "
import json, sys
data = json.load(sys.stdin)
for m in data.get('models', []):
    if m.get('provider') == 'ollamacloud':
        # tab-separated: fullModel, display name, available (1/0) — avoids fighting the shell
        # over spaces in display names like 'DeepSeek V4 Pro'.
        print(f\"{m['fullModel']}\t{m['name']}\t{1 if m.get('available') else 0}\")
" > "$TMP/models.tsv"

if [ ! -s "$TMP/models.tsv" ]; then
  echo "omniroute-model-sync: OmniRoute returned zero ollamacloud entries — is 'omniroute serve' up? Nothing to do." >&2
  exit 1
fi

echo "omniroute-model-sync: getter returned $(wc -l < "$TMP/models.tsv" | tr -d ' ') ollamacloud model(s)"

ADDED_QW=0
ADDED_OC=0
NEEDS_ENABLE=0

# The key comes from the environment first. Falling back to qwen's own settings is what lets
# this run unattended from a scheduler: a launchd job gets a bare environment with no exported
# OMNIROUTE_API_KEY, so an env-only lookup meant the tool could never be put on a timer and new
# models only ever landed when someone remembered to run it by hand. The fallback reads the same
# key qwen already uses to reach OmniRoute, so it introduces no new secret and no new location.
OMNIROUTE_KEY="${OMNIROUTE_API_KEY:-}"
if [ -z "$OMNIROUTE_KEY" ] && [ -f "$QW" ]; then
  OMNIROUTE_KEY="$(jq -r '.security.auth.apiKey // empty' "$QW" 2>/dev/null)"
  [ -n "$OMNIROUTE_KEY" ] && echo "omniroute-model-sync: OMNIROUTE_API_KEY not in the environment; using the key qwen already has at .security.auth.apiKey"
fi
if [ -z "$OMNIROUTE_KEY" ]; then
  echo "omniroute-model-sync: no OmniRoute key in OMNIROUTE_API_KEY or in $QW at .security.auth.apiKey — can't live-verify routing, aborting rather than write unverified entries" >&2
  exit 1
fi

while IFS=$'\t' read -r route_id display_name available; do
  [ -z "$route_id" ] && continue

  if [ "$available" != "1" ]; then
    echo "  NEEDS ENABLING: '$display_name' ($route_id) — OmniRoute reports this unavailable. Enable it yourself in the OmniRoute web dashboard (Providers/Endpoints page — needs your login, the proxy API key this script uses can't do it) before it can be added here."
    NEEDS_ENABLE=$((NEEDS_ENABLE+1))
    continue
  fi

  # Context window: try omniroute's /v1/models endpoint first (it carries context_length for
  # ollamacloud models now — verified 2026-08-15), fall back to `ollama show` only if absent.
  # NEVER guess or copy from another model — that's how 8 of 10 entries ended up wrong.
  ctx="$(curl -sf "http://localhost:20128/v1/models" | jq -r ".data[] | select(.id == \"$route_id\") | .context_length // empty" 2>/dev/null)"
  if [ -z "$ctx" ]; then
    tag="${route_id#ollamacloud/}"
    ctx="$(ollama show "${tag}:cloud" 2>/dev/null | awk '/context length/{print $3}')"
    [ -z "$ctx" ] && ctx="$(ollama show "$tag" 2>/dev/null | awk '/context length/{print $3}')"
  fi
  if [ -z "$ctx" ]; then
    echo "  '$display_name' ($route_id) — neither omniroute nor 'ollama show' has context-length metadata. Adding without a contextWindowSize rather than guessing one."
  fi

  # Live-verify the route actually works before writing it anywhere — one real request. The
  # getter's `available: true` means OmniRoute THINKS it's ready; this proves it, since a
  # provider can report available while still failing (expired upstream key, model retired, etc.).
  # Found live 2026-08-15 (convocation review): `curl -s` on a connection failure/timeout
  # writes NOTHING to stdout and prints its own error to stderr, which `-s` also
  # suppresses — so the old `grep -qi '"error"'` check saw an empty string, found no
  # "error" substring, and let the model through as "verified live" when the probe never
  # actually reached OmniRoute at all. Now: check curl's own exit code AND require the
  # response to contain a real, expected field ("choices", a genuine completion) before
  # calling it verified — empty, truncated, or connection-failure responses are treated
  # as failed verification, not as passing silence.
  # Do NOT add max_tokens to this probe. Reasoning models (GLM, DeepSeek) emit `reasoning`
  # tokens before any `content`, so a small cap returns a choice with empty content and
  # OmniRoute reports "returned an empty response (no usable choices)" — which is
  # indistinguishable from a dead model. Verified 2026-08-19: seven ollamacloud models read
  # as dead at max_tokens=16 and every one of them served at 300.
  #
  # --max-time 120, not 20. A cold-start on a very large cloud model (qwen3.5:397b, the
  # 675B Mistral) routinely exceeds 20 seconds on the first request of the day, and curl
  # exit 28 is a TIMEOUT, never a verdict about the model. The old 20-second cap silently
  # dropped qwen3.5:397b on 2026-08-19 while that model answered fine when given room.
  # One retry, because a first-request timeout usually means the upstream is warming.
  probe_once() {
    curl -s --max-time 120 "http://localhost:20128/v1/chat/completions" \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $OMNIROUTE_KEY" \
      -d "{\"model\":\"${route_id}\",\"messages\":[{\"role\":\"user\",\"content\":\"reply with one word: PING\"}],\"stream\":false}"
  }
  probe="$(probe_once)"
  curl_rc=$?
  if [ "$curl_rc" -eq 28 ] || { [ "$curl_rc" -ne 0 ] && [ -z "$probe" ]; }; then
    echo "  '$display_name' ($route_id) — first probe timed out (curl exit $curl_rc); retrying once, large models cold-start slowly"
    probe="$(probe_once)"
    curl_rc=$?
  fi
  if [ "$curl_rc" -ne 0 ] || [ -z "$probe" ]; then
    echo "  skip '$display_name' ($route_id) — probe request never got an answer from OmniRoute (curl exit $curl_rc, response was $([ -z "$probe" ] && echo empty || echo non-empty)). This is an UNKNOWN, not a verdict that the model is dead — re-run the sync and it may well add. Not writing an unverified route."
    continue
  fi
  # A 402 from one model takes the WHOLE provider down for about two minutes, so a plain
  # skip here would silently drop every model probed after it. Verified 2026-08-19: probing
  # ollamacloud/kimi-k3 (extra-usage-only, not in the Ollama Max plan) returned 402, flipped
  # the ollama-cloud connection to test_status=credits_exhausted, and every other ollamacloud
  # model — including one that had just answered — then reported "No active credentials for
  # provider: ollama-cloud" until the lockout expired 2m04s later. So when we see that exact
  # message, wait the lockout out and re-probe instead of recording a false negative.
  if printf '%s' "$probe" | grep -qi 'No active credentials for provider'; then
    echo "  '$display_name' ($route_id) — provider is in its post-402 lockout (another model exhausted credits). Waiting 130s for it to clear, then re-probing."
    sleep 130
    probe="$(probe_once)"
    curl_rc=$?
    if [ "$curl_rc" -ne 0 ] || [ -z "$probe" ]; then
      echo "  skip '$display_name' ($route_id) — still no answer after the provider lockout window. UNKNOWN, not a verdict; re-run the sync."
      continue
    fi
  fi
  if printf '%s' "$probe" | grep -qi '"error"'; then
    echo "  skip '$display_name' ($route_id) — reported available but the real request failed: $(printf '%s' "$probe" | head -c 200)"
    continue
  fi
  if ! printf '%s' "$probe" | grep -q '"choices"'; then
    echo "  skip '$display_name' ($route_id) — response had neither an error field nor a real completion (\"choices\") — treating as unverified: $(printf '%s' "$probe" | head -c 200)"
    continue
  fi

  already_qw="$(jq --arg id "$route_id" '.modelProviders.openai // [] | map(.id == $id) | any' "$QW")"
  already_oc="$(grep -qF "\"$route_id\"" "$OC" && echo true || echo false)"

  if [ "$already_qw" = "true" ] && [ "$already_oc" = "true" ]; then
    continue
  fi

  echo "  NEW: '$display_name' -> verified live route '$route_id'${ctx:+ (real context: $ctx tokens)}"

  if [ "$already_qw" != "true" ]; then
    # Say what actually happened. A real run that prints "would add" reads as a no-op and
    # sent a reader looking for a bug that was not there (2026-08-19).
    echo "    -> $([ "$DRY_RUN" -eq 1 ] && echo 'would add' || echo 'ADDING') to qwen ($QW) as id '$route_id'"
    ADDED_QW=$((ADDED_QW+1))
    if [ "$DRY_RUN" -eq 0 ]; then
      python3 - "$QW" "$route_id" "$display_name" "${ctx:-0}" <<'PYEOF'
import json, sys
qw, route_id, display_name, ctx = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
d = json.load(open(qw))
d.setdefault('modelProviders', {}).setdefault('openai', [])
entry = {
    "baseUrl": "http://localhost:20128/v1",
    "envKey": "OMNIROUTE_API_KEY",
    "id": route_id,
    "name": f"{display_name} (OmniRoute)",
}
if ctx:
    entry["generationConfig"] = {"contextWindowSize": ctx}
d['modelProviders']['openai'].append(entry)
json.dump(d, open(qw, 'w'), indent=2)
PYEOF
    fi
  fi

  if [ "$already_oc" != "true" ]; then
    echo "    -> $([ "$DRY_RUN" -eq 1 ] && echo 'would add' || echo 'ADDING') to opencode ($OC) as key '$route_id'"
    ADDED_OC=$((ADDED_OC+1))
    if [ "$DRY_RUN" -eq 0 ]; then
      python3 - "$OC" "$route_id" "$display_name" "${ctx:-0}" <<'PYEOF'
import re, sys
oc, route_id, display_name, ctx = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
s = open(oc).read()
if f'"{route_id}"' not in s:
    m = re.search(r'("omniroute"\s*:\s*\{.*?"models"\s*:\s*\{)', s, re.S)
    if m:
        if ctx:
            entry = '\n        "%s": {\n          "name": "%s (Ollama Cloud)",\n          "context_length": %d\n        },' % (route_id, display_name, ctx)
        else:
            entry = '\n        "%s": {\n          "name": "%s (Ollama Cloud)"\n        },' % (route_id, display_name)
        s = s[:m.end()] + entry + s[m.end():]
        open(oc, 'w').write(s)
PYEOF
    fi
  fi
done < "$TMP/models.tsv"

if [ "$NEEDS_ENABLE" -gt 0 ]; then
  echo "omniroute-model-sync: $NEEDS_ENABLE model(s) need enabling in the OmniRoute dashboard before this script can add them — see NEEDS ENABLING lines above"
fi

if [ "$DRY_RUN" -eq 1 ]; then
  echo "omniroute-model-sync: [dry-run] would add $ADDED_QW to qwen, $ADDED_OC to opencode — nothing written"
else
  echo "omniroute-model-sync: added $ADDED_QW to qwen, $ADDED_OC to opencode"
fi
