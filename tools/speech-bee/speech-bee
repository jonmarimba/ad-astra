#!/usr/bin/env bash
# speech-bee — a swappable STT/TTS "bee": audio in → text out, text in → audio out.
# Same stdin/stdout contract regardless of engine, so the backend can be Apple, whisper, or
# anything else later. For kicker2's voice side-channel and for transcribing recorded calls.
#
# Engines now: STT = whisper.cpp (whisper-cli); TTS = macOS `say` (AVSpeechSynthesizer).
# Next: an Apple SpeechAnalyzer/SpeechTranscriber Swift backend (macOS 26+, on-device, beats
# Whisper Large v3 Turbo) — drop it in behind the same `stt`/`tts` verbs.
#
# Usage:
#   speech-bee stt <audiofile>            # transcription → stdout
#   speech-bee tts "text"  [--out f.aiff] # or:  echo text | speech-bee tts -
#   speech-bee bootstrap [model]          # fetch a whisper model (default base.en)
#   SPEECH_BEE_MODEL=/path/ggml-x.bin  SPEECH_BEE_STT=whisper  SPEECH_BEE_TTS=say
set -uo pipefail
export PATH="${ASTRA_PATH:-/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:$PATH}"

MODEL="${SPEECH_BEE_MODEL:-$HOME/.cache/whisper/ggml-base.en.bin}"
STT_ENGINE="${SPEECH_BEE_STT:-whisper}"
TTS_ENGINE="${SPEECH_BEE_TTS:-say}"

die(){ echo "speech-bee: $*" >&2; exit 1; }

# Download a whisper model next to $MODEL. Downloads via tmp+rename so an interrupted fetch
# cannot leave a truncated model that passes the -f existence gate.
fetch_model(){
  local m="$1" dest; dest="$(dirname "$MODEL")/ggml-${m}.bin"; mkdir -p "$(dirname "$MODEL")"
  local url="${SPEECH_BEE_MODEL_URL_BASE:-https://huggingface.co/ggerganov/whisper.cpp/resolve/main}/ggml-${m}.bin"
  echo "fetching ggml-${m}.bin → $dest" >&2
  curl -L --fail -o "$dest.part" "$url" && mv "$dest.part" "$dest" && echo "done: $dest" >&2 || { rm -f "$dest.part"; die "model download failed ($url)"; }
}

# The tool finds its own dependencies (that is the point of astra): a missing whisper-cli or
# model is fetched on first use instead of failing and sending a person to run a second command.
# SPEECH_BEE_NO_FETCH=1 turns that off, for machines that must not reach the network.
heal(){  # heal <command> <brew formula>
  command -v "$1" >/dev/null && return 0
  [ -z "${SPEECH_BEE_NO_FETCH:-}" ] && command -v brew >/dev/null && { echo "speech-bee: $1 missing; brew install $2" >&2; brew install "$2" >&2; }
  command -v "$1" >/dev/null || die "$1 not found (brew install $2)"
}

stt_whisper(){
  local src="$1"
  heal whisper-cli whisper-cpp
  heal ffmpeg ffmpeg
  if [ ! -f "$MODEL" ]; then
    local name; name="$(basename "$MODEL")"
    case "$name" in ggml-*.bin) ;; *) die "no model at $MODEL (not a ggml-<name>.bin file, so it cannot be fetched)";; esac
    [ -z "${SPEECH_BEE_NO_FETCH:-}" ] || die "no model at $MODEL — run: speech-bee bootstrap"
    name="${name#ggml-}"; fetch_model "${name%.bin}"
    [ -f "$MODEL" ] || die "no model at $MODEL after fetching"
  fi
  local wav; wav="$(mktemp).wav"
  ffmpeg -nostdin -loglevel error -y -i "$src" -ar 16000 -ac 1 -c:a pcm_s16le "$wav" || die "ffmpeg convert failed"
  local base; base="$(mktemp)"
  whisper-cli -m "$MODEL" -f "$wav" -nt -otxt -of "$base" >/dev/null 2>&1 || die "whisper-cli failed"
  cat "$base.txt"; rm -f "$wav" "$base.txt"
}

tts_say(){
  local text="$1" out="${2:-}"
  [ "$text" = "-" ] && text="$(cat)"
  if [ -n "$out" ]; then say -o "$out" "$text"; echo "wrote $out"; else say "$text"; fi
}

case "${1:-}" in
  stt)
    [ $# -ge 2 ] || die "usage: speech-bee stt <audiofile>"
    case "$STT_ENGINE" in whisper) stt_whisper "$2" ;; apple) die "apple STT backend not built yet (Swift SpeechAnalyzer — planned)";; *) die "unknown STT engine $STT_ENGINE";; esac ;;
  tts)
    shift; text="${1:-}"; out=""
    [ "${2:-}" = "--out" ] && out="${3:-}"
    case "$TTS_ENGINE" in say) tts_say "$text" "$out" ;; apple) die "use say (already AVSpeechSynthesizer)";; *) die "unknown TTS engine";; esac ;;
  bootstrap)
    # honors SPEECH_BEE_MODEL's directory
    fetch_model "${2:-base.en}" ;;
  *) echo "usage: speech-bee stt <audio> | tts <text>|- [--out f] | bootstrap [model]"; exit 1 ;;
esac
