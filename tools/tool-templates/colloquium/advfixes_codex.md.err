   917	def build_server(upstreams: list[Upstream]) -> Server:
   918	    single = len(upstreams) == 1
   919	    # Prefixes are honoured VERBATIM — the single-upstream override that forced "" here
   920	    # made the daemon and the validator disagree about the same file, and made adding a
   921	    # second server silently rename the first one's entire surface.
   922	    prefix_of = {u: u.prefix for u in upstreams}
   923	    upstream_by_prefix = {prefix_of[u]: u for u in upstreams}
   924	    # Bare-name passthrough exists ONLY for the deployed env-var single mode: an env
   925	    # spec cannot carry blocks or maps, so nothing is bypassed there. A FILE config —
   926	    # even single-server, even with an empty prefix — goes through the catalogued path,
   927	    # or its sieve would filter the listing while leaving the tools callable by name
   928	    # (phase-3 panel, all three brands).
   929	    passthrough = (upstreams[0]
   930	                   if single and upstreams[0].prefix == "" and upstreams[0].from_env
   931	                   else None)
   932	
   933	    # Standing warnings (collisions, stale override descriptions) are logged once per
   934	    # distinct key: clients poll tools/list every few seconds, and a warning repeated
   935	    # forever stops being read (phase-3 panel, claude leg).
   936	    reported_warnings: set = set()
   937	
   938	    def warn_once(key, msg, *args):
   939	        if key in reported_warnings:
   940	            return
   941	        reported_warnings.add(key)
   942	        log.warning(msg, *args)
   943	
   944	    # EXPLICIT DISPATCH TABLE (increment 1.3): exposed name -> (upstream, bare upstream
   945	    # name), rebuilt every time the surface is composed in on_list_tools. Consulted
   946	    # FIRST on tools/call; the startswith() prefix walk below survives only as a
   947	    # fallback for a name that has not been listed yet in this daemon's lifetime.
   948	    # Prefix routing alone cannot survive the tool map (Phase 3): a mapped name that
   949	    # drops the prefix would be advertised and then rejected as unknown. The config
   950	    # loader already rejects the prefix sets that would make this table ambiguous
   951	    # (duplicates, prefixes of each other).
   952	    dispatch: dict[str, tuple[Upstream, str]] = {}
   953	
   954	    # Downstream notification registry (4.1). ServerSession is a per-request proxy over
   955	    # a stable per-client Connection whose standalone channel carries server-initiated
   956	    # notifications; remembering the latest proxy per connection lets the broadcaster
   957	    # reach every client that has ever made a request. The `_connection` read is the one
   958	    # private attribute this daemon touches — the SDK offers no public registry, and the
   959	    # alternative was shipping no relay at all.
   960	    downstream_sessions: dict = {}
   961	    # An abandoned session's send neither raises nor drains on the legacy transport
   962	    # (the SDK drops server-initiated messages for a session with no open GET stream),
   963	    # so the registry cannot rely on failure for eviction — it is BOUNDED instead, and
   964	    # insertion order makes the dict its own LRU: oldest-registered goes first. 128 is
   965	    # far above the concurrent-client count here (a handful of harness sessions plus
   966	    # kicker nodes), so eviction only ever removes the long-abandoned (phase-5 panel,
   967	    # all three brands, on the unbounded leak).
   968	    DOWNSTREAM_CAP = 128
   969	
   970	    def _remember_downstream(ctx: ServerRequestContext) -> None:
   971	        conn = getattr(ctx.session, "_connection", None)
   972	        if conn is None:
   973	            return
   974	        key = id(conn)
   975	        # Re-registering moves the entry to the newest position; entries hold the
   976	        # session (which holds the connection) strongly, so a live key cannot be
   977	        # reused by a new connection.
   978	        downstream_sessions.pop(key, None)
   979	        downstream_sessions[key] = ctx.session
   980	        while len(downstream_sessions) > DOWNSTREAM_CAP:
   981	            downstream_sessions.pop(next(iter(downstream_sessions)))
   982	
   983	    async def broadcast_list_changed() -> None:
   984	        # Concurrent, one timeout each: serial sends made broadcast latency scale with
   985	        # the registry (phase-5 panel), and one stuck client must not delay the rest.
   986	        async def _send_one(key, session):
   987	            try:
   988	                with anyio.move_on_after(1):
   989	                    await session.send_tool_list_changed()
   990	            except Exception:
   991	                downstream_sessions.pop(key, None)  # connection gone; forget it
   992	
   993	        async with anyio.create_task_group() as tg:
   994	            for key, session in list(downstream_sessions.items()):
   995	                tg.start_soon(_send_one, key, session)
   996	        # Modern-protocol (2026-07-28+) clients hear changes on subscriptions/listen
   997	        # streams instead; the bus fans this out to every active listener there.
   998	        await subscription_bus.publish(ToolsListChanged())
