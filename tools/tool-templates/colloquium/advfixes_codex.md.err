 cat > "$SB/_mcp_info.json" <<EOF
 {
   "mcpServers": {
-    "alpha": {"command": "python3", "args": ["$STUB", "--name", "alpha", "--tool", "ping=alpha-pong", "--tool", "build=alpha-built"]},
