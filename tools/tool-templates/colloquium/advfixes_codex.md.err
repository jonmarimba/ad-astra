    87	        if field in spec:
    88	            raise ConfigError(
    89	                "unimplemented field '%s' on server '%s' — the wrapper passes only command "
    90	                "and args to the child; remove it or implement it, but do not expect it to "
    91	                "take effect" % (field, name))
    92	    for field in spec:
    93	        if field not in IMPLEMENTED_FIELDS:
    94	            raise ConfigError("unknown field '%s' on server '%s'" % (field, name))
    95	
    96	    command = spec.get("command")
    97	    if not isinstance(command, str) or not command:
    98	        raise ConfigError("server '%s' has no 'command' (non-empty string required)" % name)
    99	
   100	    args = spec.get("args", [])
