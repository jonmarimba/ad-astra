   462	class Upstream:
   463	    """One upstream MCP server this daemon fronts, and everything needed to
   464	    keep a persistent connection to it alive. In single-upstream mode there's
   465	    exactly one of these and its tools are forwarded unprefixed (unchanged
   466	    behavior from before multi-upstream support existed). In multi-upstream
   467	    mode there are several, and the aggregator (see build_server) prefixes
   468	    each one's tools with `self.name + "__"` so two upstreams that happen to
   469	    share a tool name can't collide."""
   470	
   471	    def __init__(self, name: str, command: str, args: list[str], require_xcode_running: bool,
   472	                 prefix: str = "", env: dict | None = None, blocks: dict | None = None,
   473	                 maps: dict | None = None, from_env: bool = False,
   474	                 expected_version: str | None = None):
   475	        # The recorded compatible serverInfo.version, advisory only: a mismatch warns
   476	        # (in-band via instructions, once-persisted for the human) and NEVER refuses —
   477	        # an Xcode update taking the whole surface down is the worse failure (SPEC).
   478	        self.expected_version = expected_version
   479	        self.name = name
   480	        # Exposed-name prefix, VERBATIM from the spec. The daemon used to force "" for a
   481	        # sole upstream regardless of what the config declared, so the validator printed
   482	        # prefix=solo__ while the daemon served bare names — and adding a second server
   483	        # silently renamed every tool the first one offered (round-one colloquium defect
   484	        # 2; the phase-1 panel measured it still live). The env-var single mode passes ""
   485	        # explicitly, which keeps the deployed passthrough unprefixed.
   486	        self.prefix = prefix
   487	        self.env = dict(env) if env else None
   488	        # The sieve (Phase 2): bare tool name -> the recorded reason it is withheld.
   489	        # Deny-list only, per Jonathan. Applied when the surface is composed AND at
   490	        # tools/call — a listing filter alone is decoration, because the model knows
   491	        # names from its own context and previous sessions.
   492	        self.blocks: dict[str, str] = dict(blocks) if blocks else {}
   493	        self._stale_blocks_reported: set[str] = set()
   494	        # The map (Phase 3): bare tool name -> mcp_config.MapEntry. The exposed name is
   495	        # FINAL — it replaces prefix+bare outright; the original is refused like any
   496	        # other name the upstream does not offer on this surface.
   497	        self.maps: dict = dict(maps) if maps else {}
   498	        self._stale_maps_reported: set[str] = set()
   499	        # True only for the legacy env-var single-upstream contract — the one spec the
   500	        # bare-name passthrough is allowed for, because an env spec cannot carry blocks

