     1	#!/usr/bin/env python3
     2	"""mcp_config — load and validate the aggregator's upstream config (_mcp_info.json).
     3	
     4	The shape is Claude Code's own — {"mcpServers": {"<name>": {"command": ..., "args": [...]}}} —
     5	because Jonathan already reads and writes that shape, and an entry can then move between this
     6	file and a real .mcp.json by copy and paste. Two additive fields belong to the wrapper:
     7	
     8	  prefix  exposed-name prefix for this upstream's tools, defaulting to "<name>__"
     9	  quirks  list of named per-upstream behaviours; today only "require_xcode" (wait for a live
    10	          Xcode before connecting). Keeping quirks per-upstream is the point: the old parser
    11	          made require-Xcode a positional boolean every upstream had to answer, so every
    12	          server was described in Xcode's terms whether or not it had anything to do with it.
    13	
    14	EVERYTHING ELSE IS REJECTED BY NAME. Claude Code's format also carries env, cwd and url; the
    15	daemon passes only command and args to the child, so accepting those fields would drop them
    16	silently and the failure would surface later, at the first call, pointing at nothing. A field
    17	we do not implement is an error naming the field and the server, at load — the same policy for
    18	keys we have never heard of. (tool-templates increment 1.1; roadmap: "red when a config with
    19	url is accepted silently".)
    20	
    21	Runs on python3 >= 3.9 (the tests use the system interpreter, which is 3.9.6 on this machine;
    22	scheduled jobs get the same one).
    23	
    24	CLI, used by test-mcp-front-config.sh and handy for a human:
    25	    mcp_config.py validate <file>     rc 0 and one line per upstream, or a named rejection
    26	Exit codes: 65 (EX_DATAERR) config invalid, 66 (EX_NOINPUT) unreadable file.
    27	"""
    28	import json
    29	import sys
    30	
    31	KNOWN_QUIRKS = frozenset({"require_xcode"})
    32	# Claude Code fields the daemon does not pass through yet. Named individually so the error
    33	# can say "unimplemented" — which invites implementing — rather than "unknown", which reads
    34	# as a typo. type/transport/headers travel with url in real .mcp.json files. env moved to
    35	# the implemented set in the Phase 1 hardening: the SDK's default child environment is a
    36	# six-variable allowlist, and Drew's server is configured through XCODEMCP_ALLOWED_FOLDERS,
    37	# so rejecting env left that mechanism unreachable.
    38	UNIMPLEMENTED_FIELDS = ("cwd", "url", "type", "transport", "headers")
    39	IMPLEMENTED_FIELDS = frozenset({"command", "args", "prefix", "quirks", "env", "block", "map",
    40	                                "version"})
    41	TOP_LEVEL_FIELDS = frozenset({"mcpServers"})
