    48	class UpstreamSpec:
    49	    def __init__(self, name, command, args, prefix, quirks, env=None, blocks=None, maps=None,
    50	                 from_env=False, version=None):
    51	        # The recorded COMPATIBLE version (serverInfo.version at authoring time), and it
    52	        # is ADVISORY (SPEC: "a version mismatch warns; it never refuses"). Exact string
    53	        # comparison only — serverInfo.version is opaque, so 'newer'/'older' cannot be
    54	        # classified without a per-upstream comparator (ROADMAP 4.2).
    55	        self.version = version
    56	        # from_env marks the legacy single-upstream env contract, the ONLY spec allowed
    57	        # the daemon's bare-name passthrough: env specs cannot carry blocks or maps, so
    58	        # the passthrough cannot bypass them there. A FILE config with an empty prefix
    59	        # goes through the catalogued path like everyone else (phase-3 panel, all three
    60	        # brands: the passthrough made a file config's blocked tools callable by name).
    61	        self.from_env = from_env
    62	        self.name = name
    63	        self.command = command
    64	        self.args = args
    65	        self.prefix = prefix
    66	        self.quirks = quirks
    67	        self.env = dict(env) if env else {}
    68	        # The sieve (Phase 2): bare upstream tool name -> the stated reason it is
    69	        # withheld. Deny-list only, per Jonathan: "KISS it. I'd rather have a collision
    70	        # or a little less safety than miss features."
    71	        self.blocks = dict(blocks) if blocks else {}
