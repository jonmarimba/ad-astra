   129	        if tool in blocks:
   130	            raise ConfigError(
   131	                "'%s' on server '%s' is both blocked and mapped — a tool cannot be "
   132	                "withheld and renamed at once; pick one decision" % (tool, name))
   133	    for entry in maps.values():
   134	        if entry.exposed in blocks:
   135	            # Otherwise the call path resolves the contradiction by TIMING: before the
   136	            # first list the name is refused with the block's why, after it the map
   137	            # routes it (phase-3 panel, claude leg).
   138	            raise ConfigError(
   139	                "exposed name '%s' on server '%s' shadows a blocked tool — the same "
   140	                "name cannot be both refused and served" % (entry.exposed, name))
   141	
   142	    return UpstreamSpec(name, command, list(args), prefix, frozenset(quirks), env, blocks,
   143	                        maps, version=version)
   144	
   145	
   146	class MapEntry:
   147	    def __init__(self, exposed, why, description=None):
   148	        self.exposed = exposed          # the FINAL exposed name; replaces prefix+bare
   149	        self.why = why
   150	        self.description = description  # optional outright override; None = mechanical pass only
   151	
   152	
   153	def _parse_maps(name, raw, strict):
   154	    """Map entries: [{"tool", "name", "why", "description"?}] -> {bare tool: MapEntry}.
   155	    Same why policy as the sieve: hard error at authoring time, warn-and-apply at daemon
   156	    runtime (ROADMAP 2.2 applies to every decision field)."""
   157	    if not isinstance(raw, list) or not all(isinstance(m, dict) for m in raw):
   158	        raise ConfigError("server '%s': 'map' must be a list of objects" % name)
   159	    maps = {}
   160	    claimed = set()
   161	    for m in raw:
   162	        tool = m.get("tool")
   163	        if not isinstance(tool, str) or not tool:
   164	            raise ConfigError("map entry on server '%s' has no 'tool' name" % name)
   165	        for key in m:
   166	            if key not in ("tool", "name", "why", "description"):
   167	                raise ConfigError("unknown field '%s' in map entry for '%s' on server '%s'"
   168	                                  % (key, tool, name))
   169	        exposed = m.get("name")
   170	        if not isinstance(exposed, str) or not exposed:
   171	            raise ConfigError("map entry for '%s' on server '%s' has no 'name' (the "
   172	                              "exposed name it becomes)" % (tool, name))
   173	        why = m.get("why")
   174	        if not isinstance(why, str) or not why.strip():
   175	            msg = ("map entry for '%s' on server '%s' has no 'why' — every rename "
   176	                   "carries its stated reason, or the map outlives its cause"
   177	                   % (tool, name))
   178	            if strict:
   179	                raise ConfigError(msg)
   180	            print("mcp_config: WARNING: %s (applying the rename anyway; fix the template)"
   181	                  % msg, file=sys.stderr)
   182	            why = "(no reason recorded — fix the template)"
   183	        if tool in maps:
   184	            raise ConfigError("duplicate map entry for '%s' on server '%s'" % (tool, name))
   185	        if exposed in claimed:
   186	            raise ConfigError("exposed name '%s' is claimed twice on server '%s'"
   187	                              % (exposed, name))
   188	        claimed.add(exposed)
   189	        desc = m.get("description")
   190	        if desc is not None and not isinstance(desc, str):
   191	            raise ConfigError("map entry for '%s' on server '%s': 'description' must be "
   192	                              "a string" % (tool, name))
   193	        maps[tool] = MapEntry(exposed, why, desc)
   194	    return maps
   195	
   196	
   197	def _parse_blocks(name, raw, strict):
   198	    """Sieve entries: [{"tool": ..., "why": ...}] -> {tool: why}.
   199	
   200	    `why` is DATA and it is REQUIRED — a jsonc comment cannot be enforced or read back,
   201	    and a block without a stated cause is the entry that outlives its reason and narrows
   202	    the surface forever. Enforcement lives at AUTHORING time (strict=True, the validate
   203	    CLI): the daemon's own load (strict=False) warns and applies the block anyway,
   204	    because failing a repo at daemon startup over a sentence someone forgot in astra is
   205	    the wrong place to hurt (ROADMAP 2.2)."""
   206	    if not isinstance(raw, list) or not all(isinstance(b, dict) for b in raw):
   207	        raise ConfigError("server '%s': 'block' must be a list of objects" % name)
   208	    blocks = {}
   209	    for b in raw:
   210	        tool = b.get("tool")
   211	        if not isinstance(tool, str) or not tool:
   212	            raise ConfigError("block entry on server '%s' has no 'tool' name" % name)
   213	        for key in b:
   214	            if key not in ("tool", "why"):
   215	                raise ConfigError("unknown field '%s' in block entry for '%s' on server '%s'"
   216	                                  % (key, tool, name))
   217	        why = b.get("why")
   218	        if not isinstance(why, str) or not why.strip():
   219	            msg = ("block entry for '%s' on server '%s' has no 'why' — every withheld "
   220	                   "tool carries its stated reason, or the block outlives its cause"
   221	                   % (tool, name))
   222	            if strict:
   223	                raise ConfigError(msg)
   224	            print("mcp_config: WARNING: %s (applying the block anyway; fix the template)"
   225	                  % msg, file=sys.stderr)
   226	            why = "(no reason recorded — fix the template)"
   227	        if tool in blocks:
   228	            raise ConfigError("duplicate block entry for '%s' on server '%s'" % (tool, name))
   229	        blocks[tool] = why
   230	    return blocks
   231	
   232	
   233	def load(path, strict=True):
   234	    """-> list of UpstreamSpec, in the file's order. Raises ConfigError (bad content) or
   235	    OSError (unreadable file); the caller chooses the exit code.
   236	
   237	    strict=True is the AUTHORING contract (the validate CLI, template checks): a sieve
   238	    entry without a why is a hard error. strict=False is the DAEMON contract
   239	    (resolve_specs): the same omission warns on stderr and the block still applies,
   240	    because failing a repo at daemon startup over a sentence someone forgot in astra is
   241	    the wrong place to hurt (ROADMAP 2.2)."""
   242	    try:
   243	        raw = open(path, encoding="utf-8").read()
   244	    except OSError as e:
   245	        raise OSError("mcp_config: cannot read %s (%s)" % (path, e))
   246	    try:
   247	        cfg = json.loads(raw)
   248	    except ValueError as e:
   249	        # A jsonc human file lands here. Say so: the difference between a typo and a
   250	        # deliberate comment is the whole remedy. Same wording as mcp_tools.py on purpose.
   251	        raise ConfigError(
   252	            "%s is not strict JSON (%s). If this is the commented human-owned file, point "
   253	            "at the generated one instead — comments are only allowed there." % (path, e))
   254	    servers = cfg.get("mcpServers") if isinstance(cfg, dict) else None
   255	    if not isinstance(servers, dict) or not servers:
   256	        raise ConfigError("%s has no non-empty mcpServers object" % path)
   257	    # Same policy as per-server keys, at the root: Phase 2's sieve and Phase 3's map land
   258	    # here, and a typo'd stanza that validates silently is a limiting policy that never
   259	    # applies (all three phase-1 panel brands flagged this gap).
   260	    for key in cfg:
   261	        if key not in TOP_LEVEL_FIELDS:
   262	            raise ConfigError("unknown top-level field '%s' in %s" % (key, path))
   263	    specs = [_parse_server(name, spec, strict) for name, spec in servers.items()]
   264	    _check_prefixes(specs)
   265	    _check_exposed_names(specs)
   266	    return specs
   267	
   268	
   269	def _check_exposed_names(specs):
   270	    """Two servers claiming one exposed name is a static contradiction, caught at load.
   271	    (A mapped name colliding with another upstream's LIVE prefixed tool is dynamic — the
   272	    daemon degrades by dropping the alias at composition, per increment 3.3.)"""
   273	    owner = {}
   274	    for s in specs:
   275	        for entry in s.maps.values():
   276	            if entry.exposed in owner:
   277	                raise ConfigError(
   278	                    "exposed name '%s' is claimed by both server '%s' and server '%s'"
   279	                    % (entry.exposed, owner[entry.exposed], s.name))
   280	            owner[entry.exposed] = s.name
   281	
   282	
   283	def _check_prefixes(specs):
   284	    """The prefix set must compose into an unambiguous surface (increment 1.3).
   285	
   286	    Two upstreams sharing a prefix collide exposed names. A prefix that is a prefix of
   287	    another — 'a__' and 'a__b__' — makes routing 'a__b__tool' depend on iteration order.
   288	    An empty prefix beside another upstream exposes bare names that cannot be routed
   289	    back. All three are author mistakes; reject them at load, when the author can still
   290	    fix them, never at call time as a misroute."""
   291	    if len(specs) < 2:
   292	        return
   293	    seen = {}
   294	    for s in specs:
   295	        if s.prefix == "":
   296	            raise ConfigError(
   297	                "server '%s' has an empty prefix beside other upstreams — its bare tool "
   298	                "names could not be routed back to it" % s.name)
   299	        if s.prefix in seen:
   300	            raise ConfigError("servers '%s' and '%s' have the same prefix '%s' — their "
   301	                              "exposed names would collide" % (seen[s.prefix], s.name, s.prefix))
   302	        seen[s.prefix] = s.name
   303	    ordered = sorted(specs, key=lambda s: s.prefix)
   304	    for a, b in zip(ordered, ordered[1:]):
   305	        if b.prefix.startswith(a.prefix):
   306	            raise ConfigError(
   307	                "server '%s' prefix '%s' is a prefix of server '%s' prefix '%s' — routing "
   308	                "a name under the longer one would be order-dependent"
   309	                % (a.name, a.prefix, b.name, b.prefix))
   310	
   311	
   312	def resolve_specs(environ):
   313	    """How the daemon picks its upstreams (increment 1.2). One mechanism wins, visibly:
   314	
   315	    - XCODE_MCP_FRONT_UPSTREAMS set: HARD ERROR. The colon/comma format silently corrupted
   316	      a colon in a command path and a comma in an argument; it is replaced, not deprecated,
   317	      because a daemon half-honouring both mechanisms would hide which one won.
   318	    - XCODE_MCP_FRONT_MCP_INFO set: load that _mcp_info.json.
   319	    - neither: the deployed single-upstream env contract, unchanged — UPSTREAM_CMD
   320	      (default xcrun), UPSTREAM_ARGS (default mcpbridge), REQUIRE_XCODE (default 1),
   321	      served unprefixed exactly as before.
   322	    """
   323	    if environ.get("XCODE_MCP_FRONT_UPSTREAMS"):
   324	        raise ConfigError(
   325	            "XCODE_MCP_FRONT_UPSTREAMS has been replaced by _mcp_info.json — set "
   326	            "XCODE_MCP_FRONT_MCP_INFO=<path> instead. The colon/comma format corrupts a "
   327	            "command path containing ':' and an argument containing ',', silently.")
   328	    info = environ.get("XCODE_MCP_FRONT_MCP_INFO")
   329	    if info:
   330	        return load(info, strict=False)  # daemon runtime: warn on a missing why, still serve
   331	    quirks = frozenset({"require_xcode"}) if environ.get(
   332	        "XCODE_MCP_FRONT_REQUIRE_XCODE", "1") == "1" else frozenset()
   333	    return [UpstreamSpec(
   334	        name="default",
   335	        command=environ.get("XCODE_MCP_FRONT_UPSTREAM_CMD", "xcrun"),
   336	        args=environ.get("XCODE_MCP_FRONT_UPSTREAM_ARGS", "mcpbridge").split(),
   337	        prefix="",
   338	        quirks=quirks,
   339	        from_env=True,
   340	    )]
   341	
   342	
   343	def _print_specs(upstreams):
   344	    for u in upstreams:
   345	        quirks = ",".join(sorted(u.quirks)) or "-"
   346	        env = " env=" + ",".join(sorted(u.env)) if u.env else ""
   347	        ver = " version=" + u.version if u.version else ""
   348	        print("%s  prefix=%s  quirks=%s%s%s  %s %s" % (u.name, u.prefix, quirks, env, ver,
   349	                                                       u.command, " ".join(u.args)))
   350	        for tool, why in sorted(u.blocks.items()):
   351	            print("    blocked: %s — %s" % (tool, why))
   352	        for tool, entry in sorted(u.maps.items()):
   353	            print("    mapped:  %s -> %s — %s" % (tool, entry.exposed, entry.why))
   354	
   355	
   356	def main(argv):
   357	    import os
   358	    if len(argv) == 2 and argv[1] == "resolve":
   359	        try:
   360	            upstreams = resolve_specs(os.environ)
   361	        except ConfigError as e:
   362	            print("mcp_config: %s" % e, file=sys.stderr)
   363	            return 65
   364	        except OSError as e:
   365	            print(str(e), file=sys.stderr)
   366	            return 66
   367	        _print_specs(upstreams)
   368	        return 0
   369	    if len(argv) != 3 or argv[1] != "validate":
   370	        print("usage: mcp_config.py validate <file> | resolve", file=sys.stderr)
   371	        return 64
   372	    try:
   373	        upstreams = load(argv[2])
   374	    except ConfigError as e:
   375	        print("mcp_config: %s" % e, file=sys.stderr)
   376	        return 65
   377	    except OSError as e:
   378	        print(str(e), file=sys.stderr)
   379	        return 66
   380	    _print_specs(upstreams)
   381	    return 0
   382	
   383	
   384	if __name__ == "__main__":
   385	    sys.exit(main(sys.argv))
     1	#!/bin/bash
     2	# repo-daemon-run.sh — launch THIS repo's autonomous MCP front daemon.
     3	#
     4	# Installed into <repo>/.astra/mcp-front/run.sh by repo-daemon-install.sh; everything is
     5	# derived from its own location, so the same file works in every repo (portability
     6	# doctrine: no hardcoded paths, no baked-in identity).
     7	#
     8	# PORT POLICY, per Jonathan's Phase 5 answer ("detect port collisions and fix them at
     9	# launch"): the BASE port is deterministic from the repo path, so a repo keeps the same
    10	# port across launches and .mcp.json stays put. At launch: validate the config BEFORE
    11	# any side effect, self-preempt only the pid this launcher itself recorded (with a
    12	# TERM-wait-KILL escalation — the daemon observably wedges in stdio teardown, which a
    13	# single TERM plus one second does not cover), then step past any FOREIGN listener one
    14	# port at a time. A foreign listener is left alone; it is somebody's live service. The
    15	# resolved port is written to ./port and into the repo's .mcp.json, which is how
    16	# clients find the daemon.
    17	set -uo pipefail
    18	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
    19	HERE="$(cd "$(dirname "$0")" && pwd)"                 # <repo>/.astra/mcp-front
    20	REPO_ROOT="$(cd "$HERE/../.." && pwd)"
    21	CONFIG="$HERE/_mcp_info.json"
    22	
    23	BASE_PORT=$(( 21000 + $(printf '%s' "$REPO_ROOT" | cksum | cut -d' ' -f1) % 3000 ))
    24	if [ "${1:-}" = "--print-port" ]; then
    25	  echo "$BASE_PORT"
    26	  exit 0
    27	fi
    28	
    29	# VALIDATE BEFORE ANY SIDE EFFECT. The installer's placeholder is deliberately
    30	# unservable so a daemon launched before the template writes real upstreams dies
    31	# loudly — but dying loudly must not first preempt processes, rewrite .mcp.json to a
    32	# dead endpoint, and leave a port file (phase-5 panel: the crash loop's side effects
    33	# were the problem, not the crash). This is a shape check only; the daemon's own
    34	# loader does the real validation with the lenient runtime contract.
    35	if ! jq -e '.mcpServers | type == "object" and length > 0' "$CONFIG" >/dev/null 2>&1; then
    36	  echo "repo-daemon: $CONFIG has no servable mcpServers — the template has not written" >&2
    37	  echo "  a real config yet (or it is malformed). Refusing to touch anything." >&2
    38	  exit 78
    39	fi
    40	
    41	# Self-preempt: ONLY the pid this launcher recorded, and only after confirming that
    42	# process is really running this repo's daemon.py (literal match, ps not pgrep — a
    43	# pgrep -f pattern is an unanchored REGEX over every process's argv, and the phase-5
    44	# panel demonstrated it matching a bystander `tail -f` on the installed file).
    45	PIDFILE="$HERE/pid"
    46	if [ -f "$PIDFILE" ]; then
    47	  oldpid="$(cat "$PIDFILE" 2>/dev/null)"
    48	  if [ -n "$oldpid" ] && ps -o command= -p "$oldpid" 2>/dev/null | grep -qF "$HERE/daemon.py"; then
    49	    echo "repo-daemon: preempting stale daemon (pid $oldpid) for $REPO_ROOT"
    50	    kill "$oldpid" 2>/dev/null || true
    51	    waited=0
    52	    while kill -0 "$oldpid" 2>/dev/null && [ "$waited" -lt 5 ]; do sleep 1; waited=$((waited+1)); done
    53	    if kill -0 "$oldpid" 2>/dev/null; then
    54	      # The wedged-teardown state stall_watchdog documents: TERM cannot reach it.
    55	      echo "repo-daemon: pid $oldpid ignored TERM for ${waited}s — escalating to KILL"
    56	      kill -9 "$oldpid" 2>/dev/null || true
    57	      sleep 1
    58	    fi
    59	  fi
    60	fi
    61	
    62	PORT=$BASE_PORT
    63	while lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; do
    64	  PORT=$((PORT + 1))
    65	done
    66	echo "$PORT" > "$HERE/port"
    67	
    68	# Record the resolved endpoint where clients look. A jq failure here (a hand-edited
    69	# .mcp.json with a stray comma) must kill the launch where launchd can see it — a
    70	# daemon serving on a port .mcp.json does not name is a daemon nobody can find.
    71	MCP_JSON="$REPO_ROOT/.mcp.json"
    72	[ -f "$MCP_JSON" ] || printf '{"mcpServers": {}}\n' > "$MCP_JSON"
    73	if ! jq --arg url "http://127.0.0.1:$PORT/mcp" \
    74	     '.mcpServers["astra-front"] = {"type": "http", "url": $url}' \
    75	     "$MCP_JSON" > "$MCP_JSON.tmp"; then
    76	  rm -f "$MCP_JSON.tmp"
    77	  echo "repo-daemon: could not rewrite $MCP_JSON (malformed JSON?) — refusing to serve" >&2
    78	  echo "  an endpoint clients cannot find. Fix the file and relaunch." >&2
    79	  exit 70
    80	fi
    81	mv "$MCP_JSON.tmp" "$MCP_JSON"
    82	
    83	export XCODE_MCP_FRONT_MCP_INFO="$CONFIG"
    84	export XCODE_MCP_FRONT_PORT="$PORT"
    85	export XCODE_MCP_FRONT_HOME="$HERE/home"
    86	export XCODE_MCP_FRONT_SERVER_NAME="astra-front-$(basename "$REPO_ROOT")"
    87	# A spawn-per-connect upstream (uvx, npx) may need to DOWNLOAD on first launch, and a
    88	# 15-second initialize window kills the install mid-download every cycle, forever —
    89	# the 2026-08-31 drews incident (SYNTHESIS_phase1). Sixty seconds covers a cold
    90	# install; override per-repo if a template knows better.
    91	export XCODE_MCP_FRONT_CONNECT_TIMEOUT_S="${XCODE_MCP_FRONT_CONNECT_TIMEOUT_S:-60}"
    92	mkdir -p "$XCODE_MCP_FRONT_HOME"
    93	
    94	# $$ becomes the daemon's pid at exec; recorded first so the next launch can preempt
    95	# exactly this process and nothing else.
    96	echo "$$" > "$PIDFILE"
    97	exec uv run --script "$HERE/daemon.py"
     1	#!/bin/bash
     2	# repo-daemon-install.sh — install an AUTONOMOUS per-repo copy of the MCP front daemon.
     3	#
     4	# Phase 5 of the tool-template roadmap, per Jonathan's design (2026-08-31), which
     5	# overrides the panel's shared-broker recommendation: "I'd strongly prefer each install
     6	# in a given repo to be autonomous. That way, one thing failing doesn't fuck all my
     7	# projects at once." Each repo gets its own clone of the wrapper under .astra/mcp-front
     8	# — APFS clones (cp -c), like a gentleman — its own launchd plist, and a run script
     9	# that resolves port collisions at launch (see repo-daemon-run.sh).
    10	#
    11	# What this does NOT automate: TCC. A config whose upstream carries the require_xcode
    12	# quirk needs the approval clicker, which needs a wrapped .app with Automation grants a
    13	# human adds in System Settings (see wrap-in-app). Non-Xcode upstreams need none of
    14	# that and run as installed here. The plist is GENERATED but not loaded; load it with:
    15	#   launchctl bootstrap gui/$(id -u) <repo>/.astra/mcp-front/launchd.plist
    16	#
    17	# Usage: repo-daemon-install.sh --into <repo>
    18	set -euo pipefail
    19	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
    20	HERE="$(cd "$(dirname "$0")" && pwd)"
    21	
    22	REPO=""
    23	while [ $# -gt 0 ]; do
    24	  case "$1" in
    25	    --into) REPO="${2:-}"; shift 2 ;;
    26	    *) echo "repo-daemon-install: unknown flag '$1'" >&2; exit 64 ;;
    27	  esac
    28	done
    29	[ -n "$REPO" ] || { echo "usage: repo-daemon-install.sh --into <repo>" >&2; exit 64; }
    30	REPO="$(cd "$REPO" 2>/dev/null && pwd)" || { echo "repo-daemon-install: no such repo directory" >&2; exit 66; }
    31	
    32	# The astra cardinal rule: never global. A per-repo daemon belongs in a repo.
    33	case "$REPO" in
    34	  "$HOME"|"$HOME/"|"$HOME/.claude"*|"$HOME/.agents"*|"$HOME/.config"*|"$HOME/Library"*)
    35	    echo "repo-daemon-install: refusing target '$REPO' — per-repo means a repo, never HOME or a global config dir" >&2
    36	    exit 64 ;;
    37	esac
    38	# git rev-parse, not [ -d .git ]: a worktree's .git is a FILE, and the checkout set
    39	# here includes one (phase-5 panel, codex leg — js-lp-members-site).
    40	git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    41	  || { echo "repo-daemon-install: '$REPO' is not a git repo" >&2; exit 65; }
    42	
    43	DEST="$REPO/.astra/mcp-front"
    44	mkdir -p "$DEST"
    45	
    46	clone() { # APFS clone with plain-copy fallback for non-APFS filesystems
    47	  cp -c "$1" "$2" 2>/dev/null || cp "$1" "$2"
    48	}
    49	clone "$HERE/daemon.py"           "$DEST/daemon.py"
    50	clone "$HERE/mcp_config.py"       "$DEST/mcp_config.py"
    51	clone "$HERE/repo-daemon-run.sh"  "$DEST/run.sh"
    52	chmod +x "$DEST/run.sh"
    53	
    54	# The machine-owned config placeholder (mogenerator convention: the template layer
    55	# overwrites this on every update; the sibling mcp_info.json stays human-owned). The
    56	# placeholder is deliberately INVALID-to-serve — a daemon launched before a template
    57	# writes real upstreams should die loudly at startup, not serve an empty surface.
    58	if [ ! -f "$DEST/_mcp_info.json" ]; then
    59	  printf '{"mcpServers": {}}\n' > "$DEST/_mcp_info.json"
    60	fi
    61	
    62	LABEL="com.jonathansaggau.astra-mcp-front.$(printf '%s' "$REPO" | cksum | cut -d' ' -f1)"
    63	# KeepAlive is BARE true on purpose: {SuccessfulExit:false} reads a clean
    64	# exit-on-EADDRINUSE as "finished on purpose" and the daemon silently stays dead
    65	# (found live 2026-08-14, asserted ever since in test-xcode-mcp-front.sh).
    66	cat > "$DEST/launchd.plist" <<PLIST
    67	<?xml version="1.0" encoding="UTF-8"?>
    68	<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    69	<plist version="1.0">
    70	<dict>
    71	  <key>Label</key><string>$LABEL</string>
    72	  <key>ProgramArguments</key>
    73	  <array>
    74	    <string>/bin/bash</string>
    75	    <string>$DEST/run.sh</string>
    76	  </array>
    77	  <key>RunAtLoad</key><true/>
    78	  <key>KeepAlive</key><true/>
