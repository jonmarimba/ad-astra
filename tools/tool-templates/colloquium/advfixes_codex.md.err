  1387	@contextlib.asynccontextmanager
  1388	async def _lifespan(app: Server, upstreams: list[Upstream], broadcast):
  1389	    async with anyio.create_task_group() as tg:
  1390	        # The notification relay's downstream half (4.1): surface-change events from the
  1391	        # Upstreams (connect, break, upstream listChanged) wake this task, which
  1392	        # debounces a burst and pushes tools/list_changed to every known client.
  1393	        changed = {"event": anyio.Event()}
  1394	
  1395	        def _wake(reason: str) -> None:
  1396	            changed["event"].set()
  1397	
  1398	        _surface_changed_callbacks.append(_wake)
  1399	
  1400	        async def _broadcaster() -> None:
  1401	            while True:
  1402	                await changed["event"].wait()
  1403	                changed["event"] = anyio.Event()
  1404	                await anyio.sleep(0.5)  # a reconnect burst becomes one notification
  1405	                await broadcast()
  1406	
  1407	        for u in upstreams:
  1408	            tg.start_soon(u.connection_manager)
  1409	            tg.start_soon(u.stall_watchdog)
  1410	        tg.start_soon(_broadcaster)
  1411	        try:
  1412	            yield {}
  1413	        finally:
  1414	            _surface_changed_callbacks.remove(_wake)
  1415	            tg.cancel_scope.cancel()
