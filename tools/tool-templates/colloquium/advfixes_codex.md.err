    61	
    62	mcp_call() { # usage: mcp_call <method> <params-json> -> raw SSE body on stdout
    63	  local method="$1" params="$2" init_resp session
    64	  init_resp="$(curl -s --max-time 10 -D - -X POST "http://127.0.0.1:$PORT/mcp" \
    65	    -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
    66	    -H "MCP-Protocol-Version: 2025-06-18" \
    67	    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"test","version":"0"}}}')"
    68	  session="$(printf '%s' "$init_resp" | grep -i "mcp-session-id" | tr -d '\r' | awk '{print $2}')"
    69	  [ -n "$session" ] || { echo "NO_SESSION"; return 1; }
    70	  curl -s --max-time 10 -X POST "http://127.0.0.1:$PORT/mcp" \
    71	    -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
    72	    -H "MCP-Protocol-Version: 2025-06-18" -H "Mcp-Session-Id: $session" \
    73	    -d "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"$method\",\"params\":$params}"
    74	}
    75	
    76	# Wait for the daemon to be up AND for both stub upstreams to be connected (the connection
    77	# managers connect asynchronously after uvicorn starts answering).
    78	waited=0
    79	until [ "$waited" -ge 30 ]; do
    80	  if ! kill -0 "$DPID" 2>/dev/null; then
    81	    fail "daemon exited during startup — its log:"; sed 's/^/        /' "$SB/daemon.log" >&2
    82	    finish; exit 1
    83	  fi
    84	  list="$(mcp_call tools/list '{}' 2>/dev/null || true)"
    85	  case "$list" in *alpha__*) break ;; esac
    86	  sleep 1; waited=$((waited+1))
    87	done
    88	
    89	printf '%s' "$list" > "$SB/list.out"
    90	assert_contains "$SB/list.out" "alpha__ping" "tools/list serves alpha's tools under the alpha__ prefix"
    91	assert_contains "$SB/list.out" "alpha__build" "tools/list serves alpha's second tool"
    92	assert_contains "$SB/list.out" "beta__ping" "tools/list serves beta's tools under the beta__ prefix"
    93	
    94	# Same tool name on both upstreams routes by prefix, not by luck.
    95	mcp_call tools/call '{"name":"alpha__ping","arguments":{}}' > "$SB/alpha.out"
    96	assert_contains "$SB/alpha.out" "alpha-pong" "alpha__ping routes to the alpha stub"
    97	mcp_call tools/call '{"name":"beta__ping","arguments":{}}' > "$SB/beta.out"
    98	assert_contains "$SB/beta.out" "beta-pong" "beta__ping routes to the beta stub, same bare name"
    99	
   100	# --- Phase 4.1: the daemon is a notification relay, and says so ---
   101	# The surface genuinely changes (upstream flaps, upstream listChanged), so the daemon
   102	# must advertise tools.listChanged and push notifications/tools/list_changed to
   103	# connected clients — a client that lists once and caches otherwise never learns the
   104	# missing 21 tools exist (phase-1 panel, all three brands).
   105	init_body="$(curl -s --max-time 10 -X POST "http://127.0.0.1:8899/mcp" \
   106	  -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
   107	  -H "MCP-Protocol-Version: 2025-06-18" \
   108	  -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"cap-probe","version":"0"}}}')"
   109	printf '%s' "$init_body" > "$SB/init.out"
   110	assert_contains "$SB/init.out" '"listChanged":true' \
   111	  "initialize advertises tools.listChanged — the list is a moving target and says so"
   112	
   113	# --- Phase 4.2: a version mismatch warns in-band and persists for the human ---
   114	assert_contains "$SB/init.out" "9.9.9" \
   115	  "a fresh session's instructions carry the recorded compatible version"
   116	assert_contains "$SB/init.out" "1.0-stub" "and the version actually found"
   117	assert_contains "$SB/daemon.log" "expected version '9.9.9'" "the mismatch is logged for the human"
   118	assert_file "$SB/home/version-mismatches.json" \
   119	  "the mismatch is persisted so a restart does not re-raise it"
   120	assert_contains "$SB/home/version-mismatches.json" "1.0-stub" "keyed on the found version"
   121	
   122	# The relay itself: a client holding the standalone GET stream hears list_changed when
   123	# an upstream emits one (the stub emits it on the 'trigger' call).
   124	listen_resp="$(curl -s --max-time 10 -D - -X POST "http://127.0.0.1:8899/mcp" \
   125	  -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
   126	  -H "MCP-Protocol-Version: 2025-06-18" \
   127	  -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"listener","version":"0"}}}')"
   128	LSESSION="$(printf '%s' "$listen_resp" | grep -i "mcp-session-id" | tr -d '\r' | awk '{print $2}')"
   129	curl -s --max-time 10 -X POST "http://127.0.0.1:8899/mcp" \
   130	  -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
   131	  -H "MCP-Protocol-Version: 2025-06-18" -H "Mcp-Session-Id: $LSESSION" \
   132	  -d '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}' >/dev/null
   133	curl -s -N --max-time 15 "http://127.0.0.1:8899/mcp" \
   134	  -H "Accept: text/event-stream" -H "MCP-Protocol-Version: 2025-06-18" \
   135	  -H "Mcp-Session-Id: $LSESSION" > "$SB/stream.out" 2>/dev/null &
   136	STREAMPID=$!
   137	sleep 1
   138	mcp_call tools/call '{"name":"alpha__trigger","arguments":{}}' > "$SB/trigger.out"
   139	assert_contains "$SB/trigger.out" "trigger-fired" "the triggering call itself still routes"
   140	waited=0
   141	until grep -q "list_changed" "$SB/stream.out" 2>/dev/null || [ "$waited" -ge 12 ]; do
   142	  sleep 1; waited=$((waited+1))
   143	done
   144	kill "$STREAMPID" 2>/dev/null; wait "$STREAMPID" 2>/dev/null
   145	assert_contains "$SB/stream.out" "notifications/tools/list_changed" \
   146	  "an upstream's list_changed is relayed to a listening downstream client"
   147	
   148	# --- Phase 3, the map: renames replace, descriptions follow, stale entries degrade ---
   149	# The exposed name is FINAL and the original is gone: a rename is a decision about the
   150	# surface's vocabulary, not an alias (SPEC; codex leg — keeping the old name callable
   151	# would defeat the map exactly as the prefix fallback would have defeated the sieve).
   152	assert_contains "$SB/list.out" "fetch_file" "a mapped tool is listed under its exposed name"
   153	assert_not_contains "$SB/list.out" "alpha__read" "and its prefixed original is gone from the listing"
   154	mcp_call tools/call '{"name":"fetch_file","arguments":{}}' > "$SB/mapped.out"
   155	assert_contains "$SB/mapped.out" "file-contents" "the exposed name routes to the upstream's real tool"
   156	mcp_call tools/call '{"name":"alpha__read","arguments":{}}' > "$SB/oldname.out"
   157	assert_contains "$SB/oldname.out" "does not currently offer" \
   158	  "the replaced original name is refused, not quietly honoured"
   159	
   160	# The rename table drives a MECHANICAL description pass across the same upstream's other
   161	# tools — whole words only. The roadmap's own red case: a tool named 'read' renames, and
   162	# the word 'already' must survive untouched.
   163	assert_contains "$SB/list.out" "already fetch_file the docs, then fetch_file again" \
   164	  "sibling descriptions now speak the exposed name, with 'already' intact"
   165	
   166	# An explicit description override wins outright.
   167	assert_contains "$SB/list.out" "Poke beta and await its pong." \
   168	  "a map entry's description override replaces the upstream's text"
   169	mcp_call tools/call '{"name":"poke_beta","arguments":{}}' > "$SB/poke.out"
   170	assert_contains "$SB/poke.out" "beta-nudged" "the overridden tool still routes by its exposed name"
   171	
   172	# A stale map entry degrades: drop the alias, keep serving, report (increment 3.3 —
   173	# 'Don't be stupid': an upstream rename must never take the whole surface down).
   174	assert_not_contains "$SB/list.out" "never_served" "a stale map entry's exposed name is not served"
   175	assert_contains "$SB/daemon.log" "map entry for 'gone-tool'" "the stale map entry is reported by name"
   176	
   177	# Calling the stale alias exercises the static-map scan (a dispatch miss on a name only
   178	# the map tables know) and the miss-path message: it must speak the asked name, not a
   179	# prefix-stripped mangle of it (phase-3 panel: 'never_served' minus beta's prefix length
   180	# came out as 'erved').
   181	mcp_call tools/call '{"name":"never_served","arguments":{}}' > "$SB/stale-alias.out"
   182	assert_contains "$SB/stale-alias.out" "never_served" "the stale-alias refusal names what was asked"
   183	assert_not_contains "$SB/stale-alias.out" "'erved'" "and never a prefix-stripped mangle of it"
   184	
   185	# A NATURAL prefixed name always beats a mapped alias, regardless of which upstream the
   186	# config lists first (phase-3 panel, all three brands: first-inserted-wins made surface
   187	# ownership depend on server order, and in the losing order the genuine tool vanished
   188	# while its name executed a different upstream's tool). aaathief sorts and lists FIRST
   189	# and claims alpha__ping by alias; alpha's real ping must win anyway.
   190	mcp_call tools/call '{"name":"alpha__ping","arguments":{}}' > "$SB/thief.out"
   191	assert_contains "$SB/thief.out" "alpha-pong" "the natural owner keeps its name against an earlier-listed alias"
   192	assert_not_contains "$SB/thief.out" "thief-stole" "the alias never hijacks the natural name"
   193	assert_contains "$SB/list.out" "aaathief__steal" "the degraded alias falls back to its prefixed original"
   194	mcp_call tools/call '{"name":"aaathief__steal","arguments":{}}' > "$SB/thief2.out"
   195	assert_contains "$SB/thief2.out" "thief-stole" "and the fallback name routes to the real tool"
   196	
   197	# --- Phase 2, the sieve: blocked tools are neither listed nor callable ---
   198	# Blocking EVERY tool on one upstream empties only that upstream — the round-one
   199	# colloquium's catastrophic case was the sieve meeting the old blank-on-missing logic
   200	# and serving nothing from anywhere.
   201	assert_not_contains "$SB/list.out" "muzzled__a" "a blocked tool is absent from the listing"
   202	assert_not_contains "$SB/list.out" "muzzled__b" "blocking every tool on one upstream empties that upstream"
   203	assert_contains "$SB/list.out" "alpha__ping" "and the other upstreams keep serving through it"
   204	
   205	# A listing filter alone is decoration: the model knows names from its own context and
   206	# previous sessions, so the call path must refuse too, and say WHY — the recorded reason
   207	# is the whole point of the mandatory why field.
   208	mcp_call tools/call '{"name":"muzzled__a","arguments":{}}' > "$SB/muzzled.out"
   209	assert_contains "$SB/muzzled.out" "blocked on this surface" \
   210	  "a blocked tool is refused at tools/call, not just hidden from tools/list"
   211	assert_contains "$SB/muzzled.out" "alpha owns this job" "the refusal carries the recorded why"
   212	assert_not_contains "$SB/muzzled.out" "muzzled-a" "the blocked call never reached the upstream"
   213	
   214	# A block naming a tool the upstream does not offer is a line protecting nothing, and a
   215	# version bump is exactly when that happens: it surfaces in the log rather than rotting.
   216	assert_contains "$SB/daemon.log" "block entry for 'ghost-tool'" \
   217	  "a stale block entry is reported by name"
   218	
   219	# --- increment 1.5: a paginating upstream is drained into a full snapshot ---
   220	# Cursors are per-server opaque tokens, so the one downstream cursor used to be handed
   221	# to EVERY upstream verbatim; the pager stub serves one tool per page, and only draining
   222	# its pages produces both tools.
   223	assert_contains "$SB/list.out" "pager__first" "page one of a paginating upstream is served"
   224	assert_contains "$SB/list.out" "pager__second" "page two is served as well — the upstream was drained, not truncated"
   225	mcp_call tools/call '{"name":"pager__second","arguments":{}}' > "$SB/pager.out"
   226	assert_contains "$SB/pager.out" "page-two" "a tool from a drained later page is callable"
   227	
   228	# A downstream cursor this daemon never issued is refused, not forwarded to upstreams
   229	# whose cursor spaces it cannot belong to — with the spec's INVALID_PARAMS code and the
   230	# daemon's own diagnostic, so a generic 500 cannot satisfy this (panel: the bare "error"

exec
