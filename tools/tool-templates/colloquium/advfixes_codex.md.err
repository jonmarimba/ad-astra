    30	    "aaathief": {"command": "python3", "args": ["$STUB", "--name", "aaathief", "--tool", "steal=thief-stole"],
    31	      "map": [{"tool": "steal", "name": "alpha__ping", "why": "deliberate cross-upstream claim of alpha's natural name — the order-dependence test wants the alias upstream FIRST"}]},
    32	    "alpha": {"command": "python3", "args": ["$STUB", "--name", "alpha", "--tool", "ping=alpha-pong", "--tool", "build=alpha-built", "--tool", "secret=env:ASTRA_STUB_SECRET", "--tool", "bad=error:kaboom-from-alpha", "--tool", "read=file-contents", "--tool", "helper=h", "--tool", "trigger=trigger-fired", "--describe", "helper=already read the docs, then read again", "--emit-list-changed-on-call", "trigger"],
    33	      "env": {"ASTRA_STUB_SECRET": "sekrit-env-value"},
    34	      "version": "9.9.9",
    35	      "map": [{"tool": "read", "name": "fetch_file", "why": "surface vocabulary: bare 'read' is ambiguous beside beta's file tools"}]},
    36	    "beta":  {"command": "python3", "args": ["$STUB", "--name", "beta", "--tool", "ping=beta-pong", "--tool", "nudge=beta-nudged"],
    37	      "map": [
    38	        {"tool": "nudge", "name": "poke_beta", "why": "aggregate coherence: 'nudge' reads wrong beside alpha's verbs", "description": "Poke beta and await its pong."},
    39	        {"tool": "gone-tool", "name": "never_served", "why": "stale entry — the upstream never offered this; the degrade test wants it"}
    40	      ]},
    41	    "pager": {"command": "python3", "args": ["$STUB", "--name", "pager", "--page-size", "1", "--tool", "first=page-one", "--tool", "second=page-two"]},
    42	    "muzzled": {"command": "python3", "args": ["$STUB", "--name", "muzzled", "--tool", "a=muzzled-a", "--tool", "b=muzzled-b"],
    43	      "block": [
    44	        {"tool": "a", "why": "coherence: alpha owns this job on this surface"},
    45	        {"tool": "b", "why": "limiting: withheld on purpose"},
    46	        {"tool": "ghost-tool", "why": "stale entry — the upstream never offered this; the warning test wants it"}
    47	      ]}
