   514	
   515	    async def _on_upstream_message(self, message) -> None:
   516	        """The upstream notification tap (4.1): the protocol says the tool list is a
   517	        moving target and offers listChanged when it moves — a relay that drops it
   518	        leaves every downstream cache stale."""
   519	        if isinstance(message, types.ToolListChangedNotification):
   520	            log.info("[%s] upstream announced tools/list_changed — relaying downstream",
   521	                     self.name)
   522	            _fire_surface_changed(f"{self.name} listChanged")
   523	
   524	    async def list_tools(self, params: types.PaginatedRequestParams | None) -> types.ListToolsResult | None:
   525	        """Returns None when this upstream is DISCONNECTED or the call failed — which is a
   526	        different fact from a connected upstream answering with zero tools, and the two
   527	        must never be conflated (increment 1.4: conflating them is how one missing
   528	        upstream used to blank the entire aggregate surface).
   529	
   530	        CONCURRENCY, stated plainly (the phase-1 panel caught the old file claiming full
   531	        serialization while the heartbeat bypassed the lock): tools/call is serialized
   532	        through self.lock; tools/list runs WITHOUT the lock on a session snapshot. The
   533	        MCP session multiplexes concurrent requests by id, and the heartbeat has listed
   534	        concurrently with real calls in production since 2026-08-14. Holding the lock
   535	        here meant a client connecting during a 10-minute build got no tool list at all
   536	        until the build ended — measured live by the panel's claude leg."""
   537	        async with self.lock:
   538	            session = None if self.known_broken else self.session
   539	        if session is None:
   540	            return None
   541	        try:
   542	            # DRAIN EVERY PAGE (increment 1.5). Cursors are opaque, per-server tokens,
   543	            # so the downstream client's cursor cannot be forwarded here — this daemon
   544	            # aggregates several cursor spaces into one surface and therefore serves a
   545	            # complete snapshot instead. Ignoring nextCursor used to silently truncate
   546	            # any upstream that paginates.
   547	            #
   548	            # The drain is bounded STRUCTURALLY, not just by wall clock (panel, all
   549	            # three brands): a repeated cursor is a definite upstream bug, and the page
   550	            # ceiling catches the fresh-cursor-forever variant — the claude leg measured
   551	            # 48,075 pages accumulated in ten seconds from a cycling stub. Listing is
   552	            # discovery, so it gets the short connect timeout, not the 600-second budget
   553	            # that exists for real builds.
   554	            tools: list[types.Tool] = []
   555	            cursor: str | None = None
   556	            seen_cursors: set[str] = set()
   557	            pages = 0
   558	            with anyio.fail_after(CONNECT_TIMEOUT_SECONDS):
   559	                while True:
   560	                    page = await session.list_tools(
   561	                        params=types.PaginatedRequestParams(cursor=cursor) if cursor else None)
   562	                    tools.extend(page.tools)
   563	                    pages += 1
   564	                    cursor = page.next_cursor
   565	                    if not cursor:
   566	                        return types.ListToolsResult(tools=tools)
   567	                    if cursor in seen_cursors:
   568	                        raise RuntimeError(
   569	                            f"cursor {cursor!r} repeated after {pages} pages — the upstream's "
   570	                            f"pagination cycles and can never finish")
   571	                    if pages >= LIST_MAX_PAGES:
   572	                        raise RuntimeError(
   573	                            f"tools/list still paginating after {LIST_MAX_PAGES} pages — "
   574	                            f"refusing to follow further")
   575	                    seen_cursors.add(cursor)
   576	        except Exception as e:
   577	            # REPORT UNAVAILABILITY; NEVER ADJUDICATE THE CONNECTION FROM HERE. This
   578	            # ran _mark_broken for one afternoon and took the deployed daemon down:
   579	            # clients poll tools/list constantly, each poll's drain timed out against
   580	            # the approval-gated mcpbridge (its first list blocks until the dialog is
   581	            # answered), and every timeout tore the connection down — WITHDRAWING the
   582	            # approval prompt before the clicker could answer it. That is the exact
   583	            # 2026-08-30 cancel-your-own-approval pathology, reintroduced through a
   584	            # new door and reproduced against a stall-tools stub under client load.
   585	            # The heartbeat in connection_manager — which owns the click-while-blocked
   586	            # helper — is the SOLE authority on connection state; a client-triggered
   587	            # drain that fails only means "nothing to serve from here right now".
   588	            log.info("[%s] list_tools unavailable this round (connection state untouched): %s",
   589	                     self.name, e or type(e).__name__)
   590	            return None
   591	
   592	    async def call_tool(self, tool_name: str, arguments: dict) -> types.CallToolResult | None:
   593	        """Returns None if not connected — caller decides how to report that,
   594	        since the aggregator needs a slightly different message than the
   595	        single-upstream case (naming which upstream is down)."""
   596	        # The surface-change fire happens OUT HERE, after the lock is released. The
   597	        # phase-5 panel caught the call-path break never announcing the contraction:
   598	        # every downstream client kept its cached full list for the whole outage — the
   599	        # exact failure 4.1 exists to close — because the fastest break-detection path
   600	        # was the one path that stayed silent.
   601	        was_broken = self.known_broken
   602	        result = await self._call_tool_locked(tool_name, arguments)
   603	        if self.known_broken and not was_broken:
   604	            _fire_surface_changed(f"{self.name} call broken")
   605	        return result
   606	
   607	    async def _call_tool_locked(self, tool_name: str, arguments: dict) -> types.CallToolResult | None:
   608	        async with self.lock:
   609	            if self.session is None or self.known_broken:
   610	                return None
   611	            log.info("[%s] call_tool %s", self.name, tool_name)
   612	            try:
   613	                with anyio.fail_after(CALL_TIMEOUT_SECONDS):
   614	                    result = await self.session.call_tool(tool_name, arguments)
   615	            except MCPError as e:
   616	                # AN APPLICATION-LEVEL JSON-RPC ERROR IS THE CALLER'S ERROR, NOT A DEAD
   617	                # TRANSPORT. The codex leg of the phase-1 panel caught this: the upstream
   618	                # answering -32602 for an unknown tool proves the connection is HEALTHY,
   619	                # and the old blanket except tore the session down and told the client
   620	                # "not connected right now, retry" — for a call that would fail
   621	                # identically on every retry.
   622	                log.info("[%s] call_tool %s: upstream returned an error (connection kept): %s",
   623	                         self.name, tool_name, e.message)
   624	                return types.CallToolResult(
   625	                    content=[types.TextContent(
   626	                        type="text",
   627	                        text=f"[{self.name}] upstream error for {tool_name!r}: {e.message}")],
   628	                    is_error=True,
   629	                )
   630	            except Exception as e:
   631	                # See list_tools' comment — same missing-timeout bug, same fix.
   632	                self.known_broken = True
   633	                self.session = None
   634	                log.warning("[%s] call_tool %s failed, marking connection broken: %s", self.name, tool_name, e)
   635	                return None
   636	            if not isinstance(result, types.CallToolResult):
   637	                # upstream returned something this dumb proxy doesn't forward
   638	                # (e.g. InputRequiredResult) — surface as an error, don't crash.
   639	                return types.CallToolResult(
   640	                    content=[
   641	                        types.TextContent(
   642	                            type="text",
   643	                            text=f"xcode-mcp-front: [{self.name}] unsupported upstream result type "
   644	                            f"{type(result).__name__}",
   645	                        )
   646	                    ],
   647	                    is_error=True,
   648	                )
   649	            return result
   650	
   651	    async def stall_watchdog(self) -> None:
   652	        """Exit the process if this upstream stops making progress entirely.
   653	
   654	        THE RECONNECT LOOP CAN GET STUCK AND GO PERMANENTLY SILENT. Observed live
   655	        2026-08-30: xcode-mcp-front logged "heartbeat list_tools failed, marking broken"
   656	        at 18:50:55 and then never logged again — no retry, no error, nothing — while its
   657	        HTTP endpoint kept answering and serving zero tools. The cause is the teardown, not
   658	        the loop: leaving `async with stdio_client(...)` waits for the child to exit, and a
   659	        wedged mcpbridge never does, so the task blocks inside __aexit__ where no `except`
   660	        and no retry can reach it. Every health signal this daemon has says "fine" in that
   661	        state, which is the worst possible failure shape.
   662	
   663	        There is no clean way to bound a hung context-manager exit from inside it. There IS
   664	        a supervisor: launchd, with KeepAlive true. So when an upstream has made no progress
   665	        for STALL_EXIT_SECONDS — no connect attempt, no successful heartbeat — say so loudly
   666	        and exit non-zero. That is the file's own stated philosophy: "a genuine crash is what
   667	        the process supervisor is for." A restart costs one new Xcode approval prompt, which
   668	        the clicker answers.
   669	
   670	        Deliberately generous, because a false positive here restarts a working daemon: the
   671	        default is many multiples of the heartbeat interval, and any progress at all resets it.
   672	        """
   673	        while True:
   674	            await anyio.sleep(RECONNECT_POLL_SECONDS)
   675	            if self.require_xcode_running and not _xcode_is_running():
   676	                # Waiting for Xcode is not a stall; that path logs and sleeps on purpose.
   677	                self.last_progress = time.monotonic()
   678	                continue
   679	            idle = time.monotonic() - getattr(self, "last_progress", time.monotonic())
   680	            if idle > STALL_EXIT_SECONDS:
   681	                log.error("[%s] no connect attempt and no successful heartbeat for %.0fs — the "
   682	                          "reconnect loop made no progress. Two known causes: stdio_client "
   683	                          "teardown waiting on a child that will not exit, or the loop waiting "
   684	                          "on this upstream's own lock behind a wedged call. Exiting so launchd "
   685	                          "restarts us; staying up would serve zero tools while every log line "
   686	                          "claimed we were connected.", self.name, idle)
   687	                os._exit(75)
   688	
   689	
   690	    async def connection_manager(self) -> None:
   691	        """Owns this upstream's connection for the daemon's whole life. Loops
   692	        forever: while not connected, check Xcode is running (if this upstream
