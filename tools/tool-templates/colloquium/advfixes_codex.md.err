   832	def _build_upstreams() -> list[Upstream]:
   833	    """All selection and validation logic lives in mcp_config.resolve_specs (tested fast,
   834	    without this file's mcp/uvicorn dependencies); this is only the Upstream construction.
   835	    A bad config is a loud startup death for launchd to report, never a half-configured
   836	    daemon."""
   837	    try:
   838	        specs = mcp_config.resolve_specs(os.environ)
   839	    except (mcp_config.ConfigError, OSError) as e:
   840	        raise SystemExit(f"{SERVER_NAME}: {e}")
   841	    return [
   842	        Upstream(name=s.name, command=s.command, args=s.args,
   843	                 require_xcode_running=s.require_xcode, prefix=s.prefix, env=s.env,
   844	                 blocks=s.blocks, maps=s.maps, from_env=s.from_env,
   845	                 expected_version=s.version)
   846	        for s in specs
   847	    ]
   848	
   849	
   850	# Phase 4 plumbing: Upstream instances announce surface changes (connect, break, an
   851	# upstream's own listChanged) and version mismatches through these hooks; build_server
   852	# registers the consumers. Module-level because Upstream predates the server object.
   853	_surface_changed_callbacks: list = []
   854	_version_mismatch_callbacks: list = []
   855	
   856	
   857	def _fire_surface_changed(reason: str) -> None:
   858	    for cb in list(_surface_changed_callbacks):
   859	        cb(reason)
   860	
   861	
   862	def _fire_version_mismatch(name: str, expected: str, found: str) -> None:
   863	    for cb in list(_version_mismatch_callbacks):
   864	        cb(name, expected, found)
   865	
   866	
   867	_version_match_callbacks: list = []
   868	
   869	
   870	def _fire_version_match(name: str) -> None:
   871	    for cb in list(_version_match_callbacks):
   872	        cb(name)
