   403	printf '%s' "$blist" > "$SB/bare-list.out"
   404	assert_contains "$SB/bare-list.out" '"open"' "the empty-prefix file config serves bare names"
   405	assert_not_contains "$SB/bare-list.out" "dangerous" "the blocked tool is absent from the bare listing"
   406	mcp_call tools/call '{"name":"dangerous","arguments":{}}' > "$SB/bare-danger.out"
   407	assert_contains "$SB/bare-danger.out" "blocked on this surface" \
   408	  "a caller who knows the blocked bare name is refused at tools/call"
   409	assert_not_contains "$SB/bare-danger.out" "bare-danger" "and the call never reaches the upstream"
   410	mcp_call tools/call '{"name":"open","arguments":{}}' > "$SB/bare-open.out"
   411	assert_contains "$SB/bare-open.out" "bare-opened" "unblocked bare names still route"
   412	
   413	# --- RED control: the replaced env format is a startup death, not a fallback ---
   414	red "a set XCODE_MCP_FRONT_UPSTREAMS kills the daemon at startup naming the replacement" 1 "replaced by _mcp_info.json" \
   415	  env XCODE_MCP_FRONT_UPSTREAMS="xcode:1:xcrun:mcpbridge" XCODE_MCP_FRONT_PORT=8907 \
   416	      XCODE_MCP_FRONT_HOME="$SB/home4" XCODE_MCP_FRONT_AUTO_ALLOW=0 \
   417	      uv run --script "$DAEMON"
   418	
   419	finish
     1	#!/usr/bin/env bash
     2	# test-mcp-front-repo-daemon.sh — Phase 5: per-repo autonomous daemons.
     3	#
     4	# Jonathan's design, overriding the panel's shared-broker answer: "I'd strongly prefer
     5	# each install in a given repo to be autonomous. That way, one thing failing doesn't
     6	# fuck all my projects at once." A repo gets its own APFS-cloned copy of the wrapper
     7	# under .astra/mcp-front, its own launchd-able run script, a DETERMINISTIC port derived
     8	# from the repo path, and collision resolution at launch. The chosen port lands in the
     9	# repo's .mcp.json, which is how clients find the daemon.
    10	set -uo pipefail
    11	HERE="$(cd "$(dirname "$0")" && pwd)"
    12	# shellcheck disable=SC1091
    13	. "$HERE/lib.sh"
    14	
    15	need uv "brew install uv"
    16	need jq "brew install jq"
    17	need python3 "xcode-select --install"
    18	
    19	INSTALLER="$HERE/../xcode-mcp-front/repo-daemon-install.sh"
    20	STUB="$HERE/stub_mcp_server.py"
    21	
    22	RPID=""; RPID2=""; OCCUPY=""   # referenced by the EXIT trap; under set -u an unset
    23	                               # variable would fail the trap itself and leak daemons
    24	
    25	REPO="$SB/fakerepo"
    26	mkdir -p "$REPO"
    27	git -C "$REPO" init -q
    28	
    29	# --- the installer places an autonomous copy under .astra/mcp-front ---
    30	assert_rc 0 "installer succeeds into a scratch repo" bash "$INSTALLER" --into "$REPO"
    31	assert_file "$REPO/.astra/mcp-front/daemon.py" "daemon.py is cloned into the repo"
    32	assert_file "$REPO/.astra/mcp-front/mcp_config.py" "mcp_config.py travels with it"
    33	assert_file "$REPO/.astra/mcp-front/run.sh" "the per-repo run script is installed"
    34	assert_file "$REPO/.astra/mcp-front/launchd.plist" "a launchd plist is generated"
    35	plutil -lint "$REPO/.astra/mcp-front/launchd.plist" >/dev/null 2>&1 \
    36	  && pass "the generated plist parses" || fail "the generated plist does not parse"
    37	# Read the KEY, not the file text: RunAtLoad's <true/> satisfied a substring check even
    38	# with KeepAlive absent (phase-5 panel, codex leg — a genuinely tautological assertion).
    39	ka="$(/usr/libexec/PlistBuddy -c "Print :KeepAlive" "$REPO/.astra/mcp-front/launchd.plist" 2>/dev/null)"
    40	assert_eq "true" "$ka" "KeepAlive is bare true (the SuccessfulExit variant silently stays dead on EADDRINUSE)"
    41	
    42	# --- the unservable placeholder dies BEFORE any side effect ---
    43	red "launching on the placeholder config refuses with the reason" 78 "no servable mcpServers" \
    44	  bash "$REPO/.astra/mcp-front/run.sh"
    45	assert_no_file "$REPO/.astra/mcp-front/port" "no port file was written by the refused launch"
    46	assert_no_file "$REPO/.mcp.json" "and .mcp.json was not pointed at a dead endpoint"
    47	
    48	red "the installer refuses a target under HOME itself" 64 "refusing" \
    49	  bash "$INSTALLER" --into "$HOME"
    50	
    51	# --- launch: deterministic port, recorded in .mcp.json, real daemon serving ---
    52	cat > "$REPO/.astra/mcp-front/_mcp_info.json" <<EOF
    53	{"mcpServers": {"alpha": {"command": "python3", "args": ["$STUB", "--name", "alpha", "--tool", "ping=repo-pong"]}}}
    54	EOF
    55	bash "$REPO/.astra/mcp-front/run.sh" >"$SB/run1.log" 2>&1 &
    56	RPID=$!
    57	trap 'kill "$RPID" "$RPID2" 2>/dev/null; wait "$RPID" "$RPID2" 2>/dev/null; kill "$OCCUPY" 2>/dev/null; rm -rf "$SB"' EXIT
    58	waited=0
    59	until [ -f "$REPO/.astra/mcp-front/port" ] || [ "$waited" -ge 10 ]; do sleep 1; waited=$((waited+1)); done
    60	assert_file "$REPO/.astra/mcp-front/port" "the launcher records its chosen port"
    61	PORT="$(cat "$REPO/.astra/mcp-front/port" 2>/dev/null)"
    62	assert_contains "$REPO/.mcp.json" "127.0.0.1:$PORT/mcp" \
    63	  ".mcp.json points at the chosen port — clients find the daemon through it"
    64	
    65	mcp_probe() { # <port> -> tools/list body
    66	  local port="$1" init_resp session
    67	  init_resp="$(curl -s --max-time 10 -D - -X POST "http://127.0.0.1:$port/mcp" \
    68	    -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
    69	    -H "MCP-Protocol-Version: 2025-06-18" \
    70	    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"repo-test","version":"0"}}}')"
    71	  session="$(printf '%s' "$init_resp" | grep -i "mcp-session-id" | tr -d '\r' | awk '{print $2}')"
    72	  [ -n "$session" ] || return 1
    73	  curl -s --max-time 10 -X POST "http://127.0.0.1:$port/mcp" \
    74	    -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
    75	    -H "MCP-Protocol-Version: 2025-06-18" -H "Mcp-Session-Id: $session" \
    76	    -d '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}'
    77	}
    78	waited=0; body=""
    79	until [ "$waited" -ge 15 ]; do
    80	  body="$(mcp_probe "$PORT" 2>/dev/null || true)"
    81	  case "$body" in *alpha__ping*) break ;; esac
    82	  sleep 1; waited=$((waited+1))
    83	done
    84	printf '%s' "$body" > "$SB/repo-list.out"
    85	assert_contains "$SB/repo-list.out" "alpha__ping" "the per-repo daemon serves its own configured surface"
    86	
    87	# --- a SECOND repo resolves the port collision at launch and both serve ---
    88	# Same repo path cloned elsewhere would hash differently; to force a collision we
    89	# occupy this repo's NEXT deterministic launch: keep daemon 1 running, install into a
    90	# second repo, and pin the second repo's base port to the first one's by occupying
    91	# nothing — instead, occupy is proven the direct way: a foreign listener squats the
    92	# second repo's deterministic base port, and the launcher must step past it without
    93	# killing it.
    94	REPO2="$SB/fakerepo2"
    95	mkdir -p "$REPO2"; git -C "$REPO2" init -q
    96	bash "$INSTALLER" --into "$REPO2" >/dev/null 2>&1
    97	cat > "$REPO2/.astra/mcp-front/_mcp_info.json" <<EOF
    98	{"mcpServers": {"beta": {"command": "python3", "args": ["$STUB", "--name", "beta", "--tool", "ping=repo2-pong"]}}}
    99	EOF
   100	BASE2="$(bash "$REPO2/.astra/mcp-front/run.sh" --print-port)"
   101	assert_nonempty "$BASE2" "--print-port reports the deterministic base port without launching"
   102	python3 -c "
   103	import socket, time, sys
   104	s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
   105	s.bind(('127.0.0.1', int(sys.argv[1]))); s.listen(1)
   106	time.sleep(60)
   107	" "$BASE2" &
   108	OCCUPY=$!
   109	sleep 1
   110	bash "$REPO2/.astra/mcp-front/run.sh" >"$SB/run2.log" 2>&1 &
   111	RPID2=$!
   112	waited=0
   113	until [ -f "$REPO2/.astra/mcp-front/port" ] || [ "$waited" -ge 10 ]; do sleep 1; waited=$((waited+1)); done
   114	PORT2="$(cat "$REPO2/.astra/mcp-front/port" 2>/dev/null)"
   115	assert_nonempty "$PORT2" "the second launcher chose a port"
   116	[ "$PORT2" != "$BASE2" ] && pass "the squatted base port was stepped past ($BASE2 -> $PORT2)" \
   117	  || fail "the launcher took the squatted port $BASE2"
   118	kill -0 "$OCCUPY" 2>/dev/null && pass "the foreign listener was left alone, not preempted" \
   119	  || fail "the foreign listener on $BASE2 was killed — only OUR stale daemons may be preempted"
   120	assert_contains "$REPO2/.mcp.json" "127.0.0.1:$PORT2/mcp" ".mcp.json records the RESOLVED port"
   121	waited=0; body2=""
   122	until [ "$waited" -ge 15 ]; do
   123	  body2="$(mcp_probe "$PORT2" 2>/dev/null || true)"
   124	  case "$body2" in *beta__ping*) break ;; esac
   125	  sleep 1; waited=$((waited+1))
   126	done
   127	printf '%s' "$body2" > "$SB/repo2-list.out"
   128	assert_contains "$SB/repo2-list.out" "beta__ping" "the second repo's daemon serves beside the first"
   129	body1_again="$(mcp_probe "$PORT" 2>/dev/null || true)"
   130	printf '%s' "$body1_again" > "$SB/repo1-again.out"
   131	assert_contains "$SB/repo1-again.out" "alpha__ping" "the first repo's daemon is untouched — autonomy holds"
   132	
   133	# --- relaunching THIS repo's daemon preempts the stale copy and keeps the port ---
   134	# The port file is REMOVED first and the old pid captured, so these assertions cannot
   135	# be satisfied by run 1's leftovers (phase-5 panel, claude leg: the whole relaunch
   136	# section passed against a run.sh that did nothing). A bystander process that merely
   137	# carries the daemon path in its argv must survive the preempt — pgrep -f matched a
   138	# tail -f on the installed file (verified live by the panel).
   139	OLDPID="$(cat "$REPO/.astra/mcp-front/pid")"
   140	rm -f "$REPO/.astra/mcp-front/port"
   141	tail -f "$REPO/.astra/mcp-front/daemon.py" >/dev/null 2>&1 &
   142	BYSTANDER=$!
   143	bash "$REPO/.astra/mcp-front/run.sh" >"$SB/run1b.log" 2>&1 &
   144	RPID=$!
   145	sleep 3
   146	kill -0 "$BYSTANDER" 2>/dev/null && pass "a bystander holding the daemon path in argv survives the preempt" \
   147	  || fail "the preempt killed an innocent tail -f on the installed daemon.py"
   148	kill "$BYSTANDER" 2>/dev/null; wait "$BYSTANDER" 2>/dev/null
   149	kill -0 "$OLDPID" 2>/dev/null && fail "the stale daemon (pid $OLDPID) survived the relaunch" \
   150	  || pass "the stale daemon was really preempted (pid $OLDPID is gone)"
   151	PORT1B="$(cat "$REPO/.astra/mcp-front/port" 2>/dev/null)"
   152	assert_eq "$PORT" "$PORT1B" "a relaunch self-preempts and keeps the deterministic port stable"
   153	waited=0; body3=""
   154	until [ "$waited" -ge 15 ]; do
   155	  body3="$(mcp_probe "$PORT1B" 2>/dev/null || true)"
   156	  case "$body3" in *alpha__ping*) break ;; esac
   157	  sleep 1; waited=$((waited+1))
   158	done
   159	printf '%s' "$body3" > "$SB/repo1b.out"
   160	assert_contains "$SB/repo1b.out" "alpha__ping" "and the relaunched daemon serves"
   161	
   162	finish

exec
