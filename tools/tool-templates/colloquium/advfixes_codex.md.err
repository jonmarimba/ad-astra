   874	
   875	def _rewrite_refs(text: str, table: dict) -> str:
   876	    """Whole-word substitution of old tool names with their PUBLISHED names — the
   877	    mechanical description pass (SPEC): every sibling description mentioning a renamed
   878	    tool goes stale at the same moment, so the rename table substitutes them all. The
   879	    table maps old bare name -> the name actually published this composition, so a
   880	    degraded alias rewrites to its prefixed fallback, never to a name that is not on
   881	    the surface. A regex is deliberate — whole-word replacement is the one job plain
   882	    scanning cannot do without reimplementing \\b (the roadmap's red case: a tool named
   883	    'read' mangling 'already'). Alternatives sorted longest-first, because Python's
   884	    alternation is first-match: with 'foo' before 'foo-bar', the phase-3 panel measured
   885	    'use foo-bar' rewriting as 'use <mapped>-bar'."""
   886	    if not text or not table:
   887	        return text
   888	    pattern = re.compile(
   889	        r"\b(" + "|".join(re.escape(k) for k in sorted(table, key=len, reverse=True)) + r")\b")
   890	    return pattern.sub(lambda m: table[m.group(1)], text)
   891	
   892	
   893	def _not_connected_result(u: "Upstream") -> types.CallToolResult:
   894	    # The retry text is derived from the upstream's own quirks: telling a client that
   895	    # Xcode is being checked and its dialog clicked, for an upstream that has nothing to
   896	    # do with Xcode, is a lie the phase-1 panel reproduced verbatim.
   897	    if u.require_xcode_running:
   898	        how = ("checking Xcode is running and clicking its approval prompt if one is "
   899	               "showing")
   900	    else:
   901	        how = "restarting its child process"
   902	    return types.CallToolResult(
   903	        content=[
   904	            types.TextContent(
   905	                type="text",
   906	                text=(
   907	                    f"{SERVER_NAME}: [{u.name}] not connected right now. This daemon "
   908	                    f"retries on its own every few seconds ({how}) — a retry shortly "
   909	                    "should work without any manual action."
   910	                ),
   911	            )
   912	        ],
   913	        is_error=True,
   914	    )
   915	
