   278	  "mcpServers": {
   279	    "alpha": {"command": "python3", "args": ["$STUB", "--name", "alpha", "--tool", "ping=alpha-pong"]},
   280	    "gamma": {"command": "python3", "args": ["-c", "import sys; sys.exit(1)"], "block": [{"tool": "anything", "why": "a block on a DEAD upstream must be inert — the sieve applies after the availability check"}]},
   281	    "delta": {"command": "python3", "args": ["$STUB", "--name", "delta"]},
   282	    "looper": {"command": "python3", "args": ["$STUB", "--name", "looper", "--page-loop", "--tool", "trap=x"]}
   283	  }
   284	}
   285	EOF
