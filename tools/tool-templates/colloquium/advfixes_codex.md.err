   135	from mcp.server.lowlevel import Server
   136	from mcp.server.lowlevel.server import NotificationOptions, ServerRequestContext
   137	
   138	
   139	def _load_config_file() -> None:
   140	    """Reached via a wrapped .app under launchd in real deployment, which does
   141	    NOT reliably forward a launchd plist's EnvironmentVariables into the
   142	    launched app's process (a LaunchServices quirk, separate from the TCC one
   143	    this tool is already built around). A config file sidesteps that entirely:
   144	    it's read directly off disk, so it works regardless of how this process was
   145	    launched. Real env vars still win if both are set (checked with setdefault,
   146	    same layering as ollama-watch's config convention elsewhere in this repo)."""
   147	    conf = os.path.join(os.environ.get("XCODE_MCP_FRONT_HOME", os.path.expanduser("~/.xcode-mcp-front")), "config")
   148	    if not os.path.isfile(conf):
   149	        return
   150	    with open(conf) as f:
   151	        for line in f:
   152	            line = line.strip()
   153	            if not line or line.startswith("#") or "=" not in line:
   154	                continue
   155	            key, _, value = line.partition("=")
   156	            os.environ.setdefault(key.strip(), value.strip().strip("'\""))
   157	
   158	
   159	_load_config_file()
   160	
   161	HOST = os.environ.get("XCODE_MCP_FRONT_HOST", "127.0.0.1")
   162	PORT = int(os.environ.get("XCODE_MCP_FRONT_PORT", "8765"))
   163	AUTO_ALLOW = os.environ.get("XCODE_MCP_FRONT_AUTO_ALLOW", "1") == "1"
   164	
   165	# Both /Applications/Xcode.app and /Applications/Xcode-beta.app share the exact
   166	# same CFBundleExecutable ("Xcode") AND the same CFBundleIdentifier
   167	# (com.apple.dt.Xcode) - confirmed live, 2026-08-14. Neither a bare process-name
   168	# match nor a bundle-ID match can tell them apart. Only the executable's full
   169	# path differs, so that's what this matches on - anchored and exact, not a
   170	# substring, so it can't accidentally match the beta path either.
   171	XCODE_APP_PATH = os.environ.get("XCODE_MCP_FRONT_XCODE_APP_PATH", "/Applications/Xcode.app")
   172	XCODE_BINARY_PATH = f"{XCODE_APP_PATH.rstrip('/')}/Contents/MacOS/Xcode"
   173	RECONNECT_POLL_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_RECONNECT_POLL_S", "5"))
   174	CONNECT_TIMEOUT_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_CONNECT_TIMEOUT_S", "15"))
   175	# Generous on purpose - a real Xcode build_project call can legitimately run
   176	# for minutes. The point isn't to bound normal work, it's to make sure NO call
   177	# can wedge the daemon forever (found live, 2026-08-14: with no timeout at all,
   178	# one genuinely hung upstream call held the connection lock for 2+ minutes and
   179	# counting, wedging every future call to that upstream, single-upstream or
   180	# combined, until manually restarted). Raise this if a real workload needs
   181	# longer than the default.
   182	#
   183	# Default corrected to 600s (was 120s) by convocation review, 2026-08-14: 120s
   184	# contradicted this comment's own "can legitimately run for minutes" — a real
   185	# clean/first build commonly runs past 2 minutes, so the old default silently
   186	# killed and dropped exactly the workload it claimed to tolerate, then
   187	# reconnected and reported "not connected right now, retry shortly" — which is
   188	# actively misleading once this fires, since the build was killed mid-flight,
   189	# not merely delayed; a retry starts it over, it doesn't resume it.
   190	CALL_TIMEOUT_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_CALL_TIMEOUT_S", "600"))
   191	SERVER_NAME = os.environ.get("XCODE_MCP_FRONT_SERVER_NAME", "xcode-mcp-front")
   192	
   193	logging.basicConfig(level=logging.INFO, format=f"%(asctime)s {SERVER_NAME} %(message)s")
   194	log = logging.getLogger(SERVER_NAME)
   195	
   196	
   197	# NOTE: no longer consulted by the click decision. It used to gate the "Don't Allow" branch
   198	# on the dialog's PID being dead, and that gate is what let a LIVE stranger's dialog block
   199	# the daemon forever. Kept because it is a correct, cheap liveness check and reads clearly
   200	# at a call site; delete it if nothing else picks it up.
   201	def _pid_is_alive(pid_str: str) -> bool:
   202	    """No history file needed: a dialog's PID is either us, or it's a live PID
   203	    that belongs to someone else's legitimate in-flight request (leave it
   204	    alone), or it's simply not in the process table anymore (nothing is
   205	    waiting on it — always safe to dismiss, regardless of whose it was).
   206	    Generalizes to every stale dialog, not just ones this exact daemon
   207	    happens to remember spawning itself, so it can never permanently
   208	    deadlock behind one it doesn't recognize."""
   209	    try:
   210	        os.kill(int(pid_str), 0)
   211	        return True
   212	    except ProcessLookupError:
   213	        return False
   214	    except (ValueError, PermissionError):
   215	        # ValueError: not a real pid, treat as "can't tell" -> leave it alone.
   216	        # PermissionError: pid exists but isn't ours to signal -> still alive.
   217	        return True
   218	
   219	
   220	def _xcode_is_running() -> bool:
   221	    try:
   222	        # -f matches the full command line; anchored so it can only match this
   223	        # exact binary path, not a substring of some other process's args.
   224	        return (
   225	            subprocess.run(["pgrep", "-f", f"^{XCODE_BINARY_PATH}$"], capture_output=True, timeout=5).returncode
   226	            == 0
   227	        )
   228	    except Exception:
   229	        # A broken check must never itself take the daemon down — treat "can't
   230	        # tell" as "not running" and just try again next poll.
   231	        return False
   232	
   233	
   234	async def _run_osascript(script: str) -> bytes:
   235	    """Raises on a nonzero exit instead of returning empty bytes. Found by
   236	    convocation review, 2026-08-14: with stderr sent to DEVNULL and no
   237	    returncode check, a TCC grant getting revoked or dying (the documented
   238	    failure mode after any edit to the ad-hoc-signed wrapper .app — new hash,
   239	    dead grant) made osascript exit nonzero with an error, which this
   240	    previously returned as plain b"" — indistinguishable from "no dialog
   241	    showing". The click loop would then silently stop working with nothing in
   242	    the log naming the actual cause. Now surfaces it: caller's except-block
   243	    already logs at warning level, so a dead grant shows up as a real,
   244	    diagnosable log line instead of a silent no-op.
   245	
   246	    Also found LIVE the same day, the hard way: a real System Events hang
   247	    (osascript stuck talking to it, unrelated to the return-code fix above —
   248	    System Events itself was wedged) piled up one leaked orphan osascript
   249	    process EVERY poll tick, forever, because `asyncio.wait_for` timing out
   250	    only abandons Python's own wait — it does NOT kill the underlying
   251	    subprocess. Confirmed live: 30+ orphaned osascript processes accumulated
   252	    in under 10 minutes before this was caught, and System Events itself
   253	    became unresponsive to even a basic query as a result. Now explicitly
   254	    kills the process on timeout instead of leaving it to run forever."""
   255	    proc = await asyncio.create_subprocess_exec(
   256	        "osascript",
   257	        "-e",
   258	        script,
   259	        stdout=asyncio.subprocess.PIPE,
   260	        stderr=asyncio.subprocess.PIPE,
   261	    )
   262	    try:
   263	        out, err = await asyncio.wait_for(proc.communicate(), timeout=5)
   264	    except asyncio.TimeoutError:
   265	        proc.kill()
   266	        await proc.wait()  # reap it — don't leave a zombie behind either
   267	        raise RuntimeError("osascript timed out after 5s (System Events may be unresponsive)")
   268	    if proc.returncode != 0:
   269	        raise RuntimeError(f"osascript exited {proc.returncode}: {err.decode(errors='replace').strip()}")
   270	    return out
   271	
   272	
   273	# THE CLICKER IS LOAD-BEARING AND MUST NOT BE "DESIGNED AWAY". Xcode's approval is keyed to
   274	# the CONNECTING PID, and a daemon restart always mints a new one, so no grant survives a
   275	# bounce — not a signed app bundle, not the "don't ask again for this agent binary" checkbox,
   276	# which only lasts until Xcode itself restarts. An unattended daemon therefore has to answer
   277	# its own prompt or it can never connect after any restart. Jonathan, 2026-08-30, correcting
   278	# a suggestion to remove it: "the daemons HAVE to depend on a clicker."
   279	#
   280	# That is why a defect in this function is not cosmetic. It is the only path to a working
   281	# connection, so a branch that silently declines to click takes the whole daemon down while
   282	# every log line still says "connected".
   283	
   284	
   285	# How long another process's approval dialog is left alone before we clear it. Only once we
   286	# have been blocked for this long is it fair to assume nobody is coming to answer it.
   287	# HOW LONG A FOREIGN DIALOG MAY BLOCK US BEFORE WE CLEAR IT. This MUST be comfortably less
   288	# than CONNECT_TIMEOUT_SECONDS or two daemons deadlock by arithmetic rather than by bad luck.
   289	#
   290	# It was 45 against a 15-second connect timeout. Xcode's approval dialogs do not stack, so when
   291	# both front daemons are up, each one's clicker finds the other's dialog, correctly classifies it
   292	# as foreign-and-alive, and waits out a grace period three times longer than the connection
   293	# attempt it is holding up. Its own prompt therefore never surfaces, its list_tools times out,
   294	# it tears the child down — which withdraws its request — and both sides repeat forever. That is
   295	# the "do two bridges interfere" question Jonathan asked: they do, and this constant is why.
   296	#
   297	# Clearing a live foreign dialog is not destructive. That process re-prompts on its next attempt,
   298	# which for these daemons is RECONNECT_POLL_SECONDS away, so two of them alternate and both get
   299	# through instead of neither.
   300	FOREIGN_DIALOG_GRACE_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_FOREIGN_GRACE", "6"))
   301	
   302	# The relationship above is load-bearing, so it is checked rather than trusted to a comment. A
   303	# grace period at or beyond the connect timeout is a silent, permanent deadlock whenever a second
   304	# client exists, and it presents as "mcpbridge refuses to serve tools" — which is exactly how it
   305	# presented, for a night.
   306	if FOREIGN_DIALOG_GRACE_SECONDS >= CONNECT_TIMEOUT_SECONDS:
   307	    raise SystemExit(
   308	        "xcode-mcp-front: XCODE_MCP_FRONT_FOREIGN_GRACE (%.1fs) must be less than "
   309	        "XCODE_MCP_FRONT_CONNECT_TIMEOUT_S (%.1fs). A foreign approval dialog that outlives the "
   310	        "connection attempt it is blocking can never be cleared in time, so two daemons deadlock "
   311	        "and every symptom looks like Xcode refusing to serve tools."
   312	        % (FOREIGN_DIALOG_GRACE_SECONDS, CONNECT_TIMEOUT_SECONDS))
   313	
   314	# How long an upstream may make NO progress before we let launchd restart us. See
   315	# stall_watchdog(). Generous on purpose: a false positive restarts a healthy daemon.
   316	STALL_EXIT_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_STALL_EXIT", "180"))
   317	
   318	# Structural ceiling on one tools/list drain, far above any real server's page count.
   319	# See Upstream.list_tools for why a wall-clock bound alone is not enough.
   320	LIST_MAX_PAGES = int(os.environ.get("XCODE_MCP_FRONT_LIST_MAX_PAGES", "200"))
   321	
   322	# How often to look for the approval dialog while a call is blocked waiting for it. Short,
   323	# because the window is the length of one blocked list_tools and a missed dialog costs the
   324	# whole connection attempt.
   325	ALLOW_CLICK_POLL_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_CLICK_POLL", "1.5"))
   326	
   327	# Set the first time we see a foreign dialog while we are not connected; cleared whenever we
   328	# see no dialog or our own. Module-level rather than per-upstream because Xcode shows one
   329	# dialog at a time for the whole application, so this is genuinely global state.
   330	_foreign_dialog_first_seen: dict = {}
   331	
   332	
   333	async def _click_allow_if_present() -> bool:
   334	    """Best-effort, narrowly scoped: only ever touches a button whose title is
   335	    the exact literal string "Allow" or "Don't Allow", only in Xcode's own
   336	    process. This is the one dialog this tool exists to eat, not a general
   337	    click-any-prompt macro. Harmless no-op for an upstream (like
   338	    drews-xcode-mcp) that never triggers this dialog at all — it just never
   339	    finds anything to click.
   340	
   341	    Xcode's approval dialogs do NOT stack (confirmed live, 2026-08-14 — only
   342	    one is ever showing; a new connection attempt's own dialog stays hidden
   343	    behind whatever's currently up until that one is dismissed). So a single
   344	    stale, never-answered dialog can permanently block every future connection
   345	    attempt, including this daemon's own, unless something clears it.
   346	
   347	    The decision, once a dialog's own PID is read from its text:
   348	      - matches OUR current pid            -> click Allow
   349	      - doesn't match, and that pid is DEAD -> click Don't Allow (nobody's
   350	        waiting on it — always safe, regardless of whose it originally was;
   351	        no history-tracking needed, this can't deadlock behind a dialog it
   352	        doesn't "remember")
   353	      - doesn't match, and that pid is ALIVE -> leave it alone; it's someone
   354	        else's legitimate in-flight request, not ours to approve OR deny
   355	    """
   356	    my_pid = str(os.getpid())
   357	    # Iterate every window, not just window 1 — found by convocation review,
   358	    # 2026-08-14: the approval dialog isn't guaranteed to be window 1 (e.g. a
   359	    # project window frontmost, or the dialog opening as window 2). Window 1
   360	    # only would silently never find the dialog and leave it unclicked
   361	    # forever. check-allow-window.sh already iterated all windows correctly;
   362	    # this production path didn't match it.
   363	    read_script = """
   364	tell application "System Events" to tell process "Xcode"
   365	  repeat with w in windows
   366	    if exists (button "Allow" of w) then
   367	      set winText to ""
   368	      try
   369	        set winText to (value of every static text of w) as string
   370	      end try
   371	      return winText
   372	    end if
   373	  end repeat
   374	  return ""
   375	end tell
   376	"""
   377	    try:
   378	        out = await _run_osascript(read_script)
   379	    except Exception as e:
   380	        log.warning("checking for an approval dialog failed (will retry, but if this repeats, check "
   381	                     "whether the wrapper .app's Accessibility/Automation grant is still valid): %s", e)
   382	        return False
   383	
   384	    text = out.decode(errors="replace")
   385	    if "PID: " not in text:
   386	        return False  # no dialog showing — the normal case most ticks
   387	
   388	    dialog_pid = text.split("PID: ", 1)[1].split()[0].strip()
   389	
   390	    if dialog_pid == my_pid:
   391	        _foreign_dialog_first_seen.pop("pid", None)
   392	        action = "Allow"
   393	    else:
   394	        # A GRACE PERIOD, BECAUSE CLEARING UNCONDITIONALLY MONOPOLISES XCODE. The previous
   395	        # version denied every foreign PID on sight. That unblocks us and starves everyone
   396	        # else: a legitimate agent's dialog gets Don't Allow, it retries, and it lands in the
   397	        # same denial loop forever, so this daemon owns Xcode and nothing else can use it.
   398	        # GhOST-OpenClaw caught it in peer review of the commit that introduced it.
   399	        #
   400	        # The bounded version keeps both properties. Somebody else's prompt is left alone
   401	        # while there is any chance they are about to answer it — which is the normal case,
   402	        # since a live agent's own approval usually resolves in seconds. Only once the SAME
   403	        # foreign dialog has been sitting there long enough to have stopped being anyone's
   404	        # in-flight request do we clear it so ours can surface. Nothing is destroyed either
   405	        # way: a denied agent re-prompts on its next attempt.
   406	        first = _foreign_dialog_first_seen.get("pid")
   407	        now = time.monotonic()
   408	        if first is None or first[0] != dialog_pid:
   409	            _foreign_dialog_first_seen["pid"] = (dialog_pid, now)
   410	            log.debug("a foreign approval dialog (pid %s) is in the way; leaving it for %.0fs "
   411	                      "in case its own agent answers it", dialog_pid, FOREIGN_DIALOG_GRACE_SECONDS)
   412	            return False
   413	        if now - first[1] < FOREIGN_DIALOG_GRACE_SECONDS:
   414	            return False
   415	        log.info("foreign approval dialog for pid %s has blocked us for %.0fs — clearing it so "
   416	                 "our own prompt can surface; that process re-prompts on its next attempt",
   417	                 dialog_pid, now - first[1])
   418	        # ANYTHING ELSE IN FRONT OF OURS GETS CLEARED, live or dead. This used to leave a
   419	        # LIVE unfamiliar PID's dialog strictly alone, out of politeness to another agent's
   420	        # in-flight request. That politeness is unaffordable here: Xcode's dialogs do not
   421	        # stack, so a single stranger's unanswered prompt sits in front of ours forever and
   422	        # the daemon can never connect again — which is exactly what a leftover
   423	        # "Allow 'Codex' to access Xcode?" from a convocation run did on 2026-08-30, and
   424	        # what the two front daemons did to each other for the sixteen days before that.
   425	        #
   426	        # Denying is not destructive and that is what makes this safe. A denied agent is
   427	        # told no for one connection attempt and re-prompts on its next one, by which time
   428	        # ours is out of the way. Jonathan, 2026-08-30: "I don't see why this needs
   429	        # exclusive access. Just run it saying with PID you care about or whatever?"
   430	        #
   431	        # The sibling branch above still matters and is not redundant: two front daemons
   432	        # denying each other would ping-pong, each clearing the other's prompt on every
   433	        # retry. Family gets Allow, everyone else gets out of the way.
   434	        action = "Don’t Allow"
   435	    click_script = f"""
   436	tell application "System Events" to tell process "Xcode"
   437	  repeat with w in windows
   438	    if exists (button "{action}" of w) then
   439	      click (button "{action}" of w)
   440	      return "clicked"
   441	    end if
   442	  end repeat
   443	  return "gone"
   444	end tell
   445	"""
   446	    try:
   447	        out2 = await _run_osascript(click_script)
   448	    except Exception as e:
   449	        log.warning("clicking the approval dialog failed (will retry, but if this repeats, check "
   450	                     "whether the wrapper .app's Accessibility/Automation grant is still valid): %s", e)
   451	        return False
   452	
   453	    clicked = b"clicked" in out2
   454	    if clicked and action == "Allow":
   455	        log.info("clicked Allow for our own connection-approval prompt (pid %s)", my_pid)
   456	    elif clicked:
   457	        log.info("cleared an approval dialog for pid %s (not ours, not a sibling) so ours can "
   458	                 "surface — it re-prompts on its next attempt", dialog_pid)
   459	    return clicked and action == "Allow"
