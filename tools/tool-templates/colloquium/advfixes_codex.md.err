    74	        # own vocabulary rather than the vendor's (SPEC: window_close can be exposed as
    75	        # close_current_window, a name neither server uses).
    76	        self.maps = dict(maps) if maps else {}
    77	
    78	    @property
    79	    def require_xcode(self):
    80	        return "require_xcode" in self.quirks
