     1	#!/usr/bin/env bash
     2	# test-mcp-front-config.sh — the aggregator's config loader (tool-templates increment 1.1).
     3	#
     4	# The loader reads a Claude-Code-shaped _mcp_info.json — {"mcpServers": {name: {command,
     5	# args}}} plus the wrapper's additive fields (prefix, quirks) — and REJECTS anything it
     6	# would otherwise silently drop. The spec advertises the full Claude Code shape while the
     7	# daemon passes only command and args to the child, so an ignored `env` or `url` is a
     8	# late failure waiting for the first real call; rejection with the field's name is the
     9	# contract. Exercised through the module's own CLI (validate <file>), asserting by effect
    10	# on stdout, stderr and exit codes.
    11	set -uo pipefail
    12	HERE="$(cd "$(dirname "$0")" && pwd)"
    13	# shellcheck disable=SC1091
    14	. "$HERE/lib.sh"
    15	
    16	need python3 "xcode-select --install or brew install python3"
    17	LOADER="$HERE/../xcode-mcp-front/mcp_config.py"
    18	assert_file "$LOADER" "mcp_config.py exists next to the daemon"
    19	
    20	ok_cfg="$SB/good.json"
    21	cat > "$ok_cfg" <<'EOF'
    22	{
    23	  "mcpServers": {
    24	    "xcode": {"command": "xcrun", "args": ["mcpbridge"], "quirks": ["require_xcode"]},
    25	    "drews": {"command": "uvx", "args": ["drews-xcode-mcp"]}
    26	  }
    27	}
    28	EOF
    29	
    30	# --- the happy path: both upstreams parsed, prefixes defaulted from the server name ---
    31	out="$SB/good.out"
    32	python3 "$LOADER" validate "$ok_cfg" >"$out" 2>&1
    33	assert_eq "0" "$?" "a valid two-upstream config validates"
    34	assert_contains "$out" "xcode" "validate lists the first upstream"
    35	assert_contains "$out" "drews" "validate lists the second upstream"
    36	assert_contains "$out" "xcode__" "prefix defaults to the server name plus __"
    37	
    38	# --- a command path containing a colon and an argument containing a comma survive ---
    39	# Both are silently corrupted by the env-var format this file replaces (split(':') and
    40	# split(',')); the JSON path must round-trip them intact.
    41	tricky="$SB/tricky.json"
    42	cat > "$tricky" <<'EOF'
    43	{
    44	  "mcpServers": {
    45	    "odd": {"command": "/opt/we:ird/bin/serve", "args": ["--label", "a,b,c"]}
    46	  }
    47	}
    48	EOF
    49	out="$SB/tricky.out"
    50	python3 "$LOADER" validate "$tricky" >"$out" 2>&1
    51	assert_eq "0" "$?" "colon-in-command and comma-in-arg config validates"
    52	assert_contains "$out" "/opt/we:ird/bin/serve" "a colon inside the command path survives parsing"
    53	assert_contains "$out" "a,b,c" "a comma inside one argument stays one argument"
    54	
    55	# --- unimplemented Claude Code fields are REJECTED BY NAME, never ignored ---
    56	# (env graduated to implemented in the Phase 1 hardening and has its own tests below)
    57	for field in cwd url; do
    58	  bad="$SB/has-$field.json"
