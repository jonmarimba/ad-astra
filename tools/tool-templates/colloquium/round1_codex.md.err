     1	#!/usr/bin/env bash
     2	# install.sh — convocation agents. RULE: check for an existing install FIRST (any method),
     3	# and only ever install via the SAME method this environment already uses — never a second
     4	# copy through a different package manager.
     5	#   claude = npm -g @anthropic-ai/claude-code   codex = npm -g @openai/codex   qwen = brew qwen-code
     6	set -euo pipefail
     7	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$HOME/.local/bin:$PATH"
     8	
     9	have() {  # present anywhere on PATH? report where + how it resolves, and skip install
    10	  local p; p="$(command -v "$1" 2>/dev/null)" || return 1
    11	  echo "already installed: $1 -> $p $( [ -L "$p" ] && echo "-> $(readlink "$p")" )"
    12	}
    13	
    14	have claude || { echo "installing claude via npm (the method used here)"; npm install -g @anthropic-ai/claude-code; }
    15	have codex  || { echo "installing codex via npm (the method used here)";  npm install -g @openai/codex; }
    16	have qwen   || { echo "installing qwen via brew (the method used here)";  brew install qwen-code; }
    17	
    18	echo "--- final state (one copy each, no shadowing) ---"
    19	for b in claude codex qwen; do
    20	  hits=0
    21	  for d in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin" "$HOME/bin" "$HOME/.bun/bin" "$HOME/.cargo/bin"; do
    22	    [ -e "$d/$b" ] && { echo "  $d/$b"; hits=$((hits+1)); }
    23	  done
    24	  [ "$hits" -gt 1 ] && echo "  WARNING: $b has $hits copies — resolve before scheduling anything that calls it"
    25	done
    26	# the [ -gt 1 ] test being false on the loop's last iteration must not become the script's
    27	# exit code (a clean single-copy state read as failure — caught by test-installers-which-first)
    28	
    29	# --into <repo>: also install convocation's DOCTRINE (convoq-first + mix-brands) into that repo's
    30	# instruction files, so the capability travels with the rules for using it there.
    31	INTO=""; want_into=0
    32	for a in "$@"; do
    33	  if [ "$want_into" = 1 ]; then INTO="$a"; want_into=0; continue; fi
    34	  [ "$a" = "--into" ] && want_into=1
    35	done
    36	if [ -n "$INTO" ]; then
    37	  HERE="$(cd "$(dirname "$0")" && pwd)"
    38	  "$HERE/../lib/install-doctrine.sh" "$INTO" "$HERE/convocation-doctrine.md" --slug convocation
    39	fi
    40	exit 0

