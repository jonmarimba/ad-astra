   418	
   419	def main():
   420	    cmds = {"scan": cmd_scan, "status": cmd_status, "sync": cmd_sync}
   421	    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
   422	        print(f"usage: registry.py {{{'|'.join(cmds)}}} [--dry-run] [tool...]")
   423	        return 64
   424	    return cmds[sys.argv[1]](sys.argv[2:])
   425	
   426	
   427	if __name__ == "__main__":
   428	    sys.exit(main())

