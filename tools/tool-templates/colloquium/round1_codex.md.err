   123	def _load_config_file() -> None:
   124	    """Reached via a wrapped .app under launchd in real deployment, which does
   125	    NOT reliably forward a launchd plist's EnvironmentVariables into the
   126	    launched app's process (a LaunchServices quirk, separate from the TCC one
   127	    this tool is already built around). A config file sidesteps that entirely:
   128	    it's read directly off disk, so it works regardless of how this process was
   129	    launched. Real env vars still win if both are set (checked with setdefault,
   130	    same layering as ollama-watch's config convention elsewhere in this repo)."""
   131	    conf = os.path.join(os.environ.get("XCODE_MCP_FRONT_HOME", os.path.expanduser("~/.xcode-mcp-front")), "config")
   132	    if not os.path.isfile(conf):
   133	        return
   134	    with open(conf) as f:
   135	        for line in f:
   136	            line = line.strip()
   137	            if not line or line.startswith("#") or "=" not in line:
   138	                continue
   139	            key, _, value = line.partition("=")
   140	            os.environ.setdefault(key.strip(), value.strip().strip("'\""))
   141	
   142	
   143	_load_config_file()
   144	
   145	HOST = os.environ.get("XCODE_MCP_FRONT_HOST", "127.0.0.1")
   146	PORT = int(os.environ.get("XCODE_MCP_FRONT_PORT", "8765"))
   147	AUTO_ALLOW = os.environ.get("XCODE_MCP_FRONT_AUTO_ALLOW", "1") == "1"
   148	
   149	# Both /Applications/Xcode.app and /Applications/Xcode-beta.app share the exact
   150	# same CFBundleExecutable ("Xcode") AND the same CFBundleIdentifier
   151	# (com.apple.dt.Xcode) - confirmed live, 2026-08-14. Neither a bare process-name
   152	# match nor a bundle-ID match can tell them apart. Only the executable's full
   153	# path differs, so that's what this matches on - anchored and exact, not a
   154	# substring, so it can't accidentally match the beta path either.
   155	XCODE_APP_PATH = os.environ.get("XCODE_MCP_FRONT_XCODE_APP_PATH", "/Applications/Xcode.app")
   156	XCODE_BINARY_PATH = f"{XCODE_APP_PATH.rstrip('/')}/Contents/MacOS/Xcode"
   157	RECONNECT_POLL_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_RECONNECT_POLL_S", "5"))
   158	CONNECT_TIMEOUT_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_CONNECT_TIMEOUT_S", "15"))
   159	# Generous on purpose - a real Xcode build_project call can legitimately run
   160	# for minutes. The point isn't to bound normal work, it's to make sure NO call
   161	# can wedge the daemon forever (found live, 2026-08-14: with no timeout at all,
   162	# one genuinely hung upstream call held the connection lock for 2+ minutes and
   163	# counting, wedging every future call to that upstream, single-upstream or
   164	# combined, until manually restarted). Raise this if a real workload needs
   165	# longer than the default.
   166	#
   167	# Default corrected to 600s (was 120s) by convocation review, 2026-08-14: 120s
   168	# contradicted this comment's own "can legitimately run for minutes" — a real
   169	# clean/first build commonly runs past 2 minutes, so the old default silently
   170	# killed and dropped exactly the workload it claimed to tolerate, then
   171	# reconnected and reported "not connected right now, retry shortly" — which is
   172	# actively misleading once this fires, since the build was killed mid-flight,
   173	# not merely delayed; a retry starts it over, it doesn't resume it.
   174	CALL_TIMEOUT_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_CALL_TIMEOUT_S", "600"))
   175	SERVER_NAME = os.environ.get("XCODE_MCP_FRONT_SERVER_NAME", "xcode-mcp-front")
   176	
   177	logging.basicConfig(level=logging.INFO, format=f"%(asctime)s {SERVER_NAME} %(message)s")
   178	log = logging.getLogger(SERVER_NAME)
