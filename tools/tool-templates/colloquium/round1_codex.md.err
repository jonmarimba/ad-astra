   296	def cmd_status(_):
   297	    reg = load()
   298	    stale = current = unsafe = 0
   299	    for name, t in sorted(reg.get("tools", {}).items()):
   300	        csha = sha(ASTRA / t["canonical"])
   301	        lines = []
   302	        for i in t["installs"]:
   303	            live = sha(i["path"])
   304	            if live is None:
   305	                lines.append(("GONE   ", i["path"])); continue
   306	            if not i.get("safe", True):
   307	                lines.append(("UNSAFE ", f"{i['path']}  ({i.get('unsafe_reason')})"))
   308	                unsafe += 1
   309	            elif live == csha:
   310	                lines.append(("current", i["path"])); current += 1
   311	            else:
   312	                lines.append(("STALE  ", i["path"])); stale += 1
   313	        if lines:
   314	            print(f"── {name}  (canonical {csha})")
   315	            for st, p in lines:
   316	                print(f"     {st}  {p.replace(str(Path.home()) + '/', '~/')}")
   317	    print(f"\n{current} current, {stale} STALE, {unsafe} unsafe")
   318	    return 1 if (stale or unsafe) else 0
   319	
