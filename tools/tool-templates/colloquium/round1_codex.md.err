   649	
   650	def _parse_multi_upstreams(spec: str) -> list[Upstream]:
   651	    """"name:require_xcode:command:arg1,arg2,...;name2:..." -> [Upstream, ...]"""
   652	    upstreams = []
   653	    for chunk in spec.split(";"):
   654	        chunk = chunk.strip()
   655	        if not chunk:
   656	            continue
   657	        name, require_xcode, command, argstr = chunk.split(":", 3)
   658	        args = [a for a in argstr.split(",") if a]
   659	        upstreams.append(Upstream(name.strip(), command.strip(), args, require_xcode.strip() == "1"))
   660	    if not upstreams:
   661	        raise ValueError(f"XCODE_MCP_FRONT_UPSTREAMS set but parsed to zero upstreams: {spec!r}")
   662	    return upstreams
   663	
   664	
   665	def _build_upstreams() -> list[Upstream]:
   666	    multi_spec = os.environ.get("XCODE_MCP_FRONT_UPSTREAMS")
   667	    if multi_spec:
   668	        return _parse_multi_upstreams(multi_spec)
   669	    return [
   670	        Upstream(
   671	            name="default",
   672	            command=os.environ.get("XCODE_MCP_FRONT_UPSTREAM_CMD", "xcrun"),
   673	            args=os.environ.get("XCODE_MCP_FRONT_UPSTREAM_ARGS", "mcpbridge").split(),
   674	            require_xcode_running=os.environ.get("XCODE_MCP_FRONT_REQUIRE_XCODE", "1") == "1",
   675	        )
   676	    ]
   677	
   678	
   679	def _not_connected_result(detail: str) -> types.CallToolResult:
   680	    return types.CallToolResult(
   681	        content=[
   682	            types.TextContent(
   683	                type="text",
   684	                text=(
   685	                    f"xcode-mcp-front: {detail} This daemon retries on its own every few "
   686	                    "seconds (checking Xcode is running and clicking its approval prompt if "
   687	                    "one is showing) — a retry shortly should work without any manual action."
   688	                ),
   689	            )
   690	        ],
   691	        is_error=True,
   692	    )
   693	
   694	
   695	def build_server(upstreams: list[Upstream]) -> Server:
   696	    single = len(upstreams) == 1
   697	    prefix_of = {u: (f"{u.name}__" if not single else "") for u in upstreams}
   698	    upstream_by_prefix = {prefix_of[u]: u for u in upstreams}
   699	
   700	    async def on_list_tools(
   701	        ctx: ServerRequestContext, params: types.PaginatedRequestParams | None
   702	    ) -> types.ListToolsResult:
   703	        all_tools: list[types.Tool] = []
   704	        results_by_upstream: dict[str, list[types.Tool]] = {}
   705	        for u in upstreams:
   706	            result = await u.list_tools(params)
   707	            prefix = prefix_of[u]
   708	            upstream_tools = []
   709	            for t in result.tools:
   710	                if prefix:
   711	                    t = t.model_copy(update={"name": f"{prefix}{t.name}"})
   712	                upstream_tools.append(t)
   713	            results_by_upstream[u.name] = upstream_tools
   714	            all_tools.extend(upstream_tools)
   715	        # In multi-upstream mode, ALL upstreams must be connected.  Serving a
   716	        # partial tool list silently hides the missing upstream from the client
   717	        # — it gets half the tools and has no idea.  Return zero tools and a
   718	        # loud message instead so the client retries once the daemon reconnects
   719	        # the dead upstream (which it does on its own, every few seconds).
   720	        if not single:
   721	            missing = [u.name for u in upstreams if not results_by_upstream.get(u.name)]
   722	            if missing:
   723	                log.warning("list_tools: refusing to serve partial tool list — missing upstreams: %s", missing)
   724	                return types.ListToolsResult(tools=[])
   725	        return types.ListToolsResult(tools=all_tools)
   726	
   727	    async def on_call_tool(ctx: ServerRequestContext, params: types.CallToolRequestParams) -> types.CallToolResult:
   728	        name = params.name
   729	        target = None
   730	        tool_name = name
   731	        for prefix, u in upstream_by_prefix.items():
   732	            if prefix and name.startswith(prefix):
   733	                target = u
   734	                tool_name = name[len(prefix) :]
   735	                break
   736	        if target is None:
   737	            # single-upstream mode (no prefixes at all), or a multi-upstream
   738	            # call that somehow arrived unprefixed — route to the sole
   739	            # upstream if there's only one, otherwise this is a real error.
   740	            if single:
   741	                target = upstreams[0]
   742	            else:
   743	                return types.CallToolResult(
   744	                    content=[
   745	                        types.TextContent(
   746	                            type="text",
   747	                            text=f"xcode-mcp-front: tool name '{name}' doesn't match any known upstream prefix "
   748	                            f"({', '.join(p for p in upstream_by_prefix if p)})",
   749	                        )
   750	                    ],
   751	                    is_error=True,
   752	                )
   753	
   754	        result = await target.call_tool(tool_name, params.arguments)
   755	        if result is None:
   756	            return _not_connected_result(f"[{target.name}] not connected right now.")
   757	        return result
   758	
   759	    names = ", ".join(u.name for u in upstreams)
   760	    if single:
   761	        instructions = (
   762	            "This is a persistent proxy in front of Apple's own Xcode MCP bridge "
   763	            "(`xcrun mcpbridge`) — same tools it exposes, reached over HTTP instead of "
   764	            "each client spawning its own copy (that used to mean a separate Xcode "
   765	            "approval popup per client; this way it's approved once and stays up).\n\n"
   766	            "If a call says 'not connected right now', this daemon is already retrying "
   767	            "on its own every few seconds — checking Xcode is running and clicking its "
   768	            "approval prompt if one is showing — so a short retry should work without "
   769	            "any manual action.\n\n"
   770	            "You will likely also see other Xcode-adjacent MCP servers configured "
   771	            "alongside this one — commonly named xcode-mcp-server (a third-party tool, "
   772	            "Drew's) and XcodeBuildMCP. That overlap is INTENTIONAL, not a conflict to "
   773	            "resolve or a sign something's misconfigured. Different tools cover the same "
   774	            "ground with different tradeoffs (this one needs Xcode's own approval once; "
   775	            "XcodeBuildMCP runs headless; xcode-mcp-server has its own run/screenshot "
   776	            "path). If a call here fails or behaves inconsistently, try the equivalent "
   777	            "tool on one of the others instead of giving up.\n\n"
   778	            "If you notice one of these consistently working better (or worse) than the "
   779	            "others for a given task, say so out loud in your response — that's wanted "
   780	            "information, not noise. It may be used later to deprioritize or hide the "
   781	            "less reliable option."
   782	        )
   783	    else:
   784	        instructions = (
   785	            f"This is a persistent proxy fronting MULTIPLE Xcode-adjacent MCP servers "
   786	            f"behind one endpoint: {names}. Every tool is prefixed with its upstream's "
   787	            f"name (e.g. `{upstreams[0].name}__SomeTool`) so two upstreams that happen to "
   788	            "expose a same-named tool can't collide or shadow each other — always use "
   789	            "the prefixed name shown in the tool list, never the bare upstream name.\n\n"
   790	            "If a call says 'not connected right now', that specific upstream is "
   791	            "reconnecting on its own — the others are unaffected, since each upstream "
   792	            "has its own independent connection. A short retry should work."
   793	        )
   794	
   795	    return Server(
   796	        SERVER_NAME,
   797	        version="0.4.0",
   798	        instructions=instructions,
   799	        on_list_tools=on_list_tools,
   800	        on_call_tool=on_call_tool,
   801	        lifespan=lambda app: _lifespan(app, upstreams),
   802	    )
   803	
   804	
   805	@contextlib.asynccontextmanager
   806	async def _lifespan(app: Server, upstreams: list[Upstream]):
   807	    async with anyio.create_task_group() as tg:
   808	        for u in upstreams:
   809	            tg.start_soon(u.connection_manager)
   810	            tg.start_soon(u.stall_watchdog)
   811	        try:
   812	            yield {}
   813	        finally:
   814	            tg.cancel_scope.cancel()
   815	
   816	
   817	def main() -> None:
   818	    upstreams = _build_upstreams()
   819	    server = build_server(upstreams)
   820	    app = server.streamable_http_app(host=HOST)
   821	    log.info("listening on http://%s:%s/mcp (upstreams: %s)", HOST, PORT, ", ".join(u.name for u in upstreams))
   822	    uvicorn.run(app, host=HOST, port=PORT, log_level="info")
   823	
   824	
   825	if __name__ == "__main__":
   826	    main()

