   180	
   181	# NOTE: no longer consulted by the click decision. It used to gate the "Don't Allow" branch
   182	# on the dialog's PID being dead, and that gate is what let a LIVE stranger's dialog block
   183	# the daemon forever. Kept because it is a correct, cheap liveness check and reads clearly
   184	# at a call site; delete it if nothing else picks it up.
   185	def _pid_is_alive(pid_str: str) -> bool:
   186	    """No history file needed: a dialog's PID is either us, or it's a live PID
   187	    that belongs to someone else's legitimate in-flight request (leave it
   188	    alone), or it's simply not in the process table anymore (nothing is
   189	    waiting on it — always safe to dismiss, regardless of whose it was).
   190	    Generalizes to every stale dialog, not just ones this exact daemon
   191	    happens to remember spawning itself, so it can never permanently
   192	    deadlock behind one it doesn't recognize."""
   193	    try:
   194	        os.kill(int(pid_str), 0)
   195	        return True
   196	    except ProcessLookupError:
   197	        return False
   198	    except (ValueError, PermissionError):
   199	        # ValueError: not a real pid, treat as "can't tell" -> leave it alone.
   200	        # PermissionError: pid exists but isn't ours to signal -> still alive.
   201	        return True
   202	
   203	
   204	def _xcode_is_running() -> bool:
   205	    try:
   206	        # -f matches the full command line; anchored so it can only match this
   207	        # exact binary path, not a substring of some other process's args.
   208	        return (
   209	            subprocess.run(["pgrep", "-f", f"^{XCODE_BINARY_PATH}$"], capture_output=True, timeout=5).returncode
   210	            == 0
   211	        )
   212	    except Exception:
   213	        # A broken check must never itself take the daemon down — treat "can't
   214	        # tell" as "not running" and just try again next poll.
   215	        return False
   216	
   217	
   218	async def _run_osascript(script: str) -> bytes:
   219	    """Raises on a nonzero exit instead of returning empty bytes. Found by
   220	    convocation review, 2026-08-14: with stderr sent to DEVNULL and no
   221	    returncode check, a TCC grant getting revoked or dying (the documented
   222	    failure mode after any edit to the ad-hoc-signed wrapper .app — new hash,
   223	    dead grant) made osascript exit nonzero with an error, which this
   224	    previously returned as plain b"" — indistinguishable from "no dialog
   225	    showing". The click loop would then silently stop working with nothing in
   226	    the log naming the actual cause. Now surfaces it: caller's except-block
   227	    already logs at warning level, so a dead grant shows up as a real,
   228	    diagnosable log line instead of a silent no-op.
   229	
   230	    Also found LIVE the same day, the hard way: a real System Events hang
   231	    (osascript stuck talking to it, unrelated to the return-code fix above —
   232	    System Events itself was wedged) piled up one leaked orphan osascript
   233	    process EVERY poll tick, forever, because `asyncio.wait_for` timing out
   234	    only abandons Python's own wait — it does NOT kill the underlying
   235	    subprocess. Confirmed live: 30+ orphaned osascript processes accumulated
   236	    in under 10 minutes before this was caught, and System Events itself
   237	    became unresponsive to even a basic query as a result. Now explicitly
   238	    kills the process on timeout instead of leaving it to run forever."""
   239	    proc = await asyncio.create_subprocess_exec(
   240	        "osascript",
   241	        "-e",
   242	        script,
   243	        stdout=asyncio.subprocess.PIPE,
   244	        stderr=asyncio.subprocess.PIPE,
   245	    )
   246	    try:
   247	        out, err = await asyncio.wait_for(proc.communicate(), timeout=5)
   248	    except asyncio.TimeoutError:
   249	        proc.kill()
   250	        await proc.wait()  # reap it — don't leave a zombie behind either
   251	        raise RuntimeError("osascript timed out after 5s (System Events may be unresponsive)")
   252	    if proc.returncode != 0:
   253	        raise RuntimeError(f"osascript exited {proc.returncode}: {err.decode(errors='replace').strip()}")
   254	    return out
   255	
   256	
   257	# THE CLICKER IS LOAD-BEARING AND MUST NOT BE "DESIGNED AWAY". Xcode's approval is keyed to
   258	# the CONNECTING PID, and a daemon restart always mints a new one, so no grant survives a
   259	# bounce — not a signed app bundle, not the "don't ask again for this agent binary" checkbox,
   260	# which only lasts until Xcode itself restarts. An unattended daemon therefore has to answer
   261	# its own prompt or it can never connect after any restart. Jonathan, 2026-08-30, correcting
   262	# a suggestion to remove it: "the daemons HAVE to depend on a clicker."
   263	#
   264	# That is why a defect in this function is not cosmetic. It is the only path to a working
   265	# connection, so a branch that silently declines to click takes the whole daemon down while
   266	# every log line still says "connected".
   267	
   268	
   269	# How long another process's approval dialog is left alone before we clear it. Only once we
   270	# have been blocked for this long is it fair to assume nobody is coming to answer it.
   271	# HOW LONG A FOREIGN DIALOG MAY BLOCK US BEFORE WE CLEAR IT. This MUST be comfortably less
   272	# than CONNECT_TIMEOUT_SECONDS or two daemons deadlock by arithmetic rather than by bad luck.
   273	#
   274	# It was 45 against a 15-second connect timeout. Xcode's approval dialogs do not stack, so when
   275	# both front daemons are up, each one's clicker finds the other's dialog, correctly classifies it
   276	# as foreign-and-alive, and waits out a grace period three times longer than the connection
   277	# attempt it is holding up. Its own prompt therefore never surfaces, its list_tools times out,
   278	# it tears the child down — which withdraws its request — and both sides repeat forever. That is
   279	# the "do two bridges interfere" question Jonathan asked: they do, and this constant is why.
   280	#
   281	# Clearing a live foreign dialog is not destructive. That process re-prompts on its next attempt,
   282	# which for these daemons is RECONNECT_POLL_SECONDS away, so two of them alternate and both get
   283	# through instead of neither.
   284	FOREIGN_DIALOG_GRACE_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_FOREIGN_GRACE", "6"))
   285	
   286	# The relationship above is load-bearing, so it is checked rather than trusted to a comment. A
   287	# grace period at or beyond the connect timeout is a silent, permanent deadlock whenever a second
   288	# client exists, and it presents as "mcpbridge refuses to serve tools" — which is exactly how it
   289	# presented, for a night.
   290	if FOREIGN_DIALOG_GRACE_SECONDS >= CONNECT_TIMEOUT_SECONDS:
   291	    raise SystemExit(
   292	        "xcode-mcp-front: XCODE_MCP_FRONT_FOREIGN_GRACE (%.1fs) must be less than "
   293	        "XCODE_MCP_FRONT_CONNECT_TIMEOUT_S (%.1fs). A foreign approval dialog that outlives the "
   294	        "connection attempt it is blocking can never be cleared in time, so two daemons deadlock "
   295	        "and every symptom looks like Xcode refusing to serve tools."
   296	        % (FOREIGN_DIALOG_GRACE_SECONDS, CONNECT_TIMEOUT_SECONDS))
   297	
   298	# How long an upstream may make NO progress before we let launchd restart us. See
   299	# stall_watchdog(). Generous on purpose: a false positive restarts a healthy daemon.
   300	STALL_EXIT_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_STALL_EXIT", "180"))
   301	
   302	# How often to look for the approval dialog while a call is blocked waiting for it. Short,
   303	# because the window is the length of one blocked list_tools and a missed dialog costs the
   304	# whole connection attempt.
   305	ALLOW_CLICK_POLL_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_CLICK_POLL", "1.5"))
   306	
   307	# Set the first time we see a foreign dialog while we are not connected; cleared whenever we
   308	# see no dialog or our own. Module-level rather than per-upstream because Xcode shows one
   309	# dialog at a time for the whole application, so this is genuinely global state.
   310	_foreign_dialog_first_seen: dict = {}
   311	
   312	
   313	async def _click_allow_if_present() -> bool:
   314	    """Best-effort, narrowly scoped: only ever touches a button whose title is
   315	    the exact literal string "Allow" or "Don't Allow", only in Xcode's own
   316	    process. This is the one dialog this tool exists to eat, not a general
   317	    click-any-prompt macro. Harmless no-op for an upstream (like
   318	    drews-xcode-mcp) that never triggers this dialog at all — it just never
   319	    finds anything to click.
   320	
   321	    Xcode's approval dialogs do NOT stack (confirmed live, 2026-08-14 — only
   322	    one is ever showing; a new connection attempt's own dialog stays hidden
   323	    behind whatever's currently up until that one is dismissed). So a single
   324	    stale, never-answered dialog can permanently block every future connection
   325	    attempt, including this daemon's own, unless something clears it.
   326	
   327	    The decision, once a dialog's own PID is read from its text:
   328	      - matches OUR current pid            -> click Allow
   329	      - doesn't match, and that pid is DEAD -> click Don't Allow (nobody's
   330	        waiting on it — always safe, regardless of whose it originally was;
   331	        no history-tracking needed, this can't deadlock behind a dialog it
   332	        doesn't "remember")
   333	      - doesn't match, and that pid is ALIVE -> leave it alone; it's someone
   334	        else's legitimate in-flight request, not ours to approve OR deny
   335	    """
   336	    my_pid = str(os.getpid())
   337	    # Iterate every window, not just window 1 — found by convocation review,
   338	    # 2026-08-14: the approval dialog isn't guaranteed to be window 1 (e.g. a
   339	    # project window frontmost, or the dialog opening as window 2). Window 1
   340	    # only would silently never find the dialog and leave it unclicked
   341	    # forever. check-allow-window.sh already iterated all windows correctly;
   342	    # this production path didn't match it.
   343	    read_script = """
   344	tell application "System Events" to tell process "Xcode"
   345	  repeat with w in windows
   346	    if exists (button "Allow" of w) then
   347	      set winText to ""
   348	      try
   349	        set winText to (value of every static text of w) as string
   350	      end try
   351	      return winText
   352	    end if
   353	  end repeat
   354	  return ""
   355	end tell
   356	"""
   357	    try:
   358	        out = await _run_osascript(read_script)
   359	    except Exception as e:
   360	        log.warning("checking for an approval dialog failed (will retry, but if this repeats, check "
   361	                     "whether the wrapper .app's Accessibility/Automation grant is still valid): %s", e)
   362	        return False
   363	
   364	    text = out.decode(errors="replace")
   365	    if "PID: " not in text:
   366	        return False  # no dialog showing — the normal case most ticks
   367	
   368	    dialog_pid = text.split("PID: ", 1)[1].split()[0].strip()
   369	
   370	    if dialog_pid == my_pid:
   371	        _foreign_dialog_first_seen.pop("pid", None)
   372	        action = "Allow"
   373	    else:
   374	        # A GRACE PERIOD, BECAUSE CLEARING UNCONDITIONALLY MONOPOLISES XCODE. The previous
   375	        # version denied every foreign PID on sight. That unblocks us and starves everyone
   376	        # else: a legitimate agent's dialog gets Don't Allow, it retries, and it lands in the
   377	        # same denial loop forever, so this daemon owns Xcode and nothing else can use it.
   378	        # GhOST-OpenClaw caught it in peer review of the commit that introduced it.
   379	        #
   380	        # The bounded version keeps both properties. Somebody else's prompt is left alone
   381	        # while there is any chance they are about to answer it — which is the normal case,
   382	        # since a live agent's own approval usually resolves in seconds. Only once the SAME
   383	        # foreign dialog has been sitting there long enough to have stopped being anyone's
   384	        # in-flight request do we clear it so ours can surface. Nothing is destroyed either
   385	        # way: a denied agent re-prompts on its next attempt.
   386	        first = _foreign_dialog_first_seen.get("pid")
   387	        now = time.monotonic()
   388	        if first is None or first[0] != dialog_pid:
   389	            _foreign_dialog_first_seen["pid"] = (dialog_pid, now)
   390	            log.debug("a foreign approval dialog (pid %s) is in the way; leaving it for %.0fs "
   391	                      "in case its own agent answers it", dialog_pid, FOREIGN_DIALOG_GRACE_SECONDS)
   392	            return False
   393	        if now - first[1] < FOREIGN_DIALOG_GRACE_SECONDS:
   394	            return False
   395	        log.info("foreign approval dialog for pid %s has blocked us for %.0fs — clearing it so "
   396	                 "our own prompt can surface; that process re-prompts on its next attempt",
   397	                 dialog_pid, now - first[1])
   398	        # ANYTHING ELSE IN FRONT OF OURS GETS CLEARED, live or dead. This used to leave a
   399	        # LIVE unfamiliar PID's dialog strictly alone, out of politeness to another agent's
   400	        # in-flight request. That politeness is unaffordable here: Xcode's dialogs do not
   401	        # stack, so a single stranger's unanswered prompt sits in front of ours forever and
   402	        # the daemon can never connect again — which is exactly what a leftover
   403	        # "Allow 'Codex' to access Xcode?" from a convocation run did on 2026-08-30, and
   404	        # what the two front daemons did to each other for the sixteen days before that.
   405	        #
   406	        # Denying is not destructive and that is what makes this safe. A denied agent is
   407	        # told no for one connection attempt and re-prompts on its next one, by which time
   408	        # ours is out of the way. Jonathan, 2026-08-30: "I don't see why this needs
   409	        # exclusive access. Just run it saying with PID you care about or whatever?"
   410	        #
   411	        # The sibling branch above still matters and is not redundant: two front daemons
   412	        # denying each other would ping-pong, each clearing the other's prompt on every
   413	        # retry. Family gets Allow, everyone else gets out of the way.
   414	        action = "Don’t Allow"
   415	    click_script = f"""
   416	tell application "System Events" to tell process "Xcode"
   417	  repeat with w in windows
   418	    if exists (button "{action}" of w) then
   419	      click (button "{action}" of w)
   420	      return "clicked"
   421	    end if
   422	  end repeat
   423	  return "gone"
   424	end tell
   425	"""
   426	    try:
   427	        out2 = await _run_osascript(click_script)
   428	    except Exception as e:
   429	        log.warning("clicking the approval dialog failed (will retry, but if this repeats, check "
   430	                     "whether the wrapper .app's Accessibility/Automation grant is still valid): %s", e)
   431	        return False
   432	
   433	    clicked = b"clicked" in out2
   434	    if clicked and action == "Allow":
   435	        log.info("clicked Allow for our own connection-approval prompt (pid %s)", my_pid)
   436	    elif clicked:
   437	        log.info("cleared an approval dialog for pid %s (not ours, not a sibling) so ours can "
   438	                 "surface — it re-prompts on its next attempt", dialog_pid)
   439	    return clicked and action == "Allow"
   440	
   441	
   442	class Upstream:
   443	    """One upstream MCP server this daemon fronts, and everything needed to
   444	    keep a persistent connection to it alive. In single-upstream mode there's
   445	    exactly one of these and its tools are forwarded unprefixed (unchanged
   446	    behavior from before multi-upstream support existed). In multi-upstream
   447	    mode there are several, and the aggregator (see build_server) prefixes
   448	    each one's tools with `self.name + "__"` so two upstreams that happen to
   449	    share a tool name can't collide."""
   450	
   451	    def __init__(self, name: str, command: str, args: list[str], require_xcode_running: bool):
   452	        self.name = name
   453	        # Watchdog input: bumped on every connect attempt and every successful heartbeat.
   454	        # Initialised here so the watchdog never reads a missing attribute on a slow start.
   455	        self.last_progress = time.monotonic()
   456	        self.command = command
   457	        self.args = args
   458	        self.require_xcode_running = require_xcode_running
   459	        self.lock = anyio.Lock()
   460	        self.session: ClientSession | None = None
   461	        self.known_broken = False
   462	
   463	    async def list_tools(self, params: types.PaginatedRequestParams | None) -> types.ListToolsResult:
   464	        async with self.lock:
   465	            if self.session is None:
   466	                return types.ListToolsResult(tools=[])
   467	            try:
   468	                with anyio.fail_after(CALL_TIMEOUT_SECONDS):
   469	                    return await self.session.list_tools(params=params)
   470	            except Exception as e:
   471	                # Found live, 2026-08-14: this call had NO timeout at all before
   472	                # this fix — a genuinely hung upstream call (confirmed: a real
   473	                # tool call sat for 2+ minutes with nothing in the log, no
   474	                # timeout, no recovery) held self.lock forever, permanently
   475	                # wedging this upstream for every future call, single-upstream
   476	                # or combined. A timeout here means a hang gets treated the
   477	                # same as any other failure: marked broken, reconnected fresh.
   478	                self.known_broken = True
   479	                log.warning("[%s] list_tools failed, marking connection broken: %s", self.name, e)
   480	                return types.ListToolsResult(tools=[])
   481	
   482	    async def call_tool(self, tool_name: str, arguments: dict) -> types.CallToolResult | None:
   483	        """Returns None if not connected — caller decides how to report that,
   484	        since the aggregator needs a slightly different message than the
   485	        single-upstream case (naming which upstream is down)."""
   486	        async with self.lock:
   487	            if self.session is None:
   488	                return None
   489	            log.info("[%s] call_tool %s", self.name, tool_name)
   490	            try:
   491	                with anyio.fail_after(CALL_TIMEOUT_SECONDS):
   492	                    result = await self.session.call_tool(tool_name, arguments)
   493	            except Exception as e:
   494	                # See list_tools' comment — same missing-timeout bug, same fix.
   495	                self.known_broken = True
   496	                log.warning("[%s] call_tool %s failed, marking connection broken: %s", self.name, tool_name, e)
   497	                return None
   498	            if not isinstance(result, types.CallToolResult):
   499	                # upstream returned something this dumb proxy doesn't forward
   500	                # (e.g. InputRequiredResult) — surface as an error, don't crash.
   501	                return types.CallToolResult(
   502	                    content=[
   503	                        types.TextContent(
   504	                            type="text",
   505	                            text=f"xcode-mcp-front: [{self.name}] unsupported upstream result type "
   506	                            f"{type(result).__name__}",
   507	                        )
   508	                    ],
   509	                    is_error=True,
   510	                )
   511	            return result
   512	
   513	    async def stall_watchdog(self) -> None:
   514	        """Exit the process if this upstream stops making progress entirely.
   515	
   516	        THE RECONNECT LOOP CAN GET STUCK AND GO PERMANENTLY SILENT. Observed live
   517	        2026-08-30: xcode-mcp-front logged "heartbeat list_tools failed, marking broken"
   518	        at 18:50:55 and then never logged again — no retry, no error, nothing — while its
   519	        HTTP endpoint kept answering and serving zero tools. The cause is the teardown, not
   520	        the loop: leaving `async with stdio_client(...)` waits for the child to exit, and a
   521	        wedged mcpbridge never does, so the task blocks inside __aexit__ where no `except`
   522	        and no retry can reach it. Every health signal this daemon has says "fine" in that
   523	        state, which is the worst possible failure shape.
   524	
   525	        There is no clean way to bound a hung context-manager exit from inside it. There IS
   526	        a supervisor: launchd, with KeepAlive true. So when an upstream has made no progress
   527	        for STALL_EXIT_SECONDS — no connect attempt, no successful heartbeat — say so loudly
   528	        and exit non-zero. That is the file's own stated philosophy: "a genuine crash is what
   529	        the process supervisor is for." A restart costs one new Xcode approval prompt, which
   530	        the clicker answers.
   531	
   532	        Deliberately generous, because a false positive here restarts a working daemon: the
   533	        default is many multiples of the heartbeat interval, and any progress at all resets it.
   534	        """
   535	        while True:
   536	            await anyio.sleep(RECONNECT_POLL_SECONDS)
   537	            if self.require_xcode_running and not _xcode_is_running():
   538	                # Waiting for Xcode is not a stall; that path logs and sleeps on purpose.
   539	                self.last_progress = time.monotonic()
   540	                continue
   541	            idle = time.monotonic() - getattr(self, "last_progress", time.monotonic())
   542	            if idle > STALL_EXIT_SECONDS:
   543	                log.error("[%s] no connect attempt and no successful heartbeat for %.0fs — the "
   544	                          "reconnect loop is wedged, almost certainly blocked in stdio_client "
   545	                          "teardown waiting on an mcpbridge child that will not exit. Exiting "
   546	                          "so launchd restarts us; staying up would serve zero tools while "
   547	                          "every log line claimed we were connected.", self.name, idle)
   548	                os._exit(75)
   549	
   550	
   551	    async def connection_manager(self) -> None:
   552	        """Owns this upstream's connection for the daemon's whole life. Loops
   553	        forever: while not connected, check Xcode is running (if this upstream
   554	        needs it), best-effort click its approval prompt if showing, attempt a
   555	        fresh connect. Once connected, holds the session open — polling (and
   556	        clicking) on the same timer — until a call proves it's broken, then
   557	        goes back to reconnecting. In-process, never exits on its own; a
   558	        genuine crash is what the process supervisor (launchd) is for."""
   559	        params = StdioServerParameters(command=self.command, args=self.args)
   560	        while True:
   561	            if self.require_xcode_running and not _xcode_is_running():
   562	                log.info("[%s] Xcode not running, waiting", self.name)
   563	                await anyio.sleep(RECONNECT_POLL_SECONDS)
   564	                continue
   565	
   566	            if AUTO_ALLOW:
   567	                await _click_allow_if_present()
   568	
   569	            log.info("[%s] attempting connect: %s %s", self.name, self.command, self.args)
   570	            self.last_progress = time.monotonic()
   571	            try:
   572	                async with stdio_client(params) as (read, write):
   573	                    async with ClientSession(read, write) as session:
   574	                        with anyio.fail_after(CONNECT_TIMEOUT_SECONDS):
   575	                            await session.initialize()
   576	                        async with self.lock:
   577	                            self.session = session
   578	                            self.known_broken = False
   579	                        log.info("[%s] connected — serving until this breaks", self.name)
   580	                        self.last_progress = time.monotonic()
   581	                        while not self.known_broken:
   582	                            await anyio.sleep(RECONNECT_POLL_SECONDS)
   583	                            # Health-check: a silent list_tools call catches a
   584	                            # dead upstream before any client discovers it.
   585	                            # Without this, a killed Xcode leaves the daemon
   586	                            # sitting "connected" until a real client call
   587	                            # fails — minutes of silently serving zero tools.
   588	                            # CLICK WHILE THE CALL IS BLOCKED, NOT AFTER IT RETURNS. This is
   589	                            # the deadlock that kept the suite at 6/10 and looked for a whole
   590	                            # night like Apple's bridge refusing to serve tools.
   591	                            #
   592	                            # Xcode raises "Allow <x> to access Xcode?" lazily, on the first real
   593	                            # list_tools rather than at the handshake — the comment below has
   594	                            # said so since 2026-08-14. So list_tools BLOCKS until that dialog is
   595	                            # answered. The clicker that answers it was placed after the await.
   596	                            # It therefore ran only once list_tools had already returned, and on
   597	                            # the timeout path the except branch marks the upstream broken and
   598	                            # breaks out before reaching it at all. The one thing that could
   599	                            # unblock the call was scheduled to run only after the call unblocked.
   600	                            #
   601	                            # Worse, the teardown withdraws the prompt: the dialog is bound to the
   602	                            # live connecting process, so killing the child on timeout retracts
   603	                            # the question. With a 5s reconnect loop the daemon spent all night
   604	                            # asking Xcode for permission and cancelling the request before anyone
   605	                            # could say yes — which is why no dialog was ever found on screen, and
   606	                            # why running a single bridge by hand and simply leaving it alive
   607	                            # produced the prompt immediately and 21 tools once it was answered.
   608	                            #
   609	                            # Two daemons made it twice as fast, which is the "do two bridges
   610	                            # interfere" question: they do, but only by doubling the churn. One
   611	                            # daemon alone reproduces it.
   612	                            try:
   613	                                with anyio.fail_after(CONNECT_TIMEOUT_SECONDS):
   614	                                    async with anyio.create_task_group() as _tg:
   615	                                        async def _click_while_blocked():
   616	                                            # Poll rather than click once: the dialog appears a
   617	                                            # moment AFTER the request goes out, so a single
   618	                                            # attempt at the start reliably finds nothing.
   619	                                            while True:
   620	                                                if AUTO_ALLOW:
   621	                                                    await _click_allow_if_present()
   622	                                                await anyio.sleep(ALLOW_CLICK_POLL_SECONDS)
   623	                                        _tg.start_soon(_click_while_blocked)
   624	                                        await session.list_tools()
   625	                                        _tg.cancel_scope.cancel()
   626	                                self.last_progress = time.monotonic()
   627	                            except Exception as e:
   628	                                log.warning("[%s] heartbeat list_tools failed, marking broken: %s", self.name, e)
   629	                                async with self.lock:
   630	                                    self.known_broken = True
   631	                                break
   632	                            # The approval prompt has been observed appearing
   633	                            # AFTER a successful initialize() — requested
   634	                            # lazily, apparently on the first real list_tools
   635	                            # call rather than at the handshake. So keep
   636	                            # checking even once connected, not just while
   637	                            # reconnecting — safe every tick regardless, since
   638	                            # it only ever acts on our own pid or a dead one.
   639	                            if AUTO_ALLOW:
   640	                                await _click_allow_if_present()
   641	            except Exception as e:
   642	                log.warning("[%s] connect attempt failed (will retry): %s", self.name, e)
   643	
   644	            async with self.lock:
   645	                self.session = None
   646	            log.info("[%s] not connected, retrying in %ss", self.name, RECONNECT_POLL_SECONDS)
   647	            await anyio.sleep(RECONNECT_POLL_SECONDS)
   648	
   649	
   650	def _parse_multi_upstreams(spec: str) -> list[Upstream]:
   651	    """"name:require_xcode:command:arg1,arg2,...;name2:..." -> [Upstream, ...]"""
   652	    upstreams = []
   653	    for chunk in spec.split(";"):
   654	        chunk = chunk.strip()
   655	        if not chunk:
   656	            continue
   657	        name, require_xcode, command, argstr = chunk.split(":", 3)
   658	        args = [a for a in argstr.split(",") if a]
   659	        upstreams.append(Upstream(name.strip(), command.strip(), args, require_xcode.strip() == "1"))
   660	    if not upstreams:
   661	        raise ValueError(f"XCODE_MCP_FRONT_UPSTREAMS set but parsed to zero upstreams: {spec!r}")
   662	    return upstreams
   663	
   664	
   665	def _build_upstreams() -> list[Upstream]:
   666	    multi_spec = os.environ.get("XCODE_MCP_FRONT_UPSTREAMS")
   667	    if multi_spec:
   668	        return _parse_multi_upstreams(multi_spec)
   669	    return [
   670	        Upstream(
   671	            name="default",
   672	            command=os.environ.get("XCODE_MCP_FRONT_UPSTREAM_CMD", "xcrun"),
   673	            args=os.environ.get("XCODE_MCP_FRONT_UPSTREAM_ARGS", "mcpbridge").split(),
   674	            require_xcode_running=os.environ.get("XCODE_MCP_FRONT_REQUIRE_XCODE", "1") == "1",
   675	        )
   676	    ]
   677	
   678	
   679	def _not_connected_result(detail: str) -> types.CallToolResult:
   680	    return types.CallToolResult(
   681	        content=[
   682	            types.TextContent(
   683	                type="text",
   684	                text=(
   685	                    f"xcode-mcp-front: {detail} This daemon retries on its own every few "
   686	                    "seconds (checking Xcode is running and clicking its approval prompt if "
   687	                    "one is showing) — a retry shortly should work without any manual action."
   688	                ),
   689	            )
   690	        ],
   691	        is_error=True,
   692	    )
   693	
   694	
   695	def build_server(upstreams: list[Upstream]) -> Server:
   696	    single = len(upstreams) == 1
   697	    prefix_of = {u: (f"{u.name}__" if not single else "") for u in upstreams}
   698	    upstream_by_prefix = {prefix_of[u]: u for u in upstreams}
   699	
   700	    async def on_list_tools(
   701	        ctx: ServerRequestContext, params: types.PaginatedRequestParams | None
   702	    ) -> types.ListToolsResult:
   703	        all_tools: list[types.Tool] = []
   704	        results_by_upstream: dict[str, list[types.Tool]] = {}
   705	        for u in upstreams:
   706	            result = await u.list_tools(params)
   707	            prefix = prefix_of[u]
   708	            upstream_tools = []
   709	            for t in result.tools:
   710	                if prefix:
   711	                    t = t.model_copy(update={"name": f"{prefix}{t.name}"})
   712	                upstream_tools.append(t)
   713	            results_by_upstream[u.name] = upstream_tools
   714	            all_tools.extend(upstream_tools)
   715	        # In multi-upstream mode, ALL upstreams must be connected.  Serving a
   716	        # partial tool list silently hides the missing upstream from the client
   717	        # — it gets half the tools and has no idea.  Return zero tools and a
   718	        # loud message instead so the client retries once the daemon reconnects
   719	        # the dead upstream (which it does on its own, every few seconds).
   720	        if not single:
   721	            missing = [u.name for u in upstreams if not results_by_upstream.get(u.name)]
   722	            if missing:
   723	                log.warning("list_tools: refusing to serve partial tool list — missing upstreams: %s", missing)
   724	                return types.ListToolsResult(tools=[])
   725	        return types.ListToolsResult(tools=all_tools)
   726	
   727	    async def on_call_tool(ctx: ServerRequestContext, params: types.CallToolRequestParams) -> types.CallToolResult:
   728	        name = params.name
   729	        target = None
   730	        tool_name = name
   731	        for prefix, u in upstream_by_prefix.items():
   732	            if prefix and name.startswith(prefix):
   733	                target = u
   734	                tool_name = name[len(prefix) :]
   735	                break
   736	        if target is None:
   737	            # single-upstream mode (no prefixes at all), or a multi-upstream
   738	            # call that somehow arrived unprefixed — route to the sole
   739	            # upstream if there's only one, otherwise this is a real error.
   740	            if single:
   741	                target = upstreams[0]
   742	            else:
   743	                return types.CallToolResult(
   744	                    content=[
   745	                        types.TextContent(
   746	                            type="text",
   747	                            text=f"xcode-mcp-front: tool name '{name}' doesn't match any known upstream prefix "
   748	                            f"({', '.join(p for p in upstream_by_prefix if p)})",
   749	                        )
   750	                    ],
   751	                    is_error=True,
   752	                )
   753	
   754	        result = await target.call_tool(tool_name, params.arguments)
   755	        if result is None:
   756	            return _not_connected_result(f"[{target.name}] not connected right now.")
   757	        return result
   758	
   759	    names = ", ".join(u.name for u in upstreams)
   760	    if single:
   761	        instructions = (
   762	            "This is a persistent proxy in front of Apple's own Xcode MCP bridge "
   763	            "(`xcrun mcpbridge`) — same tools it exposes, reached over HTTP instead of "
   764	            "each client spawning its own copy (that used to mean a separate Xcode "
   765	            "approval popup per client; this way it's approved once and stays up).\n\n"
   766	            "If a call says 'not connected right now', this daemon is already retrying "
   767	            "on its own every few seconds — checking Xcode is running and clicking its "
   768	            "approval prompt if one is showing — so a short retry should work without "
   769	            "any manual action.\n\n"
   770	            "You will likely also see other Xcode-adjacent MCP servers configured "
   771	            "alongside this one — commonly named xcode-mcp-server (a third-party tool, "
   772	            "Drew's) and XcodeBuildMCP. That overlap is INTENTIONAL, not a conflict to "
   773	            "resolve or a sign something's misconfigured. Different tools cover the same "
   774	            "ground with different tradeoffs (this one needs Xcode's own approval once; "
   775	            "XcodeBuildMCP runs headless; xcode-mcp-server has its own run/screenshot "
   776	            "path). If a call here fails or behaves inconsistently, try the equivalent "
   777	            "tool on one of the others instead of giving up.\n\n"
   778	            "If you notice one of these consistently working better (or worse) than the "
   779	            "others for a given task, say so out loud in your response — that's wanted "
   780	            "information, not noise. It may be used later to deprioritize or hide the "
   781	            "less reliable option."
   782	        )
   783	    else:
   784	        instructions = (
   785	            f"This is a persistent proxy fronting MULTIPLE Xcode-adjacent MCP servers "
   786	            f"behind one endpoint: {names}. Every tool is prefixed with its upstream's "
   787	            f"name (e.g. `{upstreams[0].name}__SomeTool`) so two upstreams that happen to "
   788	            "expose a same-named tool can't collide or shadow each other — always use "
   789	            "the prefixed name shown in the tool list, never the bare upstream name.\n\n"
   790	            "If a call says 'not connected right now', that specific upstream is "
   791	            "reconnecting on its own — the others are unaffected, since each upstream "
   792	            "has its own independent connection. A short retry should work."
   793	        )
   794	
   795	    return Server(
   796	        SERVER_NAME,
   797	        version="0.4.0",
   798	        instructions=instructions,
   799	        on_list_tools=on_list_tools,
   800	        on_call_tool=on_call_tool,
   801	        lifespan=lambda app: _lifespan(app, upstreams),
   802	    )
   803	
   804	
   805	@contextlib.asynccontextmanager
   806	async def _lifespan(app: Server, upstreams: list[Upstream]):
   807	    async with anyio.create_task_group() as tg:
   808	        for u in upstreams:
   809	            tg.start_soon(u.connection_manager)
   810	            tg.start_soon(u.stall_watchdog)
   811	        try:
   812	            yield {}
   813	        finally:
   814	            tg.cancel_scope.cancel()
   815	
   816	
   817	def main() -> None:
   818	    upstreams = _build_upstreams()
   819	    server = build_server(upstreams)
   820	    app = server.streamable_http_app(host=HOST)
   821	    log.info("listening on http://%s:%s/mcp (upstreams: %s)", HOST, PORT, ", ".join(u.name for u in upstreams))
   822	    uvicorn.run(app, host=HOST, port=PORT, log_level="info")
   823	
   824	
   825	if __name__ == "__main__":
   826	    main()

