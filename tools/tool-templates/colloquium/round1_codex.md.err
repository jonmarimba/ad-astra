     1	#!/usr/bin/env python3
     2	"""
     3	astra-update — vendored into every repo at .astra/astra-update.
     4	
     5	WHAT THIS IS
     6	------------
     7	The pull half of astra's tool distribution. A repo that has astra tools
     8	installed carries this script and a manifest saying where each tool came from
     9	and what it looked like on arrival. This asks the source whether anything has
    10	moved on, and updates in place.
    11	
    12	WHY IT IS HERE AND NOT IN ASTRA (Jonathan, 2026-08-18)
    13	------------------------------------------------------
    14	The first design had astra push: a post-commit hook in astra rewrote files
    15	across six checkouts, deciding what belonged to it by matching filenames. That
    16	put the blast radius in the wrong place. A bug in astra could destroy work in a
    17	legal repo, and it did — the fork guard was unreachable, so an edited copy was
    18	silently overwritten.
    19	
    20	Pull inverts it. Each repo asks, on its own schedule, from its own hook. Astra
    21	never reaches into anything. A repo can be cloned, moved, or taken offline and
    22	this still behaves correctly, which a central list of absolute paths cannot.
    23	
    24	THE SAFETY RULE, learned the hard way
    25	-------------------------------------
    26	Update a file only when it is EXACTLY what we installed. The manifest records
    27	the hash of every file at install time, so a local edit is a fact rather than
    28	an inference. Matching hash means nobody touched it and replacing it loses
    29	nothing. Anything else is reported and left alone — never silently overwritten,
    30	and never silently skipped either, because a watcher that hides work is how the
    31	real problem gets missed.
    32	
    33	    .astra/astra-update            report what is behind, change nothing
    34	    .astra/astra-update --pull     update the unmodified, report the rest
    35	"""
    36	import hashlib
    37	import json
    38	import os
    39	import shutil
    40	import sys
    41	from pathlib import Path
    42	
    43	HERE = Path(__file__).resolve().parent          # <repo>/.astra
    44	REPO = HERE.parent                              # the repo that owns this install
    45	MANIFEST = HERE / "manifest.json"
    46	
    47	
    48	def sha(p):
    49	    try:
    50	        return hashlib.sha256(Path(p).read_bytes()).hexdigest()[:16]
    51	    except OSError:
    52	        return None
    53	
    54	
    55	def load():
    56	    try:
    57	        return json.loads(MANIFEST.read_text())
    58	    except FileNotFoundError:
    59	        print(f"no manifest at {MANIFEST} — nothing installed here", file=sys.stderr)
    60	        raise SystemExit(0)
    61	    except Exception as e:
    62	        # A corrupt manifest must never be treated as "nothing installed".
    63	        # That reading would make a broken repo look like a clean one.
    64	        print(f"manifest unreadable ({e}) — refusing to guess", file=sys.stderr)
    65	        raise SystemExit(2)
    66	
    67	
    68	def save(data):
    69	    tmp = MANIFEST.with_suffix(".json.tmp")
    70	    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    71	    os.replace(tmp, MANIFEST)
    72	
    73	
    74	def main():
    75	    pull = "--pull" in sys.argv
    76	    data = load()
    77	    behind = modified = current = missing = 0
    78	
    79	    for tool, meta in sorted(data.get("tools", {}).items()):
    80	        src_root = Path(meta.get("source", ""))
    81	        src_dir = src_root / "tools" / tool
    82	        dest_dir = HERE / tool
    83	
    84	        # A tool whose files all carry explicit paths need not have a tools/<tool> directory.
    85	        if not src_dir.is_dir() and not meta.get("paths"):
    86	            # The source is gone or this repo moved to a machine without it.
    87	            # Say so plainly; the installed copy still works.
    88	            print(f"  SOURCE GONE  {tool}  (looked in {src_dir})")
    89	            missing += 1
    90	            continue
    91	
    92	        # A tool may place files OUTSIDE .astra — doctrine installs to <repo>/.doctrine/<slug>.md.
    93	        # Those entries carry explicit repo-relative src and dest, because the default layout
    94	        # (<source>/tools/<tool>/<file> -> <repo>/.astra/<tool>/<file>) cannot express them.
    95	        #
