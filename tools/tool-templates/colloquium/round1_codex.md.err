     2	"""
     3	registry.py — where every astra tool is installed, and whether those copies are current.
     4	
     5	THE PROBLEM
     6	-----------
     7	Astra's model is copy-on-install: a tool is copied into a target repo, and
     8	re-running the installer is the update path. Nothing ever ran the installer
     9	again. On 2026-08-18 `generate_pdf_sidecars.sh` existed in five places at four
    10	different vintages — canonical from 08-10, js-utils from 08-07, grandparentLegal
    11	from 07-08, js-speedway from 07-03. Nobody had forked it; every copy was simply
    12	an old snapshot. The legal repos were generating PDF text sidecars with a
    13	month-old converter and no one could have known.
    14	
    15	Jonathan: "I had you make these things so they could be used everywhere."
    16	
    17	WHAT THIS IS
    18	------------
    19	A registry of tool -> installed locations, and a `status` that compares each
    20	installed copy's hash against canonical. Feeds an astra post-commit hook that
    21	pushes updates to stale copies automatically, so "installed once in June" stops
    22	being a silent state.
    23	
    24	THREE THINGS IT MUST GET RIGHT, each bought by a real bug today
    25	---------------------------------------------------------------
    26	1. FOLLOW SYMLINKS. js-speedway is a symlink into Dropbox, and `find` does not
    27	   descend symlinked directories by default. An earlier scan silently omitted an
    28	   entire repo — the exact class of miss this registry exists to end.
    29	
    30	2. NEVER TOUCH A GLOBAL PATH. Every target must resolve inside the workspace
    31	   root. A path under ~/.claude, ~/.agents, ~/.config or ~/Library is refused.
    32	   Those global installs were removed today; nothing here may recreate one.
    33	
    34	3. NEVER CLOBBER LOCAL EDITS. If an installed copy differs from BOTH the current
    35	   canonical and the version it was installed from, someone changed it in place.
    36	   That is a fork, not a stale copy, and updating it would destroy work. Report
    37	   it and skip.
    38	"""
    39	import hashlib
    40	import json
    41	import os
    42	import shutil
    43	import subprocess
    44	import sys
    45	from pathlib import Path
    46	
    47	ASTRA = Path(__file__).resolve().parent.parent.parent      # js-db-ad-astra
    48	WORKSPACE = Path(os.environ.get("ASTRA_WORKSPACE", Path.home() / "svnCheckouts")).resolve()
    49	REGISTRY = ASTRA / "tools" / "lib" / "installed.json"
    50	
    51	FORBIDDEN_PREFIXES = [
    52	    Path.home() / ".claude",
    53	    Path.home() / ".agents",
    54	    Path.home() / ".config",
    55	    Path.home() / "Library",
    56	]
    57	
    58	
    59	def sha(p):
    60	    try:
    61	        return hashlib.sha256(Path(p).read_bytes()).hexdigest()[:16]
    62	    except OSError:
    63	        return None
    64	
    65	
    66	def is_safe_target(p):
    67	    """A target must live inside the workspace and never in a global config dir.
    68	
    69	    TWO DIFFERENT PATHS ARE TESTED, deliberately:
    70	
    71	      forbidden-global  -> the RESOLVED path, so a symlink pointing at
    72	                           ~/.claude cannot smuggle a global install past us.
    73	      workspace member  -> the path AS GIVEN, because several repos are
    74	                           themselves symlinks out of the workspace. js-speedway
    75	                           and js-hoa both live in Dropbox and are linked into
    76	                           ~/svnCheckouts. Resolving before that test declared
    77	                           fourteen perfectly legitimate installs "outside the
    78	                           workspace" — the symlink lesson biting for the third
    79	                           time today, in a third place.
    80	    """
    81	    given = Path(p)
    82	    try:
    83	        rp = given.resolve()
    84	    except OSError:
    85	        rp = given
    86	
    87	    for bad in FORBIDDEN_PREFIXES:
    88	        for candidate in (rp, given):
    89	            try:
    90	                candidate.relative_to(bad.resolve())
    91	                return False, f"global location ({bad})"
    92	            except (ValueError, OSError):
    93	                pass
    94	
    95	    # Membership uses the given path so symlinked repos count as inside.
    96	    try:
    97	        given.relative_to(WORKSPACE)
    98	        return True, ""
    99	    except ValueError:
   100	        pass
   101	    try:
   102	        rp.relative_to(WORKSPACE)
   103	        return True, ""
   104	    except ValueError:
   105	        return False, f"outside workspace {WORKSPACE}"
   106	
   107	
   108	def load():
   109	    try:
   110	        return json.loads(REGISTRY.read_text())
   111	    except FileNotFoundError:
   112	        return {"tools": {}}
   113	    except Exception as e:
   114	        print(f"registry unreadable ({e}) — refusing to continue rather than "
   115	              f"overwrite it", file=sys.stderr)
   116	        raise
   117	
   118	
   119	def save(reg):
   120	    REGISTRY.parent.mkdir(parents=True, exist_ok=True)
   121	    tmp = REGISTRY.with_suffix(".tmp")
   122	    tmp.write_text(json.dumps(reg, indent=2, sort_keys=True) + "\n")
   123	    os.replace(tmp, REGISTRY)
   124	
   125	
   126	def discover(names):
   127	    """Find installed copies of the given canonical files across the workspace.
   128	
   129	    ONE filesystem walk, not one per file. The first version ran a separate
   130	    `find` for every canonical file — forty full-workspace traversals for a job
   131	    that runs on every astra commit, which took minutes. Walk once, bucket by
   132	    basename, match afterwards.
   133	
   134	    Uses `find -L` to FOLLOW SYMLINKS: js-speedway is a symlink into Dropbox and
   135	    a plain find silently skips it, which is how an entire repo vanished from an
   136	    earlier scan."""
   137	    wanted = {Path(c).name: c for c in names}
   138	    buckets = {c: [] for c in names}
   139	    try:
   140	        r = subprocess.run(
   141	            ["find", "-L", str(WORKSPACE), "-type", "f",
   142	             # Track every extension a tool can ship in. An earlier version
   143	             # watched only .sh and .py, so check-prose.js and its rules.json —
   144	             # the very files whose hand-copied drift prompted this registry —
   145	             # would have gone untracked and drifted again in a new extension.
   146	             "(", "-name", "*.sh", "-o", "-name", "*.py",
   147	             "-o", "-name", "*.js", "-o", "-name", "rules.json", ")",
   148	             "-not", "-path", "*/.git/*",
   149	             "-not", "-path", "*/node_modules/*",
   150	             "-not", "-path", "*/tmp/*",
   151	             "-not", "-path", "*/Pods/*",
   152	             "-not", "-path", "*/.venv/*",
   153	             "-not", "-path", f"{ASTRA}/*"],
   154	            capture_output=True, text=True, timeout=300)
   155	        hits = r.stdout.splitlines()
   156	    except Exception as e:
   157	        print(f"  discover failed: {e}", file=sys.stderr)
   158	        return buckets
   159	
   160	    seen = set()
   161	    for h in hits:
   162	        h = h.strip()
   163	        if not h:
   164	            continue
   165	        base = os.path.basename(h)
   166	        canon = wanted.get(base)
   167	        if not canon:
   168	            continue
   169	        # -L can surface one real file through several symlinked paths.
   170	        try:
   171	            rp = str(Path(h).resolve())
   172	        except OSError:
   173	            continue
   174	        key = (canon, rp)
   175	        if key in seen:
   176	            continue
   177	        seen.add(key)
   178	        buckets[canon].append(h)
   179	    return buckets
   180	
   181	
   182	def cmd_scan(args):
   183	    """Refresh the ledger, and REPORT unregistered look-alikes without adopting them.
   184	
   185	    OWNERSHIP IS RECORDED, NOT INFERRED. This is the correction Jonathan made on
   186	    2026-08-18, and it dissolves a whole class of bug rather than guarding
   187	    against it.
   188	
   189	    The first version decided what belonged to astra by matching FILENAMES
   190	    across the workspace. That is a guess, and it is the guess that made
   191	    everything downstream dangerous: any repo with its own rules.json or lib.sh
   192	    was silently adopted as an astra install, and the post-commit hook then
   193	    overwrote it with astra's version. Two astra tools already share a basename
   194	    with each other, so it could confuse even its own files. Guarding a bad
   195	    inference with ever-cleverer fork detection was the wrong shape of fix.
   196	
   197	    Now the ledger is authoritative. sync() only ever writes to paths the ledger
   198	    already holds, and the ledger only grows when something is deliberately
   199	    adopted. A same-named file that is NOT in the ledger is reported as a
   200	    candidate and left completely alone.
   201	
   202	    The 36 installs present when this changed were verified current against
   203	    canonical and seeded once with `scan --adopt`. Every later addition should
   204	    come from a tool's own install.sh recording where it wrote.
   205	    """
   206	    adopt = "--adopt" in args
   207	    reg = load()
   208	    canon_files = []
   209	    for d in (ASTRA / "tools").iterdir() if (ASTRA / "tools").is_dir() else []:
   210	        if not d.is_dir():
   211	            continue
   212	        for f in d.iterdir():
   213	            if f.is_file() and (f.suffix in (".sh", ".py", ".js")
   214	                                or f.name == "rules.json") and f.name not in (
   215	                    "install.sh", "uninstall.sh", "setup.sh"):
   216	                canon_files.append(str(f))
   217	
   218	    found = discover(canon_files)
   219	
   220	    # PROVENANCE IS NOT OBSERVATION. A previous version recorded each install's

