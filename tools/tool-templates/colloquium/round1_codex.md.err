   177	        print(f"no such template: {name}")
   178	        return 66
   179	    print(json.dumps(meta, indent=2))
   180	    return 0
   181	
   182	
   183	def _target(args):
   184	    if "--into" not in args:
   185	        print("usage: template.py <cmd> <name> --into <repo>", file=sys.stderr)
   186	        sys.exit(64)
   187	    repo = Path(args[args.index("--into") + 1]).expanduser()
   188	    if not repo.is_dir():
   189	        print(f"no such directory: {repo}", file=sys.stderr)
   190	        sys.exit(66)
   191	    return repo
   192	
   193	
   194	def _apply(verb, args):
   195	    name = args[0] if args and not args[0].startswith("-") else ""
   196	    meta = load()["templates"].get(name)
   197	    if not meta:
   198	        print(f"no such template: {name}", file=sys.stderr)
   199	        return 66
   200	    repo = _target(args)
   201	
   202	    # UNINSTALL ONLY WHAT THE RECORD SAYS IS INSTALLED.
   203	    #
   204	    # tools_still_claimed() answers "what do the OTHER installed templates
   205	    # need" by reading the record. If the record has been deleted, truncated or
   206	    # hand-edited, that question comes back empty and uninstall happily removes
   207	    # tools a second, still-installed template depends on. The corrupt case is
   208	    # refused when the file is read; this catches the deleted one, and it does
   209	    # so without guessing at what is installed by inspecting the filesystem —
   210	    # which cannot work anyway, since MCP templates write .mcp.json rather than
   211	    # a directory of their own.
   212	    #
   213	    # Being asked to remove something no record mentions is suspicious on its
   214	    # own terms. Say so rather than acting on an empty list.
   215	    if verb == "uninstall" and name not in installed_templates(repo):
   216	        print(f"'{name}' is not recorded as installed in {repo}.", file=sys.stderr)
   217	        print(f"  Refusing, because deciding what to remove means asking which "
   218	              f"OTHER templates still need each tool, and that question cannot "
   219	              f"be answered from a record that does not list this one.",
   220	              file=sys.stderr)
   221	        print(f"  Recorded: {', '.join(installed_templates(repo)) or '(none)'}",
   222	              file=sys.stderr)
   223	        return 65
   224	
   225	    ok_n = fail_n = kept_n = 0
   226	    print(f"{verb}ing template '{name}' -> {repo}")
   227	    keep = tools_still_claimed(repo, name) if verb == "uninstall" else set()
   228	    for t in meta.get("tools", []):
   229	        if t in keep:
   230	            others = [n for n in installed_templates(repo) if n != name
   231	                      and t in load()["templates"].get(n, {}).get("tools", [])]
   232	            print(f"  KEPT    {t} — still required by: {', '.join(others)}")
   233	            kept_n += 1
   234	            continue
   235	        ok, why = run_tool(t, verb, repo)
   236	        if ok:
   237	            print(f"  {verb}ed  {t}")
   238	            ok_n += 1
   239	        else:
   240	            print(f"  FAILED  {t}: {why}")
   241	            fail_n += 1
   242	    record_template(repo, name, add=(verb == "install"))
   243	    extra = f", {kept_n} kept (shared with another template)" if kept_n else ""
   244	    print(f"\n{ok_n} ok, {fail_n} failed{extra}")
   245	    return 1 if fail_n else 0
   246	
   247	
   248	def cmd_install(args):
   249	    return _apply("install", args)
   250	
   251	
   252	def cmd_uninstall(args):
   253	    return _apply("uninstall", args)
   254	
   255	
   256	def cmd_status(args):
   257	    """Which templates are fully present in a repo?"""
   258	    repo = _target(args)
   259	    mcp = {}
   260	    f = repo / ".mcp.json"
   261	    if f.exists():
   262	        try:
   263	            mcp = json.loads(f.read_text()).get("mcpServers", {})
   264	        except Exception:
   265	            pass
   266	    print(f"repo: {repo}")
   267	    print(f"  MCP servers present: {', '.join(sorted(mcp)) or 'none'}")
   268	    for name, meta in sorted(load()["templates"].items()):
   269	        want = [t for t in meta.get("tools", []) if t.startswith("mcp-")]
   270	        have = [t for t in want if t.replace("mcp-", "", 1) in mcp]
   271	        if want:
   272	            state = "complete" if len(have) == len(want) else (
   273	                "partial" if have else "absent")
   274	            print(f"  {name:<14} {state:<9} ({len(have)}/{len(want)} mcp tools)")
   275	    return 0
   276	
   277	
   278	def main():
   279	    cmds = {"list": cmd_list, "show": cmd_show, "install": cmd_install,
   280	            "uninstall": cmd_uninstall, "status": cmd_status}
   281	    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
   282	        print(f"usage: template.py {{{'|'.join(cmds)}}} [name] [--into <repo>]")
   283	        return 64
   284	    return cmds[sys.argv[1]](sys.argv[2:])
   285	
   286	
   287	if __name__ == "__main__":
   288	    sys.exit(main())

