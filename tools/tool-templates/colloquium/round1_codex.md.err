    88	    try:
    89	        send({"jsonrpc": "2.0", "id": 1, "method": "initialize",
    90	              "params": {"protocolVersion": "2025-06-18", "capabilities": {"tools": {}},
    91	                         "clientInfo": {"name": "mcp_tools", "version": "1"}}})
    92	        line = readline(timeout)
    93	        if not line:
    94	            return {"error": "no answer to initialize within %.0fs" % timeout}
    95	        init = json.loads(line).get("result") or {}
