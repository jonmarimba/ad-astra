     1	#!/usr/bin/env python3
     2	"""
     3	template.py — install a NAMED GROUP of astra tools into a repo.
     4	
     5	The middle layer Jonathan described on 2026-08-18: "templates for installing
     6	groups of these tools that are fit for a particular kind of project, a middle
     7	level where we can say the mhm project(s) has the swift and iOS stuff installed
     8	via a template for that along with the writing tools. Whereas the legal repos
     9	have the pdf to text stuff and the writing stuff."
    10	
    11	    template.py list
    12	    template.py show <name>
    13	    template.py install   <name> --into <repo>
    14	    template.py uninstall <name> --into <repo>
    15	    template.py status --into <repo>
    16	
    17	TWO PROPERTIES THAT ARE NOT NEGOTIABLE
    18	--------------------------------------
    19	NON-EXCLUSIVE. Installing a template ADDS its tools. It never removes anything
    20	another template put there, and two templates may overlap freely — the legal and
    21	Maharam sets both want the writing tools, and installing one after the other must
    22	leave both intact. Uninstall removes only what that template names, so a shared
    23	tool survives until the last template needing it is gone. Anything else would
    24	make the second install silently break the first.
    25	
    26	NEVER GLOBAL. Templates delegate to each tool's own install.sh --into <repo>,
    27	and those already refuse a target under $HOME, ~/.claude, ~/.agents, ~/.config or
    28	~/Library. The global installs that had accumulated were removed on 2026-08-18
    29	and nothing here may recreate one.
    30	
    31	Templates are DATA (templates.json), not code, so adding one is an edit rather
    32	than a patch. Every tool a template names must have its own install.sh and
    33	uninstall.sh — that is what made splitting the MCP bundle into seven small tools
    34	the prerequisite for this layer.
    35	"""
    36	import json
    37	import os
    38	import subprocess
    39	import sys
    40	from pathlib import Path
    41	
    42	ASTRA = Path(__file__).resolve().parent.parent.parent
    43	TOOLS = ASTRA / "tools"
    44	TEMPLATES = TOOLS / "lib" / "templates.json"
    45	
    46	
    47	def load():
    48	    try:
    49	        return json.loads(TEMPLATES.read_text())
    50	    except FileNotFoundError:
    51	        return {"templates": {}}
    52	
    53	
    54	def tool_dir(name):
    55	    d = TOOLS / name
    56	    return d if d.is_dir() else None
    57	
    58	
    59	def run_tool(name, verb, repo):
    60	    """Delegate to the tool's own installer. Missing tools are LOUD.
    61	
    62	    A template that silently skips a tool it names would report success while
    63	    installing less than it claimed — the same shape as a test that passes
    64	    against a broken implementation."""
    65	    d = tool_dir(name)
    66	    if d is None:
    67	        return False, f"no such tool: tools/{name}"
    68	    script = d / f"{verb}.sh"
    69	    if not script.exists():
    70	        return False, f"tools/{name} has no {verb}.sh (every template member needs one)"
    71	    try:
    72	        r = subprocess.run([str(script), "--into", str(repo)],
    73	                           capture_output=True, text=True, timeout=300)
    74	        if r.returncode != 0:
    75	            tail = (r.stderr or r.stdout or "").strip().splitlines()
    76	            return False, (tail[-1] if tail else f"exit {r.returncode}")
    77	        return True, ""
    78	    except Exception as e:
    79	        return False, f"{e}"
    80	
    81	
    82	def state_path(repo):
    83	    """Template state lives in the SAME file as tool state.
    84	
    85	    It used to sit in its own .astra-templates.json at the repo root, which made
    86	    two files that had to agree about one repo and gave no reason they would.
    87	    Everything a repo knows about its astra install now lives in
    88	    .astra/manifest.json.
    89	    """
    90	    return Path(repo) / ".astra" / "manifest.json"
    91	
    92	
    93	def _read_state(repo):
    94	    p = state_path(repo)
    95	    try:
    96	        return json.loads(p.read_text())
    97	    except FileNotFoundError:
    98	        # Genuinely nothing installed. A legitimate empty answer.
    99	        legacy = Path(repo) / ".astra-templates.json"
   100	        if legacy.exists():
   101	            try:
   102	                old = json.loads(legacy.read_text()).get("installed", [])
   103	                return {"templates": sorted(old)}
   104	            except Exception:
   105	                pass
   106	        return {}
   107	    except Exception as e:
   108	        # NOT the same as "nothing installed", and the difference is the whole
   109	        # non-exclusive property. installed_templates() used to swallow every
   110	        # error into an empty list, so a corrupt or hand-edited state file made
   111	        # uninstall believe no other template claimed anything — and it would
   112	        # then remove tools a second, still-installed template needed. Refuse.
   113	        print(f"{p} is unreadable ({e}). Refusing to act on template state we "
   114	              f"cannot read, because reading it as empty would let uninstall "
   115	              f"remove tools another template still needs.", file=sys.stderr)
   116	        sys.exit(65)
   117	
   118	
