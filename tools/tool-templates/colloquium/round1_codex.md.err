     2	# Templates must be NON-EXCLUSIVE. Two templates sharing a tool must coexist, and
     3	# uninstalling one must not remove a tool the other still needs.
     4	#
     5	# This test caught the property failing on the day it was written: uninstalling
     6	# kicker-dev removed mcp-xcode and mcp-mac-control-mcp while swift-ios was
     7	# installed and using both. Keep it red-capable — it is the only thing standing
     8	# between "templates" and "the second install silently breaks the first".
     9	set -u
    10	A="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
    11	command -v jq >/dev/null || { echo "MISSING DEPENDENCY: jq"; exit 1; }
    12	T="$(mktemp -d)/repo"; git clone --quiet ~/svnCheckouts/js-llmKicker "$T" 2>/dev/null || { echo "clone failed"; exit 1; }
    13	fail=()
    14	
    15	python3 "$A/tools/lib/template.py" install swift-ios --into "$T" >/dev/null 2>&1
    16	python3 "$A/tools/lib/template.py" install kicker-dev --into "$T" >/dev/null 2>&1
    17	out="$(python3 "$A/tools/lib/template.py" uninstall kicker-dev --into "$T" 2>&1)"
    18	rc=$?
    19	after="$(jq -r '.mcpServers|keys|join(",")' "$T/.mcp.json" 2>/dev/null)"
    20	
    21	for need in xcode mac-control-mcp XcodeBuildMCP ios-simulator mobile-mcp; do
    22	  echo "$after" | grep -q "$need" || fail+=("swift-ios lost $need after uninstalling an overlapping template")
    23	done
    24	echo "$after" | grep -q kickerd && fail+=("kickerd survived its own template's uninstall")
    25	echo "$out" | grep -q "KEPT" || fail+=("shared tools were not reported as KEPT")
    26	[ $rc -eq 0 ] || fail+=("uninstall exited $rc on a successful run")
    27	
    28	
    29	# ── State-file integrity ────────────────────────────────────────────────────
    30	# The overlap property above is only as good as the record it reasons from.
    31	# installed_templates() used to swallow every read error into an empty list, so
    32	# a corrupt or hand-edited state file made uninstall believe nothing else
    33	# claimed a shared tool — and it would remove tools a still-installed template
    34	# needed. Reading "I cannot tell" as "nothing installed" is the bug.
    35	
    36	echo '{"templates": ["swift-ios"], "tools":' > "$T/.astra/manifest.json"   # truncated mid-write
    37	out="$(python3 "$A/tools/lib/template.py" uninstall kicker-dev --into "$T" 2>&1)"; rc=$?
    38	if [ "$rc" -eq 65 ] && echo "$out" | grep -q "unreadable"; then
    39	  echo "  corrupt state refused instead of read as empty"
    40	else
    41	  fail+=("a corrupt manifest did not stop uninstall (rc=$rc) — it would remove tools another template still needs")
    42	fi
    43	
    44	# A deleted record with the tools still present is the same class: the repo is
    45	# not empty, so an empty list is not the answer.
    46	rm -f "$T/.astra/manifest.json"
    47	out="$(python3 "$A/tools/lib/template.py" uninstall kicker-dev --into "$T" 2>&1)"; rc=$?
    48	if [ "$rc" -eq 65 ] && echo "$out" | grep -q "not recorded as installed"; then
    49	  echo "  deleted state refused rather than acted on as an empty list"
    50	else
    51	  fail+=("a deleted manifest let uninstall run from an empty list (rc=$rc)")
    52	fi
    53	
    54	rm -rf "$(dirname "$T")"
    55	if [ ${#fail[@]} -eq 0 ]; then echo "templates: non-exclusive overlap holds"; exit 0; fi
    56	printf 'FAIL: %s\n' "${fail[@]}"; exit 1

