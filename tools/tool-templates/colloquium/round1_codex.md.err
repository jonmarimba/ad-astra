   102	                    "error": "initialize answered but tools/list did not, within %.0fs. This is "
   103	                             "NOT an empty tool list. A server that gates tool access behind an "
   104	                             "approval dialog blocks here until the dialog is answered — check "
   105	                             "for one before believing anything about this server." % timeout}
   106	        if line == "":
