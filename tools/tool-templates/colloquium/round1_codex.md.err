     1	#!/usr/bin/env bash
     2	# run-all.sh — run every tools/tests/test-*.sh, report per-file and overall. Nonzero exit on
     3	# ANY failure. No skips: a test that can't run its subject fails loudly (lib.sh `need`).
     4	set -uo pipefail
     5	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
     6	HERE="$(cd "$(dirname "$0")" && pwd)"
     7	overall=0; ran=0
     8	for t in "$HERE"/test-*.sh; do
     9	  [ -f "$t" ] || { echo "no tests found in $HERE"; exit 1; }
    10	  echo "── $(basename "$t")"
    11	  if bash "$t"; then :; else overall=1; fi
    12	  ran=$((ran+1))
    13	done
    14	echo ""
    15	if [ "$overall" -eq 0 ]; then echo "ALL GREEN ($ran test files)"; else echo "FAILURES PRESENT ($ran test files) — fix before shipping"; fi
    16	exit "$overall"

