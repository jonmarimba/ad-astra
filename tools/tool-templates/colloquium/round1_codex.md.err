   139	
   140	def _norm(name):
   141	    """window_close, close_window and closeWindow all reduce to the same token bag.
   142	
   143	    Deliberately crude. It exists to catch the word-order and separator variants that two
   144	    independently written servers produce for the same job — Jonathan's example was window_open
   145	    against open_window — and it is not pretending to find semantic matches. That is what the
   146	    optional model pass is for, and the two must not be confused for each other.
   147	    """
