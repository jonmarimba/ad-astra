   108	before="$(ls -i "$TARGET" | awk '{print $1}')"
   109	"$R/.astra/astra-update" --pull >/dev/null 2>&1
   110	after="$(ls -i "$TARGET" | awk '{print $1}')"
   111	if [ "$before" != "$after" ]; then
   112	  ok "replaced atomically (inode $before -> $after)"
   113	else
   114	  bad "written IN PLACE — an interrupted update leaves a truncated tool"
   115	fi
   116	cp "$SAVE/rules.json" "$RULES"
   117	
   118	echo "== 5. A missing file must be reported, not silently passed =="
   119	new_repo
   120	rm -f "$TARGET"
   121	out="$("$R/.astra/astra-update" 2>&1)"; rc=$?
   122	if [ "$rc" -ne 0 ] && echo "$out" | grep -q "MISSING"; then
   123	  ok "missing file reported and exit is nonzero"
   124	else
   125	  bad "a missing tool file passed quietly (rc=$rc, out=$(echo "$out" | tr '\n' ' '))"
   126	fi
   127	
   128	echo "== 6. A corrupt manifest must refuse, not read as 'nothing installed' =="
   129	new_repo
   130	echo 'this is not json' > "$R/.astra/manifest.json"
   131	out="$("$R/.astra/astra-update" 2>&1)"; rc=$?
   132	if [ "$rc" -ne 0 ] && echo "$out" | grep -qi "unreadable"; then
   133	  ok "corrupt manifest refused loudly"
   134	else
   135	  bad "corrupt manifest treated as empty — a broken repo looks like a clean one (rc=$rc)"
   136	fi
   137	
   138	echo "== 7. Astra must no longer be able to push into other repos =="
   139	out="$(python3 "$ASTRA/tools/lib/registry.py" sync 2>&1)"; rc=$?
   140	if [ "$rc" -ne 0 ] && echo "$out" | grep -q "RETIRED"; then
   141	  ok "registry sync refuses"
   142	else
   143	  bad "registry sync still writes into other repos (rc=$rc)"
   144	fi
   145	
   146	echo "== 8. Scan must not adopt a same-named file it was never told about =="
   147	# The collision bug: any repo's own rules.json or lib.sh was claimed as an astra
   148	# install and overwritten. Ownership is recorded now, so an unknown look-alike
   149	# is reported and left alone.
   150	WS="$(mktemp -d)"
   151	mkdir -p "$WS/somebodyelse"
   152	echo '{"this":"is not ours"}' > "$WS/somebodyelse/rules.json"
   153	out="$(ASTRA_WORKSPACE="$WS" python3 "$ASTRA/tools/lib/registry.py" scan 2>&1)"
   154	if echo "$out" | grep -q "NOT in the ledger"; then
   155	  ok "unregistered look-alike reported as a candidate"
   156	else
   157	  bad "scan did not flag an unknown same-named file (out=$(echo "$out" | tr '\n' ' '))"
   158	fi
   159	if grep -q "is not ours" "$WS/somebodyelse/rules.json"; then
   160	  ok "and it was left completely untouched"
   161	else
   162	  bad "SOMEBODY ELSE'S FILE WAS MODIFIED"
   163	fi
   164	rm -rf "$WS"
   165	
   166	echo
   167	echo "passed $PASS, failed $FAIL"
   168	[ "$FAIL" -eq 0 ] || exit 1

