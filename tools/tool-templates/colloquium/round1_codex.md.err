   321	def cmd_sync(args):
   322	    """RETIRED. Astra does not write into other repos.
   323	
   324	    This pushed canonical files out across the workspace and was the whole
   325	    reason ownership had to be guessed at. Distribution is now pull: each repo
   326	    carries .astra/manifest.json plus .astra/astra-update and fetches on its own
   327	    post-commit hook. Nothing reaches in from here.
   328	
   329	    Left in place as a loud refusal rather than deleted, because a script or a
   330	    habit may still call it, and a silently missing command is how the old
   331	    behaviour would quietly come back.
   332	    """
   333	    if "--i-know-this-is-retired" not in args:
   334	        print("registry sync is RETIRED — astra no longer writes into other repos.",
   335	              file=sys.stderr)
   336	        print("  Update a repo from inside it:  <repo>/.astra/astra-update --pull",
   337	              file=sys.stderr)
   338	        print("  Install or reinstall a tool:   tools/<tool>/install.sh --into <repo>",
   339	              file=sys.stderr)
   340	        return 78
   341	    dry = "--dry-run" in args
   342	    only = [a for a in args if not a.startswith("-")]
   343	    reg = load()
   344	    updated, skipped = 0, 0
   345	    for name, t in sorted(reg.get("tools", {}).items()):
   346	        if only and name not in only:
   347	            continue
   348	        canon = ASTRA / t["canonical"]
   349	        csha = sha(canon)
   350	        recorded = t.get("canonical_sha")
   351	        for i in t["installs"]:
   352	            live = sha(i["path"])
   353	            if live is None or live == csha:
   354	                continue
   355	            ok, why = is_safe_target(i["path"])
   356	            if not ok:
   357	                print(f"  REFUSED  {i['path']}  ({why})")
   358	                skipped += 1
   359	                continue
   360	
   361	            # A DESTINATION SYMLINK is a write to somewhere else. is_safe_target
   362	            # judged the path we were given; copy2 would follow the link and
   363	            # land wherever it points, including outside the workspace. We do
   364	            # not install through symlinks, so seeing one means something we do
   365	            # not understand — refuse rather than guess.
   366	            if Path(i["path"]).is_symlink():
   367	                print(f"  REFUSED  {i['path']}  (destination is a symlink)")
   368	                skipped += 1
   369	                continue
   370	
   371	            # WHAT COUNTS AS SAFE TO OVERWRITE. We may replace a copy only when
   372	            # we can account for its current contents:
   373	            #   - it is exactly what sync last wrote here (nobody touched it), or
   374	            #   - it is exactly what it looked like when we first found it, and
   375	            #     we have never written to it (the adopted-stale case: the
   376	            #     month-old pdf-sidecars copies this registry was built for).
   377	            # Anything else changed after we last had eyes on it. That is a
   378	            # fork, and overwriting it destroys work.
   379	            synced = i.get("synced_sha")
   380	            first_seen = i.get("first_seen_sha")
   381	            accounted = (live == synced) if synced else (live == first_seen)
   382	            if not accounted:
   383	                print(f"  LOCAL EDITS, skipping  {i['path']}")
   384	                print(f"     content is neither what we last wrote nor what we "
   385	                      f"first found — someone changed it, resolve by hand")
   386	                skipped += 1
   387	                continue
   388	
   389	            if dry:
   390	                print(f"  would update  {i['path']}")
   391	            else:
   392	                # ATOMIC. copy2 opens the destination 'wb', truncating it before
   393	                # a single byte is copied, so an interrupted sync leaves a
   394	                # zero-length tool behind. Write beside it and rename, which is
   395	                # atomic within a filesystem: the target is either the old file
   396	                # or the new one, never a fragment.
   397	                dest = Path(i["path"])
   398	                tmp = dest.with_name(dest.name + ".astra-sync.tmp")
