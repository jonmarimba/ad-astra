 succeeded in 0ms:
     1	#!/usr/bin/env bash
     2	# XcodeBuildMCP — install ONE MCP server, into a given repo.
     3	#
     4	# Headless Xcode builds — no Xcode approval prompt.
     5	#
     6	# Split out of tools/mcp-bundle on 2026-08-18. The bundle came over from kicker
     7	# as a single 727-line script that installed seven servers together; Jonathan's
     8	# plan is many small composable tools plus templates that install a set fit for a
     9	# kind of project. This is one of those small tools.
    10	#
    11	# It delegates to the bundle rather than duplicating its logic. The bundle
    12	# already knows how to write this server's entry for all three agents that keep
    13	# config in different places — Claude Code (<repo>/.mcp.json via
    14	# `claude mcp add --scope project`), Qwen (<repo>/.qwen/settings.json), Codex
    15	# (<repo>/.codex/config.toml). Copying that per-server would be seven chances to
    16	# drift, which is the exact disease the tool registry exists to cure.
    17	#
    18	# Dependencies: node_npx, claude, npm:xcodebuildmcp
    19	#
    20	# Usage: ./install.sh --into <repo>
    21	set -euo pipefail
    22	HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    23	BUNDLE="$HERE/../mcp-bundle"
    24	exec "$BUNDLE/install.sh" "$@" XcodeBuildMCP

