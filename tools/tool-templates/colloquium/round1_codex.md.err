   134	
   135	    parts = [f"{current} current"]
   136	    if behind:
   137	        parts.append(f"{behind} {'updated' if pull else 'behind'}")
   138	    if modified:
   139	        parts.append(f"{modified} locally modified")
   140	    if missing:
   141	        parts.append(f"{missing} missing")
   142	    print(", ".join(parts))
   143	
   144	    # Nonzero only for things a human must act on. Being behind is not a
   145	    # failure when --pull just fixed it.
   146	    return 1 if (modified or missing or (behind and not pull)) else 0
