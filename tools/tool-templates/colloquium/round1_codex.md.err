   218	        # a prompt flag here; using it silently sends the wrong thing.
   219	        proc = subprocess.run(["llm", prompt], input="\n".join(payload),
   220	                              capture_output=True, text=True)
   221	        print("\n=== possible semantic collisions, per %s ===" % (
   222	            subprocess.run(["llm", "models", "default"], capture_output=True, text=True).stdout.strip() or "llm"))
   223	        if proc.returncode != 0:
   224	            print("  llm failed (%d): %s" % (proc.returncode, (proc.stderr or "").strip()[:300]))
   225	            return 2
   226	        print(proc.stdout.strip())
   227	    return 0
   228	
   229	
   230	def main():
   231	    ap = argparse.ArgumentParser()
   232	    sub = ap.add_subparsers(dest="cmd", required=True)
   233	
   234	    l = sub.add_parser("list", help="list one server's tools")
   235	    l.add_argument("--config", required=True)
   236	    l.add_argument("--server", required=True)
   237	    l.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
   238	    l.set_defaults(fn=cmd_list)
   239	
   240	    c = sub.add_parser("compare", help="compare two servers for collisions")
   241	    c.add_argument("--config", required=True)
   242	    c.add_argument("--server", required=True)
   243	    c.add_argument("--against", required=True)
   244	    c.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
   245	    c.add_argument("--summarize", action="store_true",
   246	                   help="hand both lists to the default llm model for a semantic pass")
   247	    c.set_defaults(fn=cmd_compare)
   248	
   249	    a = ap.parse_args()
   250	    return a.fn(a)
   251	
   252	
   253	if __name__ == "__main__":
   254	    sys.exit(main())

