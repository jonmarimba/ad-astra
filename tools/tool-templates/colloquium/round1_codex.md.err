   122	
   123	
   124	def cmd_list(a):
   125	    servers = load_servers(a.config)
   126	    if a.server not in servers:
   127	        sys.exit("mcp_tools: %r is not in %s (have: %s)"
   128	                 % (a.server, a.config, ", ".join(sorted(servers))))
   129	    info = probe(a.server, servers[a.server], a.timeout)
   130	    if "error" in info and "tools" not in info:
   131	        print("%s: %s" % (a.server, info["error"]), file=sys.stderr)
   132	        return 2
   133	    print("%s  —  %s  —  %d tools" % (a.server, describe(info), len(info["tools"])))
   134	    for t in sorted(info["tools"], key=lambda t: t.get("name", "")):
   135	        desc = " ".join((t.get("description") or "").split())
   136	        print("  %-34s %s" % (t.get("name"), desc[:110]))
   137	    return 0
