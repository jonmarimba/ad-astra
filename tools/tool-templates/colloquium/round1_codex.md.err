     1	#!/bin/bash
     2	# test-astra-update.sh — RED-capable tests for tool distribution.
     3	#
     4	# These properties used to belong to `registry.py sync`, which pushed files from
     5	# astra into other repos. That mechanism is retired: it had to guess which files
     6	# were its own, and the guess let it overwrite work in a legal repo. Each repo
     7	# now pulls with .astra/astra-update, so the tests live where the behaviour does.
     8	#
     9	# Two things must both hold, and it is easy to get one by sacrificing the other:
    10	#   - a copy nobody touched gets updated (or the whole tool is pointless)
    11	#   - a copy somebody edited is never silently overwritten
    12	# Test 2 is the control for that trade. It passes against both the old and new
    13	# implementations, which is how a fix that merely refuses everything gets caught.
    14	
    15	set -u
    16	ASTRA="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
    17	PASS=0
    18	FAIL=0
    19	ok()  { echo "  PASS: $1"; PASS=$((PASS+1)); }
    20	bad() { echo "  FAIL: $1"; FAIL=$((FAIL+1)); }
    21	
    22	need() {
    23	  command -v "$1" >/dev/null 2>&1 || { echo "MISSING DEPENDENCY: $1 — install it, do not skip"; exit 1; }
    24	}
    25	need python3
    26	need git
    27	
    28	# Astra's own check-prose files are the fixture. They must be restored no matter
    29	# how this exits — a test that leaves the canonical tree modified has broken the
    30	# thing it was checking.
    31	RULES="$ASTRA/tools/check-prose/rules.json"
    32	JS="$ASTRA/tools/check-prose/check-prose.js"
    33	SAVE="$(mktemp -d)"
    34	cp "$RULES" "$SAVE/rules.json"
    35	cp "$JS" "$SAVE/check-prose.js"
    36	cleanup() {
    37	  cp "$SAVE/rules.json" "$RULES"
    38	  cp "$SAVE/check-prose.js" "$JS"
    39	  rm -rf "$SAVE" ${WORK:-}
    40	}
    41	trap cleanup EXIT
    42	
    43	new_repo() {
    44	  WORK="$(mktemp -d)"
    45	  R="$WORK/repo"
    46	  mkdir -p "$R"
    47	  git -C "$R" init -q .
    48	  "$ASTRA/tools/check-prose/install.sh" --into "$R" >/dev/null
    49	  TARGET="$R/.astra/check-prose/rules.json"
    50	}
    51	
    52	echo "== 1. Install must land in .astra and record where it came from =="
    53	new_repo
    54	if [ -f "$R/.astra/check-prose/check-prose.js" ] && [ -f "$R/.astra/manifest.json" ]; then
    55	  ok "tool and manifest present under .astra"
    56	else
    57	  bad "install did not produce .astra/<tool> plus a manifest"
    58	fi
    59	if grep -q "js-db-ad-astra" "$R/.astra/manifest.json"; then
    60	  ok "manifest records the source it was installed from"
    61	else
    62	  bad "manifest does not record a source — the repo cannot pull updates"
    63	fi
    64	# The whole point of .astra is that nothing lands where the repo keeps its own
    65	# work. A stray copy outside it would reintroduce the collision hazard.
    66	stray="$(find "$R" -name 'check-prose.js' -not -path '*/.astra/*' | wc -l | tr -d ' ')"
    67	if [ "$stray" = "0" ]; then
    68	  ok "nothing installed outside .astra"
    69	else
    70	  bad "$stray copy(ies) landed outside .astra"
    71	fi
    72	
    73	echo "== 2. A copy nobody touched MUST be updated =="
    74	# The control. A fix that protects local edits by refusing every update would
    75	# pass test 3 and fail here.
    76	new_repo
    77	printf '\n{"zzz":"upstream moved"}\n' >> "$RULES"
    78	"$R/.astra/astra-update" --pull >/dev/null 2>&1
    79	if grep -q "upstream moved" "$TARGET"; then
    80	  ok "untouched copy picked up the upstream change"
    81	else
    82	  bad "untouched copy was NOT updated — distribution does not work"
    83	fi
    84	cp "$SAVE/rules.json" "$RULES"
    85	
    86	echo "== 3. A locally edited copy must never be overwritten =="
    87	new_repo
    88	printf '\n// LOCAL EDIT\n' >> "$R/.astra/check-prose/check-prose.js"
    89	printf '\n// upstream also moved\n' >> "$JS"
    90	out="$("$R/.astra/astra-update" --pull 2>&1)"
    91	if grep -q "LOCAL EDIT" "$R/.astra/check-prose/check-prose.js"; then
    92	  ok "local edit survived a pull"
    93	else
    94	  bad "LOCAL EDIT DESTROYED by pull"
    95	fi
    96	if echo "$out" | grep -q "LOCAL EDITS"; then
    97	  ok "pull reported the divergence instead of hiding it"
    98	else
