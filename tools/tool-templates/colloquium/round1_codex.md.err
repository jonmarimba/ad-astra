     1	#!/usr/bin/env bash
     2	# lib.sh — shared assertions for the @astra tool tests. Source from every test-*.sh.
     3	#
     4	# The rules these tests follow are Jonathan's own (js-llmKicker/docs/TAUTOLOGY-AUDIT-20260801.md,
     5	# docs/planning/07d-test-truthfulness/SPEC.md, AGENTS.md "a test that goes red is worth more than
     6	# a paragraph that is true"):
     7	#   1. Assert BY EFFECT — a file that exists, a message that routed, an exit code — never "it ran".
     8	#   2. Every test file carries at least one RED control: an input that MUST fail. If the RED
     9	#      control passes, the test is a tautology and the run fails.
    10	#   3. No silent skips. A missing dependency is a loud FAIL with the reason, never a quiet pass.
    11	#   4. Names don't overclaim: a test named for a fragment tests that fragment.
    12	set -uo pipefail
    13	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
    14	
    15	TESTS_PASS=0; TESTS_FAIL=0
    16	SB="$(mktemp -d -t astra-test)"          # per-test sandbox, wiped on exit
    17	_lib_cleanup(){ rm -rf "$SB"; }
    18	trap _lib_cleanup EXIT
    19	
    20	pass(){ TESTS_PASS=$((TESTS_PASS+1)); echo "  ok:   $*"; }
    21	fail(){ TESTS_FAIL=$((TESTS_FAIL+1)); echo "  FAIL: $*" >&2; }
    22	
    23	need(){ # loud dependency gate — rule 3. usage: need <cmd> "<how to get it>"
    24	  command -v "$1" >/dev/null && return 0
    25	  fail "missing dependency '$1' ($2) — this is a FAILURE, not a skip"
    26	  finish; exit 1
    27	}
    28	
    29	assert_eq(){        [ "$1" = "$2" ]        && pass "$3" || fail "$3 (want '$1' got '$2')"; }
    30	assert_file(){      [ -f "$1" ]            && pass "$2" || fail "$2 (missing $1)"; }
    31	assert_no_file(){   [ ! -e "$1" ]          && pass "$2" || fail "$2 (unexpected $1)"; }
    32	assert_dir(){       [ -d "$1" ]            && pass "$2" || fail "$2 (missing dir $1)"; }
    33	assert_contains(){ # an empty needle is a tautology — grep -F "" matches any nonempty file, so an
    34	  # accidentally-unset variable (e.g. an unquoted ${x:-} that resolved to "") would green-light
    35	  # against ANY real output instead of the specific string the caller meant to check for. Found
    36	  # by convocation review (claude leg), 2026-08-14.
    37	  [ -n "$2" ] || { fail "$3 (empty needle passed to assert_contains — tautology guard, fix the caller)"; return; }
    38	  grep -qF -- "$2" "$1" 2>/dev/null && pass "$3" || fail "$3 ('$2' not in $1)"
    39	}
    40	assert_not_contains(){ # fails on a MISSING file too — "not present" must mean "checked and absent"
    41	  [ -f "$1" ] || { fail "$3 (file $1 missing — vacuous pass refused)"; return; }
    42	  grep -qF -- "$2" "$1" && fail "$3 ('$2' unexpectedly in $1)" || pass "$3"
    43	}
    44	assert_empty(){     [ -z "$1" ]            && pass "$2" || fail "$2 (expected empty, got '$1')"; }
    45	assert_nonempty(){  [ -n "$1" ]            && pass "$2" || fail "$2 (expected output, got none)"; }
    46	
    47	assert_rc(){ # usage: assert_rc <want-rc> "<label>" cmd args...
    48	  local want="$1" label="$2"; shift 2
    49	  "$@" >"$SB/.rc.out" 2>"$SB/.rc.err"; local got=$?
    50	  [ "$got" = "$want" ] && pass "$label (rc=$got)" || { fail "$label (want rc=$want got rc=$got)"; sed 's/^/        /' "$SB/.rc.err" >&2; }
    51	}
    52	
    53	red(){ # RED control — rule 2. The command MUST fail (nonzero rc), and fail FOR THE RIGHT REASON —
    54	  # not because the shell couldn't even find/run it. 126 (found, not executable) and 127 (command
    55	  # not found) mean a typo'd path or missing binary, not the code under test rejecting bad input;
    56	  # counting those as a passed RED control would let a broken invocation register as "tautology
    57	  # guard confirmed" without ever exercising the real code. Found by convocation review (claude
    58	  # leg), 2026-08-14. usage: red "<label>" cmd args...
    59	  local label="$1"; shift
    60	  "$@" >/dev/null 2>&1; local rc=$?
    61	  if [ "$rc" -eq 0 ]; then
    62	    fail "RED control DID NOT FAIL (tautology): $label"
    63	  elif [ "$rc" -eq 126 ] || [ "$rc" -eq 127 ]; then
    64	    fail "RED control failed for the WRONG reason (rc=$rc, command not found/executable — fix the invocation, this proves nothing): $label"
    65	  else
    66	    pass "red: $label"
    67	  fi
    68	}
    69	
    70	finish(){
    71	  # A test file that reaches finish() having run zero assertions (every assert sat behind a
    72	  # conditional that never fired, an early return skipped them all, etc.) would otherwise print
    73	  # "0 ok, 0 failed" and exit 0 — a silent-pass gate baked into the harness itself, worse than any
    74	  # single tautological assertion because it hides EVERY test in the file at once. Found by
    75	  # convocation review (claude + codex, independently), 2026-08-14.
    76	  if [ "$((TESTS_PASS + TESTS_FAIL))" -eq 0 ]; then
    77	    echo "== $(basename "$0"): ran ZERO assertions — this is a failure, not a silent pass" >&2
    78	    return 1
    79	  fi
    80	  echo "== $(basename "$0"): $TESTS_PASS ok, $TESTS_FAIL failed"
    81	  [ "$TESTS_FAIL" -eq 0 ]
    82	}

