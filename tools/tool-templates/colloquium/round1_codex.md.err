   442	class Upstream:
   443	    """One upstream MCP server this daemon fronts, and everything needed to
   444	    keep a persistent connection to it alive. In single-upstream mode there's
   445	    exactly one of these and its tools are forwarded unprefixed (unchanged
   446	    behavior from before multi-upstream support existed). In multi-upstream
   447	    mode there are several, and the aggregator (see build_server) prefixes
   448	    each one's tools with `self.name + "__"` so two upstreams that happen to
   449	    share a tool name can't collide."""
   450	
   451	    def __init__(self, name: str, command: str, args: list[str], require_xcode_running: bool):
   452	        self.name = name
   453	        # Watchdog input: bumped on every connect attempt and every successful heartbeat.
   454	        # Initialised here so the watchdog never reads a missing attribute on a slow start.
   455	        self.last_progress = time.monotonic()
   456	        self.command = command
   457	        self.args = args
   458	        self.require_xcode_running = require_xcode_running
   459	        self.lock = anyio.Lock()
   460	        self.session: ClientSession | None = None
   461	        self.known_broken = False
   462	
   463	    async def list_tools(self, params: types.PaginatedRequestParams | None) -> types.ListToolsResult:
   464	        async with self.lock:
   465	            if self.session is None:
   466	                return types.ListToolsResult(tools=[])
   467	            try:
   468	                with anyio.fail_after(CALL_TIMEOUT_SECONDS):
   469	                    return await self.session.list_tools(params=params)
   470	            except Exception as e:
   471	                # Found live, 2026-08-14: this call had NO timeout at all before
   472	                # this fix — a genuinely hung upstream call (confirmed: a real
   473	                # tool call sat for 2+ minutes with nothing in the log, no
   474	                # timeout, no recovery) held self.lock forever, permanently
   475	                # wedging this upstream for every future call, single-upstream
   476	                # or combined. A timeout here means a hang gets treated the
   477	                # same as any other failure: marked broken, reconnected fresh.
   478	                self.known_broken = True
   479	                log.warning("[%s] list_tools failed, marking connection broken: %s", self.name, e)
   480	                return types.ListToolsResult(tools=[])
   481	
   482	    async def call_tool(self, tool_name: str, arguments: dict) -> types.CallToolResult | None:
   483	        """Returns None if not connected — caller decides how to report that,
   484	        since the aggregator needs a slightly different message than the
   485	        single-upstream case (naming which upstream is down)."""
   486	        async with self.lock:
   487	            if self.session is None:
   488	                return None
   489	            log.info("[%s] call_tool %s", self.name, tool_name)
   490	            try:
   491	                with anyio.fail_after(CALL_TIMEOUT_SECONDS):
   492	                    result = await self.session.call_tool(tool_name, arguments)
   493	            except Exception as e:
   494	                # See list_tools' comment — same missing-timeout bug, same fix.
   495	                self.known_broken = True
   496	                log.warning("[%s] call_tool %s failed, marking connection broken: %s", self.name, tool_name, e)
   497	                return None
   498	            if not isinstance(result, types.CallToolResult):
   499	                # upstream returned something this dumb proxy doesn't forward
   500	                # (e.g. InputRequiredResult) — surface as an error, don't crash.
   501	                return types.CallToolResult(
   502	                    content=[
   503	                        types.TextContent(
   504	                            type="text",
   505	                            text=f"xcode-mcp-front: [{self.name}] unsupported upstream result type "
   506	                            f"{type(result).__name__}",
   507	                        )
   508	                    ],
   509	                    is_error=True,
   510	                )
   511	            return result
   512	
   513	    async def stall_watchdog(self) -> None:
   514	        """Exit the process if this upstream stops making progress entirely.
   515	
   516	        THE RECONNECT LOOP CAN GET STUCK AND GO PERMANENTLY SILENT. Observed live
   517	        2026-08-30: xcode-mcp-front logged "heartbeat list_tools failed, marking broken"
   518	        at 18:50:55 and then never logged again — no retry, no error, nothing — while its
   519	        HTTP endpoint kept answering and serving zero tools. The cause is the teardown, not
   520	        the loop: leaving `async with stdio_client(...)` waits for the child to exit, and a
   521	        wedged mcpbridge never does, so the task blocks inside __aexit__ where no `except`
   522	        and no retry can reach it. Every health signal this daemon has says "fine" in that
   523	        state, which is the worst possible failure shape.
   524	
   525	        There is no clean way to bound a hung context-manager exit from inside it. There IS
   526	        a supervisor: launchd, with KeepAlive true. So when an upstream has made no progress
   527	        for STALL_EXIT_SECONDS — no connect attempt, no successful heartbeat — say so loudly
   528	        and exit non-zero. That is the file's own stated philosophy: "a genuine crash is what
   529	        the process supervisor is for." A restart costs one new Xcode approval prompt, which
   530	        the clicker answers.
   531	
   532	        Deliberately generous, because a false positive here restarts a working daemon: the
   533	        default is many multiples of the heartbeat interval, and any progress at all resets it.
   534	        """
   535	        while True:
   536	            await anyio.sleep(RECONNECT_POLL_SECONDS)
   537	            if self.require_xcode_running and not _xcode_is_running():
   538	                # Waiting for Xcode is not a stall; that path logs and sleeps on purpose.
   539	                self.last_progress = time.monotonic()
   540	                continue
   541	            idle = time.monotonic() - getattr(self, "last_progress", time.monotonic())
   542	            if idle > STALL_EXIT_SECONDS:
   543	                log.error("[%s] no connect attempt and no successful heartbeat for %.0fs — the "
   544	                          "reconnect loop is wedged, almost certainly blocked in stdio_client "
   545	                          "teardown waiting on an mcpbridge child that will not exit. Exiting "
   546	                          "so launchd restarts us; staying up would serve zero tools while "
   547	                          "every log line claimed we were connected.", self.name, idle)
   548	                os._exit(75)
   549	
   550	
   551	    async def connection_manager(self) -> None:
   552	        """Owns this upstream's connection for the daemon's whole life. Loops
   553	        forever: while not connected, check Xcode is running (if this upstream
   554	        needs it), best-effort click its approval prompt if showing, attempt a
   555	        fresh connect. Once connected, holds the session open — polling (and
   556	        clicking) on the same timer — until a call proves it's broken, then
   557	        goes back to reconnecting. In-process, never exits on its own; a
   558	        genuine crash is what the process supervisor (launchd) is for."""
   559	        params = StdioServerParameters(command=self.command, args=self.args)
   560	        while True:
   561	            if self.require_xcode_running and not _xcode_is_running():
   562	                log.info("[%s] Xcode not running, waiting", self.name)
   563	                await anyio.sleep(RECONNECT_POLL_SECONDS)
   564	                continue
   565	
   566	            if AUTO_ALLOW:
   567	                await _click_allow_if_present()
   568	
   569	            log.info("[%s] attempting connect: %s %s", self.name, self.command, self.args)
   570	            self.last_progress = time.monotonic()
   571	            try:
   572	                async with stdio_client(params) as (read, write):
   573	                    async with ClientSession(read, write) as session:
   574	                        with anyio.fail_after(CONNECT_TIMEOUT_SECONDS):
   575	                            await session.initialize()
   576	                        async with self.lock:
   577	                            self.session = session
   578	                            self.known_broken = False
   579	                        log.info("[%s] connected — serving until this breaks", self.name)
   580	                        self.last_progress = time.monotonic()
   581	                        while not self.known_broken:
   582	                            await anyio.sleep(RECONNECT_POLL_SECONDS)
   583	                            # Health-check: a silent list_tools call catches a
   584	                            # dead upstream before any client discovers it.
   585	                            # Without this, a killed Xcode leaves the daemon
   586	                            # sitting "connected" until a real client call
   587	                            # fails — minutes of silently serving zero tools.
   588	                            # CLICK WHILE THE CALL IS BLOCKED, NOT AFTER IT RETURNS. This is
   589	                            # the deadlock that kept the suite at 6/10 and looked for a whole
   590	                            # night like Apple's bridge refusing to serve tools.
   591	                            #
   592	                            # Xcode raises "Allow <x> to access Xcode?" lazily, on the first real
   593	                            # list_tools rather than at the handshake — the comment below has
   594	                            # said so since 2026-08-14. So list_tools BLOCKS until that dialog is
   595	                            # answered. The clicker that answers it was placed after the await.
   596	                            # It therefore ran only once list_tools had already returned, and on
   597	                            # the timeout path the except branch marks the upstream broken and
   598	                            # breaks out before reaching it at all. The one thing that could
   599	                            # unblock the call was scheduled to run only after the call unblocked.
   600	                            #
   601	                            # Worse, the teardown withdraws the prompt: the dialog is bound to the
   602	                            # live connecting process, so killing the child on timeout retracts
   603	                            # the question. With a 5s reconnect loop the daemon spent all night
   604	                            # asking Xcode for permission and cancelling the request before anyone
   605	                            # could say yes — which is why no dialog was ever found on screen, and
   606	                            # why running a single bridge by hand and simply leaving it alive
   607	                            # produced the prompt immediately and 21 tools once it was answered.
   608	                            #
   609	                            # Two daemons made it twice as fast, which is the "do two bridges
   610	                            # interfere" question: they do, but only by doubling the churn. One
   611	                            # daemon alone reproduces it.
   612	                            try:
   613	                                with anyio.fail_after(CONNECT_TIMEOUT_SECONDS):
   614	                                    async with anyio.create_task_group() as _tg:
   615	                                        async def _click_while_blocked():
   616	                                            # Poll rather than click once: the dialog appears a
   617	                                            # moment AFTER the request goes out, so a single
   618	                                            # attempt at the start reliably finds nothing.
   619	                                            while True:
   620	                                                if AUTO_ALLOW:
   621	                                                    await _click_allow_if_present()
   622	                                                await anyio.sleep(ALLOW_CLICK_POLL_SECONDS)
   623	                                        _tg.start_soon(_click_while_blocked)
   624	                                        await session.list_tools()
   625	                                        _tg.cancel_scope.cancel()
   626	                                self.last_progress = time.monotonic()
   627	                            except Exception as e:
   628	                                log.warning("[%s] heartbeat list_tools failed, marking broken: %s", self.name, e)
   629	                                async with self.lock:
   630	                                    self.known_broken = True

