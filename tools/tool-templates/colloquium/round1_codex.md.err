   217	
   218	async def _run_osascript(script: str) -> bytes:
   219	    """Raises on a nonzero exit instead of returning empty bytes. Found by
   220	    convocation review, 2026-08-14: with stderr sent to DEVNULL and no
   221	    returncode check, a TCC grant getting revoked or dying (the documented
   222	    failure mode after any edit to the ad-hoc-signed wrapper .app — new hash,
   223	    dead grant) made osascript exit nonzero with an error, which this
   224	    previously returned as plain b"" — indistinguishable from "no dialog
   225	    showing". The click loop would then silently stop working with nothing in
   226	    the log naming the actual cause. Now surfaces it: caller's except-block
   227	    already logs at warning level, so a dead grant shows up as a real,
   228	    diagnosable log line instead of a silent no-op.
   229	
   230	    Also found LIVE the same day, the hard way: a real System Events hang
   231	    (osascript stuck talking to it, unrelated to the return-code fix above —
   232	    System Events itself was wedged) piled up one leaked orphan osascript
   233	    process EVERY poll tick, forever, because `asyncio.wait_for` timing out
   234	    only abandons Python's own wait — it does NOT kill the underlying
   235	    subprocess. Confirmed live: 30+ orphaned osascript processes accumulated
   236	    in under 10 minutes before this was caught, and System Events itself
   237	    became unresponsive to even a basic query as a result. Now explicitly
   238	    kills the process on timeout instead of leaving it to run forever."""
   239	    proc = await asyncio.create_subprocess_exec(
   240	        "osascript",
   241	        "-e",
   242	        script,
   243	        stdout=asyncio.subprocess.PIPE,
   244	        stderr=asyncio.subprocess.PIPE,
   245	    )
   246	    try:
   247	        out, err = await asyncio.wait_for(proc.communicate(), timeout=5)
   248	    except asyncio.TimeoutError:
   249	        proc.kill()
   250	        await proc.wait()  # reap it — don't leave a zombie behind either
   251	        raise RuntimeError("osascript timed out after 5s (System Events may be unresponsive)")
   252	    if proc.returncode != 0:
   253	        raise RuntimeError(f"osascript exited {proc.returncode}: {err.decode(errors='replace').strip()}")
   254	    return out
