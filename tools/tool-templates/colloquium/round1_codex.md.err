     1	#!/usr/bin/env python3
     2	"""mcp_tools — list the tools an MCP server offers, and compare two servers for collisions.
     3	
     4	    mcp_tools.py list    --config _mcp_info.json --server xcode
     5	    mcp_tools.py compare --config _mcp_info.json --server xcode --against drews
     6	    mcp_tools.py compare --config _mcp_info.json --server xcode --against drews --summarize
     7	
     8	WHY. Wrapping several MCP servers behind one surface means deciding which server does a job when
     9	more than one covers it, and that decision needs the two tool lists side by side. Doing it by
    10	reading documentation is how you miss the pair that are named nothing alike and do the same
    11	thing. This prints both lists, finds the overlaps that string comparison can find, and will
    12	optionally hand the rest to a model, which is the part string comparison cannot do.
    13	
    14	It reads the Claude Code config shape — {"mcpServers": {"<name>": {"command", "args", "env"}}} —
    15	because that is the shape the wrapper is specified to take, so one file drives both.
    16	
    17	TWO THINGS THIS REFUSES TO DO, both learned the hard way on 2026-08-31.
    18	
    19	A server that answers `initialize` and then never answers `tools/list` is NOT a server with zero
    20	tools, and reporting it as one cost a night. Xcode raises a per-process approval dialog lazily on
    21	the first real tools/list, so the call blocks until a human or a clicker answers it, and a probe
    22	that gives up reports silence as emptiness. This tool distinguishes them: an answered-but-empty
    23	list is a fact, a timeout is reported as a timeout, with the approval dialog named as the likely
    24	cause when the server is one that shows one.
    25	
    26	And the child's stdin stays open for the whole exchange. Closing it after writing makes the
    27	server exit cleanly, which looks identical to a server that refused to answer — that mistake
    28	produced a confident and wrong "mcpbridge is broken" diagnosis the same day.
    29	"""
    30	import argparse
    31	import json
    32	import os
    33	import select
    34	import subprocess
    35	import sys
    36	
    37	# Long by design. The first tools/list against a server that gates on an approval dialog does not
    38	# return until the dialog is answered, and a short timeout here turns "waiting for a human" into
    39	# "server has no tools" — which is the failure this file exists to refuse.
    40	DEFAULT_TIMEOUT = 45.0
    41	
    42	
    43	def load_servers(path):
    44	    try:
    45	        raw = open(path, encoding="utf-8").read()
    46	    except OSError as e:
    47	        sys.exit("mcp_tools: cannot read %s (%s)" % (path, e))
    48	    try:
    49	        cfg = json.loads(raw)
    50	    except ValueError as e:
    51	        # A jsonc human file will land here. Say so rather than "invalid JSON", because the
    52	        # difference between a typo and a deliberate comment is the whole remedy.
    53	        sys.exit("mcp_tools: %s is not strict JSON (%s). If this is the commented human-owned "
    54	                 "file, point at the generated one instead — comments are only allowed there."
    55	                 % (path, e))
    56	    servers = cfg.get("mcpServers")
    57	    if not isinstance(servers, dict) or not servers:
    58	        sys.exit("mcp_tools: %s has no non-empty mcpServers object" % path)
    59	    return servers
    60	
    61	
    62	def probe(name, spec, timeout):
    63	    """-> dict with serverInfo and tools, or an explicit failure. Never guesses."""
    64	    command = spec.get("command")
    65	    if not command:
    66	        return {"error": "server %r has no 'command'; http upstreams are not supported yet" % name}
    67	    args = spec.get("args") or []
    68	    env = dict(os.environ)
    69	    env.update(spec.get("env") or {})
    70	
    71	    p = subprocess.Popen([command] + list(args), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
    72	                         stderr=subprocess.PIPE, text=True, bufsize=1, env=env)
    73	
    74	    def send(obj):
    75	        try:
    76	            p.stdin.write(json.dumps(obj) + "\n")
    77	            p.stdin.flush()
    78	            return True
    79	        except (BrokenPipeError, ValueError):
    80	            return False
    81	
    82	    def readline(limit):
    83	        ready, _, _ = select.select([p.stdout], [], [], limit)
    84	        if not ready:
    85	            return None          # still open, said nothing — NOT the same as empty
    86	        return p.stdout.readline()
