     1	#!/usr/bin/env bash
     2	# test-ai-setup-diff.sh — the comparison logic against a REAL fake remote: the ssh shim
     3	# executes each remote command with bash under a different $HOME, so remote-side quoting is
     4	# genuinely evaluated (this is the seam where '$HOME' once shipped single-quoted, never
     5	# expanded remotely, and everything falsely read "ONLY LOCAL").
