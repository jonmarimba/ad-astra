     1	#!/usr/bin/env bash
     2	# dedup-scan — the decided dedup strategy as one command, COARSE by design:
     3	#   1. periphery        -> dead Swift code (skipped without .periphery.yml)
     4	#   2. graph mining     -> FILE-level candidate pairs: same call-surface, no edges between them
     5	#   3. LLM judgment     -> claude reads each candidate pair: "same purpose? merge-worthy?"
     6	# Granularity guard: candidates need >=MIN_SHARED shared callees and land at file level —
     7	# no per-call noise, no fopen warnings. Top-K pairs go to the LLM, never everything.
     8	#   dedup-scan <repo> [--top 8] [--min-shared 3] [--no-llm]
     9	set -uo pipefail
    10	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$HOME/.local/bin:$PATH"
    11	CLAUDE_BIN="${CLAUDE_BIN:-/opt/homebrew/bin/claude}"
    12	REPO="${1:?usage: dedup-scan <repo> [--top 8] [--min-shared 3] [--no-llm]}"; shift || true
    13	TOP=8; MINSHARED=3; LLM=1
    14	while [ $# -gt 0 ]; do case "$1" in
    15	  --top) TOP="$2"; shift 2;; --min-shared) MINSHARED="$2"; shift 2;; --no-llm) LLM=0; shift;;
    16	  # a typo'd flag must error, not silently run with defaults (same class as the convoke find)
    17	  *) echo "dedup-scan: unknown argument '$1'" >&2; exit 64;;
    18	esac; done
    19	cd "$REPO"
    20	OUT="graphify-out/DEDUP_REPORT.md"
    21	echo "# Dedup scan — $(basename "$REPO")" > "$OUT"
    22	
    23	echo "## 1. Dead code (periphery)" >> "$OUT"
    24	if [ -f .periphery.yml ] && command -v periphery >/dev/null; then
    25	  periphery scan --quiet 2>/dev/null | head -100 >> "$OUT" || echo "(periphery scan failed — run interactively to debug)" >> "$OUT"
    26	else
    27	  echo "(skipped — no .periphery.yml; run 'periphery scan --setup' once in this repo)" >> "$OUT"
    28	fi
    29	
    30	echo "## 2. Same-purpose candidates (file-level, coarse)" >> "$OUT"
    31	[ -f graphify-out/graph.json ] || { echo "no graphify-out/graph.json — run graphify-repo first"; exit 1; }
    32	python3 - "$MINSHARED" "$TOP" <<'PY' >> "$OUT"
    33	import json, sys, itertools
    34	from collections import defaultdict
    35	min_shared, top = int(sys.argv[1]), int(sys.argv[2])
    36	d = json.load(open('graphify-out/graph.json'))
    37	nodes = {n['id']: n for n in d['nodes']}
    38	edges = d.get('edges') or d.get('links')
    39	# call-surface per SOURCE FILE: the set of callee labels its code touches
    40	surface = defaultdict(set); linked = defaultdict(set)
    41	for e in edges:
    42	    s, t = nodes.get(e['source']), nodes.get(e['target'])
    43	    if not s or not t: continue
    44	    sf, tf = s.get('source_file'), t.get('source_file')
    45	    if sf and t.get('label'): surface[sf].add(t['label'])
    46	    if sf and tf and sf != tf:
    47	        linked[sf].add(tf); linked[tf].add(sf)
    48	CODE_EXT = ('.swift','.py','.m','.mm','.c','.cpp','.h','.js','.ts','.rb','.go','.rs','.sh','.zsh')
    49	def is_real_code(f):
    50	    lf = f.lower()
    51	    if not lf.endswith(CODE_EXT): return False                    # no markdown/config noise
    52	    if '/tests/' in lf or lf.startswith('tests/') or '/test_' in lf or lf.endswith(('__init__.py',)): return False
    53	    return True                                                    # tests importing the package is not duplication
    54	files = [f for f in surface if len(surface[f]) >= min_shared and is_real_code(f)]
    55	cands = []
     1	#!/usr/bin/env bash
     2	# md2pdf — headless Markdown -> PDF (pandoc -> HTML+CSS -> weasyprint). The no-GUI,
     3	# no-mouse-grab replacement for marked_to_pdf.sh. Template selection is a CSS file via --template.
     4	#   md2pdf input.md output.pdf [--template /path/style.css | --template NAME]
     5	# A --template NAME that isn't a readable file is resolved to ./templates/NAME.css.
     6	set -euo pipefail
     7	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
     8	HERE="$(cd "$(dirname "$0")" && pwd)"
     9	[ $# -ge 2 ] || { echo "usage: md2pdf input.md output.pdf [--template style.css]"; exit 2; }
    10	IN="$1"; OUT="$2"; shift 2
    11	TPL="$HERE/templates/default.css"
    12	# strict flag parsing: "--template" with no value, or any misspelled flag, must ERROR —
    13	# a legal export silently falling back to default.css ships with the wrong stylesheet
    14	while [ $# -gt 0 ]; do case "$1" in
    15	  --template)
    16	    [ -n "${2:-}" ] || { echo "md2pdf: --template needs a value" >&2; exit 64; }
    17	    if [ -f "$2" ]; then TPL="$2"; elif [ -f "$HERE/templates/$2.css" ]; then TPL="$HERE/templates/$2.css"; else echo "template not found: $2" >&2; exit 1; fi
    18	    shift 2 ;;
    19	  *) echo "md2pdf: unknown argument '$1'" >&2; exit 64 ;;
    20	esac; done
    21	[ -f "$IN" ] || { echo "input not found: $IN" >&2; exit 1; }
    22	command -v pandoc >/dev/null || { echo "need pandoc" >&2; exit 1; }
    23	command -v weasyprint >/dev/null || { echo "need weasyprint (brew install weasyprint)" >&2; exit 1; }
    24	TD="$(mktemp -d -t md2pdf)"; HTML="$TD/doc.html"
    25	pandoc "$IN" --standalone --embed-resources --css "$TPL" -o "$HTML"
    26	weasyprint "$HTML" "$OUT"
    27	rm -rf "$TD"
    28	[ -f "$OUT" ] || { echo "PDF not produced" >&2; exit 1; }
    29	if python3 -c "import fitz" 2>/dev/null && [ -x "$HERE/pdf_add_footer.py" ]; then
    30	  "$HERE/pdf_add_footer.py" "$OUT" 2>/dev/null || true
    31	fi
    32	echo "wrote $OUT (template: $(basename "$TPL"))"
     1	#!/usr/bin/env bash
     2	# speech-bee — a swappable STT/TTS "bee": audio in → text out, text in → audio out.
     3	# Same stdin/stdout contract regardless of engine, so the backend can be Apple, whisper, or
     4	# anything else later. For kicker2's voice side-channel and for transcribing recorded calls.
     5	#
     6	# Engines now: STT = whisper.cpp (whisper-cli); TTS = macOS `say` (AVSpeechSynthesizer).
     7	# Next: an Apple SpeechAnalyzer/SpeechTranscriber Swift backend (macOS 26+, on-device, beats
     8	# Whisper Large v3 Turbo) — drop it in behind the same `stt`/`tts` verbs.
     9	#
    10	# Usage:
    11	#   speech-bee stt <audiofile>            # transcription → stdout
    12	#   speech-bee tts "text"  [--out f.aiff] # or:  echo text | speech-bee tts -
    13	#   speech-bee bootstrap [model]          # fetch a whisper model (default base.en)
    14	#   SPEECH_BEE_MODEL=/path/ggml-x.bin  SPEECH_BEE_STT=whisper  SPEECH_BEE_TTS=say
    15	set -uo pipefail
    16	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
    17	
    18	MODEL="${SPEECH_BEE_MODEL:-$HOME/.cache/whisper/ggml-base.en.bin}"
    19	STT_ENGINE="${SPEECH_BEE_STT:-whisper}"
    20	TTS_ENGINE="${SPEECH_BEE_TTS:-say}"
    21	
    22	die(){ echo "speech-bee: $*" >&2; exit 1; }
    23	
    24	stt_whisper(){
    25	  local src="$1"
    26	  command -v whisper-cli >/dev/null || die "whisper-cli not found (brew install whisper-cpp)"
    27	  [ -f "$MODEL" ] || die "no model at $MODEL — run: speech-bee bootstrap"
    28	  local wav; wav="$(mktemp).wav"
    29	  ffmpeg -nostdin -loglevel error -y -i "$src" -ar 16000 -ac 1 -c:a pcm_s16le "$wav" || die "ffmpeg convert failed"
    30	  local base; base="$(mktemp)"
    31	  whisper-cli -m "$MODEL" -f "$wav" -nt -otxt -of "$base" >/dev/null 2>&1 || die "whisper-cli failed"
    32	  cat "$base.txt"; rm -f "$wav" "$base.txt"
    33	}
    34	
    35	tts_say(){
    36	  local text="$1" out="${2:-}"
    37	  [ "$text" = "-" ] && text="$(cat)"
    38	  if [ -n "$out" ]; then say -o "$out" "$text"; echo "wrote $out"; else say "$text"; fi
    39	}
    40	
    41	case "${1:-}" in
    42	  stt)
    43	    [ $# -ge 2 ] || die "usage: speech-bee stt <audiofile>"
    44	    case "$STT_ENGINE" in whisper) stt_whisper "$2" ;; apple) die "apple STT backend not built yet (Swift SpeechAnalyzer — planned)";; *) die "unknown STT engine $STT_ENGINE";; esac ;;
    45	  tts)
    46	    shift; text="${1:-}"; out=""
    47	    [ "${2:-}" = "--out" ] && out="${3:-}"
    48	    case "$TTS_ENGINE" in say) tts_say "$text" "$out" ;; apple) die "use say (already AVSpeechSynthesizer)";; *) die "unknown TTS engine";; esac ;;
    49	  bootstrap)
    50	    # honors SPEECH_BEE_MODEL's directory, and downloads via tmp+rename so an interrupted
    51	    # fetch can't leave a truncated model that passes the -f existence gate
    52	    m="${2:-base.en}"; dest="$(dirname "$MODEL")/ggml-${m}.bin"; mkdir -p "$(dirname "$MODEL")"
    53	    url="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-${m}.bin"
    54	    echo "fetching ggml-${m}.bin → $dest"
    55	    curl -L --fail -o "$dest.part" "$url" && mv "$dest.part" "$dest" && echo "done: $dest" || { rm -f "$dest.part"; die "bootstrap download failed"; } ;;
    56	  *) echo "usage: speech-bee stt <audio> | tts <text>|- [--out f] | bootstrap [model]"; exit 1 ;;
    57	esac

