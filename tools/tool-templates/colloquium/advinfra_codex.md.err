    85	GMED="$SB/media"; mkdir -p "$GMED"
    86	: > "$GMED/a_photo.jpeg"; : > "$GMED/b_clip.mov"; : > "$GMED/c_later.jpeg"
    87	# exiftool stub that returns per-file dates + a GPS so the gallery can group + caption
    88	cat > "$SB/bin/exiftool-gal" <<'STUB'
    89	#!/usr/bin/env bash
    90	for a in "$@"; do case "$a" in
   300	 'figure.on{outline:2px solid #4a9eff}img,video{width:300px;height:auto;border-radius:4px;display:block}',
   301	 'figcaption{font-size:12px;color:#aaa;padding:4px 2px}.pk{position:absolute;top:10px;left:10px;width:22px;height:22px;cursor:pointer}',
   302	 '#bar{position:fixed;left:0;right:0;bottom:0;background:#000d;backdrop-filter:blur(6px);border-top:1px solid #333;padding:10px 16px;display:flex;gap:10px;align-items:center}',
   303	 '#bar button{background:#4a9eff;color:#001;border:0;border-radius:5px;padding:8px 12px;font-weight:600;cursor:pointer}#bar .sec{background:#333;color:#ddd}#cnt{margin-left:auto;color:#ccc}</style>',
   304	 f'<h1>Evidence gallery — {esc(os.path.basename(os.path.abspath(src)))}</h1>',
   305	 f'<p style=color:#888>{len(files)} items across {len(bydate)} day(s). Tick the ones you want; download the selection; feed it to <code>geo-evidence pull --select</code>.</p>']
   306	for day,items in bydate.items():
   307	    parts.append(f'<div class=day data-day="{esc(day)}"><h2>{esc(day)}</h2><span style=color:#888>{len(items)} item(s)</span>'
   308	                 f'<button onclick="grp(\'{esc(day)}\',1)">select all</button><button onclick="grp(\'{esc(day)}\',0)">none</button></div><div class=grid>')
   309	    for dt,fn,isvid,note,ident,pv in items:
   310	        tm=esc(dt[11:19] if len(dt)>=19 else dt)
   311	        cap=tm+(' · '+esc(note) if note else '')
   312	        if pv:   # have a preview file
   313	            rel=esc(pv); pv_is_img=os.path.splitext(pv)[1].lower() in IMG
   314	            if isvid and not pv_is_img:
   315	                media=f'<video controls preload=metadata src="{rel}"></video>'
   316	            else:   # image, or a video's poster-frame derivative -> show as image
   317	                badge='<span style="position:absolute;top:10px;right:10px;background:#000a;padding:2px 6px;border-radius:4px;font-size:11px">🎬</span>' if isvid else ''
   318	                media=f'<a href="{rel}"><img loading=lazy src="{rel}"></a>{badge}'
   319	        else:    # not downloaded (video/iCloud-only) — still selectable
   320	            icon='🎬 video' if isvid else '📷 photo'
   321	            media=f'<div style="width:300px;height:180px;background:#222;display:flex;align-items:center;justify-content:center;color:#888;text-align:center;border-radius:4px">{icon}<br>not downloaded<br><small>pull will fetch it</small></div>'
   322	        parts.append(f'<figure data-day="{esc(day)}"><input type=checkbox class=pk data-id="{esc(ident)}" onchange="upd()">{media}<figcaption>{cap}<br>{esc(fn)}</figcaption></figure>')
   323	    parts.append('</div>')
   324	parts.append('<div id=bar><button onclick="all(1)">Select all</button><button class=sec onclick="all(0)">Clear</button>'
   325	 '<button onclick="dl()">⬇ Download selection</button><span id=cnt>0 selected</span></div>')
   326	parts.append('''<script>
   327	function boxes(){return[...document.querySelectorAll('input.pk')]}
   328	function upd(){let n=0;boxes().forEach(b=>{b.closest('figure').classList.toggle('on',b.checked);if(b.checked)n++});document.getElementById('cnt').textContent=n+' selected'}
   329	function all(v){boxes().forEach(b=>b.checked=v);upd()}
   330	function grp(day,v){boxes().forEach(b=>{if(b.closest('figure').dataset.day===day)b.checked=v});upd()}
   331	function dl(){let ids=boxes().filter(b=>b.checked).map(b=>b.dataset.id);if(!ids.length){alert('nothing selected');return}
   332	 let blob=new Blob([ids.join('\\n')+'\\n'],{type:'text/plain'});let a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='geo-evidence-selection.txt';a.click()}
   333	</script>''')
   334	open(out,'w').write('\n'.join(parts))
   335	print(f'geo-evidence: gallery -> {out} ({len(files)} items, {len(bydate)} day(s); {"selectable, uuid-mapped" if umap else "selectable by filename (no uuid map found)"})')
   336	PYEOF
   337	    ;;
   338	  *) echo "usage: geo-evidence scan|pull --since D --until D [--property NAME --out DIR [--preview]] | gallery <DIR> --out FILE"; exit 1 ;;
   339	esac
     1	#!/usr/bin/env bash
     2	# test-installers-which-first.sh — the anti-double-copy contract, run for real: on a machine
     3	# where the tools exist, every installer must detect them ("already installed") and invoke
     4	# NO package manager for them. This is the exact regression that bit on 2026-08-12 (a
     5	# Brewfile that would have installed brew copies of npm-installed claude/codex).
     6	# NOT covered here: the absent-tool branch (would really install software on this machine)
     7	# and pdf-sidecars/install.sh (unconditionally runs `uv tool install marker-pdf` — a
     8	# mutating step with no which-first gate; run it by hand, not from a test).
     9	HERE="$(cd "$(dirname "$0")" && pwd)"; . "$HERE/lib.sh"
    10	need claude "npm install -g @anthropic-ai/claude-code"
    11	need codex "npm install -g @openai/codex"
    12	need qwen "brew install qwen-code"
    13	need periphery "brew install periphery"
    14	
    15	# ---- convocation: all three agents detected, zero installs, no shadow copies ----
    16	out="$("$HERE/../convocation/install.sh" 2>&1)"; rc=$?
    17	assert_eq "0" "$rc" "convocation install exits 0"
    18	for b in claude codex qwen; do
    19	  printf '%s\n' "$out" | grep -q "already installed: $b" && pass "convocation: $b detected, not reinstalled" || fail "convocation: no 'already installed' for $b"
    20	done
    21	printf '%s\n' "$out" | grep -q "installing" && fail "convocation: an install step ran despite tools being present" || pass "convocation: no package manager invoked"
    22	printf '%s\n' "$out" | grep -q "WARNING" && fail "convocation: shadow copies present on this machine (resolve!)" || pass "convocation: exactly one copy of each agent"
    23	
    24	# ---- periphery: detected, brew not invoked ----
    25	out="$("$HERE/../periphery/install.sh" 2>&1)"; rc=$?
    26	assert_eq "0" "$rc" "periphery install exits 0"
    27	printf '%s\n' "$out" | grep -q "already installed: periphery" && pass "periphery detected, brew bundle skipped" || fail "periphery: no 'already installed' line"
    28	
    29	# ---- ponytail: real fetch into a temp repo, idempotent second run ----
    30	REPO="$SB/repo"; mkdir -p "$REPO"
    31	assert_rc 0 "ponytail installs into a repo" "$HERE/../ponytail/install-into-repo.sh" "$REPO"
    32	assert_file "$REPO/.claude/skills/ponytail/SKILL.md" "ponytail skill landed"
    33	assert_file "$REPO/.claude/skills/ponytail-audit/SKILL.md" "ponytail-audit skill landed"
    34	assert_contains "$REPO/.claude/skills/ponytail/SKILL.md" "name:" "skill has frontmatter (not an error page)"
    35	out="$("$HERE/../ponytail/install-into-repo.sh" "$REPO" 2>&1)"
    36	printf '%s\n' "$out" | grep -c "already installed" | grep -q "^2$" && pass "second run: both skills detected, nothing re-fetched" || fail "ponytail re-run not idempotent"
    37	
    38	# ---- RED controls ----
    39	red "ponytail without a repo arg must fail" 1 "usage: install-into-repo.sh" "$HERE/../ponytail/install-into-repo.sh"
    40	
    41	finish

