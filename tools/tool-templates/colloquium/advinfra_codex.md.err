    31	assert_contains "$IMSG_SEND_LOG" "[testbot] hello jonathan" "send reached imsg tagged with the bot name"
    32	assert_eq "testbot" "$(cat "$BOTLINE_HOME/last_bot")" "send marked testbot as last-to-message"
