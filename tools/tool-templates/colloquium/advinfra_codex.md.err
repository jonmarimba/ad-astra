 succeeded in 0ms:
     1	#!/usr/bin/env python3
     2	"""stub_mcp_server — a minimal, dependency-free stdio MCP server for tests.
     3	
     4	Speaks just enough newline-delimited JSON-RPC for the aggregator's client to connect:
     5	initialize, notifications/initialized, tools/list, tools/call, ping. Every knob is an
     6	argument so any test (or any other agent's harness) can shape it without editing it:
     7	
     8	    stub_mcp_server.py --name alpha --tool ping=alpha-pong --tool build=done
     9	    stub_mcp_server.py --name empty                       # connects fine, zero tools
    10	    stub_mcp_server.py --name chatty --banner "starting"  # spec-illegal stdout banner line
    11	    stub_mcp_server.py --name pager --tool a=1 --tool b=2 --page-size 1   # paginates
    12	
    13	--tool NAME=REPLY declares one tool; calling it returns REPLY as text content. Two REPLY
    14	  prefixes change the behaviour: "env:VAR" answers with os.environ[VAR] resolved at call
    15	  time (proves an env pass-through by effect), and "error:MSG" answers with a JSON-RPC
    16	  ERROR response (an application-level error a proxy must forward, not treat as a dead
    17	  transport).
    18	--banner LINE prints LINE to stdout before serving (reproduces the class of server that
    19	  breaks naive next-line readers).
    20	--notify-before-reply emits a spec-legal notification line immediately before every
    21	  response (a next-line reader misreads the notification as the answer).
    22	--stall-tools answers initialize normally and then never answers tools/list (reproduces
    23	  the approval-dialog gate that must read as a timeout, never as an empty tool list).
    24	--page-size N makes tools/list return N tools per page with a nextCursor, exercising
    25	  per-upstream cursors.
    26	--page-loop makes every tools/list page carry nextCursor "0" forever (a cursor cycle,
    27	  the upstream bug a drain must bound rather than follow to memory exhaustion).
    28	Python 3.9-compatible; no third-party imports.
    29	"""
    30	import argparse
    31	import json
    32	import os
    33	import sys
    34	
    35	
    36	def main():
    37	    ap = argparse.ArgumentParser()
    38	    ap.add_argument("--name", required=True)
    39	    ap.add_argument("--version", default="1.0-stub")
    40	    ap.add_argument("--tool", action="append", default=[], metavar="NAME=REPLY")
    41	    ap.add_argument("--describe", action="append", default=[], metavar="NAME=TEXT",
    42	                    help="override a tool's description (for description-rewrite tests)")
    43	    ap.add_argument("--banner", default=None)
    44	    ap.add_argument("--notify-before-reply", action="store_true")
    45	    ap.add_argument("--stall-tools", action="store_true")
    46	    ap.add_argument("--emit-list-changed-on-call", default=None, metavar="TOOL",
    47	                    help="emit notifications/tools/list_changed before answering a call "
    48	                         "to TOOL (deterministic trigger for notification-relay tests)")
    49	    ap.add_argument("--page-size", type=int, default=0)
    50	    ap.add_argument("--page-loop", action="store_true")
    51	    a = ap.parse_args()
    52	
    53	    tools = {}
    54	    for spec in a.tool:
    55	        name, _, reply = spec.partition("=")
    56	        tools[name] = reply
    57	    described = {}
    58	    for spec in a.describe:
    59	        n, _, text = spec.partition("=")
    60	        described[n] = text
    61	    tool_list = [{"name": n,
    62	                  "description": described.get(n, "stub tool %s on %s" % (n, a.name)),
    63	                  "inputSchema": {"type": "object"}}
    64	                 for n in tools]
    65	
    66	    def send(obj):
    67	        if a.notify_before_reply and "id" in obj:
    68	            sys.stdout.write(json.dumps({"jsonrpc": "2.0",
    69	                                         "method": "notifications/message",
    70	                                         "params": {"level": "info",
    71	                                                    "data": "stub %s chatter" % a.name}}) + "\n")
    72	        sys.stdout.write(json.dumps(obj) + "\n")
    73	        sys.stdout.flush()
    74	
    75	    if a.banner is not None:
    76	        sys.stdout.write(a.banner + "\n")
    77	        sys.stdout.flush()
    78	
    79	    for line in sys.stdin:
    80	        line = line.strip()
    81	        if not line:
    82	            continue
    83	        msg = json.loads(line)
    84	        method = msg.get("method")
    85	        mid = msg.get("id")
    86	        if mid is None:
    87	            continue  # a notification; nothing to answer
    88	        if method == "initialize":
    89	            send({"jsonrpc": "2.0", "id": mid, "result": {
    90	                "protocolVersion": msg.get("params", {}).get("protocolVersion", "2025-06-18"),
    91	                "capabilities": {"tools": {"listChanged": True}},
    92	                "serverInfo": {"name": a.name, "version": a.version}}})
    93	        elif method == "tools/list" and a.stall_tools:
    94	            continue  # never answer — the approval-dialog gate, as a stub
    95	        elif method == "tools/list":
    96	            if a.page_loop:
    97	                send({"jsonrpc": "2.0", "id": mid, "result": {
    98	                    "tools": tool_list, "nextCursor": "0"}})
    99	            elif a.page_size > 0:
   100	                cursor = msg.get("params") or {}
   101	                start = int(cursor.get("cursor") or 0)
   102	                page = tool_list[start:start + a.page_size]
   103	                result = {"tools": page}
   104	                if start + a.page_size < len(tool_list):
   105	                    result["nextCursor"] = str(start + a.page_size)
   106	                send({"jsonrpc": "2.0", "id": mid, "result": result})
   107	            else:
   108	                send({"jsonrpc": "2.0", "id": mid, "result": {"tools": tool_list}})
   109	        elif method == "tools/call":
   110	            params = msg.get("params") or {}
   111	            name = params.get("name")
   112	            if name in tools:
   113	                if a.emit_list_changed_on_call == name:
   114	                    send({"jsonrpc": "2.0", "method": "notifications/tools/list_changed"})
   115	                reply = tools[name]
   116	                if reply.startswith("env:"):
   117	                    reply = os.environ.get(reply[4:], "<unset:%s>" % reply[4:])
   118	                if reply.startswith("error:"):
   119	                    send({"jsonrpc": "2.0", "id": mid, "error": {
   120	                        "code": -32050, "message": reply[6:]}})
   121	                    continue
   122	                send({"jsonrpc": "2.0", "id": mid, "result": {
   123	                    "content": [{"type": "text", "text": reply}], "isError": False}})
   124	            else:
   125	                send({"jsonrpc": "2.0", "id": mid, "error": {
   126	                    "code": -32602, "message": "unknown tool %r on stub %s" % (name, a.name)}})
   127	        elif method == "ping":
   128	            send({"jsonrpc": "2.0", "id": mid, "result": {}})
   129	        else:
   130	            send({"jsonrpc": "2.0", "id": mid, "error": {
   131	                "code": -32601, "message": "stub %s does not implement %s" % (a.name, method)}})
   132	
   133	
   134	if __name__ == "__main__":
   135	    main()
