FILE ../tool-templates/mcp_tools.py
     1	#!/usr/bin/env python3
     2	"""mcp_tools — list the tools an MCP server offers, and compare two servers for collisions.
     3	
     4	    mcp_tools.py list    --config _mcp_info.json --server xcode
     5	    mcp_tools.py compare --config _mcp_info.json --server xcode --against drews
     6	    mcp_tools.py compare --config _mcp_info.json --server xcode --against drews --summarize
     7	
     8	WHY. Wrapping several MCP servers behind one surface means deciding which server does a job when
     9	more than one covers it, and that decision needs the two tool lists side by side. Doing it by
    10	reading documentation is how you miss the pair that are named nothing alike and do the same
    11	thing. This prints both lists, finds the overlaps that string comparison can find, and will
    12	optionally hand the rest to a model, which is the part string comparison cannot do.
    13	
    14	It reads the Claude Code config shape — {"mcpServers": {"<name>": {"command", "args", "env"}}} —
    15	because that is the shape the wrapper is specified to take, so one file drives both.
    16	
    17	TWO THINGS THIS REFUSES TO DO, both learned the hard way on 2026-08-31.
    18	
    19	A server that answers `initialize` and then never answers `tools/list` is NOT a server with zero
    20	tools, and reporting it as one cost a night. Xcode raises a per-process approval dialog lazily on
    21	the first real tools/list, so the call blocks until a human or a clicker answers it, and a probe
    22	that gives up reports silence as emptiness. This tool distinguishes them: an answered-but-empty
    23	list is a fact, a timeout is reported as a timeout, with the approval dialog named as the likely
    24	cause when the server is one that shows one.
    25	
    26	And the child's stdin stays open for the whole exchange. Closing it after writing makes the
    27	server exit cleanly, which looks identical to a server that refused to answer — that mistake
    28	produced a confident and wrong "mcpbridge is broken" diagnosis the same day.
    29	"""
    30	import argparse
    31	import json
    32	import os
    33	import select
    34	import subprocess
    35	import sys
    36	import threading
    37	import time
    38	
    39	# Long by design. The first tools/list against a server that gates on an approval dialog does not
    40	# return until the dialog is answered, and a short timeout here turns "waiting for a human" into
    41	# "server has no tools" — which is the failure this file exists to refuse.
    42	DEFAULT_TIMEOUT = 45.0
    43	
    44	
    45	def load_servers(path):
    46	    try:
    47	        raw = open(path, encoding="utf-8").read()
    48	    except OSError as e:
    49	        sys.exit("mcp_tools: cannot read %s (%s)" % (path, e))
    50	    try:
    51	        cfg = json.loads(raw)
    52	    except ValueError as e:
    53	        # A jsonc human file will land here. Say so rather than "invalid JSON", because the
    54	        # difference between a typo and a deliberate comment is the whole remedy.
    55	        sys.exit("mcp_tools: %s is not strict JSON (%s). If this is the commented human-owned "
    56	                 "file, point at the generated one instead — comments are only allowed there."
    57	                 % (path, e))
    58	    servers = cfg.get("mcpServers")
    59	    if not isinstance(servers, dict) or not servers:
    60	        sys.exit("mcp_tools: %s has no non-empty mcpServers object" % path)
    61	    return servers
    62	
    63	
    64	def probe(name, spec, timeout):
    65	    """-> dict with serverInfo and tools, or an explicit failure. Never guesses."""
    66	    command = spec.get("command")
    67	    if not command:
    68	        return {"error": "server %r has no 'command'; http upstreams are not supported yet" % name}
    69	    args = spec.get("args") or []
    70	    env = dict(os.environ)
    71	    env.update(spec.get("env") or {})
    72	
    73	    p = subprocess.Popen([command] + list(args), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
    74	                         stderr=subprocess.PIPE, env=env)
    75	
    76	    # Drain stderr on its own thread for the child's whole life. A chatty server that
    77	    # fills the stderr pipe otherwise BLOCKS mid-write, which from out here is
    78	    # indistinguishable from the approval-dialog stall this tool exists to name honestly.
    79	    stderr_lines = []
    80	    stderr_thread = threading.Thread(
    81	        target=lambda: stderr_lines.extend(
    82	            l.decode("utf-8", "replace").rstrip("\n") for l in p.stderr),
    83	        daemon=True)
    84	    stderr_thread.start()
    85	
    86	    def send(obj):
    87	        try:
    88	            p.stdin.write((json.dumps(obj) + "\n").encode("utf-8"))
    89	            p.stdin.flush()
    90	            return True
    91	        except (BrokenPipeError, ValueError):
    92	            return False
    93	
    94	    # RAW BYTES + OWN LINE SPLITTING, NOT select()-then-readline(). A buffered readline
    95	    # can swallow several lines in one os-level read; the next select() then blocks on a
    96	    # pipe with no NEW bytes while the answer already sits in the wrapper's buffer. That
    97	    # combination timed out on the very first chatty-server test this file's tests ran.
    98	    pending = [b""]
    99	
   100	    def next_line(deadline):
   101	        """One decoded line, or None on deadline, or "" on closed stdout."""
   102	        while True:
   103	            nl = pending[0].find(b"\n")
   104	            if nl >= 0:
   105	                line = pending[0][:nl]
   106	                pending[0] = pending[0][nl + 1:]
   107	                return line.decode("utf-8", "replace")
   108	            remaining = deadline - time.monotonic()
   109	            if remaining <= 0:
   110	                return None
   111	            ready, _, _ = select.select([p.stdout], [], [], remaining)
   112	            if not ready:
   113	                return None          # still open, said nothing — NOT the same as empty
   114	            chunk = os.read(p.stdout.fileno(), 65536)
   115	            if chunk == b"":
   116	                if pending[0]:       # closed mid-line: hand over what there is, then EOF
   117	                    line, pending[0] = pending[0], b""
   118	                    return line.decode("utf-8", "replace")
   119	                return ""
   120	            pending[0] += chunk
   121	
   122	    def read_response(want_id, limit):
   123	        """Read until THE RESPONSE WITH THIS ID arrives, a deadline passes, or stdout
   124	        closes. The old version took whatever line came next, so a startup banner or a
   125	        spec-legal notification arriving between request and response was misread as the
   126	        answer or crashed the probe — the exact class of error the module docstring
   127	        forbids, found independently by all three round-one colloquium brands.
   128	        Returns the parsed response object, None on timeout, "" on closed stdout."""
   129	        deadline = time.monotonic() + limit
   130	        while True:
   131	            line = next_line(deadline)
   132	            if line is None:
   133	                return None
   134	            if line == "":
   135	                return ""
   136	            line = line.strip()
   137	            if not line:
   138	                continue
   139	            try:
   140	                obj = json.loads(line)
   141	            except ValueError:
   142	                continue             # a banner or log line on stdout; not ours to parse
   143	            if not isinstance(obj, dict) or obj.get("id") != want_id:
   144	                continue             # a notification, or an answer to something else
   145	            return obj
   146	
   147	    try:
   148	        send({"jsonrpc": "2.0", "id": 1, "method": "initialize",
   149	              "params": {"protocolVersion": "2025-06-18", "capabilities": {"tools": {}},
   150	                         "clientInfo": {"name": "mcp_tools", "version": "1"}}})
   151	        resp = read_response(1, timeout)
   152	        if not resp:
   153	            return {"error": "no answer to initialize within %.0fs" % timeout}
   154	        init = resp.get("result") or {}
   155	
   156	        send({"jsonrpc": "2.0", "method": "notifications/initialized"})
   157	        send({"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}})
   158	        resp = read_response(2, timeout)
   159	        if resp is None:
   160	            return {"serverInfo": init.get("serverInfo"),
   161	                    "error": "initialize answered but tools/list did not, within %.0fs. This is "
   162	                             "NOT an empty tool list. A server that gates tool access behind an "
   163	                             "approval dialog blocks here until the dialog is answered — check "
   164	                             "for one before believing anything about this server." % timeout}
   165	        if resp == "":
   166	            return {"serverInfo": init.get("serverInfo"),
   167	                    "error": "the server closed its output after initialize rather than answering "
   168	                             "tools/list%s" % (
   169	                                 " — its stderr said: %s" % " ".join(stderr_lines)[-300:]
   170	                                 if stderr_lines else "")}
   171	        tools = (resp.get("result") or {}).get("tools")
   172	        if tools is None:
   173	            return {"serverInfo": init.get("serverInfo"),
   174	                    "error": "tools/list returned no result field: %s" % json.dumps(resp)[:200]}
   175	        return {"serverInfo": init.get("serverInfo"), "tools": tools}
   176	    finally:
   177	        p.kill()
   178	        p.wait()                     # reap — a zombie per probe adds up in a long session
   179	
   180	
   181	def describe(info):
   182	    si = info.get("serverInfo") or {}
   183	    return "%s %s" % (si.get("name", "?"), si.get("version", "?"))
   184	
   185	
   186	def cmd_list(a):
   187	    servers = load_servers(a.config)
   188	    if a.server not in servers:
   189	        sys.exit("mcp_tools: %r is not in %s (have: %s)"
   190	                 % (a.server, a.config, ", ".join(sorted(servers))))
   191	    info = probe(a.server, servers[a.server], a.timeout)
   192	    if "error" in info and "tools" not in info:
   193	        print("%s: %s" % (a.server, info["error"]), file=sys.stderr)
   194	        return 2
   195	    print("%s  —  %s  —  %d tools" % (a.server, describe(info), len(info["tools"])))
   196	    for t in sorted(info["tools"], key=lambda t: t.get("name", "")):
   197	        desc = " ".join((t.get("description") or "").split())
   198	        print("  %-34s %s" % (t.get("name"), desc[:110]))
   199	    return 0
   200	
   201	
   202	def _norm(name):
   203	    """window_close, close_window and closeWindow all reduce to the same token bag.
   204	
   205	    Deliberately crude. It exists to catch the word-order and separator variants that two
   206	    independently written servers produce for the same job — Jonathan's example was window_open
   207	    against open_window — and it is not pretending to find semantic matches. That is what the
   208	    optional model pass is for, and the two must not be confused for each other.
   209	    """
   210	    out = []
   211	    for ch in name:
   212	        if ch in "_-. ":
   213	            out.append(" ")
   214	        elif ch.isupper():
   215	            out.append(" " + ch.lower())
   216	        else:
   217	            out.append(ch)
   218	    return frozenset(w for w in "".join(out).split() if w)
   219	
   220	
   221	def cmd_compare(a):
   222	    servers = load_servers(a.config)
   223	    for want in (a.server, a.against):
   224	        if want not in servers:
   225	            sys.exit("mcp_tools: %r is not in %s (have: %s)"
   226	                     % (want, a.config, ", ".join(sorted(servers))))
   227	    left = probe(a.server, servers[a.server], a.timeout)
   228	    right = probe(a.against, servers[a.against], a.timeout)
   229	
   230	    failed = False
   231	    for nm, info in ((a.server, left), (a.against, right)):
   232	        if "tools" not in info:
   233	            print("%s: %s" % (nm, info.get("error")), file=sys.stderr)
   234	            failed = True
   235	    if failed:
   236	        print("\nRefusing to compare. A server whose tools could not be listed would show up as "
   237	              "having no overlaps, which reads as 'no collisions' and is the opposite of what is "
   238	              "known.", file=sys.stderr)
   239	        return 2
   240	
   241	    lnames = {t.get("name") for t in left["tools"]}
   242	    rnames = {t.get("name") for t in right["tools"]}
   243	    print("%s  —  %s  —  %d tools" % (a.server, describe(left), len(lnames)))
   244	    print("%s  —  %s  —  %d tools" % (a.against, describe(right), len(rnames)))
   245	
   246	    exact = sorted(lnames & rnames)
   247	    print("\nEXACT NAME COLLISIONS: %d" % len(exact))
   248	    for n in exact:
   249	        print("  %s" % n)
   250	
   251	    lmap = {}
   252	    for t in left["tools"]:
   253	        lmap.setdefault(_norm(t.get("name", "")), []).append(t.get("name"))
   254	    near = []
   255	    for t in right["tools"]:
   256	        key = _norm(t.get("name", ""))
   257	        for other in lmap.get(key, []):
   258	            if other != t.get("name"):
   259	                near.append((other, t.get("name")))
   260	    print("\nSAME WORDS, DIFFERENT ORDER OR SEPARATOR: %d" % len(near))
   261	    for l, r in sorted(near):
   262	        print("  %-34s %s" % (l, r))
   263	
   264	    print("\nThese are the collisions STRING COMPARISON can find. Two tools that do the same job "
   265	          "under unrelated names will not appear above; use --summarize for that pass.")
   266	
   267	    if a.summarize:
   268	        payload = ["Server A: %s" % describe(left)]
   269	        for t in sorted(left["tools"], key=lambda t: t.get("name", "")):
   270	            payload.append("  A %s: %s" % (t.get("name"), " ".join((t.get("description") or "").split())[:200]))
   271	        payload.append("Server B: %s" % describe(right))
   272	        for t in sorted(right["tools"], key=lambda t: t.get("name", "")):
   273	            payload.append("  B %s: %s" % (t.get("name"), " ".join((t.get("description") or "").split())[:200]))
   274	        prompt = ("Below are the tools of two MCP servers that are about to be merged behind one "
   275	                  "surface. List pairs that do substantially the same job and would confuse a "
   276	                  "caller if both were offered, naming which one looks better suited and why in "
   277	                  "one sentence. Ignore pairs that merely share words but do different work. Be "
   278	                  "specific and short; do not restate tools that have no counterpart.")
   279	        # The prompt is positional in this CLI. `llm -p` is the codex/qwen convention and is not
   280	        # a prompt flag here; using it silently sends the wrong thing.
   281	        proc = subprocess.run(["llm", prompt], input="\n".join(payload),
   282	                              capture_output=True, text=True)
   283	        print("\n=== possible semantic collisions, per %s ===" % (
   284	            subprocess.run(["llm", "models", "default"], capture_output=True, text=True).stdout.strip() or "llm"))
   285	        if proc.returncode != 0:
   286	            print("  llm failed (%d): %s" % (proc.returncode, (proc.stderr or "").strip()[:300]))
   287	            return 2
   288	        print(proc.stdout.strip())
   289	    return 0
   290	
   291	
   292	def main():
   293	    ap = argparse.ArgumentParser()
   294	    sub = ap.add_subparsers(dest="cmd", required=True)
   295	
   296	    l = sub.add_parser("list", help="list one server's tools")
   297	    l.add_argument("--config", required=True)
   298	    l.add_argument("--server", required=True)
   299	    l.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
   300	    l.set_defaults(fn=cmd_list)
   301	
   302	    c = sub.add_parser("compare", help="compare two servers for collisions")
   303	    c.add_argument("--config", required=True)
   304	    c.add_argument("--server", required=True)
   305	    c.add_argument("--against", required=True)
   306	    c.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
   307	    c.add_argument("--summarize", action="store_true",
   308	                   help="hand both lists to the default llm model for a semantic pass")
   309	    c.set_defaults(fn=cmd_compare)
   310	
   311	    a = ap.parse_args()
   312	    return a.fn(a)
   313	
   314	
   315	if __name__ == "__main__":
   316	    sys.exit(main())
FILE ../lib/template.py
     1	#!/usr/bin/env python3
     2	"""
     3	template.py — install a NAMED GROUP of astra tools into a repo.
     4	
     5	The middle layer Jonathan described on 2026-08-18: "templates for installing
     6	groups of these tools that are fit for a particular kind of project, a middle
     7	level where we can say the mhm project(s) has the swift and iOS stuff installed
     8	via a template for that along with the writing tools. Whereas the legal repos
     9	have the pdf to text stuff and the writing stuff."
    10	
    11	    template.py list
    12	    template.py show <name>
    13	    template.py install   <name> --into <repo>
    14	    template.py uninstall <name> --into <repo>
    15	    template.py status --into <repo>
    16	
    17	TWO PROPERTIES THAT ARE NOT NEGOTIABLE
    18	--------------------------------------
    19	NON-EXCLUSIVE. Installing a template ADDS its tools. It never removes anything
    20	another template put there, and two templates may overlap freely — the legal and
    21	Maharam sets both want the writing tools, and installing one after the other must
    22	leave both intact. Uninstall removes only what that template names, so a shared
    23	tool survives until the last template needing it is gone. Anything else would
    24	make the second install silently break the first.
    25	
    26	NEVER GLOBAL. Templates delegate to each tool's own install.sh --into <repo>,
    27	and those already refuse a target under $HOME, ~/.claude, ~/.agents, ~/.config or
    28	~/Library. The global installs that had accumulated were removed on 2026-08-18
    29	and nothing here may recreate one.
    30	
    31	Templates are DATA (templates.json), not code, so adding one is an edit rather
    32	than a patch. Every tool a template names must have its own install.sh and
    33	uninstall.sh — that is what made splitting the MCP bundle into seven small tools
    34	the prerequisite for this layer.
    35	"""
    36	import json
    37	import os
    38	import subprocess
    39	import sys
    40	from pathlib import Path
    41	
    42	ASTRA = Path(__file__).resolve().parent.parent.parent
    43	TOOLS = ASTRA / "tools"
    44	# ASTRA_TEMPLATES_JSON exists for the tests: they need a template whose member is
    45	# guaranteed to fail without editing the real catalogue. Tools still resolve from the
    46	# real tools/ tree either way.
    47	TEMPLATES = Path(os.environ.get("ASTRA_TEMPLATES_JSON") or (TOOLS / "lib" / "templates.json"))
    48	
    49	
    50	def load():
    51	    try:
    52	        return json.loads(TEMPLATES.read_text())
    53	    except FileNotFoundError:
    54	        return {"templates": {}}
    55	
    56	
    57	def resolve_tools(templates, name, _stack=None):
    58	    """The COMPOSED tool list: this template's own tools plus its member templates',
    59	    transitively, in member-first order, deduplicated. Composition is the mechanism the
    60	    whole design rests on (SPEC: a Mac+Swift template is simply its members) — so a
    61	    cycle and an unknown member are loud, named refusals, never a silent partial
    62	    install. Raises ValueError; callers print it and exit 65."""
    63	    _stack = _stack or []
    64	    if name in _stack:
    65	        raise ValueError("template cycle: " + " -> ".join(_stack + [name]))
    66	    meta = templates.get(name)
    67	    if meta is None:
    68	        suffix = f" (member of '{_stack[-1]}')" if _stack else ""
    69	        raise ValueError(f"no such template: {name}{suffix}")
    70	    tools = []
    71	    for member in meta.get("templates", []):
    72	        for t in resolve_tools(templates, member, _stack + [name]):
    73	            if t not in tools:
    74	                tools.append(t)
    75	    for t in meta.get("tools", []):
    76	        if t not in tools:
    77	            tools.append(t)
    78	    return tools
    79	
    80	
    81	def tool_dir(name):
    82	    d = TOOLS / name
    83	    return d if d.is_dir() else None
    84	
    85	
    86	def run_tool(name, verb, repo):
    87	    """Delegate to the tool's own installer. Missing tools are LOUD.
    88	
    89	    A template that silently skips a tool it names would report success while
    90	    installing less than it claimed — the same shape as a test that passes
    91	    against a broken implementation."""
    92	    d = tool_dir(name)
    93	    if d is None:
    94	        return False, f"no such tool: tools/{name}"
    95	    script = d / f"{verb}.sh"
    96	    if not script.exists():
    97	        return False, f"tools/{name} has no {verb}.sh (every template member needs one)"
    98	    try:
    99	        r = subprocess.run([str(script), "--into", str(repo)],
   100	                           capture_output=True, text=True, timeout=300)
   101	        if r.returncode != 0:
   102	            tail = (r.stderr or r.stdout or "").strip().splitlines()
   103	            return False, (tail[-1] if tail else f"exit {r.returncode}")
   104	        return True, ""
   105	    except Exception as e:
   106	        return False, f"{e}"
   107	
   108	
   109	def state_path(repo):
   110	    """Template state lives in the SAME file as tool state.
   111	
   112	    It used to sit in its own .astra-templates.json at the repo root, which made
   113	    two files that had to agree about one repo and gave no reason they would.
   114	    Everything a repo knows about its astra install now lives in
   115	    .astra/manifest.json.
   116	    """
   117	    return Path(repo) / ".astra" / "manifest.json"
   118	
   119	
   120	def _read_state(repo):
   121	    p = state_path(repo)
   122	    try:
   123	        return json.loads(p.read_text())
   124	    except FileNotFoundError:
   125	        # Genuinely nothing installed. A legitimate empty answer.
   126	        legacy = Path(repo) / ".astra-templates.json"
   127	        if legacy.exists():
   128	            try:
   129	                old = json.loads(legacy.read_text()).get("installed", [])
   130	                return {"templates": sorted(old)}
   131	            except Exception:
   132	                pass
   133	        return {}
   134	    except Exception as e:
   135	        # NOT the same as "nothing installed", and the difference is the whole
   136	        # non-exclusive property. installed_templates() used to swallow every
   137	        # error into an empty list, so a corrupt or hand-edited state file made
   138	        # uninstall believe no other template claimed anything — and it would
   139	        # then remove tools a second, still-installed template needed. Refuse.
   140	        print(f"{p} is unreadable ({e}). Refusing to act on template state we "
   141	              f"cannot read, because reading it as empty would let uninstall "
   142	              f"remove tools another template still needs.", file=sys.stderr)
   143	        sys.exit(65)
   144	
   145	
   146	def installed_templates(repo):
   147	    return _read_state(repo).get("templates", [])
   148	
   149	
   150	def record_template(repo, name, add=True):
   151	    data = _read_state(repo)
   152	    cur = list(data.get("templates", []))
   153	    if add and name not in cur:
   154	        cur.append(name)
   155	    if not add and name in cur:
   156	        cur.remove(name)
   157	    data["templates"] = sorted(cur)
   158	    p = state_path(repo)
   159	    p.parent.mkdir(parents=True, exist_ok=True)
   160	    # Write beside and rename: a half-written manifest is exactly the corrupt
   161	    # state the refusal above exists to catch, and there is no reason to
   162	    # manufacture it ourselves.
   163	    tmp = p.with_suffix(".json.tmp")
   164	    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
   165	    os.replace(tmp, p)
   166	    # Retire the old sidecar file once its contents are safely carried over.
   167	    legacy = Path(repo) / ".astra-templates.json"
   168	    if legacy.exists():
   169	        legacy.unlink()
   170	
   171	
   172	def tools_still_claimed(repo, excluding):
   173	    """Tools that templates OTHER than `excluding` still need in this repo.
   174	
   175	    This is the whole non-exclusive property. Without it, uninstalling
   176	    kicker-dev removed mcp-xcode and mcp-mac-control-mcp — both still required
   177	    by swift-ios, which was installed and working. Caught by the overlap test on
   178	    2026-08-18, which is exactly what that test exists for."""
   179	    t = load()["templates"]
   180	    claimed = set()
   181	    for name in installed_templates(repo):
   182	        if name == excluding:
   183	            continue
   184	        try:
   185	            # Claims are TRANSITIVE: a composed template claims its members' tools, or
   186	            # uninstalling a sibling would remove tools the wrapper still needs.
   187	            claimed.update(resolve_tools(t, name))
   188	        except ValueError:
   189	            # A recorded template the catalogue no longer resolves still claims its
   190	            # FLAT list — under-claiming here is what deletes another template's tools.
   191	            claimed.update(t.get(name, {}).get("tools", []))
   192	    return claimed
   193	
   194	
   195	def cmd_list(_):
   196	    t = load()["templates"]
   197	    if not t:
   198	        print("no templates defined")
   199	        return 0
   200	    for name, meta in sorted(t.items()):
   201	        print(f"── {name}")
   202	        print(f"     {meta.get('description','')}")
   203	        if meta.get("templates"):
   204	            print(f"     members: {', '.join(meta['templates'])}")
   205	            try:
   206	                print(f"     tools (resolved): {', '.join(resolve_tools(t, name))}")
   207	            except ValueError as e:
   208	                print(f"     tools (UNRESOLVABLE): {e}")
   209	        else:
   210	            print(f"     tools: {', '.join(meta.get('tools', []))}")
   211	    return 0
   212	
   213	
   214	def cmd_show(args):
   215	    name = args[0] if args else ""
   216	    templates = load()["templates"]
   217	    meta = templates.get(name)
   218	    if not meta:
   219	        print(f"no such template: {name}")
   220	        return 66
   221	    print(json.dumps(meta, indent=2))
   222	    try:
   223	        resolved = resolve_tools(templates, name)
   224	    except ValueError as e:
   225	        print(f"template.py: {e}", file=sys.stderr)
   226	        return 65
   227	    if meta.get("templates"):
   228	        print(f"resolved tools (own + member templates): {', '.join(resolved)}")
   229	    return 0
   230	
   231	
   232	def _target(args):
   233	    if "--into" not in args:
   234	        print("usage: template.py <cmd> <name> --into <repo>", file=sys.stderr)
   235	        sys.exit(64)
   236	    repo = Path(args[args.index("--into") + 1]).expanduser()
   237	    if not repo.is_dir():
   238	        print(f"no such directory: {repo}", file=sys.stderr)
   239	        sys.exit(66)
   240	    return repo
   241	
   242	
   243	def _apply(verb, args):
   244	    name = args[0] if args and not args[0].startswith("-") else ""
   245	    templates = load()["templates"]
   246	    meta = templates.get(name)
   247	    if not meta:
   248	        print(f"no such template: {name}", file=sys.stderr)
   249	        return 66
   250	    try:
   251	        member_tools = resolve_tools(templates, name)
   252	    except ValueError as e:
   253	        print(f"template.py: {e}", file=sys.stderr)
   254	        return 65
   255	    repo = _target(args)
   256	
   257	    # UNINSTALL ONLY WHAT THE RECORD SAYS IS INSTALLED.
   258	    #
   259	    # tools_still_claimed() answers "what do the OTHER installed templates
   260	    # need" by reading the record. If the record has been deleted, truncated or
   261	    # hand-edited, that question comes back empty and uninstall happily removes
   262	    # tools a second, still-installed template depends on. The corrupt case is
   263	    # refused when the file is read; this catches the deleted one, and it does
   264	    # so without guessing at what is installed by inspecting the filesystem —
   265	    # which cannot work anyway, since MCP templates write .mcp.json rather than
   266	    # a directory of their own.
   267	    #
   268	    # Being asked to remove something no record mentions is suspicious on its
   269	    # own terms. Say so rather than acting on an empty list.
   270	    if verb == "uninstall" and name not in installed_templates(repo):
   271	        print(f"'{name}' is not recorded as installed in {repo}.", file=sys.stderr)
   272	        print(f"  Refusing, because deciding what to remove means asking which "
   273	              f"OTHER templates still need each tool, and that question cannot "
   274	              f"be answered from a record that does not list this one.",
   275	              file=sys.stderr)
   276	        print(f"  Recorded: {', '.join(installed_templates(repo)) or '(none)'}",
   277	              file=sys.stderr)
   278	        return 65
   279	
   280	    ok_n = fail_n = kept_n = 0
   281	    print(f"{verb}ing template '{name}' -> {repo}")
   282	    keep = tools_still_claimed(repo, name) if verb == "uninstall" else set()
   283	    for t in member_tools:
   284	        if t in keep:
   285	            others = [n for n in installed_templates(repo) if n != name
   286	                      and t in resolve_tools(load()["templates"], n)]
   287	            print(f"  KEPT    {t} — still required by: {', '.join(others)}")
   288	            kept_n += 1
   289	            continue
   290	        ok, why = run_tool(t, verb, repo)
   291	        if ok:
   292	            print(f"  {verb}ed  {t}")
   293	            ok_n += 1
   294	        else:
   295	            print(f"  FAILED  {t}: {why}")
   296	            fail_n += 1
   297	    # ONLY A CLEAN RUN CHANGES THE RECORD. Recording an install whose members failed
   298	    # would claim tools this template never placed; unrecording an uninstall whose
   299	    # members failed would orphan the tools that remain. Installers are idempotent
   300	    # re-runs, so the remedy for a partial failure is: fix the cause, run the same verb
   301	    # again, and the record changes when the run is clean. (Found by the round-one
   302	    # colloquium, codex leg — record_template ran unconditionally here.)
   303	    if fail_n == 0:
   304	        record_template(repo, name, add=(verb == "install"))
   305	    else:
   306	        print(f"NOT recording this {verb}: {fail_n} member(s) failed, and the record "
   307	              f"must describe what actually happened. Fix the failure and re-run "
   308	              f"(installers are idempotent).", file=sys.stderr)
   309	    extra = f", {kept_n} kept (shared with another template)" if kept_n else ""
   310	    print(f"\n{ok_n} ok, {fail_n} failed{extra}")
   311	    return 1 if fail_n else 0
   312	
   313	
   314	def cmd_install(args):
   315	    return _apply("install", args)
   316	
   317	
   318	def cmd_uninstall(args):
   319	    return _apply("uninstall", args)
   320	
   321	
   322	def cmd_status(args):
   323	    """Which templates are fully present in a repo?"""
   324	    repo = _target(args)
   325	    mcp = {}
   326	    f = repo / ".mcp.json"
   327	    if f.exists():
   328	        try:
   329	            mcp = json.loads(f.read_text()).get("mcpServers", {})
   330	        except Exception:
   331	            pass
   332	    print(f"repo: {repo}")
   333	    print(f"  MCP servers present: {', '.join(sorted(mcp)) or 'none'}")
   334	    templates = load()["templates"]
   335	    for name, meta in sorted(templates.items()):
   336	        try:
   337	            resolved = resolve_tools(templates, name)
   338	        except ValueError:
   339	            resolved = meta.get("tools", [])
   340	        want = [t for t in resolved if t.startswith("mcp-")]
   341	        have = [t for t in want if t.replace("mcp-", "", 1) in mcp]
   342	        if want:
   343	            state = "complete" if len(have) == len(want) else (
   344	                "partial" if have else "absent")
   345	            print(f"  {name:<14} {state:<9} ({len(have)}/{len(want)} mcp tools)")
   346	    return 0
   347	
   348	
   349	def main():
   350	    cmds = {"list": cmd_list, "show": cmd_show, "install": cmd_install,
   351	            "uninstall": cmd_uninstall, "status": cmd_status}
   352	    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
   353	        print(f"usage: template.py {{{'|'.join(cmds)}}} [name] [--into <repo>]")
   354	        return 64
   355	    return cmds[sys.argv[1]](sys.argv[2:])
   356	
   357	
   358	if __name__ == "__main__":
   359	    sys.exit(main())
