    19	cat > "$SB/bin/ssh" <<SHIM
    20	#!/usr/bin/env bash
    21	[ -f "$SB/host_down" ] && exit 255
    22	# last argument is the remote command; evaluate it for real under the fake remote home
    23	for cmd in "\$@"; do :; done
    24	HOME="$REMOTE" bash -c "\$cmd"
