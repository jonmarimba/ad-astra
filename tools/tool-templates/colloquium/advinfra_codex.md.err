     1	#!/usr/bin/env python3
     2	"""tooljson.py — the reader for tools/*/tool.json (Phase 6.1 of the tool-template work).
     3	
     4	Seven descriptors existed for weeks with NOTHING reading them (INVENTORY.md, 2026-08-31:
     5	"seven carry a tool.json descriptor... and nothing reads those files"). This converts
     6	them into a validated registry: every descriptor either parses into a known shape or
     7	fails naming what is wrong. The roadmap's rule for the schema: build on what exists, do
     8	not invent a third format.
     9	
    10	THE SHAPE
    11	---------
    12	Required: name (must equal the tool's directory name), description, provides,
    13	dependencies (a list). provides == "mcp-server" additionally requires server (the MCP
    14	server key the tool configures). Optional: backed_by (an astra-relative path that must
    15	exist).
    16	
    17	DEPENDENCIES ARE DECLARED BY ECOSYSTEM — "eco:coordinate" strings:
    18	    brew:jq           npm:ios-simulator-mcp      uv:drews-xcode-mcp
    19	    human:Full Disk Access for Mail
    20	The human class is real and first-class on this machine: xcode-mcp-front needs an
    21	Automator .app, a launchd plist, and TCC grants a person clicks. A brew-only model
    22	under-declares more than half of what is here, silently (ROADMAP phase 6). Bare legacy
    23	tokens (claude, uvx, xcrun, node_npx, mac_control_mcp) are ACCEPTED and reported on
    24	stderr, so existing descriptors keep validating while getting nudged toward migration;
    25	an unknown "eco:" prefix is an error, because a typo'd ecosystem is a dependency that
    26	never installs.
    27	
    28	THIRD-PARTY ADOPTION (optional trio): source (coordinate), version (pin), digest
    29	(artifact hash). source requires version — a coordinate without a pin is an
    30	unrepeatable install; digest is recommended and validated as a string when present.
    31	
    32	CLI:
    33	    tooljson.py list                 validate every tools/*/tool.json; table to stdout
    34	    tooljson.py validate <file|dir>  one descriptor; rc 65 with a named reason
    35	    tooljson.py deps <tool-name>     dependencies grouped by ecosystem
    36	Runs on python3 >= 3.9 (the system interpreter runs the tests and any scheduled job).
    37	"""
    38	import json
    39	import os
    40	import sys
    41	from pathlib import Path
    42	
    43	ASTRA = Path(__file__).resolve().parent.parent.parent
    44	TOOLS = ASTRA / "tools"
    45	
    46	KNOWN_ECOSYSTEMS = ("brew", "npm", "uv", "human")
    47	# Bare tokens the seven pre-existing descriptors use. Accepted, reported, not grown:
    48	# a NEW bare token is an error, so the legacy set only ever shrinks.
    49	LEGACY_TOKENS = frozenset({"claude", "uvx", "xcrun", "node_npx", "mac_control_mcp"})
    50	REQUIRED = ("name", "description", "provides", "dependencies")
    51	KNOWN_FIELDS = frozenset({"name", "server", "description", "dependencies", "provides",
    52	                          "backed_by", "source", "version", "digest"})
    53	
    54	
    55	class DescriptorError(ValueError):
    56	    pass
    57	
    58	
    59	def parse(path, expect_dirname=None):
    60	    """-> dict descriptor. Raises DescriptorError with a named reason. Legacy
    61	    dependency tokens are collected under key '_legacy' and reported by the caller."""
    62	    path = Path(path)
    63	    try:
    64	        raw = path.read_text(encoding="utf-8")
    65	    except OSError as e:
    66	        raise DescriptorError("cannot read %s (%s)" % (path, e))
    67	    try:
    68	        d = json.loads(raw)
    69	    except ValueError as e:
    70	        raise DescriptorError("%s is not valid JSON (%s)" % (path, e))
    71	    if not isinstance(d, dict):
    72	        raise DescriptorError("%s: a descriptor is an object" % path)
    73	
    74	    for field in d:
    75	        if field not in KNOWN_FIELDS:
    76	            raise DescriptorError("%s: unknown field '%s'" % (path, field))
    77	    for field in REQUIRED:
    78	        if field not in d:
    79	            raise DescriptorError("%s has no '%s'" % (path, field))
    80	
    81	    name = d["name"]
    82	    if not isinstance(name, str) or not name:
    83	        raise DescriptorError("%s has no 'name' (non-empty string required)" % path)
    84	    dirname = expect_dirname or path.parent.name
    85	    if name != dirname:
    86	        raise DescriptorError(
    87	            "%s: name '%s' does not match its directory '%s' — the directory is the "
    88	            "identity everything else keys on" % (path, name, dirname))
    89	
    90	    if not isinstance(d["description"], str) or not d["description"].strip():
    91	        raise DescriptorError("%s has no 'description' text" % path)
    92	
    93	    provides = d["provides"]
    94	    if not isinstance(provides, str) or not provides:
    95	        raise DescriptorError("%s has no 'provides'" % path)
    96	    if provides == "mcp-server" and not d.get("server"):
    97	        raise DescriptorError(
    98	            "%s provides 'mcp-server' but names no 'server' — the MCP server key is "
    99	            "what installers configure" % path)
   100	
   101	    deps = d["dependencies"]
   102	    if not isinstance(deps, list) or not all(isinstance(x, str) for x in deps):
   103	        raise DescriptorError("%s: 'dependencies' must be a list of strings" % path)
   104	    grouped = {eco: [] for eco in KNOWN_ECOSYSTEMS}
   105	    legacy = []
   106	    for dep in deps:
   107	        eco, sep, coord = dep.partition(":")
   108	        if sep:
   109	            if eco not in KNOWN_ECOSYSTEMS:
   110	                raise DescriptorError(
   111	                    "%s: unknown dependency ecosystem '%s' in '%s' (known: %s)"
   112	                    % (path, eco, dep, ", ".join(KNOWN_ECOSYSTEMS)))
   113	            if not coord:
   114	                raise DescriptorError("%s: dependency '%s' names no coordinate" % (path, dep))
   115	            grouped[eco].append(coord)
   116	        elif dep in LEGACY_TOKENS:
   117	            legacy.append(dep)
   118	        else:
   119	            raise DescriptorError(
   120	                "%s: bare dependency '%s' is neither ecosystem-qualified (eco:coordinate) "
   121	                "nor a known legacy token (%s)" % (path, dep, ", ".join(sorted(LEGACY_TOKENS))))
   122	
   123	    backed_by = d.get("backed_by")
   124	    if backed_by is not None:
   125	        if not isinstance(backed_by, str):
   126	            raise DescriptorError("%s: 'backed_by' must be a string path" % path)
   127	        if not (ASTRA / backed_by).exists():
   128	            raise DescriptorError("%s: backed_by '%s' does not exist under %s"
   129	                                  % (path, backed_by, ASTRA))
   130	
   131	    for field in ("source", "version", "digest"):
   132	        if field in d and not isinstance(d[field], str):
   133	            raise DescriptorError("%s: '%s' must be a string" % (path, field))
   134	    if d.get("source") and not d.get("version"):
   135	        raise DescriptorError(
   136	            "%s: 'source' requires 'version' — a coordinate without a pin is an "
   137	            "unrepeatable install" % path)
   138	
   139	    d["_grouped"] = grouped
   140	    d["_legacy"] = legacy
   141	    return d
   142	
   143	
   144	def load_all():
   145	    """-> (descriptors by name, error list). Reads every tools/*/tool.json."""
   146	    found, errors = {}, []
   147	    for tdir in sorted(TOOLS.iterdir()):
   148	        tj = tdir / "tool.json"
   149	        if not tdir.is_dir() or not tj.is_file():
   150	            continue
   151	        try:
   152	            found[tdir.name] = parse(tj)
   153	        except DescriptorError as e:
   154	            errors.append(str(e))
   155	    return found, errors
   156	
   157	
   158	def _report_legacy(name, legacy):
   159	    if legacy:
   160	        print("tooljson: %s uses legacy dependency token(s) %s — migrate to "
   161	              "eco:coordinate form" % (name, ", ".join(sorted(legacy))), file=sys.stderr)
   162	
   163	
   164	def cmd_list(_):
   165	    found, errors = load_all()
   166	    for e in errors:
   167	        print("tooljson: %s" % e, file=sys.stderr)
   168	    for name, d in sorted(found.items()):
   169	        eco = "; ".join("%s:%d" % (k, len(v)) for k, v in d["_grouped"].items() if v)
   170	        print("%-24s %-11s %s%s" % (name, d["provides"],
   171	                                    d["description"][:60],
   172	                                    ("  [" + eco + "]") if eco else ""))
   173	        _report_legacy(name, d["_legacy"])
   174	    print("%d descriptor(s), %d invalid" % (len(found), len(errors)))
   175	    return 65 if errors else 0
   176	
   177	
   178	def cmd_validate(args):
   179	    if not args:
   180	        print("usage: tooljson.py validate <file|dir>", file=sys.stderr)
   181	        return 64
   182	    p = Path(args[0])
   183	    if p.is_dir():
   184	        p = p / "tool.json"
   185	    try:
   186	        d = parse(p)
   187	    except DescriptorError as e:
   188	        print("tooljson: %s" % e, file=sys.stderr)
   189	        return 65
   190	    _report_legacy(d["name"], d["_legacy"])
   191	    print("%s: valid (%s)" % (d["name"], d["provides"]))
   192	    for eco in KNOWN_ECOSYSTEMS:
   193	        for coord in d["_grouped"][eco]:
   194	            print("  %s: %s" % (eco, coord))
   195	    for tok in d["_legacy"]:
   196	        print("  legacy: %s" % tok)
   197	    return 0
   198	
   199	
   200	def cmd_deps(args):
   201	    if not args:
   202	        print("usage: tooljson.py deps <tool-name>", file=sys.stderr)
   203	        return 64
   204	    found, errors = load_all()
   205	    d = found.get(args[0])
   206	    if d is None:
   207	        print("tooljson: no valid descriptor for '%s' (have: %s)"
   208	              % (args[0], ", ".join(sorted(found))), file=sys.stderr)
   209	        return 66
   210	    for eco in KNOWN_ECOSYSTEMS:
   211	        for coord in d["_grouped"][eco]:
   212	            print("%s: %s" % (eco, coord))
   213	    for tok in d["_legacy"]:
   214	        print("legacy: %s" % tok)
   215	    return 0
   216	
   217	
   218	def main():
   219	    cmds = {"list": cmd_list, "validate": cmd_validate, "deps": cmd_deps}
   220	    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
   221	        print("usage: tooljson.py {list|validate|deps} [...]", file=sys.stderr)
   222	        return 64
   223	    return cmds[sys.argv[1]](sys.argv[2:])
   224	
   225	
   226	if __name__ == "__main__":
   227	    sys.exit(main())
FILE ponytail real installer
     1	#!/usr/bin/env bash
     2	# install-into-repo.sh — put the ponytail skill (DietrichGebert/ponytail: "the laziest senior
     3	# dev" decision ladder — does this need to exist? stdlib? platform? existing dep? one line?)
     4	# into ONE repo's .claude/skills/, repo-level. Which-first: skips if already present.
     5	#   install-into-repo.sh <repo-path>     ·  uninstall: rm -rf <repo>/.claude/skills/ponytail
     6	set -euo pipefail
     7	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
     8	REPO="${1:?usage: install-into-repo.sh <repo-path>}"
     9	[ -d "$REPO" ] || { echo "install-into-repo.sh: no such directory: $REPO" >&2; exit 1; }
    10	BASE="https://raw.githubusercontent.com/DietrichGebert/ponytail/main/skills"
    11	for skill in ponytail ponytail-audit; do
    12	  DEST="$REPO/.claude/skills/$skill"
    13	  if [ -f "$DEST/SKILL.md" ]; then echo "already installed: $DEST"; continue; fi
    14	  mkdir -p "$DEST"
    15	  curl -fsSL "$BASE/$skill/SKILL.md" -o "$DEST/SKILL.md"
    16	  grep -q "name:" "$DEST/SKILL.md" && echo "installed: $DEST/SKILL.md" || { echo "download looks wrong — inspect $DEST/SKILL.md"; exit 1; }
    17	done
FILE test dedup
     1	#!/usr/bin/env bash
     2	# test-dedup-scan.sh — the graph miner (step 2) against a fixture graph.json exercising
     3	# every filter: no-edge same-surface pairs surface, linked files don't, test files and
     4	# non-code files don't, sub-majority overlaps don't. Steps 1 (periphery, needs a real
     5	# Swift repo) and 3 (claude judgment) are exercised by the real kicker/pot-mhm runs, not
     6	# here — this file tests the miner and says so (names don't overclaim).
     7	HERE="$(cd "$(dirname "$0")" && pwd)"; . "$HERE/lib.sh"
     8	DS="$HERE/../dedup-scan/dedup-scan"
     9	need python3 "xcode-select --install"
    10	
    11	REPO="$SB/repo"; mkdir -p "$REPO/graphify-out"
    12	python3 - "$REPO/graphify-out/graph.json" <<'PY'
    13	import json, sys
    14	# helpers h1..h3 + files: a.py and b.py share the full surface with NO edge between them
    15	# (the duplicate pair); c.py shares it but LINKS to a.py (knows about it — not a dup);
    16	# tests/test_a.py and doc.md share it but must be filtered by kind
    17	nodes = [{"id": f"h{i}", "label": f"helper_{i}", "source_file": "helpers.py"} for i in (1,2,3)]
    18	edges = []
    19	for f in ("a.py","b.py","c.py","tests/test_a.py","doc.md"):
    20	    nid = "f_" + f
    21	    nodes.append({"id": nid, "label": f, "source_file": f})
    22	    for i in (1,2,3):
    23	        edges.append({"source": nid, "target": f"h{i}"})
    24	edges.append({"source": "f_c.py", "target": "f_a.py"})   # c knows about a
    25	json.dump({"nodes": nodes, "edges": edges}, open(sys.argv[1], "w"))
    26	PY
    27	
    28	assert_rc 0 "miner runs (--no-llm)" "$DS" "$REPO" --no-llm --min-shared 3
    29	R="$REPO/graphify-out/DEDUP_REPORT.md"
    30	assert_file "$R" "report written"
    31	grep -q "a.py" "$R" && grep -q "b.py" "$R" && pass "unlinked same-surface pair (a.py, b.py) surfaced" || fail "the real duplicate pair is missing from the report"
    32	line="$(grep -F "a.py" "$R" | grep -F "b.py" | head -1)"
    33	assert_nonempty "$line" "a.py and b.py reported as one PAIR"
    34	grep -F "c.py" "$R" | grep -qF "a.py" && fail "linked pair (c.py knows a.py) wrongly surfaced" || pass "linked files not reported as duplicates"
    35	assert_not_contains "$R" "test_a.py" "test file excluded from candidates"
    36	assert_not_contains "$R" "doc.md" "non-code file excluded from candidates"
    37	
    38	# ---- RED controls ----
    39	mkdir -p "$SB/empty-repo"
    40	red "missing graph.json must fail with the pointer to graphify-repo" 1 "no graphify-out/graph.json — run graphify-repo first" "$DS" "$SB/empty-repo" --no-llm
    41	red "typo'd flag must error, not run with defaults" 64 "unknown argument '--no-lm'" "$DS" "$REPO" --no-lm
    42	red "missing repo arg must fail" 1 "usage: dedup-scan <repo>" "$DS"
    43	
    44	finish
FILE uninstall tests
     1	#!/usr/bin/env bash
     2	# test-uninstall-common.sh — the shared uninstall contract, proved BY EFFECT through the two real
     3	# uninstallers (frame-review, geo-evidence): plain run dis-integrates local state and LEAVES shared
     4	# deps alone; --deps removes them. Dep removal is captured by a stub at the $BREW_BIN/$UV_BIN seam,
     5	# so the real ffmpeg/exiftool/osxphotos are never touched.
     6	HERE="$(cd "$(dirname "$0")" && pwd)"; . "$HERE/lib.sh"
     7	FR="$HERE/../frame-review/uninstall.sh"
     8	GEO="$HERE/../geo-evidence/uninstall.sh"
     9	
    10	# a stub that records every invocation (one line per call) — stands in for brew AND uv
    11	STUB="$SB/toolstub"; LOG="$SB/toolstub.log"
    12	cat > "$STUB" <<EOF
    13	#!/usr/bin/env bash
    14	echo "\$@" >> "$LOG"
    15	EOF
    16	chmod +x "$STUB"
    17	export BREW_BIN="$STUB" UV_BIN="$STUB"
    18	
    19	# ---- geo-evidence: plain uninstall removes config, does NOT touch deps ----
    20	GH="$SB/geohome"; mkdir -p "$GH"; printf 'HouseA\t1\t2\n' > "$GH/config"
    21	: > "$LOG"
    22	GEO_EVIDENCE_HOME="$GH" assert_rc 0 "geo plain uninstall succeeds" "$GEO"
    23	assert_no_file "$GH/config" "plain uninstall removed the geo config/state dir"
    24	assert_empty "$(cat "$LOG" 2>/dev/null)" "plain uninstall did NOT invoke brew/uv (deps left alone)"
    25	
    26	# ---- geo-evidence: --deps removes exiftool (brew) AND osxphotos (uv tool) ----
    27	GH2="$SB/geohome2"; mkdir -p "$GH2"; printf 'x\n' > "$GH2/config"
    28	: > "$LOG"
    29	GEO_EVIDENCE_HOME="$GH2" assert_rc 0 "geo --deps uninstall succeeds" "$GEO" --deps
    30	assert_contains "$LOG" "uninstall exiftool" "--deps removed exiftool via brew seam"
    31	assert_contains "$LOG" "tool uninstall osxphotos" "--deps removed osxphotos via uv seam"
    32	assert_no_file "$GH2/config" "--deps uninstall also removed the config dir"
    33	
    34	# ---- frame-review: plain leaves ffmpeg; --deps removes it ----
    35	: > "$LOG"
    36	assert_rc 0 "frame-review plain uninstall succeeds" "$FR"
    37	assert_empty "$(cat "$LOG" 2>/dev/null)" "frame-review plain uninstall did NOT touch ffmpeg"
    38	: > "$LOG"
    39	assert_rc 0 "frame-review --deps uninstall succeeds" "$FR" --deps
    40	assert_contains "$LOG" "uninstall ffmpeg" "frame-review --deps removed ffmpeg via brew seam"
    41	
    42	# ---- a non-symlink at a symlink slot is preserved (never delete a real file) ----
    43	. "$HERE/../lib/uninstall-common.sh"
    44	realf="$SB/realfile"; printf 'precious\n' > "$realf"
    45	uc_rm_symlink "$realf" >/dev/null
    46	assert_file "$realf" "uc_rm_symlink refused to delete a real (non-symlink) file"
    47	
    48	# ---- RED controls ----
    49	red "unknown flag must fail" 64 "unknown flag" "$GEO" --nuke-everything
    50	red "missing shared lib would break sourcing (sanity: bad path fails)" 1 "No such file or directory" bash -c '. /no/such/uninstall-common.sh'
    51	
    52	finish
FILE templates tests
     1	#!/usr/bin/env bash
     2	# Templates must be NON-EXCLUSIVE. Two templates sharing a tool must coexist, and
     3	# uninstalling one must not remove a tool the other still needs.
     4	#
     5	# This test caught the property failing on the day it was written: uninstalling
     6	# kicker-dev removed mcp-xcode and mcp-mac-control-mcp while swift-ios was
     7	# installed and using both. Keep it red-capable — it is the only thing standing
     8	# between "templates" and "the second install silently breaks the first".
     9	set -u
    10	A="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
    11	command -v jq >/dev/null || { echo "MISSING DEPENDENCY: jq"; exit 1; }
    12	T="$(mktemp -d)/repo"; git clone --quiet ~/svnCheckouts/js-llmKicker "$T" 2>/dev/null || { echo "clone failed"; exit 1; }
    13	fail=()
    14	
    15	python3 "$A/tools/lib/template.py" install swift-ios --into "$T" >/dev/null 2>&1
    16	
    17	# swift-ios carries the code-quality set (INVENTORY item 5: "an edit to one JSON file,
    18	# not a system to build" — plus the member installers that edit required).
    19	[ -f "$T/.claude/skills/ponytail/SKILL.md" ] || fail+=("swift-ios did not install the ponytail skill")
    20	[ -f "$T/.astra/dedup-scan/dedup-scan" ] || fail+=("swift-ios did not install dedup-scan")
    21	command -v periphery >/dev/null 2>&1 || fail+=("swift-ios did not ensure periphery is available")
    22	
    23	python3 "$A/tools/lib/template.py" install kicker-dev --into "$T" >/dev/null 2>&1
    24	out="$(python3 "$A/tools/lib/template.py" uninstall kicker-dev --into "$T" 2>&1)"
    25	rc=$?
    26	after="$(jq -r '.mcpServers|keys|join(",")' "$T/.mcp.json" 2>/dev/null)"
    27	
    28	for need in xcode mac-control-mcp XcodeBuildMCP ios-simulator mobile-mcp; do
    29	  echo "$after" | grep -q "$need" || fail+=("swift-ios lost $need after uninstalling an overlapping template")
    30	done
    31	echo "$after" | grep -q kickerd && fail+=("kickerd survived its own template's uninstall")
    32	echo "$out" | grep -q "KEPT" || fail+=("shared tools were not reported as KEPT")
    33	[ $rc -eq 0 ] || fail+=("uninstall exited $rc on a successful run")
    34	
    35	
    36	# ── State-file integrity ────────────────────────────────────────────────────
    37	# The overlap property above is only as good as the record it reasons from.
    38	# installed_templates() used to swallow every read error into an empty list, so
    39	# a corrupt or hand-edited state file made uninstall believe nothing else
    40	# claimed a shared tool — and it would remove tools a still-installed template
    41	# needed. Reading "I cannot tell" as "nothing installed" is the bug.
    42	
    43	echo '{"templates": ["swift-ios"], "tools":' > "$T/.astra/manifest.json"   # truncated mid-write
    44	out="$(python3 "$A/tools/lib/template.py" uninstall kicker-dev --into "$T" 2>&1)"; rc=$?
    45	if [ "$rc" -eq 65 ] && echo "$out" | grep -q "unreadable"; then
    46	  echo "  corrupt state refused instead of read as empty"
    47	else
    48	  fail+=("a corrupt manifest did not stop uninstall (rc=$rc) — it would remove tools another template still needs")
    49	fi
    50	
    51	# A deleted record with the tools still present is the same class: the repo is
    52	# not empty, so an empty list is not the answer.
    53	rm -f "$T/.astra/manifest.json"
    54	out="$(python3 "$A/tools/lib/template.py" uninstall kicker-dev --into "$T" 2>&1)"; rc=$?
    55	if [ "$rc" -eq 65 ] && echo "$out" | grep -q "not recorded as installed"; then
    56	  echo "  deleted state refused rather than acted on as an empty list"
    57	else
    58	  fail+=("a deleted manifest let uninstall run from an empty list (rc=$rc)")
    59	fi
    60	
    61	# ── A failed install is not recorded as an install ──────────────────────────
    62	# _apply() used to call record_template unconditionally after the member loop, so a
    63	# template with failed member installs was recorded as installed and claimed tools it
    64	# never placed (found by the round-one colloquium, codex leg, verified at the call
    65	# site). Installers are idempotent re-runs, so the honest record after a partial
    66	# failure is "not installed": fix the cause, re-run, and only then record.
    67	T2="$(mktemp -d)/repo"; git clone --quiet ~/svnCheckouts/js-llmKicker "$T2" 2>/dev/null || { echo "clone failed"; exit 1; }
    68	BROKEN_TPL="$(mktemp -d)/templates.json"
    69	cat > "$BROKEN_TPL" <<'EOF'
    70	{"templates": {"half-broken": {"description": "test template with a member that cannot install",
    71	  "tools": ["check-prose", "no-such-tool-astra-test"]}}}
    72	EOF
    73	out="$(ASTRA_TEMPLATES_JSON="$BROKEN_TPL" python3 "$A/tools/lib/template.py" install half-broken --into "$T2" 2>&1)"; rc=$?
    74	recorded="$(python3 -c "import json,sys; print(','.join(json.load(open('$T2/.astra/manifest.json')).get('templates',[])))" 2>/dev/null)"
    75	[ "$rc" -ne 0 ] || fail+=("an install with a failed member exited 0")
    76	echo "$out" | grep -q "FAILED  no-such-tool-astra-test" || fail+=("the failed member was not named in the output")
    77	case ",$recorded," in
    78	  *,half-broken,*) fail+=("a template with a FAILED member was recorded as installed (manifest: '$recorded')") ;;
    79	  *) echo "  failed install left no false record (manifest: '${recorded:-empty}')" ;;
    80	esac
    81	echo "$out" | grep -qi "not record" || fail+=("the output does not say the record was withheld")
    82	rm -rf "$(dirname "$T2")" "$(dirname "$BROKEN_TPL")"
    83	
    84	rm -rf "$(dirname "$T")"
    85	if [ ${#fail[@]} -eq 0 ]; then echo "templates: non-exclusive overlap holds"; exit 0; fi
    86	printf 'FAIL: %s\n' "${fail[@]}"; exit 1

