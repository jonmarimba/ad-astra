     7	ASD="$HERE/../ai-setup-diff/ai-setup-diff"
     8	
     9	LOCAL="$SB/local-home"; REMOTE="$SB/remote-home"
    10	mkdir -p "$LOCAL/.claude" "$LOCAL/.codex" "$LOCAL/.qwen" "$REMOTE/.claude" "$REMOTE/.codex"
