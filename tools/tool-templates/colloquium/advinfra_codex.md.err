   126	finish
     1	#!/usr/bin/env bash
     2	# botline — a generic two-way text bridge: ANY local bot can text Jonathan, and his replies
     3	# route back to the bot that messaged him. Minimal setup for a bot: call `botline send` and
     4	# `botline recv`. Built entirely on `imsg` (steipete/openclaw) — no GhOST dependency, portable.
     5	#
     6	#   botline send --from <bot> "text"     # texts JS's phone as "[bot] text"; marks <bot> as last-to-message
     7	#   botline dispatch                      # route JS's new replies into each bot's inbox (run on a timer)
     8	#   botline recv --as <bot> [--peek]      # print (and clear) messages waiting for <bot>
     9	#   botline register --name <bot>         # create a bot's inbox
    10	#   botline list                          # registered bots + pending counts + who JS is replying to
    11	#
    12	# Reply routing: JS's reply beginning "@<bot> ..." goes to that bot; otherwise it goes to the
    13	# LAST bot that messaged him (reply-to-last). Config (chat id / number) lives in $BOTLINE_HOME/config,
    14	# NOT hardcoded here — point it at any recipient/thread.
    15	set -uo pipefail
    16	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
    17	
    18	BOTLINE_HOME="${BOTLINE_HOME:-$HOME/.botline}"
    19	mkdir -p "$BOTLINE_HOME/inbox"
    20	CONF="$BOTLINE_HOME/config"
    21	if [ ! -f "$CONF" ]; then
    22	  cat > "$CONF" <<CFG
    23	# botline config — the recipient (Jonathan's phone via the Google Voice thread)
    24	JS_NUMBER="+17049185655"
    25	JS_CHAT_ID="1903"
    26	CFG
    27	fi
    28	# shellcheck disable=SC1090
    29	. "$CONF"
    30	
    31	die(){ echo "botline: $*" >&2; exit 1; }
    32	# transport binary is injectable (IMSG_BIN) so tests can run the real script against a recorded
    33	# transport instead of texting a live phone — same seam pattern as ambrosio's BOTLINE_BIN/LMS_BIN
    34	IMSG="${IMSG_BIN:-imsg}"
    35	command -v "$IMSG" >/dev/null || die "imsg not found (brew install steipete/tap/imsg)"
    36	
    37	cmd_send(){
    38	  local from="" ; [ "${1:-}" = "--from" ] && { from="$2"; shift 2; }
    39	  [ -n "$from" ] || die "usage: botline send --from <bot> \"text\""
    40	  local text="$*"; [ -n "$text" ] || die "empty message"
    41	  "$IMSG" send --to "$JS_NUMBER" --text "[$from] $text" || die "imsg send failed"
    42	  echo "$from" > "$BOTLINE_HOME/last_bot"
    43	  mkdir -p "$BOTLINE_HOME/inbox/$from"
    44	  echo "sent to JS as [$from]"
    45	}
    46	
    47	cmd_dispatch(){
    48	  local wm_iso wm_id
    49	  wm_iso="$(cat "$BOTLINE_HOME/watermark_iso" 2>/dev/null || true)"
    50	  wm_id="$(cat "$BOTLINE_HOME/watermark_id" 2>/dev/null || echo 0)"
    51	  if [ -z "$wm_iso" ]; then
    52	    # first run: seed to now so the whole existing thread isn't replayed as "new bot replies"
    53	    wm_iso="$(python3 -c 'import datetime;print(datetime.datetime.now(datetime.timezone.utc).isoformat())')"
    54	    echo "$wm_iso" > "$BOTLINE_HOME/watermark_iso"; echo 0 > "$BOTLINE_HOME/watermark_id"
    55	    echo "dispatch: seeded watermark to now (first run) — future replies will route" >&2; return 0
    56	  fi
    57	  # --start (no arbitrary limit → no silent drop); id>watermark dedups the boundary overlap
    58	  local last_bot; last_bot="$(cat "$BOTLINE_HOME/last_bot" 2>/dev/null || echo unrouted)"
    59	  # a broken transport must be LOUD, not read as "no new replies": stdout here pokes the
    60	  # channel via schd's poke-on-stdout convention, which is exactly what a stalled bridge needs
    61	  local hist
    62	  if ! hist="$("$IMSG" history --chat-id "$JS_CHAT_ID" --start "$wm_iso" --json 2>&1)"; then
    63	    echo "botline dispatch: imsg history FAILED — reply routing is STALLED: $(printf '%s' "$hist" | head -3)"
    64	    return 1
    65	  fi
    66	  printf '%s\n' "$hist" | \
    67	  BOTLINE_HOME="$BOTLINE_HOME" LAST_BOT="$last_bot" WM_ID="$wm_id" python3 -c '
    68	import sys, os, json, re
    69	home=os.environ["BOTLINE_HOME"]; last=os.environ["LAST_BOT"]; wm_id=int(os.environ["WM_ID"])
    70	routed=0; max_id=wm_id; max_iso=None
    71	for line in sys.stdin:
    72	    line=line.strip()
    73	    if not line: continue
    74	    try: m=json.loads(line)
    75	    except Exception: continue
    76	    if m.get("is_from_me"): continue          # JS inbound only
    77	    mid=int(m.get("id",0))
    78	    if mid<=wm_id: continue                     # already processed
    79	    text=(m.get("text") or "").strip()
    80	    if not text: continue
    81	    mo=re.match(r"^@(\S+)\s+(.*)$", text, re.S)
    82	    if mo: target, body = mo.group(1), mo.group(2)
    83	    else:  target, body = last, text
    84	    # a target is a bare inbox name, never a path: "@../../x" or "@/tmp/x" must not
    85	    # write outside the spool — fall back to reply-to-last for anything path-shaped
    86	    if "/" in target or target.startswith(".") or not target:
    87	        target, body = last, text
    88	    d=os.path.join(home,"inbox",target); os.makedirs(d, exist_ok=True)
    89	    open(os.path.join(d, f"{mid}.msg"),"w").write(body+"\n")
    90	    routed+=1
    91	    if mid>max_id: max_id=mid; max_iso=m.get("created_at")
    92	if max_iso:
    93	    open(os.path.join(home,"watermark_id"),"w").write(str(max_id))
    94	    open(os.path.join(home,"watermark_iso"),"w").write(max_iso)
    95	if routed:  # stay SILENT on stdout when nothing routed (a schd command-job pokes on ANY stdout)
    96	    sys.stderr.write(f"dispatch: routed {routed} reply(ies)\n")
    97	' || true
    98	  return 0
    99	}
   100	
   101	cmd_recv(){
   102	  local as="" peek=0
   103	  while [ $# -gt 0 ]; do case "$1" in --as) as="$2"; shift 2;; --peek) peek=1; shift;; *) shift;; esac; done
   104	  [ -n "$as" ] || die "usage: botline recv --as <bot> [--peek]"
   105	  case "$as" in */*|.*) die "invalid bot name '$as' (bare name, not a path)";; esac
   106	  local d="$BOTLINE_HOME/inbox/$as"
   107	  [ -d "$d" ] || { exit 0; }
   108	  # numeric sort on the bare filename (message id): "9.msg" before "10.msg" — a path-wise
   109	  # byte sort flips those once ids cross a digit-length boundary (caught by test-botline.sh)
   110	  for name in $(ls "$d" 2>/dev/null | sort -n); do
   111	    local f="$d/$name"
   112	    # delete ONLY after the message actually reached the reader — if cat fails (reader went
   113	    # away mid-stream, disk full), keep the file for the next recv instead of destroying it
   114	    if cat "$f"; then
   115	      [ "$peek" -eq 0 ] && rm -f "$f"
   116	    else
   117	      echo "botline: recv delivery interrupted — '$name' and later messages kept" >&2
   118	      exit 1
   119	    fi
   120	  done
   121	  exit 0
   122	}
   123	
   124	cmd_list(){
   125	  echo "recipient: ${JS_NUMBER} (chat ${JS_CHAT_ID})"
   126	  echo "last bot to message JS: $(cat "$BOTLINE_HOME/last_bot" 2>/dev/null || echo none)"
   127	  for d in "$BOTLINE_HOME"/inbox/*/; do
   128	    [ -d "$d" ] || continue
   129	    echo "  $(basename "$d"): $(ls "$d"/*.msg 2>/dev/null | wc -l | tr -d ' ') pending"
   130	  done
   131	}
   132	
   133	case "${1:-}" in
   134	  send) shift; cmd_send "$@" ;;
   135	  dispatch) cmd_dispatch ;;
   136	  recv) shift; cmd_recv "$@" ;;
   137	  register)
   138	    [ "${2:-}" = "--name" ] && [ -n "${3:-}" ] || die "usage: botline register --name <bot>"
   139	    case "$3" in */*|.*) die "invalid bot name '$3' (bare name, not a path)";; esac
   140	    mkdir -p "$BOTLINE_HOME/inbox/$3" && echo "registered $3" ;;
   141	  list) cmd_list ;;
   142	  *) echo "usage: botline send|dispatch|recv|register|list (see header)"; exit 1 ;;
   143	esac
    65	
