     1	#!/usr/bin/env python3
     2	"""tooljson.py — the reader for tools/*/tool.json (Phase 6.1 of the tool-template work).
     3	
     4	Seven descriptors existed for weeks with NOTHING reading them (INVENTORY.md, 2026-08-31:
     5	"seven carry a tool.json descriptor... and nothing reads those files"). This converts
     6	them into a validated registry: every descriptor either parses into a known shape or
     7	fails naming what is wrong. The roadmap's rule for the schema: build on what exists, do
     8	not invent a third format.
     9	
    10	THE SHAPE
    11	---------
    12	Required: name (must equal the tool's directory name), description, provides,
    13	dependencies (a list). provides == "mcp-server" additionally requires server (the MCP
    14	server key the tool configures). Optional: backed_by (an astra-relative path that must
    15	exist).
    16	
    17	DEPENDENCIES ARE DECLARED BY ECOSYSTEM — "eco:coordinate" strings:
    18	    brew:jq           npm:ios-simulator-mcp      uv:drews-xcode-mcp
    19	    human:Full Disk Access for Mail
    20	The human class is real and first-class on this machine: xcode-mcp-front needs an
    21	Automator .app, a launchd plist, and TCC grants a person clicks. A brew-only model
    22	under-declares more than half of what is here, silently (ROADMAP phase 6). Bare legacy
    23	tokens (claude, uvx, xcrun, node_npx, mac_control_mcp) are ACCEPTED and reported on
    24	stderr, so existing descriptors keep validating while getting nudged toward migration;
    25	an unknown "eco:" prefix is an error, because a typo'd ecosystem is a dependency that
    26	never installs.
    27	
    28	THIRD-PARTY ADOPTION (optional trio): source (coordinate), version (pin), digest
    29	(artifact hash). source requires version — a coordinate without a pin is an
    30	unrepeatable install; digest is recommended and validated as a string when present.
    31	
    32	CLI:
    33	    tooljson.py list                 validate every tools/*/tool.json; table to stdout
    34	    tooljson.py validate <file|dir>  one descriptor; rc 65 with a named reason
    35	    tooljson.py deps <tool-name>     dependencies grouped by ecosystem
    36	Runs on python3 >= 3.9 (the system interpreter runs the tests and any scheduled job).
    37	"""
    38	import json
    39	import os
    40	import sys
    41	from pathlib import Path
    42	
    43	ASTRA = Path(__file__).resolve().parent.parent.parent
    44	TOOLS = ASTRA / "tools"
    45	
    46	KNOWN_ECOSYSTEMS = ("brew", "npm", "uv", "human")
    47	# Bare tokens the seven pre-existing descriptors use. Accepted, reported, not grown:
    48	# a NEW bare token is an error, so the legacy set only ever shrinks.
    49	LEGACY_TOKENS = frozenset({"claude", "uvx", "xcrun", "node_npx", "mac_control_mcp"})
    50	REQUIRED = ("name", "description", "provides", "dependencies")
    51	KNOWN_FIELDS = frozenset({"name", "server", "description", "dependencies", "provides",
    52	                          "backed_by", "source", "version", "digest"})
    53	
    54	
    55	class DescriptorError(ValueError):
    56	    pass
    57	
    58	
    59	def parse(path, expect_dirname=None):
    60	    """-> dict descriptor. Raises DescriptorError with a named reason. Legacy
    61	    dependency tokens are collected under key '_legacy' and reported by the caller."""
    62	    path = Path(path)
    63	    try:
    64	        raw = path.read_text(encoding="utf-8")
    65	    except OSError as e:
    66	        raise DescriptorError("cannot read %s (%s)" % (path, e))
    67	    try:
    68	        d = json.loads(raw)
    69	    except ValueError as e:
    70	        raise DescriptorError("%s is not valid JSON (%s)" % (path, e))
    71	    if not isinstance(d, dict):
    72	        raise DescriptorError("%s: a descriptor is an object" % path)
    73	
    74	    for field in d:
    75	        if field not in KNOWN_FIELDS:
    76	            raise DescriptorError("%s: unknown field '%s'" % (path, field))
    77	    for field in REQUIRED:
    78	        if field not in d:
    79	            raise DescriptorError("%s has no '%s'" % (path, field))
    80	
    81	    name = d["name"]
    82	    if not isinstance(name, str) or not name:
    83	        raise DescriptorError("%s has no 'name' (non-empty string required)" % path)
    84	    dirname = expect_dirname or path.parent.name
    85	    if name != dirname:
    86	        raise DescriptorError(
    87	            "%s: name '%s' does not match its directory '%s' — the directory is the "
    88	            "identity everything else keys on" % (path, name, dirname))
    89	
    90	    if not isinstance(d["description"], str) or not d["description"].strip():
    91	        raise DescriptorError("%s has no 'description' text" % path)
    92	
    93	    provides = d["provides"]
    94	    if not isinstance(provides, str) or not provides:
    95	        raise DescriptorError("%s has no 'provides'" % path)
    96	    if provides == "mcp-server" and not d.get("server"):
    97	        raise DescriptorError(
    98	            "%s provides 'mcp-server' but names no 'server' — the MCP server key is "
    99	            "what installers configure" % path)
   100	
   101	    deps = d["dependencies"]
   102	    if not isinstance(deps, list) or not all(isinstance(x, str) for x in deps):
   103	        raise DescriptorError("%s: 'dependencies' must be a list of strings" % path)
   104	    grouped = {eco: [] for eco in KNOWN_ECOSYSTEMS}
   105	    legacy = []
   106	    for dep in deps:
   107	        eco, sep, coord = dep.partition(":")
   108	        if sep:
   109	            if eco not in KNOWN_ECOSYSTEMS:
   110	                raise DescriptorError(
   111	                    "%s: unknown dependency ecosystem '%s' in '%s' (known: %s)"
   112	                    % (path, eco, dep, ", ".join(KNOWN_ECOSYSTEMS)))
   113	            if not coord:
   114	                raise DescriptorError("%s: dependency '%s' names no coordinate" % (path, dep))
   115	            grouped[eco].append(coord)
   116	        elif dep in LEGACY_TOKENS:
   117	            legacy.append(dep)
   118	        else:
   119	            raise DescriptorError(
   120	                "%s: bare dependency '%s' is neither ecosystem-qualified (eco:coordinate) "
   121	                "nor a known legacy token (%s)" % (path, dep, ", ".join(sorted(LEGACY_TOKENS))))
   122	
   123	    backed_by = d.get("backed_by")
   124	    if backed_by is not None:
   125	        if not isinstance(backed_by, str):
   126	            raise DescriptorError("%s: 'backed_by' must be a string path" % path)
   127	        if not (ASTRA / backed_by).exists():
   128	            raise DescriptorError("%s: backed_by '%s' does not exist under %s"
   129	                                  % (path, backed_by, ASTRA))
   130	
   131	    for field in ("source", "version", "digest"):
   132	        if field in d and not isinstance(d[field], str):
   133	            raise DescriptorError("%s: '%s' must be a string" % (path, field))
   134	    if d.get("source") and not d.get("version"):
   135	        raise DescriptorError(
   136	            "%s: 'source' requires 'version' — a coordinate without a pin is an "
   137	            "unrepeatable install" % path)
   138	
   139	    d["_grouped"] = grouped
   140	    d["_legacy"] = legacy
   141	    return d
   142	
   143	
   144	def load_all():
   145	    """-> (descriptors by name, error list). Reads every tools/*/tool.json."""
   146	    found, errors = {}, []
   147	    for tdir in sorted(TOOLS.iterdir()):
   148	        tj = tdir / "tool.json"
   149	        if not tdir.is_dir() or not tj.is_file():
   150	            continue
   151	        try:
   152	            found[tdir.name] = parse(tj)
   153	        except DescriptorError as e:
   154	            errors.append(str(e))
   155	    return found, errors
   156	
   157	
   158	def _report_legacy(name, legacy):
   159	    if legacy:
   160	        print("tooljson: %s uses legacy dependency token(s) %s — migrate to "
   161	              "eco:coordinate form" % (name, ", ".join(sorted(legacy))), file=sys.stderr)
   162	
   163	
   164	def cmd_list(_):
   165	    found, errors = load_all()
   166	    for e in errors:
   167	        print("tooljson: %s" % e, file=sys.stderr)
   168	    for name, d in sorted(found.items()):
   169	        eco = "; ".join("%s:%d" % (k, len(v)) for k, v in d["_grouped"].items() if v)
   170	        print("%-24s %-11s %s%s" % (name, d["provides"],
   171	                                    d["description"][:60],
   172	                                    ("  [" + eco + "]") if eco else ""))
   173	        _report_legacy(name, d["_legacy"])
   174	    print("%d descriptor(s), %d invalid" % (len(found), len(errors)))
   175	    return 65 if errors else 0
   176	
   177	
   178	def cmd_validate(args):
   179	    if not args:
   180	        print("usage: tooljson.py validate <file|dir>", file=sys.stderr)
   181	        return 64
   182	    p = Path(args[0])
   183	    if p.is_dir():
   184	        p = p / "tool.json"
   185	    try:
   186	        d = parse(p)
   187	    except DescriptorError as e:
   188	        print("tooljson: %s" % e, file=sys.stderr)
   189	        return 65
   190	    _report_legacy(d["name"], d["_legacy"])
   191	    print("%s: valid (%s)" % (d["name"], d["provides"]))
   192	    for eco in KNOWN_ECOSYSTEMS:
   193	        for coord in d["_grouped"][eco]:
   194	            print("  %s: %s" % (eco, coord))
   195	    for tok in d["_legacy"]:
   196	        print("  legacy: %s" % tok)
   197	    return 0
   198	
   199	
   200	def cmd_deps(args):
   201	    if not args:
   202	        print("usage: tooljson.py deps <tool-name>", file=sys.stderr)
   203	        return 64
   204	    found, errors = load_all()
   205	    d = found.get(args[0])
   206	    if d is None:
   207	        print("tooljson: no valid descriptor for '%s' (have: %s)"
   208	              % (args[0], ", ".join(sorted(found))), file=sys.stderr)
   209	        return 66
   210	    for eco in KNOWN_ECOSYSTEMS:
   211	        for coord in d["_grouped"][eco]:
   212	            print("%s: %s" % (eco, coord))
   213	    for tok in d["_legacy"]:
   214	        print("legacy: %s" % tok)
   215	    return 0
   216	
   217	
   218	def main():
   219	    cmds = {"list": cmd_list, "validate": cmd_validate, "deps": cmd_deps}
   220	    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
   221	        print("usage: tooljson.py {list|validate|deps} [...]", file=sys.stderr)
   222	        return 64
   223	    return cmds[sys.argv[1]](sys.argv[2:])
   224	
   225	
   226	if __name__ == "__main__":
   227	    sys.exit(main())
FILE ../lib/astra-update
     1	#!/usr/bin/env python3
     2	"""
     3	astra-update — vendored into every repo at .astra/astra-update.
     4	
     5	WHAT THIS IS
     6	------------
     7	The pull half of astra's tool distribution. A repo that has astra tools
     8	installed carries this script and a manifest saying where each tool came from
     9	and what it looked like on arrival. This asks the source whether anything has
    10	moved on, and updates in place.
    11	
    12	WHY IT IS HERE AND NOT IN ASTRA (Jonathan, 2026-08-18)
    13	------------------------------------------------------
    14	The first design had astra push: a post-commit hook in astra rewrote files
    15	across six checkouts, deciding what belonged to it by matching filenames. That
    16	put the blast radius in the wrong place. A bug in astra could destroy work in a
    17	legal repo, and it did — the fork guard was unreachable, so an edited copy was
    18	silently overwritten.
    19	
    20	Pull inverts it. Each repo asks, on its own schedule, from its own hook. Astra
    21	never reaches into anything. A repo can be cloned, moved, or taken offline and
    22	this still behaves correctly, which a central list of absolute paths cannot.
    23	
    24	THE SAFETY RULE, learned the hard way
    25	-------------------------------------
    26	Update a file only when it is EXACTLY what we installed. The manifest records
    27	the hash of every file at install time, so a local edit is a fact rather than
    28	an inference. Matching hash means nobody touched it and replacing it loses
    29	nothing. Anything else is reported and left alone — never silently overwritten,
    30	and never silently skipped either, because a watcher that hides work is how the
    31	real problem gets missed.
    32	
    33	    .astra/astra-update            report what is behind, change nothing
    34	    .astra/astra-update --pull     update the unmodified, report the rest
    35	"""
    36	import hashlib
    37	import json
    38	import os
    39	import shutil
    40	import sys
    41	from pathlib import Path
    42	
    43	HERE = Path(__file__).resolve().parent          # <repo>/.astra
    44	REPO = HERE.parent                              # the repo that owns this install
    45	MANIFEST = HERE / "manifest.json"
    46	
    47	
    48	def sha(p):
    49	    try:
    50	        return hashlib.sha256(Path(p).read_bytes()).hexdigest()[:16]
    51	    except OSError:
    52	        return None
    53	
    54	
    55	def load():
    56	    try:
    57	        return json.loads(MANIFEST.read_text())
    58	    except FileNotFoundError:
    59	        print(f"no manifest at {MANIFEST} — nothing installed here", file=sys.stderr)
    60	        raise SystemExit(0)
    61	    except Exception as e:
    62	        # A corrupt manifest must never be treated as "nothing installed".
    63	        # That reading would make a broken repo look like a clean one.
    64	        print(f"manifest unreadable ({e}) — refusing to guess", file=sys.stderr)
    65	        raise SystemExit(2)
    66	
    67	
    68	def save(data):
    69	    tmp = MANIFEST.with_suffix(".json.tmp")
    70	    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    71	    os.replace(tmp, MANIFEST)
    72	
    73	
    74	def resolve_source(recorded):
    75	    """The manifest records an ABSOLUTE source path, which broke every cloned repo:
    76	    on a machine without that exact path, nothing could update — and third-party
    77	    adoption is impossible if a checkout only works where it was first installed
    78	    (ROADMAP phase 6). Resolution order, first hit wins:
    79	
    80	      1. the recorded path itself (the common case, unchanged);
    81	      2. $ASTRA_SOURCE — the explicit override for unusual layouts;
    82	      3. a sibling of this repo's parent named like the recorded source's basename —
    83	         the cloned-workspace convention (~/checkouts/js-db-ad-astra next to
    84	         ~/checkouts/consumer clones as /elsewhere/js-db-ad-astra next to
    85	         /elsewhere/consumer).
    86	
    87	    Returns (path or None, note). The note says when a fallback was used, because a
    88	    silently substituted source is how the wrong checkout feeds an update."""
    89	    recorded = Path(recorded) if recorded else None
    90	    candidates = []
    91	    if recorded:
    92	        candidates.append((recorded, ""))
    93	    env = os.environ.get("ASTRA_SOURCE")
    94	    if env:
    95	        candidates.append((Path(env), "via $ASTRA_SOURCE"))
    96	    if recorded and recorded.name:
    97	        candidates.append((REPO.parent / recorded.name, "sibling of this repo's parent"))
    98	    for cand, how in candidates:
    99	        if (cand / "tools").is_dir():
   100	            note = f" (resolved {how}: {cand})" if how else ""
   101	            return cand, note
   102	    return None, ""
   103	
   104	
   105	def main():
   106	    pull = "--pull" in sys.argv
   107	    data = load()
   108	    behind = modified = current = missing = 0
   109	
   110	    for tool, meta in sorted(data.get("tools", {}).items()):
   111	        src_root, src_note = resolve_source(meta.get("source", ""))
   112	        if src_root is None:
   113	            print(f"  SOURCE GONE  {tool}  (recorded {meta.get('source')!r}; no "
   114	                  f"$ASTRA_SOURCE, no sibling clone). Set ASTRA_SOURCE=<path to the "
   115	                  f"source checkout> or clone it beside this repo.")
   116	            missing += 1
   117	            continue
   118	        if src_note:
   119	            print(f"  note: {tool} source{src_note}")
   120	        src_dir = src_root / "tools" / tool
   121	        dest_dir = HERE / tool
   122	
   123	        # A tool whose files all carry explicit paths need not have a tools/<tool> directory.
   124	        if not src_dir.is_dir() and not meta.get("paths"):
   125	            # The source checkout exists but no longer carries this tool.
   126	            print(f"  SOURCE GONE  {tool}  (looked in {src_dir})")
   127	            missing += 1
   128	            continue
   129	
   130	        # A tool may place files OUTSIDE .astra — doctrine installs to <repo>/.doctrine/<slug>.md.
   131	        # Those entries carry explicit repo-relative src and dest, because the default layout
   132	        # (<source>/tools/<tool>/<file> -> <repo>/.astra/<tool>/<file>) cannot express them.
   133	        #
   134	        # This gap is why four installed copies of the convocation doctrine sat stale through a
   135	        # rename on 2026-08-26: install-doctrine.sh never registered them, so the updater did not
   136	        # know they existed and reported everything current. A distribution mechanism that is
   137	        # silent about what it does not cover is worse than one that covers less and says so.
   138	        paths = meta.get("paths", {})
   139	        for fname, installed_sha in sorted(meta.get("files", {}).items()):
   140	            override = paths.get(fname, {})
   141	            src = (src_root / override["src"]) if override.get("src") else (src_dir / fname)
   142	            dest = (REPO / override["dest"]) if override.get("dest") else (dest_dir / fname)
   143	            upstream, live = sha(src), sha(dest)
   144	
   145	            if upstream is None:
   146	                print(f"  SOURCE GONE  {tool}/{fname}")
   147	                missing += 1
   148	            elif live is None:
   149	                print(f"  MISSING      {tool}/{fname} — reinstall the tool")
   150	                missing += 1
   151	            elif live == upstream:
   152	                current += 1
   153	            elif live != installed_sha:
   154	                # Diverged from what we put here. Could be a deliberate local
   155	                # change or an accident; either way it is not ours to discard.
   156	                print(f"  LOCAL EDITS  {tool}/{fname} — differs from what was "
   157	                      f"installed; not touching it")
   158	                modified += 1
   159	            elif pull:
   160	                tmp = dest.with_name(dest.name + ".astra-tmp")
   161	                shutil.copy2(src, tmp)
   162	                os.replace(tmp, dest)       # atomic: never a truncated tool
   163	                meta["files"][fname] = upstream
   164	                print(f"  updated      {tool}/{fname}")
   165	                behind += 1
   166	            else:
   167	                print(f"  BEHIND       {tool}/{fname} — run .astra/astra-update --pull")
   168	                behind += 1
   169	
   170	    if pull and behind:
   171	        save(data)
   172	
   173	    parts = [f"{current} current"]
   174	    if behind:
   175	        parts.append(f"{behind} {'updated' if pull else 'behind'}")
   176	    if modified:
   177	        parts.append(f"{modified} locally modified")
   178	    if missing:
   179	        parts.append(f"{missing} missing")
   180	    print(", ".join(parts))
   181	
   182	    # Nonzero only for things a human must act on. Being behind is not a
   183	    # failure when --pull just fixed it.
   184	    return 1 if (modified or missing or (behind and not pull)) else 0
   185	
   186	
   187	if __name__ == "__main__":
   188	    sys.exit(main())
FILE ../lib/uninstall-common.sh
     1	#!/usr/bin/env bash
     2	# uninstall-common.sh — shared dis-integration helpers for @astra tools. Source it from a tool's
     3	# uninstall.sh:  . "$(dirname "$0")/../lib/uninstall-common.sh"
     4	#
     5	# The contract (Jonathan, 2026-08-13): "anything installing needs to uninstall, too — but not
     6	# necessarily the brew stuff; that should be an option. Uninstall dis-integrates and OPTIONALLY
     7	# uninstalls deps with big loud warnings."
     8	#
     9	#   plain uninstall            → remove the tool's OWN local state (config/caches/symlinks). Deps
    10	#                                are LEFT ALONE; the tool prints the exact command to remove each.
    11	#   uninstall --deps           → also remove the shared deps, each behind a loud banner, because a
    12	#                                brew formula / uv tool is very likely used by OTHER tools too.
    13	#
    14	# Shared-dep removal runs through $BREW_BIN / $UV_BIN seams so a test can point them at a stub and
    15	# assert what WOULD be removed without touching the real toolchain — same seam pattern as install.
    16	set -uo pipefail
    17	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$HOME/.local/bin:$PATH"
    18	BREW_BIN="${BREW_BIN:-brew}"
    19	UV_BIN="${UV_BIN:-uv}"
    20	UNINSTALL_DEPS=0
    21	
    22	_uc_hr(){ printf '  %s\n' "============================================================"; }
    23	uc_warn(){ _uc_hr; for line in "$@"; do printf '  ⚠️  %s\n' "$line"; done; _uc_hr; }
    24	
    25	uc_parse(){ # read flags an uninstaller shares; call once with "$@"
    26	  for a in "$@"; do case "$a" in
    27	    --deps) UNINSTALL_DEPS=1 ;;
    28	    --help|-h) echo "usage: uninstall.sh [--deps]   (--deps also removes shared brew/uv deps, loudly)"; exit 0 ;;
    29	    --*) echo "unknown flag '$a'" >&2; exit 64 ;;
    30	  esac; done
    31	}
    32	
    33	uc_rm_state(){ # usage: uc_rm_state <path> "<human description>"
    34	  if [ -e "$1" ]; then echo "  removing $2: $1"; rm -rf "$1"
    35	  else echo "  (nothing to remove: no $2 at $1)"; fi
    36	}
    37	
    38	uc_rm_symlink(){ # remove a symlink ONLY if it points into this tool — never a real file
    39	  if [ -L "$1" ]; then echo "  removing symlink: $1 -> $(readlink "$1")"; rm -f "$1"
    40	  elif [ -e "$1" ]; then echo "  KEEPING $1 (not a symlink — left untouched)"
    41	  else echo "  (no symlink at $1)"; fi
    42	}
    43	
    44	uc_brew(){ # usage: uc_brew <formula> "<why it's shared / what may break>"
    45	  if [ "$UNINSTALL_DEPS" = 1 ]; then
    46	    uc_warn "removing shared brew dep '$1'" "$2" "Other tools on this machine may rely on it."
    47	    "$BREW_BIN" uninstall "$1" || echo "  ($BREW_BIN uninstall $1 failed or it was already gone)"
    48	  else
    49	    echo "  KEEPING shared dep '$1' (brew). To remove it too, re-run with --deps, or:  $BREW_BIN uninstall $1"
    50	  fi
    51	}
    52	
    53	uc_keep(){ # a dep we NEVER auto-remove even with --deps (foundational runtimes, or the user's own
    54	           # primary tools). usage: uc_keep <name> "<what it is / why kept>"
    55	  echo "  NOT removing '$1' — $2. Left in place; remove by hand only if you are certain."
    56	}
    57	
    58	uc_uv_tool(){ # usage: uc_uv_tool <tool> "<why it's shared>"
    59	  if [ "$UNINSTALL_DEPS" = 1 ]; then
    60	    uc_warn "removing shared uv tool '$1'" "$2" "Other tools on this machine may rely on it."
    61	    "$UV_BIN" tool uninstall "$1" || echo "  ($UV_BIN tool uninstall $1 failed or it was already gone)"
    62	  else
    63	    echo "  KEEPING shared uv tool '$1'. To remove it too, re-run with --deps, or:  $UV_BIN tool uninstall $1"
    64	  fi
    65	}
