     1	#!/usr/bin/env bash
     2	# astra-install.sh — the one place that decides WHERE an astra tool lands in a
     3	# repo and what it records about itself. Every tool's install.sh sources this.
     4	#
     5	# WHY THIS EXISTS (Jonathan, 2026-08-18)
     6	# --------------------------------------
     7	# The first design copied tools into whatever directory each repo happened to
     8	# use — 13_Scripts, scripts, tools, pdf, one repo's root — and then kept a
     9	# central list in astra of where everything went. That list was built by
    10	# matching FILENAMES across the workspace, which meant any repo's own
    11	# rules.json or lib.sh was adopted as an astra install and overwritten by a
    12	# post-commit hook. Ownership was inferred, and inference is a guess.
    13	#
    14	# Two corrections, both his:
    15	#
    16	#   "Why wouldn't you be writing someplace you know isn't going to be touched?
    17	#    like .astra or whatever?"
    18	#
    19	# Everything lands in <repo>/.astra/<tool>/. Ownership stops being a guess and
    20	# becomes a fact: if it is in there, it is ours, and nothing else is. The
    21	# collision bug cannot occur rather than being guarded against.
    22	#
    23	#   "probably worth each .astra able to find where it was installed FROM and
    24	#    check for updates?"
    25	#
    26	# So the direction of the relationship flips. Astra no longer pushes into
    27	# repos it keeps a list of; each repo records where it was installed from and
    28	# pulls. That removes the blast radius entirely — nothing reaches into another
    29	# repo uninvited — and it survives the repo being cloned or moved, which a
    30	# central list of absolute paths does not.
    31	#
    32	# Usage from a tool's install.sh:
    33	#     . "$(dirname "$0")/../lib/astra-install.sh"
    34	#     astra_target "$@"                 # parses --into, validates, sets $TARGET
    35	#     astra_place check-prose check-prose.js rules.json
    36	#
    37	set -euo pipefail
    38	
    39	ASTRA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
    40	
    41	# Parse --into and refuse anywhere that is not a project checkout. Global
    42	# installs were removed on 2026-08-18 and nothing here may recreate one.
    43	astra_target() {
    44	  TARGET=""
    45	  while [ $# -gt 0 ]; do
    46	    case "$1" in
    47	      --into) TARGET="${2:-}"; shift 2 ;;
    48	      *) shift ;;
    49	    esac
    50	  done
    51	  [ -n "$TARGET" ] || { echo "usage: --into <repo>" >&2; exit 64; }
    52	  [ -d "$TARGET" ] || { echo "no such directory: $TARGET" >&2; exit 66; }
    53	  # -P resolves symlinks: js-hoa and js-speedway are symlinks into Dropbox.
    54	  TARGET="$(cd "$TARGET" && pwd -P)"
    55	  case "$TARGET" in
    56	    "$HOME"|"$HOME/.claude"*|"$HOME/.agents"*|"$HOME/.config"*|"$HOME/Library"*)
    57	      echo "REFUSING: $TARGET is a home/global location." >&2
    58	      echo "  Astra tools install per-repo only." >&2
    59	      exit 78 ;;
    60	  esac
    61	  export TARGET
    62	}
    63	
    64	# Copy a tool's files into <repo>/.astra/<tool>/ and record its origin.
    65	astra_place() {
    66	  local tool="$1"; shift
    67	  local src="$ASTRA_ROOT/tools/$tool"
    68	  local dest="$TARGET/.astra/$tool"
    69	  mkdir -p "$dest"
    70	
    71	  local f
    72	  for f in "$@"; do
    73	    [ -f "$src/$f" ] || { echo "missing source file: $src/$f" >&2; exit 65; }
    74	    # Write beside and rename. A plain cp truncates the destination before it
    75	    # copies, so an interrupted install leaves a zero-length tool where a
    76	    # working one used to be.
    77	    cp "$src/$f" "$dest/$f.astra-tmp"
    78	    mv -f "$dest/$f.astra-tmp" "$dest/$f"
    79	  done
    80	
    81	  astra_record "$tool" "$@"
    82	  astra_vendor_updater
    83	  echo "installed $tool -> $dest"
    84	}
    85	
    86	# The manifest is what makes a repo self-sufficient: it knows what it has,
    87	# where it came from, and what it looked like when it arrived. Local
    88	# divergence is therefore detectable without asking astra anything.
    89	astra_record() {
    90	  local tool="$1"; shift
    91	  local manifest="$TARGET/.astra/manifest.json"
    92	  local dest="$TARGET/.astra/$tool"
    93	  ASTRA_TOOL="$tool" ASTRA_SRC="$ASTRA_ROOT" ASTRA_DEST="$dest" \
    94	  ASTRA_MANIFEST="$manifest" ASTRA_FILES="$*" python3 - <<'PY'
    95	import hashlib, json, os, pathlib
    96	
    97	manifest = pathlib.Path(os.environ["ASTRA_MANIFEST"])
    98	tool = os.environ["ASTRA_TOOL"]
    99	dest = pathlib.Path(os.environ["ASTRA_DEST"])
   100	files = os.environ["ASTRA_FILES"].split()
   101	
   102	def sha(p):
   103	    return hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest()[:16]
   104	
   105	try:
   106	    data = json.loads(manifest.read_text())
   107	except Exception:
   108	    data = {}
   109	data.setdefault("tools", {})
   110	# The SOURCE is recorded per-install rather than once for the file, because a
   111	# repo may legitimately be fed by more than one astra checkout over its life.
   112	data["tools"][tool] = {
   113	    "source": os.environ["ASTRA_SRC"],
   114	    "files": {f: sha(dest / f) for f in files},
   115	}
   116	manifest.parent.mkdir(parents=True, exist_ok=True)
   117	tmp = manifest.with_suffix(".json.tmp")
   118	tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
   119	os.replace(tmp, manifest)
   120	PY
   121	}
   122	
   123	# Drop the puller into the repo so it can check itself without astra reaching in.
   124	astra_vendor_updater() {
   125	  local u="$TARGET/.astra/astra-update"
   126	  cp "$ASTRA_ROOT/tools/lib/astra-update" "$u.astra-tmp"
   127	  mv -f "$u.astra-tmp" "$u"
   128	  chmod +x "$u"
   129	}
   130	
   131	# Remove a tool and forget it. Leaves .astra/ itself alone if other tools remain.
   132	astra_remove() {
   133	  local tool="$1"
   134	  rm -rf "$TARGET/.astra/$tool"
   135	  ASTRA_TOOL="$tool" ASTRA_MANIFEST="$TARGET/.astra/manifest.json" python3 - <<'PY'
   136	import json, os, pathlib
   137	m = pathlib.Path(os.environ["ASTRA_MANIFEST"])
   138	try:
   139	    data = json.loads(m.read_text())
   140	except Exception:
   141	    raise SystemExit(0)
   142	data.get("tools", {}).pop(os.environ["ASTRA_TOOL"], None)
   143	tmp = m.with_suffix(".json.tmp")
   144	tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
   145	os.replace(tmp, m)
   146	PY
   147	  echo "removed $tool from $TARGET/.astra"
   148	}
