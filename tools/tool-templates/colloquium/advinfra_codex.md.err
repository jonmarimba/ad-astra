     1	#!/usr/bin/env bash
     2	# frame-review — turn video(s) into a timestamped HTML contact sheet for fast visual review
     3	# (e.g. storm-drainage footage cross-referenced against a punchlist). Frames extracted at a
     4	# chosen rate, each thumbnail captioned with its offset and linked to the full-size frame.
     5	#
     6	#   frame-review <video> [more videos...] [--fps 0.5] [--outdir DIR]
     7	#
