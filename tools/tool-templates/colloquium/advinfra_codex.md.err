FILE ../ponytail/install.sh
     1	#!/usr/bin/env bash
     2	# install.sh — template-facing shim for ponytail. Template members are invoked as
     3	# `install.sh --into <repo>` (template.py's contract); the real installer here predates
     4	# that convention and takes a positional path. This adapts, nothing more.
     5	set -euo pipefail
     6	HERE="$(cd "$(dirname "$0")" && pwd)"
     7	REPO=""
     8	while [ $# -gt 0 ]; do
     9	  case "$1" in
    10	    --into) REPO="${2:-}"; shift 2 ;;
    11	    *) shift ;;
    12	  esac
    13	done
    14	[ -n "$REPO" ] || { echo "usage: install.sh --into <repo>" >&2; exit 64; }
    15	exec "$HERE/install-into-repo.sh" "$REPO"
FILE ../ponytail/uninstall.sh
     1	#!/usr/bin/env bash
     2	# uninstall.sh — remove the ponytail skills from one repo. The inverse the installer's
     3	# own header documents: rm -rf <repo>/.claude/skills/ponytail (and ponytail-audit).
     4	set -euo pipefail
     5	REPO=""
     6	while [ $# -gt 0 ]; do
     7	  case "$1" in
     8	    --into) REPO="${2:-}"; shift 2 ;;
     9	    *) shift ;;
    10	  esac
    11	done
    12	[ -n "$REPO" ] || { echo "usage: uninstall.sh --into <repo>" >&2; exit 64; }
    13	[ -d "$REPO" ] || { echo "uninstall.sh: no such directory: $REPO" >&2; exit 66; }
    14	rm -rf "$REPO/.claude/skills/ponytail" "$REPO/.claude/skills/ponytail-audit"
    15	echo "removed ponytail skills from $REPO/.claude/skills"
FILE ../dedup-scan/install.sh
     1	#!/usr/bin/env bash
     2	# install.sh — place dedup-scan into a repo's .astra, the standard astra_place pattern.
     3	set -euo pipefail
     4	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
     5	HERE="$(cd "$(dirname "$0")" && pwd)"
     6	export ASTRA_ROOT="$(cd "$HERE/../.." && pwd)"
     7	# shellcheck disable=SC1091
     8	. "$ASTRA_ROOT/tools/lib/astra-install.sh"
     9	astra_target "$@"
    10	astra_place dedup-scan dedup-scan
    11	chmod +x "$TARGET/.astra/dedup-scan/dedup-scan"
FILE ../dedup-scan/uninstall.sh
     1	#!/usr/bin/env bash
     2	# uninstall.sh — remove dedup-scan from a repo's .astra.
     3	set -euo pipefail
     4	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
     5	HERE="$(cd "$(dirname "$0")" && pwd)"
     6	export ASTRA_ROOT="$(cd "$HERE/../.." && pwd)"
     7	# shellcheck disable=SC1091
     8	. "$ASTRA_ROOT/tools/lib/astra-install.sh"
     9	astra_target "$@"
    10	astra_remove dedup-scan

