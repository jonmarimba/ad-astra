    26	chmod +x "$SB/bin/ssh"
    27	export SSH_BIN="$SB/bin/ssh"
    28	
    29	out="$(HOME="$LOCAL" "$ASD" fake-remote.test 2>/dev/null)"
    30	printf '%s\n' "$out" | grep -q "DIFFERS     : ~/.claude/settings.json" && pass "differing file reported DIFFERS" || fail "DIFFERS missing for .claude/settings.json"
    31	printf '%s\n' "$out" | grep -q "same        : ~/.codex/config.toml" && pass "identical file reported same (remote \$HOME expanded — the old quoting bug reads this ONLY LOCAL)" || fail "same missing for .codex/config.toml (remote quoting regressed?)"
    32	printf '%s\n' "$out" | grep -q "ONLY LOCAL  : ~/.qwen/settings.json" && pass "local-only file reported ONLY LOCAL" || fail "ONLY LOCAL missing"
    33	printf '%s\n' "$out" | grep -q "ONLY REMOTE : ~/.claude/CLAUDE.md" && pass "remote-only file reported ONLY REMOTE" || fail "ONLY REMOTE missing"
    34	printf '%s\n' "$out" | grep -q "sonnet" && pass "DIFFERS shows the actual diff body" || fail "diff body missing"
    35	
    36	# ---- read-only claim: the run must not have touched either home ----
    37	[ "$(cat "$LOCAL/.claude/settings.json")" = '{"model":"opus"}' ] && pass "local config untouched" || fail "local config MUTATED by a read-only tool"
    38	[ "$(cat "$REMOTE/.claude/settings.json")" = '{"model":"sonnet"}' ] && pass "remote config untouched" || fail "remote config MUTATED by a read-only tool"
    39	
    40	# ---- RED control: unreachable host must produce NO comparison lines ----
    41	touch "$SB/host_down"
    42	# ASD itself exits 0 on an unreachable host (it reports gracefully rather than erroring), so the
    43	# guard under test is "no comparison line leaked", not the tool's own exit code. The bash -c body
    44	# does that check itself and turns the result into a real rc+diagnostic pair for red().
    45	red "unreachable host yields no DIFFERS/same output" 1 "no comparison lines emitted for unreachable host" \
    46	  bash -c "out=\$(HOME='$LOCAL' '$ASD' fake-remote.test 2>/dev/null); if printf '%s' \"\$out\" | grep -qE 'DIFFERS|same '; then echo 'FAIL: comparison line found for an unreachable host'; exit 0; else echo 'no comparison lines emitted for unreachable host'; exit 1; fi"
    47	out2="$(HOME="$LOCAL" "$ASD" fake-remote.test 2>/dev/null)"
    48	printf '%s\n' "$out2" | grep -q "unreachable" && pass "unreachable host stated plainly" || fail "no unreachable notice"
