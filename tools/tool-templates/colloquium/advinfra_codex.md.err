     1	#!/usr/bin/env python3
     2	"""
     3	template.py — install a NAMED GROUP of astra tools into a repo.
     4	
     5	The middle layer Jonathan described on 2026-08-18: "templates for installing
     6	groups of these tools that are fit for a particular kind of project, a middle
     7	level where we can say the mhm project(s) has the swift and iOS stuff installed
     8	via a template for that along with the writing tools. Whereas the legal repos
     9	have the pdf to text stuff and the writing stuff."
    10	
    11	    template.py list
    12	    template.py show <name>
    13	    template.py install   <name> --into <repo>
    14	    template.py uninstall <name> --into <repo>
    15	    template.py status --into <repo>
    16	
    17	TWO PROPERTIES THAT ARE NOT NEGOTIABLE
    18	--------------------------------------
    19	NON-EXCLUSIVE. Installing a template ADDS its tools. It never removes anything
    20	another template put there, and two templates may overlap freely — the legal and
    21	Maharam sets both want the writing tools, and installing one after the other must
    22	leave both intact. Uninstall removes only what that template names, so a shared
    23	tool survives until the last template needing it is gone. Anything else would
    24	make the second install silently break the first.
    25	
    26	NEVER GLOBAL. Templates delegate to each tool's own install.sh --into <repo>,
    27	and those already refuse a target under $HOME, ~/.claude, ~/.agents, ~/.config or
    28	~/Library. The global installs that had accumulated were removed on 2026-08-18
    29	and nothing here may recreate one.
    30	
    31	Templates are DATA (templates.json), not code, so adding one is an edit rather
    32	than a patch. Every tool a template names must have its own install.sh and
    33	uninstall.sh — that is what made splitting the MCP bundle into seven small tools
    34	the prerequisite for this layer.
    35	"""
    36	import json
    37	import os
    38	import subprocess
    39	import sys
    40	from pathlib import Path
    41	
    42	ASTRA = Path(__file__).resolve().parent.parent.parent
    43	TOOLS = ASTRA / "tools"
    44	# ASTRA_TEMPLATES_JSON exists for the tests: they need a template whose member is
    45	# guaranteed to fail without editing the real catalogue. Tools still resolve from the
    46	# real tools/ tree either way.
    47	TEMPLATES = Path(os.environ.get("ASTRA_TEMPLATES_JSON") or (TOOLS / "lib" / "templates.json"))
    48	
    49	
    50	def load():
    51	    try:
    52	        return json.loads(TEMPLATES.read_text())
    53	    except FileNotFoundError:
    54	        return {"templates": {}}
    55	
    56	
    57	def resolve_tools(templates, name, _stack=None):
    58	    """The COMPOSED tool list: this template's own tools plus its member templates',
    59	    transitively, in member-first order, deduplicated. Composition is the mechanism the
    60	    whole design rests on (SPEC: a Mac+Swift template is simply its members) — so a
    61	    cycle and an unknown member are loud, named refusals, never a silent partial
    62	    install. Raises ValueError; callers print it and exit 65."""
    63	    _stack = _stack or []
    64	    if name in _stack:
    65	        raise ValueError("template cycle: " + " -> ".join(_stack + [name]))
    66	    meta = templates.get(name)
    67	    if meta is None:
    68	        suffix = f" (member of '{_stack[-1]}')" if _stack else ""
    69	        raise ValueError(f"no such template: {name}{suffix}")
    70	    tools = []
    71	    for member in meta.get("templates", []):
    72	        for t in resolve_tools(templates, member, _stack + [name]):
    73	            if t not in tools:
    74	                tools.append(t)
    75	    for t in meta.get("tools", []):
    76	        if t not in tools:
    77	            tools.append(t)
    78	    return tools
    79	
    80	
    81	def tool_dir(name):
    82	    d = TOOLS / name
    83	    return d if d.is_dir() else None
    84	
    85	
    86	def run_tool(name, verb, repo):
