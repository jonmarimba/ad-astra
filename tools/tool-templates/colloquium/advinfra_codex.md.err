FILE lib.sh
     1	#!/usr/bin/env bash
     2	# lib.sh — shared assertions for the @astra tool tests. Source from every test-*.sh.
     3	#
     4	# The rules these tests follow are Jonathan's own (js-llmKicker/docs/TAUTOLOGY-AUDIT-20260801.md,
     5	# docs/planning/07d-test-truthfulness/SPEC.md, AGENTS.md "a test that goes red is worth more than
     6	# a paragraph that is true"):
     7	#   1. Assert BY EFFECT — a file that exists, a message that routed, an exit code — never "it ran".
     8	#   2. Every test file carries at least one RED control: an input that MUST fail. If the RED
     9	#      control passes, the test is a tautology and the run fails.
    10	#   3. No silent skips. A missing dependency is a loud FAIL with the reason, never a quiet pass.
    11	#   4. Names don't overclaim: a test named for a fragment tests that fragment.
    12	set -uo pipefail
    13	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
    14	
    15	TESTS_PASS=0; TESTS_FAIL=0
    16	SB="$(mktemp -d -t astra-test)"          # per-test sandbox, wiped on exit
    17	_lib_cleanup(){ rm -rf "$SB"; }
    18	trap _lib_cleanup EXIT
    19	
    20	pass(){ TESTS_PASS=$((TESTS_PASS+1)); echo "  ok:   $*"; }
    21	fail(){ TESTS_FAIL=$((TESTS_FAIL+1)); echo "  FAIL: $*" >&2; }
    22	
    23	need(){ # loud dependency gate — rule 3. usage: need <cmd> "<how to get it>"
    24	  command -v "$1" >/dev/null && return 0
    25	  fail "missing dependency '$1' ($2) — this is a FAILURE, not a skip"
    26	  finish; exit 1
    27	}
    28	
    29	assert_eq(){        [ "$1" = "$2" ]        && pass "$3" || fail "$3 (want '$1' got '$2')"; }
    30	assert_file(){      [ -f "$1" ]            && pass "$2" || fail "$2 (missing $1)"; }
    31	assert_no_file(){   [ ! -e "$1" ]          && pass "$2" || fail "$2 (unexpected $1)"; }
    32	assert_dir(){       [ -d "$1" ]            && pass "$2" || fail "$2 (missing dir $1)"; }
    33	assert_contains(){ # an empty needle is a tautology — grep -F "" matches any nonempty file, so an
    34	  # accidentally-unset variable (e.g. an unquoted ${x:-} that resolved to "") would green-light
    35	  # against ANY real output instead of the specific string the caller meant to check for. Found
    36	  # by convocation review (claude leg), 2026-08-14.
    37	  [ -n "$2" ] || { fail "$3 (empty needle passed to assert_contains — tautology guard, fix the caller)"; return; }
    38	  grep -qF -- "$2" "$1" 2>/dev/null && pass "$3" || fail "$3 ('$2' not in $1)"
    39	}
    40	assert_not_contains(){ # fails on a MISSING file too — "not present" must mean "checked and absent"
    41	  [ -f "$1" ] || { fail "$3 (file $1 missing — vacuous pass refused)"; return; }
    42	  grep -qF -- "$2" "$1" && fail "$3 ('$2' unexpectedly in $1)" || pass "$3"
    43	}
    44	assert_empty(){     [ -z "$1" ]            && pass "$2" || fail "$2 (expected empty, got '$1')"; }
    45	assert_nonempty(){  [ -n "$1" ]            && pass "$2" || fail "$2 (expected output, got none)"; }
    46	
    47	assert_rc(){ # usage: assert_rc <want-rc> "<label>" cmd args...
    48	  local want="$1" label="$2"; shift 2
    49	  "$@" >"$SB/.rc.out" 2>"$SB/.rc.err"; local got=$?
    50	  [ "$got" = "$want" ] && pass "$label (rc=$got)" || { fail "$label (want rc=$want got rc=$got)"; sed 's/^/        /' "$SB/.rc.err" >&2; }
    51	}
    52	
    53	red(){ # RED control — rule 2. The command MUST fail with the EXPECTED exit code AND say the
    54	  # EXPECTED diagnostic. The old form accepted almost any nonzero exit and discarded all output,
    55	  # so a control "passed" when the command died for a missing file or a typo'd flag — it proved
    56	  # something broke, never that the guard under test rejected the input for the claimed reason.
    57	  # Replaced 2026-08-31 (tool-templates increment 0.1; test-lib.sh watched the old form pass a
    58	  # wrong-reason failure before this landed). usage:
    59	  #   red "<label>" <want-rc> "<expected-diagnostic>" cmd args...
    60	  # <want-rc> is the exact nonzero exit code the guard produces; the diagnostic is a literal
    61	  # substring looked for in the command's combined stdout+stderr.
    62	  local label="${1-}" want_rc="${2-}" want_msg="${3-}"
    63	  case "$want_rc" in
    64	    ''|*[!0-9]*)
    65	      fail "red: '$label' — second arg '$want_rc' is not an exit code. Old-style call? New usage: red label rc diagnostic cmd..."
    66	      return ;;
    67	    0)
    68	      fail "red: '$label' — expected rc 0 is not a RED control (the command is supposed to fail)"
    69	      return ;;
    70	    126|127)
    71	      fail "red: '$label' — rc $want_rc means the invocation itself is broken (not found/not executable); a RED control cannot expect it"
    72	      return ;;
    73	  esac
    74	  if [ -z "$want_msg" ]; then
    75	    fail "red: '$label' — empty expected diagnostic (tautology guard: grep -F '' matches any output, fix the caller)"
    76	    return
    77	  fi
    78	  shift 3
    79	  "$@" >"$SB/.red.out" 2>"$SB/.red.err"; local rc=$?
    80	  cat "$SB/.red.out" "$SB/.red.err" >"$SB/.red.all"
    81	  if [ "$rc" -eq 0 ]; then
    82	    fail "RED control DID NOT FAIL (tautology): $label"
    83	  elif [ "$rc" -eq 126 ] || [ "$rc" -eq 127 ]; then
    84	    fail "RED control failed for the WRONG reason (rc=$rc, command not found/executable — fix the invocation, this proves nothing): $label"
    85	  elif [ "$rc" -ne "$want_rc" ]; then
    86	    fail "RED control failed with rc=$rc, expected rc=$want_rc — wrong failure, this proves nothing: $label"
    87	    sed 's/^/        /' "$SB/.red.all" >&2
    88	  elif ! grep -qF -- "$want_msg" "$SB/.red.all"; then
    89	    fail "RED control failed (rc=$rc) but never said '$want_msg' — wrong failure, this proves nothing: $label"
    90	    sed 's/^/        /' "$SB/.red.all" >&2
    91	  else
    92	    pass "red: $label"
    93	  fi
    94	}
    95	
    96	finish(){
    97	  # A test file that reaches finish() having run zero assertions (every assert sat behind a
    98	  # conditional that never fired, an early return skipped them all, etc.) would otherwise print
    99	  # "0 ok, 0 failed" and exit 0 — a silent-pass gate baked into the harness itself, worse than any
   100	  # single tautological assertion because it hides EVERY test in the file at once. Found by
   101	  # convocation review (claude + codex, independently), 2026-08-14.
   102	  if [ "$((TESTS_PASS + TESTS_FAIL))" -eq 0 ]; then
   103	    echo "== $(basename "$0"): ran ZERO assertions — this is a failure, not a silent pass" >&2
   104	    return 1
   105	  fi
   106	  echo "== $(basename "$0"): $TESTS_PASS ok, $TESTS_FAIL failed"
   107	  [ "$TESTS_FAIL" -eq 0 ]
   108	}
FILE test-lib.sh
     1	#!/usr/bin/env bash
     2	# test-lib.sh — the test harness's own RED-control helper, tested by effect.
     3	#
     4	# red() is the mechanism every other test file leans on to prove it can fail. Increment 0.1
     5	# (tools/tool-templates/ROADMAP.md): the old red() discarded all output and accepted almost any
     6	# nonzero exit, so a control "passed" when the command failed for a missing file or a typo'd
     7	# flag — proving something broke, not that the guard rejected bad input. The new contract:
     8	#
     9	#   red "<label>" <want-rc> "<expected-diagnostic>" cmd args...
    10	#
    11	# passes ONLY when the command exits with exactly <want-rc> AND its combined stdout+stderr
    12	# contains the literal <expected-diagnostic>.
    13	#
    14	# Each case here runs red in a CHILD bash that sources lib.sh fresh, so the child's pass/fail
    15	# counters and finish() verdict are the observed effect, and this file's own counters stay
    16	# clean. Asserted by effect: the child's printed verdict lines and its exit code.
    17	set -uo pipefail
    18	HERE="$(cd "$(dirname "$0")" && pwd)"
    19	# shellcheck disable=SC1091
    20	. "$HERE/lib.sh"
    21	
    22	run_red(){ # usage: run_red <outfile-basename> red-arg... ; captures child output + exit code
    23	  local out="$SB/$1"; shift
    24	  bash -c '. "$1"; shift; red "$@"; finish' _ "$HERE/lib.sh" "$@" >"$out" 2>&1
    25	  echo $? >"$out.rc"
    26	}
    27	
    28	# 1. A correct RED control: command fails with the declared rc and prints the declared
    29	#    diagnostic. This is the only case that may pass.
    30	run_red good "rejects url field" 64 "unimplemented field: url" \
    31	  bash -c 'echo "config error — unimplemented field: url" >&2; exit 64'
    32	assert_contains "$SB/good" "red: rejects url field" "red passes when rc and diagnostic both match"
    33	assert_eq "0" "$(cat "$SB/good.rc")" "matching RED control leaves the child suite green"
    34	
    35	# 2. Wrong exit code: the command failed, but not the way the caller declared. The old red()
    36	#    passed this — that pass is exactly the defect 0.1 exists to remove.
    37	run_red wrongrc "rejects url field" 64 "unimplemented field: url" \
    38	  bash -c 'echo "no such file or directory" >&2; exit 1'
    39	assert_contains "$SB/wrongrc" "FAIL" "red fails when the command dies with the wrong exit code"
    40	assert_contains "$SB/wrongrc" "rc=1" "the wrong-rc failure names the rc it actually got"
    41	assert_eq "1" "$(cat "$SB/wrongrc.rc")" "wrong-rc RED control fails the child suite"
    42	
    43	# 3. Right rc, wrong words: exits as declared but never says the declared diagnostic, so
    44	#    nothing shows the guard under test rejected the input for the claimed reason.
    45	run_red wrongmsg "rejects url field" 64 "unimplemented field: url" \
    46	  bash -c 'echo "segmentation fault" >&2; exit 64'
    47	assert_contains "$SB/wrongmsg" "FAIL" "red fails when the expected diagnostic never appears"
    48	assert_contains "$SB/wrongmsg" "unimplemented field: url" "the missing-diagnostic failure names what it looked for"
    49	assert_eq "1" "$(cat "$SB/wrongmsg.rc")" "missing-diagnostic RED control fails the child suite"
    50	
    51	# 4. The command succeeded: a RED control that does not fail is a tautology.
    52	run_red tautology "rejects url field" 64 "unimplemented field: url" true
    53	assert_contains "$SB/tautology" "DID NOT FAIL" "red fails loudly when the command succeeds"
    54	assert_eq "1" "$(cat "$SB/tautology.rc")" "tautological RED control fails the child suite"
    55	
    56	# 5. rc 127: the invocation itself is broken (command not found); proves nothing about the
    57	#    code under test even if the caller asked for 127.
    58	run_red notfound "rejects url field" 1 "anything" /no/such/binary-astra-test
    59	assert_contains "$SB/notfound" "FAIL" "red fails when the command cannot even be found"
    60	assert_eq "1" "$(cat "$SB/notfound.rc")" "command-not-found RED control fails the child suite"
    61	run_red want127 "expects command-not-found" 127 "not found" /no/such/binary-astra-test
    62	assert_contains "$SB/want127" "FAIL" "red refuses an expected rc of 127 — that is a broken invocation, not a guard"
    63	assert_eq "1" "$(cat "$SB/want127.rc")" "expected-127 RED control fails the child suite"
    64	
    65	# 6. An old-style call (no rc, no diagnostic) must fail loudly and name the migration,
    66	#    never silently misparse its arguments as a command.
    67	run_red oldstyle "old style call" false
    68	assert_contains "$SB/oldstyle" "FAIL" "old-style red() call fails instead of misparsing"
    69	assert_contains "$SB/oldstyle" "red label rc diagnostic cmd" "old-style failure states the new usage"
    70	assert_eq "1" "$(cat "$SB/oldstyle.rc")" "old-style RED control fails the child suite"
    71	
    72	# 7. An empty expected diagnostic is the same tautology assert_contains already refuses:
    73	#    grep -F "" matches anything, so the check would green-light any failure output.
    74	run_red emptymsg "empty diagnostic" 64 "" bash -c 'exit 64'
    75	assert_contains "$SB/emptymsg" "FAIL" "red refuses an empty expected diagnostic"
    76	assert_eq "1" "$(cat "$SB/emptymsg.rc")" "empty-diagnostic RED control fails the child suite"
    77	
    78	finish
FILE run-all.sh
     1	#!/usr/bin/env bash
     2	# run-all.sh — the FAST tier: every tools/tests/test-*.sh NOT marked '# TIER: slow' in its
     3	# first three lines (first three only, so a test that merely MENTIONS the marker — in a
     4	# heredoc, a comment, an assertion — is not silently reclassified). Nonzero exit on ANY
     5	# failure. No skips: a test that can't run its subject fails loudly (lib.sh `need`).
     6	#
     7	# Files run in PARALLEL, output buffered per file and printed in order. Every test file
     8	# already builds its own mktemp sandbox (lib.sh), which is what makes this safe; a test
     9	# that needs an exclusive global resource (a live Xcode, a launchd job) belongs in the
    10	# slow tier, where files still run one at a time.
    11	#
    12	# THE TIME BUDGET IS AN ASSERTION, NOT A HOPE. Jonathan will not watch more than fifteen
    13	# seconds of basic tests, so this tier fails itself when it runs over — a suite that
    14	# quietly grows past the budget stops being run, which is worse than any single failure.
    15	# When it trips: make the culprit faster or mark it '# TIER: slow' (run-slow.sh picks it
    16	# up). ASTRA_FAST_BUDGET_S overrides the budget; its only legitimate uses are the RED
    17	# control in test-run-tiers.sh and a deliberately slower CI box.
    18	set -uo pipefail
    19	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
    20	HERE="$(cd "$(dirname "$0")" && pwd)"
    21	BUDGET="${ASTRA_FAST_BUDGET_S:-15}"
    22	JOBS="${ASTRA_FAST_JOBS:-8}"
    23	start=$(date +%s)
    24	
    25	TMPOUT="$(mktemp -d -t astra-fast-tier)"
    26	trap 'rm -rf "$TMPOUT"' EXIT
    27	
    28	fast=(); slow=0
    29	for t in "$HERE"/test-*.sh; do
    30	  [ -f "$t" ] || { echo "no tests found in $HERE"; exit 1; }
    31	  if head -3 "$t" | grep -q '^# TIER: slow'; then slow=$((slow+1)); continue; fi
    32	  fast+=("$t")
    33	done
    34	if [ "${#fast[@]}" -eq 0 ]; then
    35	  echo "fast tier ran ZERO test files — every file is marked slow or the glob is broken" >&2
    36	  exit 1
    37	fi
    38	
    39	printf '%s\n' "${fast[@]}" | TMPOUT="$TMPOUT" xargs -P "$JOBS" -I{} bash -c '
    40	  f="{}"; b="$(basename "$f")"
    41	  bash "$f" >"$TMPOUT/$b.out" 2>&1
    42	  echo $? >"$TMPOUT/$b.rc"
    43	' || true   # per-file verdicts come from the rc files, not xargs's own exit
    44	
    45	overall=0; ran=0
    46	for t in "${fast[@]}"; do
    47	  b="$(basename "$t")"
    48	  echo "── $b"
    49	  cat "$TMPOUT/$b.out"
    50	  rc="$(cat "$TMPOUT/$b.rc" 2>/dev/null || echo missing)"
    51	  if [ "$rc" != "0" ]; then
    52	    [ "$rc" = "missing" ] && echo "  FAIL: $b never reported an exit code — killed mid-run?" >&2
    53	    overall=1
    54	  fi
    55	  ran=$((ran+1))
    56	done
    57	
    58	elapsed=$(( $(date +%s) - start ))
    59	echo ""
    60	[ "$slow" -gt 0 ] && echo "(skipped $slow slow-tier file(s) — run-slow.sh runs them)"
    61	if [ "$elapsed" -gt "$BUDGET" ]; then
    62	  echo "FAST TIER OVER BUDGET: took ${elapsed}s, budget is ${BUDGET}s. Make the culprit faster" >&2
    63	  echo "or move it to the slow tier ('# TIER: slow' in the file's first three lines)." >&2
    64	  overall=1
    65	fi
    66	if [ "$overall" -eq 0 ]; then echo "ALL GREEN ($ran fast test files, ${elapsed}s)"; else echo "FAILURES PRESENT ($ran fast test files, ${elapsed}s) — fix before shipping"; fi
    67	exit "$overall"
FILE run-slow.sh
     1	#!/usr/bin/env bash
     2	# run-slow.sh — the SLOW tier: every tools/tests/test-*.sh marked '# TIER: slow', plus the
     3	# template-system tests that live beside their subject in tools/lib and were never picked
     4	# up by run-all.sh's glob at all (found by the 2026-08-31 colloquium; all three brands
     5	# missed different things, this one Claude caught).
     6	#
     7	# "Slow" means it needs a live application (Xcode, an approval dialog), the network, or
     8	# tens of seconds — not "optional". A ship gate runs BOTH tiers. Nonzero exit on ANY
     9	# failure, same as the fast tier.
    10	set -uo pipefail
    11	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
    12	HERE="$(cd "$(dirname "$0")" && pwd)"
    13	overall=0; ran=0
    14	for t in "$HERE"/test-*.sh; do
    15	  [ -f "$t" ] || { echo "no tests found in $HERE"; exit 1; }
    16	  head -3 "$t" | grep -q '^# TIER: slow' || continue   # first three lines only — a file that merely MENTIONS the marker is not slow
    17	  echo "── $(basename "$t")"
    18	  if bash "$t"; then :; else overall=1; fi
    19	  ran=$((ran+1))
    20	done
    21	for t in "$HERE/../lib/test-templates.sh" "$HERE/../lib/test-astra-update.sh"; do
    22	  [ -f "$t" ] || { echo "MISSING: $t — the template tests moved without this runner following"; overall=1; continue; }
    23	  echo "── lib/$(basename "$t")"
    24	  if bash "$t"; then :; else overall=1; fi
    25	  ran=$((ran+1))
    26	done
    27	if [ "$ran" -eq 0 ]; then
    28	  echo "slow tier ran ZERO test files — nothing is marked '# TIER: slow' and the lib tests are gone" >&2
    29	  exit 1
    30	fi
    31	echo ""
    32	if [ "$overall" -eq 0 ]; then echo "ALL GREEN ($ran slow test files)"; else echo "FAILURES PRESENT ($ran slow test files) — fix before shipping"; fi
    33	exit "$overall"
FILE test-run-tiers.sh
     1	#!/usr/bin/env bash
     2	# test-run-tiers.sh — the two-tier test runner, tested by effect in a sandbox.
     3	#
     4	# Increment 0.2 (tools/tool-templates/ROADMAP.md): run-all.sh is the fast tier and must
     5	# (a) never execute a file marked '# TIER: slow' — the live-Xcode test launches Xcode and
     6	# raises approval dialogs, so running it from the fast tier is not slowness, it is a GUI
     7	# takeover — and (b) fail ITSELF when its wall time exceeds the budget, because a suite
     8	# that quietly grows past fifteen seconds stops being run.
     9	#
    10	# The runners are copied into a sandbox with stub test files so this file can observe
    11	# them without recursing (run-all runs this file; this file must not run the real
    12	# run-all). Effects asserted: sentinel files the stubs create, the runners' own output
    13	# and exit codes.
    14	set -uo pipefail
    15	HERE="$(cd "$(dirname "$0")" && pwd)"
    16	# shellcheck disable=SC1091
    17	. "$HERE/lib.sh"
    18	
    19	FAKE="$SB/tests"; mkdir -p "$FAKE" "$SB/lib"
    20	cp "$HERE/run-all.sh" "$HERE/run-slow.sh" "$FAKE/"
    21	
    22	cat > "$FAKE/test-fast-stub.sh" <<EOF
    23	#!/usr/bin/env bash
    24	touch "$SB/fast-ran"
    25	echo "== test-fast-stub.sh: 1 ok, 0 failed"
    26	EOF
    27	cat > "$FAKE/test-slow-stub.sh" <<EOF
    28	#!/usr/bin/env bash
    29	# TIER: slow — stub for the tier test
    30	touch "$SB/slow-ran"
    31	echo "== test-slow-stub.sh: 1 ok, 0 failed"
    32	EOF
    33	# The lib-side template tests run-slow.sh must pick up (they sit outside the glob).
    34	cat > "$SB/lib/test-templates.sh" <<EOF
    35	#!/usr/bin/env bash
    36	touch "$SB/lib-templates-ran"
    37	EOF
    38	cat > "$SB/lib/test-astra-update.sh" <<EOF
    39	#!/usr/bin/env bash
    40	touch "$SB/lib-update-ran"
    41	EOF
    42	
    43	# --- fast tier: runs the fast stub, does NOT run the slow-marked one ---
    44	out="$SB/fast.out"
    45	bash "$FAKE/run-all.sh" >"$out" 2>&1
    46	assert_eq "0" "$?" "fast tier exits 0 when its files pass"
    47	assert_file "$SB/fast-ran" "fast tier executed the unmarked file"
    48	assert_no_file "$SB/slow-ran" "fast tier did NOT execute the '# TIER: slow' file"
    49	assert_contains "$out" "skipped 1 slow-tier file" "fast tier says out loud what it skipped"
    50	
    51	# --- a file that merely MENTIONS the marker (heredoc, assertion) is NOT slow ---
    52	# This file itself was misclassified on 2026-08-31: its stub heredocs contain the marker
    53	# at column 1, and a whole-file grep quietly dropped the tier test from the fast tier.
    54	cat > "$FAKE/test-mentions-marker-stub.sh" <<'STUB'
    55	#!/usr/bin/env bash
    56	# a fast test whose BODY quotes the marker, far from the top
    57	cat >/dev/null <<EOF
    58	# TIER: slow — quoted content, not a classification
    59	EOF
    60	touch "${MENTION_SENTINEL:?}"
    61	echo "== test-mentions-marker-stub.sh: 1 ok, 0 failed"
    62	STUB
    63	MENTION_SENTINEL="$SB/mention-ran" bash "$FAKE/run-all.sh" >/dev/null 2>&1
    64	assert_file "$SB/mention-ran" "a file that only quotes the marker in its body still runs in the fast tier"
    65	rm "$FAKE/test-mentions-marker-stub.sh"
    66	
    67	# --- fast tier budget: going over the budget is a FAILURE, not a note ---
    68	cat > "$FAKE/test-sluggish-stub.sh" <<'EOF'
    69	#!/usr/bin/env bash
    70	sleep 2
    71	echo "== test-sluggish-stub.sh: 1 ok, 0 failed"
    72	EOF
    73	red "fast tier over budget must fail loudly" 1 "FAST TIER OVER BUDGET" \
    74	  env ASTRA_FAST_BUDGET_S=1 bash "$FAKE/run-all.sh"
    75	rm "$FAKE/test-sluggish-stub.sh"
    76	
    77	# --- fast tier refuses to report green having run nothing ---
    78	mkdir -p "$SB/empty-tests"; cp "$HERE/run-all.sh" "$SB/empty-tests/"
    79	cat > "$SB/empty-tests/test-only-slow.sh" <<'EOF'
    80	#!/usr/bin/env bash
    81	# TIER: slow — everything is slow here
    82	EOF
    83	red "fast tier with zero runnable files must fail" 1 "ran ZERO test files" \
    84	  bash "$SB/empty-tests/run-all.sh"
    85	
    86	# --- slow tier: runs ONLY the marked file, plus the lib-side template tests ---
    87	rm -f "$SB/fast-ran"
    88	out="$SB/slow.out"
    89	bash "$FAKE/run-slow.sh" >"$out" 2>&1
    90	assert_eq "0" "$?" "slow tier exits 0 when its files pass"
    91	assert_file "$SB/slow-ran" "slow tier executed the '# TIER: slow' file"
    92	assert_no_file "$SB/fast-ran" "slow tier did NOT execute the unmarked file"
    93	assert_file "$SB/lib-templates-ran" "slow tier picked up lib/test-templates.sh (outside the glob)"
    94	assert_file "$SB/lib-update-ran" "slow tier picked up lib/test-astra-update.sh (outside the glob)"
    95	
    96	# --- the file whose fast-tier execution would take over the GUI stays marked ---
    97	assert_contains "$HERE/test-xcode-mcp-front.sh" "# TIER: slow" \
    98	  "the live-Xcode test carries the slow marker (fast tier must never launch Xcode)"
    99	
   100	finish
FILE test-mcp-tools.sh
     1	#!/usr/bin/env bash
     2	# test-mcp-tools.sh — mcp_tools.py's wire handling, against real stub servers.
     3	#
     4	# The defect all three round-one colloquium brands flagged: probe() assumed the NEXT
     5	# stdout line answers the request just sent. A banner line before the handshake, or a
     6	# spec-legal notification arriving between request and response, was misread as the
     7	# answer or crashed the probe — the exact class of error the module's own docstring
     8	# forbids. These tests speak to real child processes (stub_mcp_server.py) through the
     9	# real CLI and assert on its stdout, stderr and exit codes.
    10	set -uo pipefail
    11	HERE="$(cd "$(dirname "$0")" && pwd)"
    12	# shellcheck disable=SC1091
    13	. "$HERE/lib.sh"
    14	
    15	need python3 "xcode-select --install"
    16	MT="$HERE/../tool-templates/mcp_tools.py"
    17	STUB="$HERE/stub_mcp_server.py"
    18	
    19	cat > "$SB/cfg.json" <<EOF
    20	{
    21	  "mcpServers": {
    22	    "plain":  {"command": "python3", "args": ["$STUB", "--name", "plain", "--tool", "ping=pong", "--tool", "build=ok"]},
    23	    "chatty": {"command": "python3", "args": ["$STUB", "--name", "chatty", "--banner", "starting chatty v1...", "--notify-before-reply", "--tool", "ping=pong"]},
    24	    "gated":  {"command": "python3", "args": ["$STUB", "--name", "gated", "--stall-tools", "--tool", "hidden=x"]}
    25	  }
    26	}
    27	EOF
    28	
    29	# --- a well-behaved server lists cleanly (the baseline the rest lean on) ---
    30	python3 "$MT" list --config "$SB/cfg.json" --server plain >"$SB/plain.out" 2>&1
    31	assert_eq "0" "$?" "a plain server lists with rc 0"
    32	assert_contains "$SB/plain.out" "ping" "the tool names are listed"
    33	assert_contains "$SB/plain.out" "plain 1.0-stub" "serverInfo name and version are reported"
    34	
    35	# --- a banner line and interleaved notifications must not derail the probe ---
    36	python3 "$MT" list --config "$SB/cfg.json" --server chatty >"$SB/chatty.out" 2>&1
    37	assert_eq "0" "$?" "a server with a stdout banner and notifications still lists (rc 0)"
    38	assert_contains "$SB/chatty.out" "ping" "the real tools/list answer is found past the chatter"
    39	assert_not_contains "$SB/chatty.out" "Traceback" "no crash on non-JSON or notification lines"
    40	
    41	# --- a server that never answers tools/list is a TIMEOUT, never an empty list ---
    42	red "a gated server reads as a timeout naming the approval dialog, not as zero tools" 2 "approval dialog" \
    43	  python3 "$MT" list --config "$SB/cfg.json" --server gated --timeout 3
    44	python3 "$MT" list --config "$SB/cfg.json" --server gated --timeout 3 >"$SB/gated.out" 2>&1 || true
    45	assert_not_contains "$SB/gated.out" "0 tools" "the gated server is never reported as having zero tools"
    46	
    47	# --- compare refuses when one side failed to list ---
    48	red "compare with an unlistable side refuses rather than reporting no collisions" 2 "Refusing to compare" \
    49	  python3 "$MT" compare --config "$SB/cfg.json" --server plain --against gated --timeout 3
    50	
    51	# --- compare finds the collision between two healthy servers ---
    52	python3 "$MT" compare --config "$SB/cfg.json" --server plain --against chatty >"$SB/cmp.out" 2>&1
    53	assert_eq "0" "$?" "compare of two healthy servers exits 0"
    54	assert_contains "$SB/cmp.out" "EXACT NAME COLLISIONS: 1" "the shared 'ping' shows as an exact collision"
    55	
    56	# --- no zombie children left behind ---
    57	sleep 1
    58	leftovers="$(pgrep -f "stub_mcp_server.py --name (plain|chatty|gated)" 2>/dev/null | wc -l | tr -d ' ')"
    59	assert_eq "0" "$leftovers" "no stub child processes survive the probes"
    60	
    61	finish
FILE test-template-compose.sh
     1	#!/usr/bin/env bash
     2	# test-template-compose.sh — templates containing templates (INVENTORY item 4; the
     3	# SPEC's composition model: "a template may also list other templates as members, and
     4	# that is the point — composition is the mechanism, not a convenience").
     5	#
     6	# Exercised against the REAL template.py and the REAL check-prose installer (file
     7	# copies, no network), with a test catalogue injected through ASTRA_TEMPLATES_JSON.
     8	set -uo pipefail
     9	HERE="$(cd "$(dirname "$0")" && pwd)"
    10	# shellcheck disable=SC1091
    11	. "$HERE/lib.sh"
    12	
    13	need python3 "xcode-select --install"
    14	need git "system-present"
    15	TPL="$HERE/../lib/template.py"
    16	
    17	REPO="$SB/repo"
    18	mkdir -p "$REPO"
    19	git -C "$REPO" init -q
    20	
    21	CAT="$SB/templates.json"
    22	cat > "$CAT" <<'EOF'
    23	{"templates": {
    24	  "base-writing": {"description": "the leaf", "tools": ["check-prose"]},
    25	  "composed":     {"description": "a wrapper whose only member is another template",
    26	                   "templates": ["base-writing"], "tools": []},
    27	  "cyclic-a":     {"description": "half a cycle", "templates": ["cyclic-b"], "tools": []},
    28	  "cyclic-b":     {"description": "other half", "templates": ["cyclic-a"], "tools": []},
    29	  "bad-member":   {"description": "names a template that does not exist",
    30	                   "templates": ["no-such-template"], "tools": []}
    31	}}
    32	EOF
    33	
    34	# --- installing a composed template installs its members' tools ---
    35	out="$SB/install.out"
    36	ASTRA_TEMPLATES_JSON="$CAT" python3 "$TPL" install composed --into "$REPO" >"$out" 2>&1
    37	assert_eq "0" "$?" "installing the composed template succeeds"
    38	assert_file "$REPO/.astra/check-prose/check-prose.js" \
    39	  "the member template's tool actually landed — composition resolves transitively"
    40	
    41	# --- show resolves the closure, so a human sees what an install will do ---
    42	out="$SB/show.out"
    43	ASTRA_TEMPLATES_JSON="$CAT" python3 "$TPL" show composed >"$out" 2>&1
    44	assert_contains "$out" "check-prose" "show displays the RESOLVED tool set, not the empty flat array"
    45	
    46	# --- overlap claims are transitive: a composed claim protects a shared tool ---
    47	ASTRA_TEMPLATES_JSON="$CAT" python3 "$TPL" install base-writing --into "$REPO" >/dev/null 2>&1
    48	out="$SB/uninstall.out"
    49	ASTRA_TEMPLATES_JSON="$CAT" python3 "$TPL" uninstall composed --into "$REPO" >"$out" 2>&1
    50	assert_contains "$out" "KEPT" "uninstalling the wrapper keeps the tool the leaf still claims"
    51	assert_file "$REPO/.astra/check-prose/check-prose.js" "and the shared tool survives on disk"
    52	ASTRA_TEMPLATES_JSON="$CAT" python3 "$TPL" uninstall base-writing --into "$REPO" >/dev/null 2>&1
    53	assert_no_file "$REPO/.astra/check-prose/check-prose.js" \
    54	  "removing the last claimant removes the tool"
    55	
    56	# --- a cycle is a loud, named refusal, not a stack overflow or a silent no-op ---
    57	red "a template cycle is refused by name" 65 "template cycle" \
    58	  env ASTRA_TEMPLATES_JSON="$CAT" python3 "$TPL" install cyclic-a --into "$REPO"
    59	
    60	# --- an unknown member template is a loud refusal too ---
    61	red "a member template that does not exist is refused by name" 65 "no such template: no-such-template" \
    62	  env ASTRA_TEMPLATES_JSON="$CAT" python3 "$TPL" install bad-member --into "$REPO"
    63	
    64	finish
FILE test-tooljson.sh
     1	#!/usr/bin/env bash
     2	# test-tooljson.sh — the tool.json reader (Phase 6.1 of the tool-template roadmap).
     3	#
     4	# Seven tools/mcp-*/tool.json descriptors have existed since before this project and
     5	# NOTHING read them (INVENTORY.md: "seven dead files"). The reader converts them into a
     6	# validated registry: every descriptor either parses into a known shape or fails with a
     7	# named reason. Dependencies are declared BY ECOSYSTEM (brew:, npm:, uv:, human:) —
     8	# brew-only under-declares more than half of what is here, and 'a human must grant this
     9	# in System Settings' is a real dependency class on this machine.
    10	set -uo pipefail
    11	HERE="$(cd "$(dirname "$0")" && pwd)"
    12	# shellcheck disable=SC1091
    13	. "$HERE/lib.sh"
    14	
    15	need python3 "xcode-select --install"
    16	READER="$HERE/../lib/tooljson.py"
    17	
    18	# --- the seven real descriptors all validate (dead files become a live registry) ---
    19	out="$SB/list.out"
    20	python3 "$READER" list >"$out" 2>"$SB/list.err"
    21	assert_eq "0" "$?" "every existing tool.json in the repo validates"
    22	for t in mcp-xcode mcp-kickerd mcp-ios-simulator mcp-mobile-mcp mcp-mac-control-mcp mcp-xcode-mcp-server mcp-XcodeBuildMCP; do
    23	  assert_contains "$out" "$t" "the registry lists $t"
    24	done
    25	assert_contains "$SB/list.err" "legacy dependency" \
    26	  "bare legacy dependency tokens are accepted but reported, so they get migrated"
    27	
    28	# --- deps are resolvable by ecosystem ---
    29	out="$SB/deps.out"
    30	python3 "$READER" deps mcp-ios-simulator >"$out" 2>&1
    31	assert_eq "0" "$?" "deps resolves a named tool"
    32	assert_contains "$out" "npm: ios-simulator-mcp" "an npm-qualified dependency lands in the npm group"
    33	
    34	# --- the rejection surface, each with a named reason ---
    35	D="$SB/fake-tool"
    36	mkdir -p "$D"
    37	
    38	printf '{"description": "d", "provides": "cli", "dependencies": []}' > "$D/tool.json"
    39	red "a descriptor without a name is rejected" 65 "has no 'name'" \
    40	  python3 "$READER" validate "$D/tool.json"
    41	
    42	printf '{"name": "other-name", "description": "d", "provides": "cli", "dependencies": []}' > "$D/tool.json"
    43	red "a name that does not match its directory is rejected" 65 "does not match its directory" \
    44	  python3 "$READER" validate "$D/tool.json"
    45	
    46	printf '{"name": "fake-tool", "provides": "cli", "dependencies": []}' > "$D/tool.json"
    47	red "a descriptor without a description is rejected" 65 "has no 'description'" \
    48	  python3 "$READER" validate "$D/tool.json"
    49	
    50	printf '{"name": "fake-tool", "description": "d", "provides": "mcp-server", "dependencies": []}' > "$D/tool.json"
    51	red "provides mcp-server without a server name is rejected" 65 "provides 'mcp-server' but names no 'server'" \
    52	  python3 "$READER" validate "$D/tool.json"
    53	
    54	printf '{"name": "fake-tool", "description": "d", "provides": "cli", "dependencies": ["cargo:ripgrep"]}' > "$D/tool.json"
    55	red "an unknown dependency ecosystem is rejected by name" 65 "unknown dependency ecosystem 'cargo'" \
    56	  python3 "$READER" validate "$D/tool.json"
    57	
    58	printf '{"name": "fake-tool", "description": "d", "provides": "cli", "dependencies": [], "backed_by": "tools/no-such-dir"}' > "$D/tool.json"
    59	red "a backed_by that does not exist is rejected" 65 "backed_by 'tools/no-such-dir' does not exist" \
    60	  python3 "$READER" validate "$D/tool.json"
    61	
    62	# Third-party adoption fields (ROADMAP phase 6): source + version + digest travel
    63	# together or not at all — a coordinate without a pin is an unrepeatable install.
    64	printf '{"name": "fake-tool", "description": "d", "provides": "cli", "dependencies": [], "source": "github:someone/thing"}' > "$D/tool.json"
    65	red "a source coordinate without a version pin is rejected" 65 "'source' requires 'version'" \
    66	  python3 "$READER" validate "$D/tool.json"
    67	
    68	printf '{"name": "fake-tool", "description": "d", "provides": "cli", "dependencies": ["human:Full Disk Access for Mail"], "source": "github:someone/thing", "version": "1.2.3", "digest": "sha256:abc"}' > "$D/tool.json"
    69	out="$SB/ok.out"
    70	python3 "$READER" validate "$D/tool.json" >"$out" 2>&1
    71	assert_eq "0" "$?" "a fully-pinned third-party descriptor with a human-grant dependency validates"
    72	assert_contains "$out" "human: Full Disk Access for Mail" \
    73	  "the human-grant dependency class is first-class, not an afterthought"
    74	
    75	finish
FILE test-astra-update-portability.sh
     1	#!/usr/bin/env bash
     2	# test-astra-update-portability.sh — Phase 6: a cloned repo must update on a machine
     3	# where the recorded source path does not exist.
     4	#
     5	# astra-install records an ABSOLUTE source path and astra-update required it to exist,
     6	# so a repo cloned to another machine could never update — which forecloses third-party
     7	# adoption entirely (ROADMAP phase 6). The updater now resolves the source with
     8	# fallbacks: the recorded path, then $ASTRA_SOURCE, then a sibling directory of the
     9	# repo's parent carrying the source's basename (the cloned-workspace convention). When
    10	# nothing resolves, SOURCE GONE names the remedy instead of dead-ending.
    11	set -uo pipefail
    12	HERE="$(cd "$(dirname "$0")" && pwd)"
    13	# shellcheck disable=SC1091
    14	. "$HERE/lib.sh"
    15	
    16	need python3 "xcode-select --install"
    17	CANON="$HERE/../lib/astra-update"
    18	
    19	# A fake source tree and a fake repo whose manifest records a DEAD absolute path.
    20	WORK="$SB/work"
    21	mkdir -p "$WORK/checkouts/my-astra/tools/footool" "$WORK/checkouts/consumer/.astra/footool"
    22	printf 'echo v2\n' > "$WORK/checkouts/my-astra/tools/footool/foo.sh"
    23	printf 'echo v1\n' > "$WORK/checkouts/consumer/.astra/footool/foo.sh"
    24	V1SHA="$(python3 -c "import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest()[:16])" "$WORK/checkouts/consumer/.astra/footool/foo.sh")"
    25	cat > "$WORK/checkouts/consumer/.astra/manifest.json" <<EOF
    26	{"tools": {"footool": {"source": "/machine-that-no-longer-exists/my-astra",
    27	  "files": {"foo.sh": "$V1SHA"}}}}
    28	EOF
    29	cp "$CANON" "$WORK/checkouts/consumer/.astra/astra-update"
    30	chmod +x "$WORK/checkouts/consumer/.astra/astra-update"
    31	
    32	# --- no fallback available: SOURCE GONE, and the message says what to do ---
    33	mv "$WORK/checkouts/my-astra" "$WORK/elsewhere-astra"
    34	out="$SB/gone.out"
    35	env -u ASTRA_SOURCE "$WORK/checkouts/consumer/.astra/astra-update" >"$out" 2>&1
    36	assert_contains "$out" "SOURCE GONE" "a dead recorded path is reported"
    37	assert_contains "$out" "ASTRA_SOURCE" "and the report names the env override remedy"
    38	
    39	# --- ASTRA_SOURCE resolves the source explicitly ---
    40	out="$SB/env.out"
    41	ASTRA_SOURCE="$WORK/elsewhere-astra" "$WORK/checkouts/consumer/.astra/astra-update" >"$out" 2>&1
    42	assert_contains "$out" "BEHIND" "with ASTRA_SOURCE set, the stale copy is seen as behind"
    43	out="$SB/envpull.out"
    44	ASTRA_SOURCE="$WORK/elsewhere-astra" "$WORK/checkouts/consumer/.astra/astra-update" --pull >"$out" 2>&1
    45	assert_contains "$out" "updated" "and --pull updates it"
    46	assert_contains "$WORK/checkouts/consumer/.astra/footool/foo.sh" "v2" "the file really moved forward"
    47	
    48	# --- the sibling convention: source cloned beside the repo under its recorded basename ---
    49	printf 'echo v1\n' > "$WORK/checkouts/consumer/.astra/footool/foo.sh"   # stale again
    50	cat > "$WORK/checkouts/consumer/.astra/manifest.json" <<EOF
    51	{"tools": {"footool": {"source": "/machine-that-no-longer-exists/my-astra",
    52	  "files": {"foo.sh": "$V1SHA"}}}}
    53	EOF
    54	mv "$WORK/elsewhere-astra" "$WORK/checkouts/my-astra"
    55	out="$SB/sibling.out"
    56	env -u ASTRA_SOURCE "$WORK/checkouts/consumer/.astra/astra-update" >"$out" 2>&1
    57	assert_contains "$out" "BEHIND" "a sibling clone named like the recorded source is found without any env"
    58	assert_contains "$out" "my-astra" "and the fallback says which source it resolved"
    59	
    60	finish

