    99	def _extract_meta(params: Mapping[str, Any] | None) -> RequestParamsMeta | None:
   100	    """Lift `_meta` from raw params; `None` when absent or malformed, so
   101	    context construction is independent of params validity."""
   102	    if not params or "_meta" not in params:
   103	        return None
   104	    try:
   105	        return RequestParams.model_validate(params, by_name=False).meta
   106	    except ValidationError:
   107	        return None
