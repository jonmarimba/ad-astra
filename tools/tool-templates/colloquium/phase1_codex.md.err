   126	
   127	async def aclose_shielded(connection: Connection) -> None:
   128	    """Unwind ``connection.exit_stack`` under a shielded, bounded scope.
   129	
   130	    Called from a driver's ``finally``: the shield lets per-connection cleanup
   131	    callbacks run even when the driver itself is being cancelled, the
   132	    `_EXIT_STACK_CLOSE_TIMEOUT` bound stops a hung callback wedging shutdown,
   133	    and a raising callback is logged-and-swallowed so it never masks the
   134	    driver's own exception.
   135	    """
   136	    with anyio.move_on_after(_EXIT_STACK_CLOSE_TIMEOUT, shield=True) as scope:
   137	        try:
   138	            await connection.exit_stack.aclose()
   139	        except Exception:
   140	            logger.exception("connection exit_stack cleanup raised")
   141	    if scope.cancelled_caught:
   142	        logger.warning(
   143	            "connection exit_stack cleanup exceeded %s seconds; abandoning remaining callbacks",
   144	            _EXIT_STACK_CLOSE_TIMEOUT,
   145	        )
