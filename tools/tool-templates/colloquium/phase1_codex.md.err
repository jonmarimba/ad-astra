     1	#!/usr/bin/env python3
     2	"""mcp_config — load and validate the aggregator's upstream config (_mcp_info.json).
     3	
     4	The shape is Claude Code's own — {"mcpServers": {"<name>": {"command": ..., "args": [...]}}} —
     5	because Jonathan already reads and writes that shape, and an entry can then move between this
     6	file and a real .mcp.json by copy and paste. Two additive fields belong to the wrapper:
     7	
     8	  prefix  exposed-name prefix for this upstream's tools, defaulting to "<name>__"
     9	  quirks  list of named per-upstream behaviours; today only "require_xcode" (wait for a live
    10	          Xcode before connecting). Keeping quirks per-upstream is the point: the old parser
    11	          made require-Xcode a positional boolean every upstream had to answer, so every
    12	          server was described in Xcode's terms whether or not it had anything to do with it.
    13	
    14	EVERYTHING ELSE IS REJECTED BY NAME. Claude Code's format also carries env, cwd and url; the
    15	daemon passes only command and args to the child, so accepting those fields would drop them
    16	silently and the failure would surface later, at the first call, pointing at nothing. A field
    17	we do not implement is an error naming the field and the server, at load — the same policy for
    18	keys we have never heard of. (tool-templates increment 1.1; roadmap: "red when a config with
    19	url is accepted silently".)
    20	
    21	Runs on python3 >= 3.9 (the tests use the system interpreter, which is 3.9.6 on this machine;
    22	scheduled jobs get the same one).
    23	
    24	CLI, used by test-mcp-front-config.sh and handy for a human:
    25	    mcp_config.py validate <file>     rc 0 and one line per upstream, or a named rejection
    26	Exit codes: 65 (EX_DATAERR) config invalid, 66 (EX_NOINPUT) unreadable file.
    27	"""
    28	import json
    29	import sys
    30	
    31	KNOWN_QUIRKS = frozenset({"require_xcode"})
    32	# Claude Code fields the daemon does not pass through yet. Named individually so the error
    33	# can say "unimplemented" — which invites implementing — rather than "unknown", which reads
    34	# as a typo. type/transport/headers travel with url in real .mcp.json files.
    35	UNIMPLEMENTED_FIELDS = ("env", "cwd", "url", "type", "transport", "headers")
    36	IMPLEMENTED_FIELDS = frozenset({"command", "args", "prefix", "quirks"})
    37	
    38	
    39	class ConfigError(ValueError):
    40	    """A named rejection. str() is the full user-facing message."""
    41	
    42	
    43	class UpstreamSpec:
    44	    def __init__(self, name, command, args, prefix, quirks):
    45	        self.name = name
    46	        self.command = command
    47	        self.args = args
    48	        self.prefix = prefix
    49	        self.quirks = quirks
    50	
    51	    @property
    52	    def require_xcode(self):
    53	        return "require_xcode" in self.quirks
    54	
    55	
    56	def _parse_server(name, spec):
    57	    if not isinstance(spec, dict):
    58	        raise ConfigError("server %r must be an object, got %s" % (name, type(spec).__name__))
    59	    for field in UNIMPLEMENTED_FIELDS:
    60	        if field in spec:
    61	            raise ConfigError(
    62	                "unimplemented field '%s' on server '%s' — the wrapper passes only command "
    63	                "and args to the child; remove it or implement it, but do not expect it to "
    64	                "take effect" % (field, name))
    65	    for field in spec:
    66	        if field not in IMPLEMENTED_FIELDS:
    67	            raise ConfigError("unknown field '%s' on server '%s'" % (field, name))
    68	
    69	    command = spec.get("command")
    70	    if not isinstance(command, str) or not command:
    71	        raise ConfigError("server '%s' has no 'command' (non-empty string required)" % name)
    72	
    73	    args = spec.get("args", [])
    74	    if not isinstance(args, list) or not all(isinstance(a, str) for a in args):
    75	        raise ConfigError("server '%s': 'args' must be a list of strings" % name)
    76	
    77	    prefix = spec.get("prefix", name + "__")
    78	    if not isinstance(prefix, str):
    79	        raise ConfigError("server '%s': 'prefix' must be a string" % name)
    80	
    81	    quirks = spec.get("quirks", [])
    82	    if not isinstance(quirks, list) or not all(isinstance(q, str) for q in quirks):
    83	        raise ConfigError("server '%s': 'quirks' must be a list of strings" % name)
    84	    for q in quirks:
    85	        if q not in KNOWN_QUIRKS:
    86	            raise ConfigError("unknown quirk '%s' on server '%s' (known: %s)"
    87	                              % (q, name, ", ".join(sorted(KNOWN_QUIRKS))))
    88	
    89	    return UpstreamSpec(name, command, list(args), prefix, frozenset(quirks))
    90	
    91	
    92	def load(path):
    93	    """-> list of UpstreamSpec, in the file's order. Raises ConfigError (bad content) or
    94	    OSError (unreadable file); the caller chooses the exit code."""
    95	    try:
    96	        raw = open(path, encoding="utf-8").read()
    97	    except OSError as e:
    98	        raise OSError("mcp_config: cannot read %s (%s)" % (path, e))
    99	    try:
   100	        cfg = json.loads(raw)
   101	    except ValueError as e:
   102	        # A jsonc human file lands here. Say so: the difference between a typo and a
   103	        # deliberate comment is the whole remedy. Same wording as mcp_tools.py on purpose.
   104	        raise ConfigError(
   105	            "%s is not strict JSON (%s). If this is the commented human-owned file, point "
   106	            "at the generated one instead — comments are only allowed there." % (path, e))
   107	    servers = cfg.get("mcpServers") if isinstance(cfg, dict) else None
   108	    if not isinstance(servers, dict) or not servers:
   109	        raise ConfigError("%s has no non-empty mcpServers object" % path)
   110	    specs = [_parse_server(name, spec) for name, spec in servers.items()]
   111	    _check_prefixes(specs)
   112	    return specs
   113	
   114	
   115	def _check_prefixes(specs):
   116	    """The prefix set must compose into an unambiguous surface (increment 1.3).
   117	
   118	    Two upstreams sharing a prefix collide exposed names. A prefix that is a prefix of
   119	    another — 'a__' and 'a__b__' — makes routing 'a__b__tool' depend on iteration order.
   120	    An empty prefix beside another upstream exposes bare names that cannot be routed
   121	    back. All three are author mistakes; reject them at load, when the author can still
   122	    fix them, never at call time as a misroute."""
   123	    if len(specs) < 2:
   124	        return
   125	    seen = {}
   126	    for s in specs:
   127	        if s.prefix == "":
   128	            raise ConfigError(
   129	                "server '%s' has an empty prefix beside other upstreams — its bare tool "
   130	                "names could not be routed back to it" % s.name)
   131	        if s.prefix in seen:
   132	            raise ConfigError("servers '%s' and '%s' have the same prefix '%s' — their "
   133	                              "exposed names would collide" % (seen[s.prefix], s.name, s.prefix))
   134	        seen[s.prefix] = s.name
   135	    ordered = sorted(specs, key=lambda s: s.prefix)
   136	    for a, b in zip(ordered, ordered[1:]):
   137	        if b.prefix.startswith(a.prefix):
   138	            raise ConfigError(
   139	                "server '%s' prefix '%s' is a prefix of server '%s' prefix '%s' — routing "
   140	                "a name under the longer one would be order-dependent"
   141	                % (a.name, a.prefix, b.name, b.prefix))
   142	
   143	
   144	def resolve_specs(environ):
   145	    """How the daemon picks its upstreams (increment 1.2). One mechanism wins, visibly:
   146	
   147	    - XCODE_MCP_FRONT_UPSTREAMS set: HARD ERROR. The colon/comma format silently corrupted
   148	      a colon in a command path and a comma in an argument; it is replaced, not deprecated,
   149	      because a daemon half-honouring both mechanisms would hide which one won.
   150	    - XCODE_MCP_FRONT_MCP_INFO set: load that _mcp_info.json.
   151	    - neither: the deployed single-upstream env contract, unchanged — UPSTREAM_CMD
   152	      (default xcrun), UPSTREAM_ARGS (default mcpbridge), REQUIRE_XCODE (default 1),
   153	      served unprefixed exactly as before.
   154	    """
   155	    if environ.get("XCODE_MCP_FRONT_UPSTREAMS"):
   156	        raise ConfigError(
   157	            "XCODE_MCP_FRONT_UPSTREAMS has been replaced by _mcp_info.json — set "
   158	            "XCODE_MCP_FRONT_MCP_INFO=<path> instead. The colon/comma format corrupts a "
   159	            "command path containing ':' and an argument containing ',', silently.")
   160	    info = environ.get("XCODE_MCP_FRONT_MCP_INFO")
   161	    if info:
   162	        return load(info)
   163	    quirks = frozenset({"require_xcode"}) if environ.get(
   164	        "XCODE_MCP_FRONT_REQUIRE_XCODE", "1") == "1" else frozenset()
   165	    return [UpstreamSpec(
   166	        name="default",
   167	        command=environ.get("XCODE_MCP_FRONT_UPSTREAM_CMD", "xcrun"),
   168	        args=environ.get("XCODE_MCP_FRONT_UPSTREAM_ARGS", "mcpbridge").split(),
   169	        prefix="",
   170	        quirks=quirks,
   171	    )]
   172	
   173	
   174	def _print_specs(upstreams):
   175	    for u in upstreams:
   176	        quirks = ",".join(sorted(u.quirks)) or "-"
   177	        print("%s  prefix=%s  quirks=%s  %s %s" % (u.name, u.prefix, quirks, u.command,
   178	                                                   " ".join(u.args)))
   179	
   180	
   181	def main(argv):
   182	    import os
   183	    if len(argv) == 2 and argv[1] == "resolve":
   184	        try:
   185	            upstreams = resolve_specs(os.environ)
   186	        except ConfigError as e:
   187	            print("mcp_config: %s" % e, file=sys.stderr)
   188	            return 65
   189	        except OSError as e:
   190	            print(str(e), file=sys.stderr)
   191	            return 66
   192	        _print_specs(upstreams)
   193	        return 0
   194	    if len(argv) != 3 or argv[1] != "validate":
   195	        print("usage: mcp_config.py validate <file> | resolve", file=sys.stderr)
   196	        return 64
   197	    try:
   198	        upstreams = load(argv[2])
   199	    except ConfigError as e:
   200	        print("mcp_config: %s" % e, file=sys.stderr)
   201	        return 65
   202	    except OSError as e:
   203	        print(str(e), file=sys.stderr)
   204	        return 66
   205	    _print_specs(upstreams)
   206	    return 0
   207	
   208	
   209	if __name__ == "__main__":
   210	    sys.exit(main(sys.argv))
     1	#!/usr/bin/env bash
     2	# test-mcp-front-config.sh — the aggregator's config loader (tool-templates increment 1.1).
     3	#
     4	# The loader reads a Claude-Code-shaped _mcp_info.json — {"mcpServers": {name: {command,
     5	# args}}} plus the wrapper's additive fields (prefix, quirks) — and REJECTS anything it
     6	# would otherwise silently drop. The spec advertises the full Claude Code shape while the
     7	# daemon passes only command and args to the child, so an ignored `env` or `url` is a
     8	# late failure waiting for the first real call; rejection with the field's name is the
     9	# contract. Exercised through the module's own CLI (validate <file>), asserting by effect
    10	# on stdout, stderr and exit codes.
    11	set -uo pipefail
    12	HERE="$(cd "$(dirname "$0")" && pwd)"
    13	# shellcheck disable=SC1091
    14	. "$HERE/lib.sh"
    15	
    16	need python3 "xcode-select --install or brew install python3"
    17	LOADER="$HERE/../xcode-mcp-front/mcp_config.py"
    18	assert_file "$LOADER" "mcp_config.py exists next to the daemon"
    19	
    20	ok_cfg="$SB/good.json"
    21	cat > "$ok_cfg" <<'EOF'
    22	{
    23	  "mcpServers": {
    24	    "xcode": {"command": "xcrun", "args": ["mcpbridge"], "quirks": ["require_xcode"]},
    25	    "drews": {"command": "uvx", "args": ["drews-xcode-mcp"]}
    26	  }
    27	}
    28	EOF
    29	
    30	# --- the happy path: both upstreams parsed, prefixes defaulted from the server name ---
    31	out="$SB/good.out"
    32	python3 "$LOADER" validate "$ok_cfg" >"$out" 2>&1
    33	assert_eq "0" "$?" "a valid two-upstream config validates"
    34	assert_contains "$out" "xcode" "validate lists the first upstream"
    35	assert_contains "$out" "drews" "validate lists the second upstream"
    36	assert_contains "$out" "xcode__" "prefix defaults to the server name plus __"
    37	
    38	# --- a command path containing a colon and an argument containing a comma survive ---
    39	# Both are silently corrupted by the env-var format this file replaces (split(':') and
    40	# split(',')); the JSON path must round-trip them intact.
    41	tricky="$SB/tricky.json"
    42	cat > "$tricky" <<'EOF'
    43	{
    44	  "mcpServers": {
    45	    "odd": {"command": "/opt/we:ird/bin/serve", "args": ["--label", "a,b,c"]}
    46	  }
    47	}
    48	EOF
    49	out="$SB/tricky.out"
    50	python3 "$LOADER" validate "$tricky" >"$out" 2>&1
    51	assert_eq "0" "$?" "colon-in-command and comma-in-arg config validates"
    52	assert_contains "$out" "/opt/we:ird/bin/serve" "a colon inside the command path survives parsing"
    53	assert_contains "$out" "a,b,c" "a comma inside one argument stays one argument"
    54	
    55	# --- unimplemented Claude Code fields are REJECTED BY NAME, never ignored ---
    56	for field in env cwd url; do
    57	  bad="$SB/has-$field.json"
    58	  python3 - "$ok_cfg" "$bad" "$field" <<'PY'
    59	import json, sys
    60	cfg = json.load(open(sys.argv[1]))
    61	cfg["mcpServers"]["xcode"][sys.argv[3]] = {"A": "1"} if sys.argv[3] == "env" else "somewhere"
    62	json.dump(cfg, open(sys.argv[2], "w"))
    63	PY
    64	  red "config with '$field' is rejected naming the field and the server" 65 "unimplemented field '$field' on server 'xcode'" \
    65	    python3 "$LOADER" validate "$bad"
    66	done
    67	
    68	# --- the rest of the rejection surface, each with its own message ---
    69	printf '{"mcpServers": {}}' > "$SB/empty.json"
    70	red "empty mcpServers must fail" 65 "no non-empty mcpServers" \
    71	  python3 "$LOADER" validate "$SB/empty.json"
    72	
    73	printf '{"mcpServers": {"x": {"args": ["a"]}}}' > "$SB/nocmd.json"
    74	red "server without a command must fail naming the server" 65 "server 'x' has no 'command'" \
    75	  python3 "$LOADER" validate "$SB/nocmd.json"
    76	
    77	printf '{"mcpServers": {"x": {"command": "c", "args": "not-a-list"}}}' > "$SB/badargs.json"
    78	red "args that are not a list of strings must fail" 65 "server 'x': 'args' must be a list of strings" \
    79	  python3 "$LOADER" validate "$SB/badargs.json"
    80	
    81	printf '{"mcpServers": {"x": {"command": "c", "quirks": ["click_the_moon"]}}}' > "$SB/badquirk.json"
    82	red "unknown quirk must fail naming it" 65 "unknown quirk 'click_the_moon' on server 'x'" \
    83	  python3 "$LOADER" validate "$SB/badquirk.json"
    84	
    85	printf '{"mcpServers": {"x": {"command": "c", "transporter": "beam"}}}' > "$SB/unknownkey.json"
    86	red "an unrecognised key must fail, not be dropped" 65 "unknown field 'transporter' on server 'x'" \
    87	  python3 "$LOADER" validate "$SB/unknownkey.json"
    88	
    89	printf '{\n  // a jsonc comment\n  "mcpServers": {"x": {"command": "c"}}\n}' > "$SB/jsonc.json"
    90	red "jsonc gets the point-at-the-generated-file message, not a bare parse error" 65 "not strict JSON" \
    91	  python3 "$LOADER" validate "$SB/jsonc.json"
    92	
    93	red "missing config file must fail as a missing file" 66 "cannot read" \
    94	  python3 "$LOADER" validate "$SB/does-not-exist.json"
    95	
    96	# --- the prefix set must compose into an unambiguous surface (increment 1.3) ---
    97	# Two upstreams sharing a prefix would collide exposed names; a prefix that is a prefix
    98	# of another ('a__' and 'a__b__') makes routing 'a__b__tool' order-dependent. Both are
    99	# config mistakes and both are rejected at load, when the author can still fix them —
   100	# not at call time, when they surface as a misroute.
   101	printf '{"mcpServers": {"one": {"command": "c", "prefix": "x__"}, "two": {"command": "c", "prefix": "x__"}}}' > "$SB/dup-prefix.json"
   102	red "two upstreams with the same prefix are rejected" 65 "same prefix 'x__'" \
   103	  python3 "$LOADER" validate "$SB/dup-prefix.json"
   104	
   105	printf '{"mcpServers": {"a": {"command": "c"}, "abi": {"command": "c", "prefix": "a__b__"}}}' > "$SB/nested-prefix.json"
   106	red "a prefix that is a prefix of another is rejected as order-dependent" 65 "prefix of" \
   107	  python3 "$LOADER" validate "$SB/nested-prefix.json"
   108	
   109	printf '{"mcpServers": {"a": {"command": "c", "prefix": ""}, "b": {"command": "c"}}}' > "$SB/empty-prefix.json"
   110	red "an empty prefix beside another upstream is rejected (bare names would be unroutable)" 65 "empty prefix" \
   111	  python3 "$LOADER" validate "$SB/empty-prefix.json"
   112	
   113	# --- resolve: how the daemon picks its upstreams (increment 1.2) ---
   114	# The colon/comma env format is REPLACED, not deprecated: a set XCODE_MCP_FRONT_UPSTREAMS
   115	# is a hard error pointing at the file, because the old parser silently corrupted a colon
   116	# in a command path and a comma in an argument, and a daemon that half-honoured both
   117	# mechanisms would hide which one won.
   118	out="$SB/resolve-file.out"
   119	env -u XCODE_MCP_FRONT_UPSTREAMS XCODE_MCP_FRONT_MCP_INFO="$ok_cfg" \
   120	  python3 "$LOADER" resolve >"$out" 2>&1
   121	assert_eq "0" "$?" "resolve honours XCODE_MCP_FRONT_MCP_INFO"
   122	assert_contains "$out" "xcode__" "resolve keeps the xcode__ prefix from the file"
   123	assert_contains "$out" "drews__" "resolve keeps the drews__ prefix from the file"
   124	
   125	red "a set XCODE_MCP_FRONT_UPSTREAMS is refused, pointing at the file" 65 "replaced by _mcp_info.json" \
   126	  env XCODE_MCP_FRONT_UPSTREAMS="xcode:1:xcrun:mcpbridge" python3 "$LOADER" resolve
   127	
   128	red "UPSTREAMS set alongside the file is still refused — one mechanism must win visibly" 65 "replaced by _mcp_info.json" \
   129	  env XCODE_MCP_FRONT_UPSTREAMS="x:1:c" XCODE_MCP_FRONT_MCP_INFO="$ok_cfg" python3 "$LOADER" resolve
   130	
   131	# With neither set, the deployed single-upstream daemon's env contract is unchanged:
   132	# default xcrun mcpbridge, Xcode required, served unprefixed.
   133	out="$SB/resolve-single.out"
   134	env -u XCODE_MCP_FRONT_UPSTREAMS -u XCODE_MCP_FRONT_MCP_INFO \
   135	  python3 "$LOADER" resolve >"$out" 2>&1
   136	assert_eq "0" "$?" "resolve with no env keeps the single-upstream default"
   137	assert_contains "$out" "xcrun mcpbridge" "single-upstream default is still xcrun mcpbridge"
   138	assert_contains "$out" "require_xcode" "single-upstream default still waits for Xcode"
   139	
   140	out="$SB/resolve-drews.out"
   141	env -u XCODE_MCP_FRONT_UPSTREAMS -u XCODE_MCP_FRONT_MCP_INFO \
   142	  XCODE_MCP_FRONT_UPSTREAM_CMD=uvx XCODE_MCP_FRONT_UPSTREAM_ARGS=drews-xcode-mcp \
   143	  XCODE_MCP_FRONT_REQUIRE_XCODE=0 python3 "$LOADER" resolve >"$out" 2>&1
   144	assert_eq "0" "$?" "single-upstream env overrides still resolve"
   145	assert_contains "$out" "uvx drews-xcode-mcp" "single-upstream CMD/ARGS overrides survive"
   146	assert_not_contains "$out" "require_xcode" "REQUIRE_XCODE=0 drops the quirk"
   147	
   148	finish
     1	#!/usr/bin/env bash
     2	# test-mcp-front-daemon.sh — the aggregator daemon itself, by effect over its real HTTP
     3	# endpoint, with STUB upstreams (stub_mcp_server.py) instead of live Xcode.
     4	#
     5	# This is the fast-tier counterpart of the slow test-xcode-mcp-front.sh: same daemon.py,
     6	# same transport, but the upstreams are dependency-free stubs, so it asserts the
     7	# aggregation contract (config file honoured, prefixes served, calls routed, unknown
     8	# names rejected) without launching Xcode or waiting on an approval dialog. Increment 1.2:
     9	# the _mcp_info.json file replaces the corrupting colon/comma env format.
    10	#
    11	# XCODE_MCP_FRONT_AUTO_ALLOW=0 always: the clicker path runs osascript against System
    12	# Events, and a test must never send Apple Events from an unstable shell identity
    13	# (test-xcode-mcp-front.sh documents the tmux-grant disease).
    14	set -uo pipefail
    15	HERE="$(cd "$(dirname "$0")" && pwd)"
    16	# shellcheck disable=SC1091
    17	. "$HERE/lib.sh"
    18	
    19	need uv "brew install uv"
    20	need curl "system-present"
    21	need python3 "xcode-select --install"
    22	
    23	DAEMON="$HERE/../xcode-mcp-front/daemon.py"
    24	STUB="$HERE/stub_mcp_server.py"
    25	PORT=8899
    26	
    27	cat > "$SB/_mcp_info.json" <<EOF
    28	{
    29	  "mcpServers": {
    30	    "alpha": {"command": "python3", "args": ["$STUB", "--name", "alpha", "--tool", "ping=alpha-pong", "--tool", "build=alpha-built"]},
    31	    "beta":  {"command": "python3", "args": ["$STUB", "--name", "beta", "--tool", "ping=beta-pong"]},
    32	    "pager": {"command": "python3", "args": ["$STUB", "--name", "pager", "--page-size", "1", "--tool", "first=page-one", "--tool", "second=page-two"]}
    33	  }
    34	}
    35	EOF
    36	
    37	env -u XCODE_MCP_FRONT_UPSTREAMS \
    38	  XCODE_MCP_FRONT_MCP_INFO="$SB/_mcp_info.json" \
    39	  XCODE_MCP_FRONT_PORT="$PORT" \
    40	  XCODE_MCP_FRONT_HOME="$SB/home" \
    41	  XCODE_MCP_FRONT_AUTO_ALLOW=0 \
    42	  XCODE_MCP_FRONT_SERVER_NAME="astra-test-front" \
    43	  uv run --script "$DAEMON" >"$SB/daemon.log" 2>&1 &
    44	DPID=$!
    45	trap 'kill "$DPID" 2>/dev/null; wait "$DPID" 2>/dev/null; rm -rf "$SB"' EXIT
    46	
    47	mcp_call() { # usage: mcp_call <method> <params-json> -> raw SSE body on stdout
    48	  local method="$1" params="$2" init_resp session
    49	  init_resp="$(curl -s --max-time 10 -D - -X POST "http://127.0.0.1:$PORT/mcp" \
    50	    -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
    51	    -H "MCP-Protocol-Version: 2025-06-18" \
    52	    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"test","version":"0"}}}')"
    53	  session="$(printf '%s' "$init_resp" | grep -i "mcp-session-id" | tr -d '\r' | awk '{print $2}')"
    54	  [ -n "$session" ] || { echo "NO_SESSION"; return 1; }
    55	  curl -s --max-time 10 -X POST "http://127.0.0.1:$PORT/mcp" \
    56	    -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
    57	    -H "MCP-Protocol-Version: 2025-06-18" -H "Mcp-Session-Id: $session" \
    58	    -d "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"$method\",\"params\":$params}"
    59	}
    60	
    61	# Wait for the daemon to be up AND for both stub upstreams to be connected (the connection
    62	# managers connect asynchronously after uvicorn starts answering).
    63	waited=0
    64	until [ "$waited" -ge 30 ]; do
    65	  if ! kill -0 "$DPID" 2>/dev/null; then
    66	    fail "daemon exited during startup — its log:"; sed 's/^/        /' "$SB/daemon.log" >&2
    67	    finish; exit 1
    68	  fi
    69	  list="$(mcp_call tools/list '{}' 2>/dev/null || true)"
    70	  case "$list" in *alpha__*) break ;; esac
    71	  sleep 1; waited=$((waited+1))
    72	done
    73	
    74	printf '%s' "$list" > "$SB/list.out"
    75	assert_contains "$SB/list.out" "alpha__ping" "tools/list serves alpha's tools under the alpha__ prefix"
    76	assert_contains "$SB/list.out" "alpha__build" "tools/list serves alpha's second tool"
    77	assert_contains "$SB/list.out" "beta__ping" "tools/list serves beta's tools under the beta__ prefix"
    78	
    79	# Same tool name on both upstreams routes by prefix, not by luck.
    80	mcp_call tools/call '{"name":"alpha__ping","arguments":{}}' > "$SB/alpha.out"
    81	assert_contains "$SB/alpha.out" "alpha-pong" "alpha__ping routes to the alpha stub"
    82	mcp_call tools/call '{"name":"beta__ping","arguments":{}}' > "$SB/beta.out"
    83	assert_contains "$SB/beta.out" "beta-pong" "beta__ping routes to the beta stub, same bare name"
    84	
    85	# --- increment 1.5: a paginating upstream is drained into a full snapshot ---
    86	# Cursors are per-server opaque tokens, so the one downstream cursor used to be handed
    87	# to EVERY upstream verbatim; the pager stub serves one tool per page, and only draining
    88	# its pages produces both tools.
    89	assert_contains "$SB/list.out" "pager__first" "page one of a paginating upstream is served"
    90	assert_contains "$SB/list.out" "pager__second" "page two is served as well — the upstream was drained, not truncated"
    91	mcp_call tools/call '{"name":"pager__second","arguments":{}}' > "$SB/pager.out"
    92	assert_contains "$SB/pager.out" "page-two" "a tool from a drained later page is callable"
    93	
    94	# A downstream cursor this daemon never issued is refused, not forwarded to upstreams
    95	# whose cursor spaces it cannot belong to.
    96	mcp_call tools/list '{"cursor":"bogus-cursor"}' > "$SB/cursor.out"
    97	assert_contains "$SB/cursor.out" "error" \
    98	  "a cursor the daemon never issued is an error, not a forwarded guess"
    99	
   100	# An unrecognised exposed name is a real error, not a silent success or a misroute.
   101	mcp_call tools/call '{"name":"NotARealTool","arguments":{}}' > "$SB/unknown.out"
   102	assert_contains "$SB/unknown.out" "doesn't match any known upstream prefix" \
   103	  "an unknown exposed name returns the routing error"
   104	assert_contains "$SB/unknown.out" '"isError":true' "and it is marked as an error result"
   105	
   106	# --- increment 1.4: a dead upstream must not blank the others, and connected-but-empty
   107	# --- is not the same thing as disconnected ---
   108	# All three colloquium brands found this independently: on_list_tools served ZERO tools
   109	# for every upstream when any one was missing, so during an Xcode reconnect Drew's tools
   110	# — which need no Xcode — vanished too. gamma's command dies instantly (never connects);
   111	# delta connects fine and genuinely has zero tools. alpha must keep serving through both.
   112	cat > "$SB/_mcp_degraded.json" <<EOF
   113	{
   114	  "mcpServers": {
   115	    "alpha": {"command": "python3", "args": ["$STUB", "--name", "alpha", "--tool", "ping=alpha-pong"]},
   116	    "gamma": {"command": "python3", "args": ["-c", "import sys; sys.exit(1)"]},
   117	    "delta": {"command": "python3", "args": ["$STUB", "--name", "delta"]}
   118	  }
   119	}
   120	EOF
   121	PORT=8901
   122	env -u XCODE_MCP_FRONT_UPSTREAMS \
   123	  XCODE_MCP_FRONT_MCP_INFO="$SB/_mcp_degraded.json" \
   124	  XCODE_MCP_FRONT_PORT="$PORT" \
   125	  XCODE_MCP_FRONT_HOME="$SB/home2" \
   126	  XCODE_MCP_FRONT_AUTO_ALLOW=0 \
   127	  XCODE_MCP_FRONT_SERVER_NAME="astra-test-degraded" \
   128	  uv run --script "$DAEMON" >"$SB/daemon2.log" 2>&1 &
   129	DPID2=$!
   130	trap 'kill "$DPID" "$DPID2" 2>/dev/null; wait "$DPID" "$DPID2" 2>/dev/null; rm -rf "$SB"' EXIT
   131	
   132	# Wait only for the daemon's HTTP to answer at all — waiting for alpha__ would make the
   133	# assertion its own precondition and turn the old blank-everything defect into a timeout.
   134	waited=0
   135	until [ "$waited" -ge 20 ]; do
   136	  if ! kill -0 "$DPID2" 2>/dev/null; then
   137	    fail "degraded daemon exited during startup — its log:"; sed 's/^/        /' "$SB/daemon2.log" >&2
   138	    finish; exit 1
   139	  fi
   140	  dlist="$(mcp_call tools/list '{}' 2>/dev/null || true)"
   141	  case "$dlist" in *'"tools"'*) break ;; esac
   142	  sleep 1; waited=$((waited+1))
   143	done
   144	# Give the connection managers a few extra ticks: alpha needs to be connected AND listed.
   145	for _ in 1 2 3 4 5 6 7 8; do
   146	  case "$dlist" in *alpha__ping*) break ;; esac
   147	  sleep 1
   148	  dlist="$(mcp_call tools/list '{}' 2>/dev/null || true)"
   149	done
   150	printf '%s' "$dlist" > "$SB/dlist.out"
   151	assert_contains "$SB/dlist.out" "alpha__ping" \
   152	  "a dead upstream (gamma) does not blank the healthy one's tools"
   153	assert_not_contains "$SB/dlist.out" "gamma__" "the dead upstream contributes nothing"
   154	assert_not_contains "$SB/dlist.out" "delta__" \
   155	  "a connected upstream with zero tools contributes zero tools, and is not treated as missing"
   156	
   157	mcp_call tools/call '{"name":"alpha__ping","arguments":{}}' > "$SB/alpha2.out"
   158	assert_contains "$SB/alpha2.out" "alpha-pong" "calls to the healthy upstream still route while gamma is down"
   159	
   160	mcp_call tools/call '{"name":"gamma__anything","arguments":{}}' > "$SB/gamma.out"
   161	assert_contains "$SB/gamma.out" "[gamma] not connected right now" \
   162	  "a call to the dead upstream names IT as the unavailable one"
   163	assert_contains "$SB/gamma.out" '"isError":true' "and is an error result, not a silent success"
   164	
   165	finish
     1	#!/usr/bin/env python3
     2	"""stub_mcp_server — a minimal, dependency-free stdio MCP server for tests.
     3	
     4	Speaks just enough newline-delimited JSON-RPC for the aggregator's client to connect:
     5	initialize, notifications/initialized, tools/list, tools/call, ping. Every knob is an
     6	argument so any test (or any other agent's harness) can shape it without editing it:
     7	
     8	    stub_mcp_server.py --name alpha --tool ping=alpha-pong --tool build=done
     9	    stub_mcp_server.py --name empty                       # connects fine, zero tools
    10	    stub_mcp_server.py --name chatty --banner "starting"  # spec-illegal stdout banner line
    11	    stub_mcp_server.py --name pager --tool a=1 --tool b=2 --page-size 1   # paginates
    12	
    13	--tool NAME=REPLY declares one tool; calling it returns REPLY as text content.
    14	--banner LINE prints LINE to stdout before serving (reproduces the class of server that
    15	  breaks naive next-line readers).
    16	--notify-before-reply emits a spec-legal notification line immediately before every
    17	  response (a next-line reader misreads the notification as the answer).
    18	--stall-tools answers initialize normally and then never answers tools/list (reproduces
    19	  the approval-dialog gate that must read as a timeout, never as an empty tool list).
    20	--page-size N makes tools/list return N tools per page with a nextCursor, exercising
    21	  per-upstream cursors.
    22	Python 3.9-compatible; no third-party imports.
    23	"""
    24	import argparse
    25	import json
    26	import sys
    27	
    28	
    29	def main():
    30	    ap = argparse.ArgumentParser()
    31	    ap.add_argument("--name", required=True)
    32	    ap.add_argument("--version", default="1.0-stub")
    33	    ap.add_argument("--tool", action="append", default=[], metavar="NAME=REPLY")
    34	    ap.add_argument("--banner", default=None)
    35	    ap.add_argument("--notify-before-reply", action="store_true")
    36	    ap.add_argument("--stall-tools", action="store_true")
    37	    ap.add_argument("--page-size", type=int, default=0)
    38	    a = ap.parse_args()
    39	
    40	    tools = {}
    41	    for spec in a.tool:
    42	        name, _, reply = spec.partition("=")
    43	        tools[name] = reply
    44	    tool_list = [{"name": n,
    45	                  "description": "stub tool %s on %s" % (n, a.name),
    46	                  "inputSchema": {"type": "object"}}
    47	                 for n in tools]
    48	
    49	    def send(obj):
    50	        if a.notify_before_reply and "id" in obj:
    51	            sys.stdout.write(json.dumps({"jsonrpc": "2.0",
    52	                                         "method": "notifications/message",
    53	                                         "params": {"level": "info",
    54	                                                    "data": "stub %s chatter" % a.name}}) + "\n")
    55	        sys.stdout.write(json.dumps(obj) + "\n")
    56	        sys.stdout.flush()
    57	
    58	    if a.banner is not None:
    59	        sys.stdout.write(a.banner + "\n")
    60	        sys.stdout.flush()
    61	
    62	    for line in sys.stdin:
    63	        line = line.strip()
    64	        if not line:
    65	            continue
    66	        msg = json.loads(line)
    67	        method = msg.get("method")
    68	        mid = msg.get("id")
    69	        if mid is None:
    70	            continue  # a notification; nothing to answer
    71	        if method == "initialize":
    72	            send({"jsonrpc": "2.0", "id": mid, "result": {
    73	                "protocolVersion": msg.get("params", {}).get("protocolVersion", "2025-06-18"),
    74	                "capabilities": {"tools": {"listChanged": True}},
    75	                "serverInfo": {"name": a.name, "version": a.version}}})
    76	        elif method == "tools/list" and a.stall_tools:
    77	            continue  # never answer — the approval-dialog gate, as a stub
    78	        elif method == "tools/list":
    79	            if a.page_size > 0:
    80	                cursor = msg.get("params") or {}
    81	                start = int(cursor.get("cursor") or 0)
    82	                page = tool_list[start:start + a.page_size]
    83	                result = {"tools": page}
    84	                if start + a.page_size < len(tool_list):
    85	                    result["nextCursor"] = str(start + a.page_size)
    86	                send({"jsonrpc": "2.0", "id": mid, "result": result})
    87	            else:
    88	                send({"jsonrpc": "2.0", "id": mid, "result": {"tools": tool_list}})
    89	        elif method == "tools/call":
    90	            params = msg.get("params") or {}
    91	            name = params.get("name")
    92	            if name in tools:
    93	                send({"jsonrpc": "2.0", "id": mid, "result": {
    94	                    "content": [{"type": "text", "text": tools[name]}], "isError": False}})
    95	            else:
    96	                send({"jsonrpc": "2.0", "id": mid, "error": {
    97	                    "code": -32602, "message": "unknown tool %r on stub %s" % (name, a.name)}})
    98	        elif method == "ping":
    99	            send({"jsonrpc": "2.0", "id": mid, "result": {}})
   100	        else:
   101	            send({"jsonrpc": "2.0", "id": mid, "error": {
   102	                "code": -32601, "message": "stub %s does not implement %s" % (a.name, method)}})
   103	
   104	
   105	if __name__ == "__main__":
   106	    main()

