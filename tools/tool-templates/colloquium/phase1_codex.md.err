   468	    def add_request_handler(
   469	        self,
   470	        method: str,
   471	        params_type: type[_ParamsT],
   472	        handler: RequestHandler[LifespanResultT, _ParamsT],
   473	    ) -> None:
   474	        """Register a request handler for `method`.
   475	
   476	        `params_type` is the model incoming params are validated against
   477	        before the handler is invoked. It should subclass `RequestParams` so
   478	        `_meta` parses uniformly. A message with no `params` member validates
   479	        `{}` against `params_type`: models with required fields reject it as
   480	        INVALID_PARAMS, all-optional models reach the handler with their
   481	        defaults - the handler never receives `None`. Replaces any existing
   482	        handler for the same method, except `initialize`, which is reserved:
   483	        the runner owns the handshake, so registering it raises `ValueError`.
   484	        Use `Server.middleware` to observe or wrap initialization.
   485	        """
   486	        if method == "initialize":
   487	            raise ValueError(
   488	                "'initialize' is handled by the server runner and cannot be overridden; "
   489	                "use Server.middleware to observe or wrap initialization"
   490	            )
   491	        self._request_handlers[method] = HandlerEntry(params_type, handler)
   492	
   493	    def add_notification_handler(
   494	        self,
   495	        method: str,
   496	        params_type: type[_ParamsT],
   497	        handler: NotificationHandler[LifespanResultT, _ParamsT],
   498	    ) -> None:
   499	        """Register a notification handler for `method`.
   500	
   501	        `params_type` should subclass `NotificationParams` so `_meta`
   502	        parses uniformly. Absent params follow the same contract as requests:
   503	        `{}` is validated, so the handler receives the model with its defaults,
   504	        never `None`. Replaces any existing handler. A handler for
   505	        `notifications/initialized` runs after the runner has marked the
   506	        connection initialized.
   507	        """
   508	        self._notification_handlers[method] = HandlerEntry(params_type, handler)
   509	
   510	    def get_request_handler(self, method: str) -> HandlerEntry[LifespanResultT] | None:
   511	        """Return the registered entry for a request method, or `None`."""
   512	        return self._request_handlers.get(method)
   513	
   514	    def get_notification_handler(self, method: str) -> HandlerEntry[LifespanResultT] | None:
   515	        """Return the registered entry for a notification method, or `None`."""
   516	        return self._notification_handlers.get(method)
   517	
   518	    # TODO(L53): Rethink capabilities API. Currently capabilities are derived from registered
   519	    # handlers but require NotificationOptions to be passed externally for list_changed
   520	    # flags, and experimental_capabilities as a separate dict. Consider deriving capabilities
   521	    # entirely from server state (e.g. constructor params for list_changed) instead of
   522	    # requiring callers to assemble them at create_initialization_options() time.
   523	    def create_initialization_options(
   524	        self,
   525	        notification_options: NotificationOptions | None = None,
   526	        experimental_capabilities: dict[str, dict[str, Any]] | None = None,
   527	        extensions: dict[str, dict[str, Any]] | None = None,
   528	    ) -> InitializationOptions:
   529	        """Create initialization options from this server instance.
   530	
   531	        `extensions` advertises SEP-2133 extension support under
   532	        `ServerCapabilities.extensions`; keys are extension identifiers (e.g.
   533	        `io.modelcontextprotocol/ui`), values are per-extension settings.
   534	        Defaults to `self.extensions`, which higher layers populate.
   535	        """
   536	        return InitializationOptions(
   537	            server_name=self.name,
   538	            server_version=self.version,
   539	            title=self.title,
   540	            description=self.description,
   541	            capabilities=self.get_capabilities(
   542	                notification_options or NotificationOptions(),
   543	                experimental_capabilities or {},
   544	                extensions if extensions is not None else self.extensions,
   545	            ),
   546	            instructions=self.instructions,
   547	            website_url=self.website_url,
   548	            icons=self.icons,
   549	        )
   550	
   551	    def get_capabilities(
   552	        self,
   553	        notification_options: NotificationOptions | None = None,
   554	        experimental_capabilities: dict[str, dict[str, Any]] | None = None,
   555	        extensions: dict[str, dict[str, Any]] | None = None,
   556	        *,
   557	        protocol_version: str | None = None,
   558	    ) -> types.ServerCapabilities:
   559	        """Convert existing handlers to a ServerCapabilities object.
   560	
   561	        `extensions` is the SEP-2133 extension map (identifier -> settings)
   562	        advertised under `ServerCapabilities.extensions`; it defaults to
   563	        `self.extensions`.
   564	
   565	        `protocol_version` makes the subscription-delivered bits era-honest:
   566	        at 2026-07-28+ versions, change notifications are delivered only on
   567	        `subscriptions/listen` streams, so the `listChanged` flags and
   568	        `resources.subscribe` derive from whether that method is served -
   569	        `notification_options` and the legacy `resources/subscribe` handler
   570	        (which the modern wire cannot dispatch) are ignored. When omitted, the
   571	        handshake-era derivation applies unchanged.
   572	        """
   573	        notification_options = notification_options or NotificationOptions()
   574	        prompts_capability = None
   575	        resources_capability = None
   576	        tools_capability = None
   577	        logging_capability = None
   578	        completions_capability = None
   579	
   580	        if protocol_version in MODERN_PROTOCOL_VERSIONS:
   581	            listen_served = "subscriptions/listen" in self._request_handlers
   582	            prompts_changed = tools_changed = resources_changed = subscribe = listen_served
   583	        else:
   584	            prompts_changed = notification_options.prompts_changed
   585	            tools_changed = notification_options.tools_changed
   586	            resources_changed = notification_options.resources_changed
   587	            subscribe = "resources/subscribe" in self._request_handlers
   588	
   589	        # Set prompt capabilities if handler exists
   590	        if "prompts/list" in self._request_handlers:
   591	            prompts_capability = types.PromptsCapability(list_changed=prompts_changed)
   592	
   593	        # Set resource capabilities if handler exists
   594	        if "resources/list" in self._request_handlers:
   595	            resources_capability = types.ResourcesCapability(
   596	                subscribe=subscribe,
   597	                list_changed=resources_changed,
   598	            )
   599	
   600	        # Set tool capabilities if handler exists
   601	        if "tools/list" in self._request_handlers:
   602	            tools_capability = types.ToolsCapability(list_changed=tools_changed)
   603	
   604	        # Set logging capabilities if handler exists
   605	        if "logging/setLevel" in self._request_handlers:
   606	            logging_capability = types.LoggingCapability()
   607	
   608	        # Set completions capabilities if handler exists
   609	        if "completion/complete" in self._request_handlers:
   610	            completions_capability = types.CompletionsCapability()
   611	
   612	        capabilities = types.ServerCapabilities(
   613	            prompts=prompts_capability,
   614	            resources=resources_capability,
   615	            tools=tools_capability,
   616	            logging=logging_capability,
   617	            experimental=experimental_capabilities,
   618	            extensions=extensions if extensions is not None else (self.extensions or None),
   619	            completions=completions_capability,
   620	        )

