   815	async def serve_one(
   816	    server: Server[LifespanT],
   817	    dctx: DispatchContext[TransportContext],
   818	    method: str,
   819	    params: Mapping[str, Any] | None,
   820	    *,
   821	    connection: Connection,
   822	    lifespan_state: LifespanT,
   823	) -> dict[str, Any]:
   824	    """Handle a single request ``(method, params)`` and return its result dict.
   825	
   826	    The single-exchange driver: builds the kernel, runs `on_request` once under
   827	    `dctx`, and tears down `connection.exit_stack` (shielded) on the way out.
   828	    The entry constructs the (born-ready) `Connection` and the `dctx`; this
   829	    only consumes them.
   830	
   831	    Raises whatever the handler chain raises (`MCPError` / `ValidationError` /
   832	    unmapped); callers own the exception-to-wire mapping.
   833	    """
   834	    runner = ServerRunner(server, connection, lifespan_state)
   835	    try:
   836	        return await runner.on_request(dctx, method, params)
   837	    finally:
   838	        await aclose_shielded(connection)
   839	
   840	
   841	def modern_on_request(server: Server[LifespanT], lifespan_state: LifespanT) -> OnRequest:
   842	    """Return an `OnRequest` callback that serves each call via `serve_one` with a fresh per-request `Connection`.
   843	
   844	    Wire this into the server side of a `DirectDispatcher` peer-pair to drive an
   845	    in-process server on the modern per-request-envelope path (each request
   846	    carries protocol version, client info, and capabilities in `params._meta`;
   847	    no `initialize` handshake). The dispatch context is wrapped in the
   848	    server-requests denial, so the modern prohibition on server-initiated
   849	    JSON-RPC requests holds on this entry like on the others. Like `serve_one`,
   850	    this raises whatever the handler chain raises - the dispatcher owns the
   851	    exception-to-error mapping.
   852	    """
   853	
   854	    async def handle(
   855	        dctx: DispatchContext[TransportContext], method: str, params: Mapping[str, Any] | None
   856	    ) -> dict[str, Any]:
   857	        meta = (params or {}).get("_meta", {})
   858	        connection = Connection.from_envelope(
   859	            meta.get(PROTOCOL_VERSION_META_KEY, LATEST_MODERN_VERSION),
   860	            meta.get(CLIENT_INFO_META_KEY),
   861	            meta.get(CLIENT_CAPABILITIES_META_KEY),
   862	        )
   863	        return await serve_one(
   864	            server,
   865	            _NoServerRequestsDispatchContext(dctx),
   866	            method,
   867	            params,
   868	            connection=connection,
   869	            lifespan_state=lifespan_state,
   870	        )
   871	
   872	    return handle

