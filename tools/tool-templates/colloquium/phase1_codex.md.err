   711	def build_server(upstreams: list[Upstream]) -> Server:
   712	    single = len(upstreams) == 1
   713	    prefix_of = {u: (u.prefix if not single else "") for u in upstreams}
   714	    upstream_by_prefix = {prefix_of[u]: u for u in upstreams}
   715	
   716	    # EXPLICIT DISPATCH TABLE (increment 1.3): exposed name -> (upstream, bare upstream
   717	    # name), rebuilt every time the surface is composed in on_list_tools. Consulted
