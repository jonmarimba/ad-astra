   263	            if method == "notifications/initialized":
   264	                # Surface validation above already rejected a malformed body, so
   265	                # commit; fall through so a registered handler observes an
   266	                # initialized connection.
   267	                self.connection.initialized.set()
   268	            elif not self.connection.initialize_accepted:
   269	                logger.debug("dropped %s: received before initialization", method)
   270	                return
   271	            entry = self.server.get_notification_handler(method)
   272	            if entry is None:
   273	                logger.debug("no handler for notification %s", method)
   274	                return
   275	            # Same absent-params contract as requests.
   276	            try:
   277	                typed_params = entry.params_type.model_validate({} if params is None else params, by_name=False)
   278	            except ValidationError:
   279	                logger.warning("dropped %r: malformed params", method)
   280	                return
   281	            await entry.handler(ctx, typed_params)
   282	
   283	        call = self._compose_server_middleware(_inner)
   284	        try:
   285	            await call(ctx)
   286	        except Exception:
   287	            # A crashing handler must not cancel the dispatcher's task group;
   288	            # middleware saw the raise out of call_next() first.
   289	            logger.exception("notification handler for %r raised", method)
   290	
   291	    def _compose_server_middleware(self, inner: CallNext) -> CallNext:
   292	        """Wrap `inner` in `Server.middleware`, outermost-first.
   293	
   294	        Shared by `_on_request` and `_on_notify` so the same middleware chain
   295	        observes every inbound message. The composed callable takes the `ctx`
   296	        at call time, so a middleware can rewrite it for the rest of the chain.
   297	        """
   298	        call = inner
   299	        for middleware in reversed(self.server.middleware):
   300	            call = partial(_apply_middleware, middleware, call)
   301	        return call
   302	
   303	    def _make_context(
   304	        self,
   305	        dctx: DispatchContext[TransportContext],
   306	        method: str,
   307	        params: Mapping[str, Any] | None,
   308	        meta: RequestParamsMeta | None,
   309	        protocol_version: str,
   310	    ) -> ServerRequestContext[LifespanT, Any]:
   311	        # TODO(L54): remove for Context rework. Reads the SHTTP per-request
   312	        # data off the raw `dctx.message_metadata` carrier; replace with the
   313	        # per-transport context once that lands.
   314	        md = dctx.message_metadata
   315	        if isinstance(md, ServerMessageMetadata):
   316	            request = md.request_context
   317	            close_sse_stream = md.close_sse_stream
   318	            close_standalone_sse_stream = md.close_standalone_sse_stream
   319	        else:
   320	            request = close_sse_stream = close_standalone_sse_stream = None
   321	        # Per-request session: `dctx` is the request-scoped channel (auto-threads
   322	        # its own request_id on streamable HTTP); the standalone channel is read
   323	        # off `connection.outbound`. `related_request_id` on the public API selects.
   324	        # `meta` carries a request's log-level opt-in for the session's log gate. A
   325	        # notification has no request to opt in (and no response stream to carry
   326	        # the log entry), so its `_meta` never opens the gate.
   327	        session = ServerSession(dctx, self.connection, request_meta=meta if dctx.request_id is not None else None)
   328	        return ServerRequestContext(
   329	            session=session,
   330	            lifespan_context=self.lifespan_state,
   331	            method=method,
   332	            params=params,
   333	            request_id=dctx.request_id,
   334	            meta=meta,
   335	            protocol_version=protocol_version,
   336	            request=request,
   337	            close_sse_stream=close_sse_stream,
   338	            close_standalone_sse_stream=close_standalone_sse_stream,
   339	        )
   340	
   341	    def _serialize(self, method: str, version: str, result: HandlerResult) -> dict[str, Any]:
   342	        """Shape a handler result into its wire form: the outbound counterpart
   343	        of the inbound classification ladder.
   344	
   345	        One pass owns the whole response envelope, in order: cache hints fill
   346	        `ttlMs`/`cacheScope` the handler left unset, core-vocabulary spec-method
   347	        results are validated and sieved by the per-version surface (a claimed
   348	        extension `resultType` shape is the extension's to own), and 2026-era
   349	        results get the `serverInfo` `_meta` stamp (spec #3002). Runs inside the
   350	        middleware chain so the OpenTelemetry span observes a failing return
   351	        shape (unsupported type, malformed spec result) as an error rather
   352	        than closing on a request that the client sees fail - and so a
   353	        middleware that short-circuits without `call_next` owns its result,
   354	        envelope included.
   355	        """
   356	        # MRTR carve-out: `input_required` interim results, typed or mapping, never get hints.
   357	        if (hint := self.server.cache_hints.get(method)) is not None:
   358	            if isinstance(result, CacheableResult):
   359	                result = apply_cache_hint(result, hint)
   360	            elif isinstance(result, Mapping) and not _methods.is_input_required(result):
   361	                # Hint keys first so wire keys the handler set win, matching `apply_cache_hint` precedence.
   362	                result = {"ttlMs": hint.ttl_ms, "cacheScope": hint.scope, **result}
   363	        dumped = _dump_result(result)
   364	        # A modern-era extension `resultType` (outside the core vocabulary) marks
   365	        # a claimed shape owned by the extension that defined it: the per-version
   366	        # surface doesn't describe it, so the sieve applies to core results only.
   367	        # Legacy connections sieve everything - claimed shapes are 2026-era
   368	        # vocabulary and cannot be delivered on a legacy wire (mirrors the
   369	        # client-side ResultClaim rule).
   370	        # TODO(L56): reject extension resultType values unless the corresponding
   371	        # extension is in this request's _meta clientCapabilities.extensions; the
   372	        # explicit MUST-reject is client-side (basic/index.mdx ResultType), this enforces it proactively.
   373	        result_type = dumped.get("resultType")
   374	        core_shape = (
   375	            version not in MODERN_PROTOCOL_VERSIONS
   376	            or not isinstance(result_type, str)
   377	            or result_type in CORE_RESULT_TYPES
   378	        )
   379	        if method in _methods.SPEC_CLIENT_METHODS and core_shape:
   380	            try:
   381	                dumped = _methods.serialize_server_result(method, version, dumped)
   382	            except ValidationError:
   383	                # Server bug, not client fault. Detail stays in the server log:
   384	                # pydantic messages echo the result body.
   385	                logger.exception("handler for %r returned an invalid result", method)
   386	                raise MCPError(code=INTERNAL_ERROR, message="Handler returned an invalid result") from None
   387	        if version in MODERN_PROTOCOL_VERSIONS and dumped.get("resultType") is None:
   388	            # Spec 2026-07-28: `Result.resultType` is required - servers MUST
   389	            # include it (the absent-means-complete bridge is for clients of
   390	            # older servers only). The sieve guarantees it for core methods;
   391	            # this covers everything else: custom methods, extension methods,
   392	            # and empty results.
   393	            dumped["resultType"] = "complete"
   394	        return self._stamp_server_info(version, dumped)
   395	
   396	    def _stamp_server_info(self, version: str, result: dict[str, Any]) -> dict[str, Any]:
   397	        """Fill the `serverInfo` `_meta` stamp on a 2026-era result (spec #3002).
   398	
   399	        A handler-authored value wins; an explicit `null` reads as absent and
   400	        is stamped over, mirroring the request-side `clientInfo` posture (a
   401	        `null` is not a valid `Implementation`, so presence means a value). A
   402	        non-mapping `_meta` is the handler's to own, and handshake-era results
   403	        are never stamped. `result` is
   404	        pipeline-owned (`_dump_result` copies dicts; the spec-method sieve
   405	        re-dumps), but `_meta` may still be the handler's object, so the stamp
   406	        replaces it rather than writing into it. `server_info_stamp` is a
   407	        fresh dict per access, so the response never aliases server state.
   408	        """
   409	        if version not in MODERN_PROTOCOL_VERSIONS:
   410	            return result
   411	        raw_meta = result.get("_meta")
   412	        if raw_meta is None:
   413	            result["_meta"] = {SERVER_INFO_META_KEY: self.server.server_info_stamp}
   414	        elif isinstance(raw_meta, dict):
   415	            meta = cast("dict[str, Any]", raw_meta)
   416	            if meta.get(SERVER_INFO_META_KEY) is None:
   417	                result["_meta"] = {**meta, SERVER_INFO_META_KEY: self.server.server_info_stamp}
   418	        return result
   419	
   420	    @staticmethod
   421	    def _negotiate_initialize(params: Mapping[str, Any] | None) -> tuple[InitializeRequestParams, str]:
   422	        """Validate `initialize` params and pick the protocol version."""
   423	        init = InitializeRequestParams.model_validate(params or {}, by_name=False)
   424	        requested = init.protocol_version
   425	        negotiated = requested if requested in HANDSHAKE_PROTOCOL_VERSIONS else LATEST_HANDSHAKE_VERSION
   426	        return init, negotiated
   427	
   428	    def _handle_initialize(self, params: Mapping[str, Any] | None) -> InitializeResult:
   429	        """Build the `initialize` result; state commits later in `_on_request`."""
   430	        _, negotiated = self._negotiate_initialize(params)
   431	        opts = self.init_options if self.init_options is not None else self.server.create_initialization_options()
   432	        return InitializeResult(
   433	            protocol_version=negotiated,
   434	            capabilities=opts.capabilities,
   435	            server_info=Implementation(
   436	                name=opts.server_name,
   437	                title=opts.title,
   438	                description=opts.description,
   439	                version=opts.server_version,
   440	                website_url=opts.website_url,
   441	                icons=opts.icons,
   442	            ),
   443	            instructions=opts.instructions,
   444	        )
   445	
   446	
   447	async def serve_connection(
   448	    server: Server[LifespanT],
   449	    dispatcher: Dispatcher[Any],
   450	    *,
   451	    connection: Connection,
   452	    lifespan_state: LifespanT,
   453	    init_options: InitializationOptions | None = None,
   454	    task_status: anyio.abc.TaskStatus[None] = anyio.TASK_STATUS_IGNORED,
   455	) -> None:
   456	    """Drive ``dispatcher`` until the underlying channel closes.
   457	
   458	    The loop-mode driver: builds the kernel, hands `on_request`/`on_notify`
   459	    to `dispatcher.run()`, and tears down `connection.exit_stack` (shielded)
   460	    on the way out. The entry constructs the `Connection`; this only consumes
   461	    it.
   462	    """
   463	    runner = ServerRunner(server, connection, lifespan_state, init_options=init_options)
   464	    try:
   465	        await dispatcher.run(runner.on_request, runner.on_notify, task_status=task_status)
   466	    finally:
   467	        await aclose_shielded(connection)
   468	
   469	
   470	async def serve_loop(
   471	    server: Server[LifespanT],
   472	    read_stream: ReadStream[SessionMessage | Exception],
   473	    write_stream: WriteStream[SessionMessage],
   474	    *,
   475	    lifespan_state: LifespanT,
   476	    session_id: str | None = None,
   477	    init_options: InitializationOptions | None = None,
   478	    raise_exceptions: bool = False,
   479	) -> None:
   480	    """Drive ``server`` in handshake-only loop mode over a stream pair until the channel closes.
   481	
   482	    Builds the loop-mode `JSONRPCDispatcher` + `Connection` and hands them to
   483	    `serve_connection`. The streamable-HTTP manager (which owns its lifespan
   484	    and serves the modern era on the single-exchange entry instead) calls
   485	    this; `Server.run` drives `serve_dual_era_loop`, which extends the same
   486	    dispatcher recipe (notably the `inline_methods={"initialize"}` rule) with
   487	    era routing.
   488	    """
   489	    dispatcher: JSONRPCDispatcher[TransportContext] = JSONRPCDispatcher(
   490	        read_stream,
   491	        write_stream,
   492	        raise_handler_exceptions=raise_exceptions,
   493	        # Handle `initialize` inline so a client that pipelines it with the
   494	        # next request (spec: SHOULD NOT, not MUST NOT) sees the initialized
   495	        # state instead of failing the init-gate.
   496	        inline_methods=frozenset({"initialize"}),
   497	    )
   498	    connection = Connection.for_loop(dispatcher, session_id=session_id)
   499	    await serve_connection(
   500	        server, dispatcher, connection=connection, lifespan_state=lifespan_state, init_options=init_options
   501	    )
   502	
   503	
   504	def _has_modern_envelope(params: Mapping[str, Any] | None) -> bool:
   505	    """Whether `params._meta` carries the reserved protocol-version key.
   506	
   507	    The `io.modelcontextprotocol/protocolVersion` key exists only in
   508	    2026-07-28+ envelopes and its prefix is spec-reserved, so legacy traffic
   509	    never mints it (a bare `_meta` is not evidence - legacy requests carry
   510	    `progressToken` there). The version key alone is the signal, not the full
   511	    required pair, so a half-built envelope still routes modern and gets the
   512	    classifier's INVALID_PARAMS naming the missing key.
   513	    """
   514	    if not params:
   515	        return False
   516	    meta = params.get("_meta")
   517	    return isinstance(meta, Mapping) and PROTOCOL_VERSION_META_KEY in meta
   518	
   519	
   520	def _initialize_after_modern_data(params: Mapping[str, Any] | None) -> dict[str, Any]:
   521	    """Error data for an `initialize` arriving on a modern-locked connection.
   522	
   523	    The typed -32022 payload when the client's proposed version is parseable;
   524	    otherwise just the supported list (the point is naming what we serve).
   525	    """
   526	    requested = (params or {}).get("protocolVersion")
   527	    if isinstance(requested, str):
   528	        return UnsupportedProtocolVersionErrorData(
   529	            supported=list(MODERN_PROTOCOL_VERSIONS), requested=requested
   530	        ).model_dump(mode="json")
   531	    return {"supported": list(MODERN_PROTOCOL_VERSIONS)}
   532	
   533	
   534	def modern_error_data(exc: Exception) -> ErrorData:
   535	    """Map a modern request's handler exception to its wire `ErrorData`.
   536	
   537	    The exception-to-wire fact shared by the modern entries (the
   538	    single-exchange HTTP path and the dual-era stream loop), so an identical
   539	    modern request fails identically on every transport: `MCPError` and
   540	    `ValidationError` map via the shared `handler_exception_to_error_data`
   541	    ladder; anything else is logged server-side and surfaced as a generic
   542	    INTERNAL_ERROR so handler internals never reach the wire.
   543	    """
   544	    error = handler_exception_to_error_data(exc)
   545	    if error is not None:
   546	        return error
   547	    logger.exception("modern request handler raised")
   548	    return ErrorData(code=INTERNAL_ERROR, message="Internal server error")
   549	
   550	
   551	@dataclass
   552	class _NoServerRequestsDispatchContext:
   553	    """Delegating `DispatchContext` that refuses server-initiated requests.
   554	
   555	    Wraps the loop dispatcher's per-message context for modern-era dispatch:
   556	    the modern protocol forbids server-initiated JSON-RPC requests, so
   557	    `send_raw_request` refuses while notifications and progress still ride
   558	    the duplex pipe.
   559	    """
   560	
   561	    _inner: DispatchContext[TransportContext]
   562	
   563	    @property
   564	    def transport(self) -> TransportContext:
   565	        # Mask the per-message flag so the transport metadata agrees with this
   566	        # wrapper's denial: the modern HTTP entry builds its context with
   567	        # can_send_request=False, while the loop's default builder says True.
   568	        transport = self._inner.transport
   569	        return replace(transport, can_send_request=False) if transport.can_send_request else transport
   570	
   571	    @property
   572	    def can_send_request(self) -> bool:
   573	        return False
   574	
   575	    @property
   576	    def request_id(self) -> RequestId | None:
   577	        return self._inner.request_id
   578	
   579	    @property
   580	    def message_metadata(self) -> MessageMetadata:
   581	        return self._inner.message_metadata
   582	
   583	    @property
   584	    def cancel_requested(self) -> anyio.Event:
   585	        return self._inner.cancel_requested
   586	
   587	    async def send_raw_request(
   588	        self,
   589	        method: str,
   590	        params: Mapping[str, Any] | None,
   591	        opts: CallOptions | None = None,
   592	    ) -> dict[str, Any]:
   593	        raise NoBackChannelError(method)
   594	
   595	    async def notify(self, method: str, params: Mapping[str, Any] | None, opts: CallOptions | None = None) -> None:
   596	        await self._inner.notify(method, params, opts)
   597	
   598	    async def progress(self, progress: float, total: float | None = None, message: str | None = None) -> None:
   599	        await self._inner.progress(progress, total, message)
   600	
   601	
   602	async def serve_dual_era_loop(
   603	    server: Server[LifespanT],
   604	    read_stream: ReadStream[SessionMessage | Exception],
   605	    write_stream: WriteStream[SessionMessage],
   606	    *,
   607	    lifespan_state: LifespanT,
   608	    session_id: str | None = None,
   609	    init_options: InitializationOptions | None = None,
   610	    raise_exceptions: bool = False,
   611	) -> None:
   612	    """Drive `server` over a duplex stream pair, in the era the client opens with.
   613	
   614	    The client's first request decides the connection's protocol era, once:
   615	    a request carrying the 2026-07-28 per-request `_meta` envelope opens a
   616	    modern connection, and anything else - the `initialize` handshake, which
   617	    does not exist at 2026 versions even when a client stamps the envelope on
   618	    it - opens a legacy one. The deciding frame is replayed into the chosen
   619	    serving loop along with everything the client sent before it. A later
   620	    claim from the other era is refused: `initialize` on a modern connection
   621	    gets UNSUPPORTED_PROTOCOL_VERSION naming the served versions, and an
   622	    enveloped request on a legacy connection gets INVALID_REQUEST.
   623	    """
   624	    # This loop owns both streams from the moment it is called, so the write
   625	    # stream is closed even if the client leaves before sending any request.
   626	    try:
   627	        async with _replay_from_opening_request(read_stream) as (opening, replayed):
   628	            opens_modern = (
   629	                opening is not None and opening.method != "initialize" and _has_modern_envelope(opening.params)
   630	            )
   631	            if opens_modern:
   632	                await _serve_modern_stream(
   633	                    server, replayed, write_stream, lifespan_state=lifespan_state, raise_exceptions=raise_exceptions
   634	                )
   635	            else:
   636	                await _serve_legacy_stream(
   637	                    server,
   638	                    replayed,
   639	                    write_stream,
   640	                    lifespan_state=lifespan_state,
   641	                    session_id=session_id,
   642	                    init_options=init_options,
   643	                    raise_exceptions=raise_exceptions,
   644	                )
   645	    finally:
   646	        await write_stream.aclose()
   647	
   648	
   649	_PRE_REQUEST_REPLAY_LIMIT: int = 8
   650	"""How many frames arriving ahead of the client's first request are kept
   651	for the chosen era's loop (a bare `notifications/initialized` is the one that
   652	matters); further ones are dropped and never decide the era."""
   653	
   654	
   655	def _sender_context(stream: ReadStream[Any]) -> contextvars.Context:
   656	    """The per-message sender context a context-aware stream carries, else the current one."""
   657	    ctx = getattr(stream, "last_context", None)
   658	    return ctx if ctx is not None else contextvars.copy_context()
   659	
   660	
   661	@asynccontextmanager
   662	async def _replay_from_opening_request(
   663	    read_stream: ReadStream[SessionMessage | Exception],
   664	) -> AsyncIterator[tuple[JSONRPCRequest | None, ReadStream[SessionMessage | Exception]]]:
   665	    """Peek at the client's first request without consuming it.
   666	
   667	    Yields that request together with a stream that replays it - preceded by
   668	    up to `_PRE_REQUEST_REPLAY_LIMIT` earlier frames - and relays the rest of
   669	    `read_stream` behind it, sender contexts included. The request is `None`
   670	    if the channel closes before one arrives.
   671	    """
   672	    lead: list[tuple[contextvars.Context, SessionMessage | Exception]] = []
   673	    opening_request: JSONRPCRequest | None = None
   674	    replay_send, replay_receive = anyio.create_memory_object_stream[
   675	        tuple[contextvars.Context, SessionMessage | Exception]
   676	    ]()
   677	    replayed = ContextReceiveStream(replay_receive)
   678	
   679	    async def replay_then_relay() -> None:
   680	        async with replay_send:
   681	            for envelope in lead:
   682	                await replay_send.send(envelope)
   683	            try:
   684	                async for item in read_stream:
   685	                    await replay_send.send((_sender_context(read_stream), item))
   686	            except anyio.ClosedResourceError:
   687	                # Receive end closed under us (stateless SHTTP teardown); same as EOF.
   688	                logger.debug("read stream closed by transport; treating as EOF")
   689	
   690	    # This helper takes ownership of `read_stream` from the serving loop, so
   691	    # every exit - including cancellation while awaiting the first request -
   692	    # closes it and the replay channel.
   693	    try:
   694	        try:
   695	            async for item in read_stream:
   696	                if isinstance(item, SessionMessage) and isinstance(item.message, JSONRPCRequest):
   697	                    opening_request = item.message
   698	                elif len(lead) >= _PRE_REQUEST_REPLAY_LIMIT:
   699	                    logger.debug("dropped a frame received before the first request: %r", item)
   700	                    continue
   701	                lead.append((_sender_context(read_stream), item))
   702	                if opening_request is not None:
   703	                    break
   704	        except anyio.ClosedResourceError:
   705	            # Receive end closed under us (stateless SHTTP teardown); same as EOF.
   706	            logger.debug("read stream closed by transport; treating as EOF")
   707	        async with anyio.create_task_group() as tg:
   708	            tg.start_soon(replay_then_relay)
   709	            yield opening_request, replayed
   710	            tg.cancel_scope.cancel()
   711	    finally:
   712	        await read_stream.aclose()
   713	        replay_send.close()
   714	        replay_receive.close()
   715	
   716	
   717	async def _serve_legacy_stream(
   718	    server: Server[LifespanT],
   719	    read_stream: ReadStream[SessionMessage | Exception],
   720	    write_stream: WriteStream[SessionMessage],
   721	    *,
   722	    lifespan_state: LifespanT,
   723	    session_id: str | None,
   724	    init_options: InitializationOptions | None,
   725	    raise_exceptions: bool,
   726	) -> None:
   727	    """Serve a 2025 handshake connection; enveloped requests are refused."""
   728	    dispatcher: JSONRPCDispatcher[TransportContext] = JSONRPCDispatcher(
   729	        read_stream,
   730	        write_stream,
   731	        raise_handler_exceptions=raise_exceptions,
   732	        # `initialize` inline for the same pipelining reason as `serve_loop`.
   733	        inline_methods=frozenset({"initialize"}),
   734	    )
   735	    connection = Connection.for_loop(dispatcher, session_id=session_id)
   736	    runner = ServerRunner(server, connection, lifespan_state, init_options=init_options)
   737	
   738	    async def on_request(
   739	        dctx: DispatchContext[TransportContext], method: str, params: Mapping[str, Any] | None
   740	    ) -> dict[str, Any]:
   741	        if method != "initialize" and _has_modern_envelope(params):
   742	            raise MCPError(
   743	                code=INVALID_REQUEST,
   744	                message="this connection serves the handshake protocol era; "
   745	                "requests carrying the 2026-07-28 envelope are not accepted on it",
   746	            )
   747	        return await runner.on_request(dctx, method, params)
   748	
   749	    try:
   750	        await dispatcher.run(on_request, runner.on_notify)
   751	    finally:
   752	        await aclose_shielded(connection)
   753	
   754	
   755	async def _serve_modern_stream(
   756	    server: Server[LifespanT],
   757	    read_stream: ReadStream[SessionMessage | Exception],
   758	    write_stream: WriteStream[SessionMessage],
   759	    *,
   760	    lifespan_state: LifespanT,
   761	    raise_exceptions: bool,
   762	) -> None:
   763	    """Serve a 2026-07-28 connection: every request carries its own envelope."""
