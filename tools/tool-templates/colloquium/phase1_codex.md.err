   130	
   131	def _load_config_file() -> None:
   132	    """Reached via a wrapped .app under launchd in real deployment, which does
   133	    NOT reliably forward a launchd plist's EnvironmentVariables into the
   134	    launched app's process (a LaunchServices quirk, separate from the TCC one
   135	    this tool is already built around). A config file sidesteps that entirely:
   136	    it's read directly off disk, so it works regardless of how this process was
   137	    launched. Real env vars still win if both are set (checked with setdefault,
   138	    same layering as ollama-watch's config convention elsewhere in this repo)."""
   139	    conf = os.path.join(os.environ.get("XCODE_MCP_FRONT_HOME", os.path.expanduser("~/.xcode-mcp-front")), "config")
   140	    if not os.path.isfile(conf):
   141	        return
   142	    with open(conf) as f:
   143	        for line in f:
   144	            line = line.strip()
   145	            if not line or line.startswith("#") or "=" not in line:
   146	                continue
   147	            key, _, value = line.partition("=")
   148	            os.environ.setdefault(key.strip(), value.strip().strip("'\""))
   149	
   150	
   151	_load_config_file()
   152	
   153	HOST = os.environ.get("XCODE_MCP_FRONT_HOST", "127.0.0.1")
   154	PORT = int(os.environ.get("XCODE_MCP_FRONT_PORT", "8765"))
   155	AUTO_ALLOW = os.environ.get("XCODE_MCP_FRONT_AUTO_ALLOW", "1") == "1"
   156	
   157	# Both /Applications/Xcode.app and /Applications/Xcode-beta.app share the exact
   158	# same CFBundleExecutable ("Xcode") AND the same CFBundleIdentifier
   159	# (com.apple.dt.Xcode) - confirmed live, 2026-08-14. Neither a bare process-name
   160	# match nor a bundle-ID match can tell them apart. Only the executable's full
   161	# path differs, so that's what this matches on - anchored and exact, not a
   162	# substring, so it can't accidentally match the beta path either.
   163	XCODE_APP_PATH = os.environ.get("XCODE_MCP_FRONT_XCODE_APP_PATH", "/Applications/Xcode.app")
   164	XCODE_BINARY_PATH = f"{XCODE_APP_PATH.rstrip('/')}/Contents/MacOS/Xcode"
   165	RECONNECT_POLL_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_RECONNECT_POLL_S", "5"))
   166	CONNECT_TIMEOUT_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_CONNECT_TIMEOUT_S", "15"))
   167	# Generous on purpose - a real Xcode build_project call can legitimately run
   168	# for minutes. The point isn't to bound normal work, it's to make sure NO call
   169	# can wedge the daemon forever (found live, 2026-08-14: with no timeout at all,
   170	# one genuinely hung upstream call held the connection lock for 2+ minutes and
   171	# counting, wedging every future call to that upstream, single-upstream or
   172	# combined, until manually restarted). Raise this if a real workload needs
   173	# longer than the default.
   174	#
   175	# Default corrected to 600s (was 120s) by convocation review, 2026-08-14: 120s
   176	# contradicted this comment's own "can legitimately run for minutes" — a real
   177	# clean/first build commonly runs past 2 minutes, so the old default silently
   178	# killed and dropped exactly the workload it claimed to tolerate, then
   179	# reconnected and reported "not connected right now, retry shortly" — which is
   180	# actively misleading once this fires, since the build was killed mid-flight,
   181	# not merely delayed; a retry starts it over, it doesn't resume it.
   182	CALL_TIMEOUT_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_CALL_TIMEOUT_S", "600"))
   183	SERVER_NAME = os.environ.get("XCODE_MCP_FRONT_SERVER_NAME", "xcode-mcp-front")
   184	
   185	logging.basicConfig(level=logging.INFO, format=f"%(asctime)s {SERVER_NAME} %(message)s")
   186	log = logging.getLogger(SERVER_NAME)
   187	
   188	
   189	# NOTE: no longer consulted by the click decision. It used to gate the "Don't Allow" branch
   190	# on the dialog's PID being dead, and that gate is what let a LIVE stranger's dialog block
   191	# the daemon forever. Kept because it is a correct, cheap liveness check and reads clearly
   192	# at a call site; delete it if nothing else picks it up.
   193	def _pid_is_alive(pid_str: str) -> bool:
   194	    """No history file needed: a dialog's PID is either us, or it's a live PID
   195	    that belongs to someone else's legitimate in-flight request (leave it
   196	    alone), or it's simply not in the process table anymore (nothing is
   197	    waiting on it — always safe to dismiss, regardless of whose it was).
   198	    Generalizes to every stale dialog, not just ones this exact daemon
   199	    happens to remember spawning itself, so it can never permanently
   200	    deadlock behind one it doesn't recognize."""
   201	    try:
   202	        os.kill(int(pid_str), 0)
   203	        return True
   204	    except ProcessLookupError:
   205	        return False
   206	    except (ValueError, PermissionError):
   207	        # ValueError: not a real pid, treat as "can't tell" -> leave it alone.
   208	        # PermissionError: pid exists but isn't ours to signal -> still alive.
   209	        return True
   210	
   211	
   212	def _xcode_is_running() -> bool:
   213	    try:
   214	        # -f matches the full command line; anchored so it can only match this
   215	        # exact binary path, not a substring of some other process's args.
   216	        return (
   217	            subprocess.run(["pgrep", "-f", f"^{XCODE_BINARY_PATH}$"], capture_output=True, timeout=5).returncode
   218	            == 0
   219	        )
   220	    except Exception:
   221	        # A broken check must never itself take the daemon down — treat "can't
   222	        # tell" as "not running" and just try again next poll.
   223	        return False
   224	
   225	
   226	async def _run_osascript(script: str) -> bytes:
   227	    """Raises on a nonzero exit instead of returning empty bytes. Found by
   228	    convocation review, 2026-08-14: with stderr sent to DEVNULL and no
   229	    returncode check, a TCC grant getting revoked or dying (the documented
   230	    failure mode after any edit to the ad-hoc-signed wrapper .app — new hash,
   231	    dead grant) made osascript exit nonzero with an error, which this
   232	    previously returned as plain b"" — indistinguishable from "no dialog
   233	    showing". The click loop would then silently stop working with nothing in
   234	    the log naming the actual cause. Now surfaces it: caller's except-block
   235	    already logs at warning level, so a dead grant shows up as a real,
   236	    diagnosable log line instead of a silent no-op.
   237	
   238	    Also found LIVE the same day, the hard way: a real System Events hang
   239	    (osascript stuck talking to it, unrelated to the return-code fix above —
   240	    System Events itself was wedged) piled up one leaked orphan osascript
   241	    process EVERY poll tick, forever, because `asyncio.wait_for` timing out
   242	    only abandons Python's own wait — it does NOT kill the underlying
   243	    subprocess. Confirmed live: 30+ orphaned osascript processes accumulated
   244	    in under 10 minutes before this was caught, and System Events itself
   245	    became unresponsive to even a basic query as a result. Now explicitly
   246	    kills the process on timeout instead of leaving it to run forever."""
   247	    proc = await asyncio.create_subprocess_exec(
   248	        "osascript",
   249	        "-e",
   250	        script,
   251	        stdout=asyncio.subprocess.PIPE,
   252	        stderr=asyncio.subprocess.PIPE,
   253	    )
   254	    try:
   255	        out, err = await asyncio.wait_for(proc.communicate(), timeout=5)
   256	    except asyncio.TimeoutError:
   257	        proc.kill()
   258	        await proc.wait()  # reap it — don't leave a zombie behind either
   259	        raise RuntimeError("osascript timed out after 5s (System Events may be unresponsive)")
   260	    if proc.returncode != 0:
   261	        raise RuntimeError(f"osascript exited {proc.returncode}: {err.decode(errors='replace').strip()}")
   262	    return out
   263	
   264	
   265	# THE CLICKER IS LOAD-BEARING AND MUST NOT BE "DESIGNED AWAY". Xcode's approval is keyed to
   266	# the CONNECTING PID, and a daemon restart always mints a new one, so no grant survives a
   267	# bounce — not a signed app bundle, not the "don't ask again for this agent binary" checkbox,
   268	# which only lasts until Xcode itself restarts. An unattended daemon therefore has to answer
   269	# its own prompt or it can never connect after any restart. Jonathan, 2026-08-30, correcting
   270	# a suggestion to remove it: "the daemons HAVE to depend on a clicker."
   271	#
   272	# That is why a defect in this function is not cosmetic. It is the only path to a working
   273	# connection, so a branch that silently declines to click takes the whole daemon down while
   274	# every log line still says "connected".
   275	
   276	
   277	# How long another process's approval dialog is left alone before we clear it. Only once we
   278	# have been blocked for this long is it fair to assume nobody is coming to answer it.
   279	# HOW LONG A FOREIGN DIALOG MAY BLOCK US BEFORE WE CLEAR IT. This MUST be comfortably less
   280	# than CONNECT_TIMEOUT_SECONDS or two daemons deadlock by arithmetic rather than by bad luck.
   281	#
   282	# It was 45 against a 15-second connect timeout. Xcode's approval dialogs do not stack, so when
   283	# both front daemons are up, each one's clicker finds the other's dialog, correctly classifies it
   284	# as foreign-and-alive, and waits out a grace period three times longer than the connection
   285	# attempt it is holding up. Its own prompt therefore never surfaces, its list_tools times out,
   286	# it tears the child down — which withdraws its request — and both sides repeat forever. That is
   287	# the "do two bridges interfere" question Jonathan asked: they do, and this constant is why.
   288	#
   289	# Clearing a live foreign dialog is not destructive. That process re-prompts on its next attempt,
   290	# which for these daemons is RECONNECT_POLL_SECONDS away, so two of them alternate and both get
   291	# through instead of neither.
   292	FOREIGN_DIALOG_GRACE_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_FOREIGN_GRACE", "6"))
   293	
   294	# The relationship above is load-bearing, so it is checked rather than trusted to a comment. A
   295	# grace period at or beyond the connect timeout is a silent, permanent deadlock whenever a second
   296	# client exists, and it presents as "mcpbridge refuses to serve tools" — which is exactly how it
   297	# presented, for a night.
   298	if FOREIGN_DIALOG_GRACE_SECONDS >= CONNECT_TIMEOUT_SECONDS:
   299	    raise SystemExit(
   300	        "xcode-mcp-front: XCODE_MCP_FRONT_FOREIGN_GRACE (%.1fs) must be less than "

exec
/bin/zsh -lc "nl -ba tools/xcode-mcp-front/daemon.py | sed -n '301,600p'" in /Users/jonathan/svnCheckouts/js-db-ad-astra
 succeeded in 0ms:
   301	        "XCODE_MCP_FRONT_CONNECT_TIMEOUT_S (%.1fs). A foreign approval dialog that outlives the "
   302	        "connection attempt it is blocking can never be cleared in time, so two daemons deadlock "
   303	        "and every symptom looks like Xcode refusing to serve tools."
   304	        % (FOREIGN_DIALOG_GRACE_SECONDS, CONNECT_TIMEOUT_SECONDS))
   305	
   306	# How long an upstream may make NO progress before we let launchd restart us. See
   307	# stall_watchdog(). Generous on purpose: a false positive restarts a healthy daemon.
   308	STALL_EXIT_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_STALL_EXIT", "180"))
   309	
   310	# How often to look for the approval dialog while a call is blocked waiting for it. Short,
   311	# because the window is the length of one blocked list_tools and a missed dialog costs the
   312	# whole connection attempt.
   313	ALLOW_CLICK_POLL_SECONDS = float(os.environ.get("XCODE_MCP_FRONT_CLICK_POLL", "1.5"))
   314	
   315	# Set the first time we see a foreign dialog while we are not connected; cleared whenever we
   316	# see no dialog or our own. Module-level rather than per-upstream because Xcode shows one
   317	# dialog at a time for the whole application, so this is genuinely global state.
   318	_foreign_dialog_first_seen: dict = {}
   319	
   320	
   321	async def _click_allow_if_present() -> bool:
   322	    """Best-effort, narrowly scoped: only ever touches a button whose title is
   323	    the exact literal string "Allow" or "Don't Allow", only in Xcode's own
   324	    process. This is the one dialog this tool exists to eat, not a general
   325	    click-any-prompt macro. Harmless no-op for an upstream (like
   326	    drews-xcode-mcp) that never triggers this dialog at all — it just never
   327	    finds anything to click.
   328	
   329	    Xcode's approval dialogs do NOT stack (confirmed live, 2026-08-14 — only
   330	    one is ever showing; a new connection attempt's own dialog stays hidden
   331	    behind whatever's currently up until that one is dismissed). So a single
   332	    stale, never-answered dialog can permanently block every future connection
   333	    attempt, including this daemon's own, unless something clears it.
   334	
   335	    The decision, once a dialog's own PID is read from its text:
   336	      - matches OUR current pid            -> click Allow
   337	      - doesn't match, and that pid is DEAD -> click Don't Allow (nobody's
   338	        waiting on it — always safe, regardless of whose it originally was;
   339	        no history-tracking needed, this can't deadlock behind a dialog it
   340	        doesn't "remember")
   341	      - doesn't match, and that pid is ALIVE -> leave it alone; it's someone
   342	        else's legitimate in-flight request, not ours to approve OR deny
   343	    """
   344	    my_pid = str(os.getpid())
   345	    # Iterate every window, not just window 1 — found by convocation review,
   346	    # 2026-08-14: the approval dialog isn't guaranteed to be window 1 (e.g. a
   347	    # project window frontmost, or the dialog opening as window 2). Window 1
   348	    # only would silently never find the dialog and leave it unclicked
   349	    # forever. check-allow-window.sh already iterated all windows correctly;
   350	    # this production path didn't match it.
   351	    read_script = """
   352	tell application "System Events" to tell process "Xcode"
   353	  repeat with w in windows
   354	    if exists (button "Allow" of w) then
   355	      set winText to ""
   356	      try
   357	        set winText to (value of every static text of w) as string
   358	      end try
   359	      return winText
   360	    end if
   361	  end repeat
   362	  return ""
   363	end tell
   364	"""
   365	    try:
   366	        out = await _run_osascript(read_script)
   367	    except Exception as e:
   368	        log.warning("checking for an approval dialog failed (will retry, but if this repeats, check "
   369	                     "whether the wrapper .app's Accessibility/Automation grant is still valid): %s", e)
   370	        return False
   371	
   372	    text = out.decode(errors="replace")
   373	    if "PID: " not in text:
   374	        return False  # no dialog showing — the normal case most ticks
   375	
   376	    dialog_pid = text.split("PID: ", 1)[1].split()[0].strip()
   377	
   378	    if dialog_pid == my_pid:
   379	        _foreign_dialog_first_seen.pop("pid", None)
   380	        action = "Allow"
   381	    else:
   382	        # A GRACE PERIOD, BECAUSE CLEARING UNCONDITIONALLY MONOPOLISES XCODE. The previous
   383	        # version denied every foreign PID on sight. That unblocks us and starves everyone
   384	        # else: a legitimate agent's dialog gets Don't Allow, it retries, and it lands in the
   385	        # same denial loop forever, so this daemon owns Xcode and nothing else can use it.
   386	        # GhOST-OpenClaw caught it in peer review of the commit that introduced it.
   387	        #
   388	        # The bounded version keeps both properties. Somebody else's prompt is left alone
   389	        # while there is any chance they are about to answer it — which is the normal case,
   390	        # since a live agent's own approval usually resolves in seconds. Only once the SAME
   391	        # foreign dialog has been sitting there long enough to have stopped being anyone's
   392	        # in-flight request do we clear it so ours can surface. Nothing is destroyed either
   393	        # way: a denied agent re-prompts on its next attempt.
   394	        first = _foreign_dialog_first_seen.get("pid")
   395	        now = time.monotonic()
   396	        if first is None or first[0] != dialog_pid:
   397	            _foreign_dialog_first_seen["pid"] = (dialog_pid, now)
   398	            log.debug("a foreign approval dialog (pid %s) is in the way; leaving it for %.0fs "
   399	                      "in case its own agent answers it", dialog_pid, FOREIGN_DIALOG_GRACE_SECONDS)
   400	            return False
   401	        if now - first[1] < FOREIGN_DIALOG_GRACE_SECONDS:
   402	            return False
   403	        log.info("foreign approval dialog for pid %s has blocked us for %.0fs — clearing it so "
   404	                 "our own prompt can surface; that process re-prompts on its next attempt",
   405	                 dialog_pid, now - first[1])
   406	        # ANYTHING ELSE IN FRONT OF OURS GETS CLEARED, live or dead. This used to leave a
   407	        # LIVE unfamiliar PID's dialog strictly alone, out of politeness to another agent's
   408	        # in-flight request. That politeness is unaffordable here: Xcode's dialogs do not
   409	        # stack, so a single stranger's unanswered prompt sits in front of ours forever and
   410	        # the daemon can never connect again — which is exactly what a leftover
   411	        # "Allow 'Codex' to access Xcode?" from a convocation run did on 2026-08-30, and
   412	        # what the two front daemons did to each other for the sixteen days before that.
   413	        #
   414	        # Denying is not destructive and that is what makes this safe. A denied agent is
   415	        # told no for one connection attempt and re-prompts on its next one, by which time
   416	        # ours is out of the way. Jonathan, 2026-08-30: "I don't see why this needs
   417	        # exclusive access. Just run it saying with PID you care about or whatever?"
   418	        #
   419	        # The sibling branch above still matters and is not redundant: two front daemons
   420	        # denying each other would ping-pong, each clearing the other's prompt on every
   421	        # retry. Family gets Allow, everyone else gets out of the way.
   422	        action = "Don’t Allow"
   423	    click_script = f"""
   424	tell application "System Events" to tell process "Xcode"
   425	  repeat with w in windows
   426	    if exists (button "{action}" of w) then
   427	      click (button "{action}" of w)
   428	      return "clicked"
   429	    end if
   430	  end repeat
   431	  return "gone"
   432	end tell
   433	"""
   434	    try:
   435	        out2 = await _run_osascript(click_script)
   436	    except Exception as e:
   437	        log.warning("clicking the approval dialog failed (will retry, but if this repeats, check "
   438	                     "whether the wrapper .app's Accessibility/Automation grant is still valid): %s", e)
   439	        return False
   440	
   441	    clicked = b"clicked" in out2
   442	    if clicked and action == "Allow":
   443	        log.info("clicked Allow for our own connection-approval prompt (pid %s)", my_pid)
   444	    elif clicked:
   445	        log.info("cleared an approval dialog for pid %s (not ours, not a sibling) so ours can "
   446	                 "surface — it re-prompts on its next attempt", dialog_pid)
   447	    return clicked and action == "Allow"
   448	
   449	
   450	class Upstream:
   451	    """One upstream MCP server this daemon fronts, and everything needed to
   452	    keep a persistent connection to it alive. In single-upstream mode there's
   453	    exactly one of these and its tools are forwarded unprefixed (unchanged
   454	    behavior from before multi-upstream support existed). In multi-upstream
   455	    mode there are several, and the aggregator (see build_server) prefixes
   456	    each one's tools with `self.name + "__"` so two upstreams that happen to
   457	    share a tool name can't collide."""
   458	
   459	    def __init__(self, name: str, command: str, args: list[str], require_xcode_running: bool,
   460	                 prefix: str = ""):
   461	        self.name = name
   462	        # Exposed-name prefix in multi-upstream mode; ignored (empty) when this daemon
   463	        # fronts a single upstream, which stays an unprefixed passthrough.
   464	        self.prefix = prefix or f"{name}__"
   465	        # Watchdog input: bumped on every connect attempt and every successful heartbeat.
   466	        # Initialised here so the watchdog never reads a missing attribute on a slow start.
   467	        self.last_progress = time.monotonic()
   468	        self.command = command
   469	        self.args = args
   470	        self.require_xcode_running = require_xcode_running
   471	        self.lock = anyio.Lock()
   472	        self.session: ClientSession | None = None
   473	        self.known_broken = False
   474	
   475	    async def list_tools(self, params: types.PaginatedRequestParams | None) -> types.ListToolsResult | None:
   476	        """Returns None when this upstream is DISCONNECTED or the call failed — which is a
   477	        different fact from a connected upstream answering with zero tools, and the two
   478	        must never be conflated (increment 1.4: conflating them is how one missing
   479	        upstream used to blank the entire aggregate surface)."""
   480	        async with self.lock:
   481	            if self.session is None:
   482	                return None
   483	            try:
   484	                # DRAIN EVERY PAGE (increment 1.5). Cursors are opaque, per-server tokens,
   485	                # so the downstream client's cursor cannot be forwarded here — this daemon
   486	                # aggregates several cursor spaces into one surface and therefore serves a
   487	                # complete snapshot instead. Ignoring nextCursor used to silently truncate
   488	                # any upstream that paginates.
   489	                tools: list[types.Tool] = []
   490	                cursor: str | None = None
   491	                with anyio.fail_after(CALL_TIMEOUT_SECONDS):
   492	                    while True:
   493	                        page = await self.session.list_tools(
   494	                            params=types.PaginatedRequestParams(cursor=cursor) if cursor else None)
   495	                        tools.extend(page.tools)
   496	                        cursor = page.next_cursor
   497	                        if not cursor:
   498	                            return types.ListToolsResult(tools=tools)
   499	            except Exception as e:
   500	                # Found live, 2026-08-14: this call had NO timeout at all before
   501	                # this fix — a genuinely hung upstream call (confirmed: a real
   502	                # tool call sat for 2+ minutes with nothing in the log, no
   503	                # timeout, no recovery) held self.lock forever, permanently
   504	                # wedging this upstream for every future call, single-upstream
   505	                # or combined. A timeout here means a hang gets treated the
   506	                # same as any other failure: marked broken, reconnected fresh.
   507	                self.known_broken = True
   508	                log.warning("[%s] list_tools failed, marking connection broken: %s", self.name, e)
   509	                return None
   510	
   511	    async def call_tool(self, tool_name: str, arguments: dict) -> types.CallToolResult | None:
   512	        """Returns None if not connected — caller decides how to report that,
   513	        since the aggregator needs a slightly different message than the
   514	        single-upstream case (naming which upstream is down)."""
   515	        async with self.lock:
   516	            if self.session is None:
   517	                return None
   518	            log.info("[%s] call_tool %s", self.name, tool_name)
   519	            try:
   520	                with anyio.fail_after(CALL_TIMEOUT_SECONDS):
   521	                    result = await self.session.call_tool(tool_name, arguments)
   522	            except Exception as e:
   523	                # See list_tools' comment — same missing-timeout bug, same fix.
   524	                self.known_broken = True
   525	                log.warning("[%s] call_tool %s failed, marking connection broken: %s", self.name, tool_name, e)
   526	                return None
   527	            if not isinstance(result, types.CallToolResult):
   528	                # upstream returned something this dumb proxy doesn't forward
   529	                # (e.g. InputRequiredResult) — surface as an error, don't crash.
