   110	def _dump_result(result: Any) -> dict[str, Any]:
   111	    if result is None:
   112	        return {}
   113	    if isinstance(result, ErrorData):
   114	        # ErrorData is a JSON-RPC error, not a success result. Handler returns
   115	        # already raise in `_inner`; this catches middleware returning one.
   116	        raise MCPError.from_error_data(result)
   117	    if isinstance(result, BaseModel):
   118	        return result.model_dump(by_alias=True, mode="json", exclude_none=True)
   119	    if isinstance(result, dict):
   120	        # Copied so callers own the returned dict: handlers and middleware may
   121	        # retain the object they returned, and the outbound pipeline shapes the
   122	        # wire form without reaching into anything the handler still holds.
   123	        return dict(cast(dict[str, Any], result))
   124	    raise TypeError(f"handler returned {type(result).__name__}; expected BaseModel, dict, or None")
