   719	    # fallback for a name that has not been listed yet in this daemon's lifetime.
   720	    # Prefix routing alone cannot survive the tool map (Phase 3): a mapped name that
   721	    # drops the prefix would be advertised and then rejected as unknown. The config
   722	    # loader already rejects the prefix sets that would make this table ambiguous
   723	    # (duplicates, prefixes of each other).
