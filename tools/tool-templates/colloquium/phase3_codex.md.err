   207	def load(path, strict=True):
   208	    """-> list of UpstreamSpec, in the file's order. Raises ConfigError (bad content) or
   209	    OSError (unreadable file); the caller chooses the exit code.
   210	
   211	    strict=True is the AUTHORING contract (the validate CLI, template checks): a sieve
   212	    entry without a why is a hard error. strict=False is the DAEMON contract
   213	    (resolve_specs): the same omission warns on stderr and the block still applies,
   214	    because failing a repo at daemon startup over a sentence someone forgot in astra is
   215	    the wrong place to hurt (ROADMAP 2.2)."""
   216	    try:
   217	        raw = open(path, encoding="utf-8").read()
   218	    except OSError as e:
   219	        raise OSError("mcp_config: cannot read %s (%s)" % (path, e))
   220	    try:
   221	        cfg = json.loads(raw)
   222	    except ValueError as e:
   223	        # A jsonc human file lands here. Say so: the difference between a typo and a
   224	        # deliberate comment is the whole remedy. Same wording as mcp_tools.py on purpose.
   225	        raise ConfigError(
   226	            "%s is not strict JSON (%s). If this is the commented human-owned file, point "
   227	            "at the generated one instead — comments are only allowed there." % (path, e))
   228	    servers = cfg.get("mcpServers") if isinstance(cfg, dict) else None
   229	    if not isinstance(servers, dict) or not servers:
   230	        raise ConfigError("%s has no non-empty mcpServers object" % path)
   231	    # Same policy as per-server keys, at the root: Phase 2's sieve and Phase 3's map land
   232	    # here, and a typo'd stanza that validates silently is a limiting policy that never
   233	    # applies (all three phase-1 panel brands flagged this gap).
   234	    for key in cfg:
   235	        if key not in TOP_LEVEL_FIELDS:
   236	            raise ConfigError("unknown top-level field '%s' in %s" % (key, path))
   237	    specs = [_parse_server(name, spec, strict) for name, spec in servers.items()]
   238	    _check_prefixes(specs)
   239	    _check_exposed_names(specs)
   240	    return specs
   241	
   242	
   243	def _check_exposed_names(specs):
   244	    """Two servers claiming one exposed name is a static contradiction, caught at load.
   245	    (A mapped name colliding with another upstream's LIVE prefixed tool is dynamic — the
   246	    daemon degrades by dropping the alias at composition, per increment 3.3.)"""
   247	    owner = {}
   248	    for s in specs:
   249	        for entry in s.maps.values():
   250	            if entry.exposed in owner:
   251	                raise ConfigError(
   252	                    "exposed name '%s' is claimed by both server '%s' and server '%s'"
   253	                    % (entry.exposed, owner[entry.exposed], s.name))
   254	            owner[entry.exposed] = s.name
   255	
   256	
   257	def _check_prefixes(specs):
   258	    """The prefix set must compose into an unambiguous surface (increment 1.3).
   259	
   260	    Two upstreams sharing a prefix collide exposed names. A prefix that is a prefix of
   261	    another — 'a__' and 'a__b__' — makes routing 'a__b__tool' depend on iteration order.
   262	    An empty prefix beside another upstream exposes bare names that cannot be routed
   263	    back. All three are author mistakes; reject them at load, when the author can still
   264	    fix them, never at call time as a misroute."""
   265	    if len(specs) < 2:
   266	        return
   267	    seen = {}
   268	    for s in specs:
   269	        if s.prefix == "":
   270	            raise ConfigError(
   271	                "server '%s' has an empty prefix beside other upstreams — its bare tool "
   272	                "names could not be routed back to it" % s.name)
   273	        if s.prefix in seen:
   274	            raise ConfigError("servers '%s' and '%s' have the same prefix '%s' — their "
   275	                              "exposed names would collide" % (seen[s.prefix], s.name, s.prefix))
   276	        seen[s.prefix] = s.name
   277	    ordered = sorted(specs, key=lambda s: s.prefix)
   278	    for a, b in zip(ordered, ordered[1:]):
   279	        if b.prefix.startswith(a.prefix):
   280	            raise ConfigError(
   281	                "server '%s' prefix '%s' is a prefix of server '%s' prefix '%s' — routing "
   282	                "a name under the longer one would be order-dependent"
   283	                % (a.name, a.prefix, b.name, b.prefix))
   284	
   285	
   286	def resolve_specs(environ):
   287	    """How the daemon picks its upstreams (increment 1.2). One mechanism wins, visibly:
   288	
   289	    - XCODE_MCP_FRONT_UPSTREAMS set: HARD ERROR. The colon/comma format silently corrupted
   290	      a colon in a command path and a comma in an argument; it is replaced, not deprecated,
   291	      because a daemon half-honouring both mechanisms would hide which one won.
   292	    - XCODE_MCP_FRONT_MCP_INFO set: load that _mcp_info.json.
   293	    - neither: the deployed single-upstream env contract, unchanged — UPSTREAM_CMD
   294	      (default xcrun), UPSTREAM_ARGS (default mcpbridge), REQUIRE_XCODE (default 1),
   295	      served unprefixed exactly as before.
   296	    """
   297	    if environ.get("XCODE_MCP_FRONT_UPSTREAMS"):
   298	        raise ConfigError(
   299	            "XCODE_MCP_FRONT_UPSTREAMS has been replaced by _mcp_info.json — set "
   300	            "XCODE_MCP_FRONT_MCP_INFO=<path> instead. The colon/comma format corrupts a "
   301	            "command path containing ':' and an argument containing ',', silently.")
   302	    info = environ.get("XCODE_MCP_FRONT_MCP_INFO")
   303	    if info:
   304	        return load(info, strict=False)  # daemon runtime: warn on a missing why, still serve
   305	    quirks = frozenset({"require_xcode"}) if environ.get(
   306	        "XCODE_MCP_FRONT_REQUIRE_XCODE", "1") == "1" else frozenset()
   307	    return [UpstreamSpec(
   308	        name="default",
   309	        command=environ.get("XCODE_MCP_FRONT_UPSTREAM_CMD", "xcrun"),
   310	        args=environ.get("XCODE_MCP_FRONT_UPSTREAM_ARGS", "mcpbridge").split(),
   311	        prefix="",
   312	        quirks=quirks,
   313	    )]
   314	
   315	
   316	def _print_specs(upstreams):
   317	    for u in upstreams:
   318	        quirks = ",".join(sorted(u.quirks)) or "-"
   319	        env = " env=" + ",".join(sorted(u.env)) if u.env else ""
   320	        print("%s  prefix=%s  quirks=%s%s  %s %s" % (u.name, u.prefix, quirks, env,
   321	                                                     u.command, " ".join(u.args)))
   322	        for tool, why in sorted(u.blocks.items()):
   323	            print("    blocked: %s — %s" % (tool, why))
   324	        for tool, entry in sorted(u.maps.items()):
   325	            print("    mapped:  %s -> %s — %s" % (tool, entry.exposed, entry.why))
   326	
   327	
   328	def main(argv):
   329	    import os
   330	    if len(argv) == 2 and argv[1] == "resolve":
   331	        try:
   332	            upstreams = resolve_specs(os.environ)
   333	        except ConfigError as e:
   334	            print("mcp_config: %s" % e, file=sys.stderr)
   335	            return 65
   336	        except OSError as e:
   337	            print(str(e), file=sys.stderr)
   338	            return 66
   339	        _print_specs(upstreams)
   340	        return 0
   341	    if len(argv) != 3 or argv[1] != "validate":
   342	        print("usage: mcp_config.py validate <file> | resolve", file=sys.stderr)
   343	        return 64
   344	    try:
   345	        upstreams = load(argv[2])
   346	    except ConfigError as e:
   347	        print("mcp_config: %s" % e, file=sys.stderr)
   348	        return 65
   349	    except OSError as e:
   350	        print(str(e), file=sys.stderr)
   351	        return 66
   352	    _print_specs(upstreams)
   353	    return 0
   354	
   355	
   356	if __name__ == "__main__":
   357	    sys.exit(main(sys.argv))

