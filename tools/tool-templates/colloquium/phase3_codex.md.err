   798	def _build_upstreams() -> list[Upstream]:
   799	    """All selection and validation logic lives in mcp_config.resolve_specs (tested fast,
   800	    without this file's mcp/uvicorn dependencies); this is only the Upstream construction.

exec
/bin/zsh -lc "nl -ba tools/xcode-mcp-front/daemon.py | sed -n '801,1147p'" in /Users/jonathan/svnCheckouts/js-db-ad-astra
