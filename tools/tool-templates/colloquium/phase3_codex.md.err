   808	        Upstream(name=s.name, command=s.command, args=s.args,
   809	                 require_xcode_running=s.require_xcode, prefix=s.prefix, env=s.env,
   810	                 blocks=s.blocks, maps=s.maps)
   811	        for s in specs
   812	    ]
   813	
   814	
   815	def _not_connected_result(u: "Upstream") -> types.CallToolResult:
   816	    # The retry text is derived from the upstream's own quirks: telling a client that
   817	    # Xcode is being checked and its dialog clicked, for an upstream that has nothing to
   818	    # do with Xcode, is a lie the phase-1 panel reproduced verbatim.
   819	    if u.require_xcode_running:
   820	        how = ("checking Xcode is running and clicking its approval prompt if one is "
   821	               "showing")
   822	    else:
   823	        how = "restarting its child process"
   824	    return types.CallToolResult(
   825	        content=[
   826	            types.TextContent(
   827	                type="text",
   828	                text=(
   829	                    f"{SERVER_NAME}: [{u.name}] not connected right now. This daemon "
   830	                    f"retries on its own every few seconds ({how}) — a retry shortly "
   831	                    "should work without any manual action."
   832	                ),
   833	            )
   834	        ],
   835	        is_error=True,
   836	    )
   837	
   838	
   839	def build_server(upstreams: list[Upstream]) -> Server:
   840	    single = len(upstreams) == 1
   841	    # Prefixes are honoured VERBATIM — the single-upstream override that forced "" here
   842	    # made the daemon and the validator disagree about the same file, and made adding a
   843	    # second server silently rename the first one's entire surface.
   844	    prefix_of = {u: u.prefix for u in upstreams}
   845	    upstream_by_prefix = {prefix_of[u]: u for u in upstreams}
   846	    # Bare-name passthrough exists ONLY for the deployed env-var single mode, whose spec
   847	    # carries an explicitly empty prefix.
   848	    passthrough = upstreams[0] if single and upstreams[0].prefix == "" else None
   849	
   850	    # EXPLICIT DISPATCH TABLE (increment 1.3): exposed name -> (upstream, bare upstream
   851	    # name), rebuilt every time the surface is composed in on_list_tools. Consulted
   852	    # FIRST on tools/call; the startswith() prefix walk below survives only as a
   853	    # fallback for a name that has not been listed yet in this daemon's lifetime.
   854	    # Prefix routing alone cannot survive the tool map (Phase 3): a mapped name that
   855	    # drops the prefix would be advertised and then rejected as unknown. The config
   856	    # loader already rejects the prefix sets that would make this table ambiguous
   857	    # (duplicates, prefixes of each other).
   858	    dispatch: dict[str, tuple[Upstream, str]] = {}
   859	
   860	    async def on_list_tools(
   861	        ctx: ServerRequestContext, params: types.PaginatedRequestParams | None
   862	    ) -> types.ListToolsResult:
   863	        # A DISCONNECTED upstream is reported and skipped; it must NOT blank the others
   864	        # (increment 1.4 — the defect all three colloquium brands found independently:
   865	        # this used to serve zero tools for EVERY upstream when any one was missing, so
   866	        # during an Xcode reconnect Drew's tools, which need no Xcode, vanished too).
   867	        # A connected upstream answering with zero tools contributes zero tools; that is
   868	        # an answer, not an absence.
   869	        # This daemon serves its whole surface as ONE page (each upstream is drained in
   870	        # Upstream.list_tools), so it never issues a nextCursor — and a cursor it never
   871	        # issued cannot be honoured. Refusing beats forwarding it into upstream cursor
   872	        # spaces it cannot belong to, which corrupted per-upstream pagination silently.
   873	        if params is not None and params.cursor is not None:
   874	            # MCPError so both transport paths return the spec's INVALID_PARAMS with the
   875	            # message intact — a raised ValueError became code 0 on the 2025 path and a
   876	            # message-less "Internal server error" on the modern one (panel, measured by
   877	            # the claude leg on both protocol versions; empty-string cursor caught by
   878	            # codex — "" is as unissued as any other value).
   879	            raise MCPError(
   880	                types.INVALID_PARAMS,
   881	                f"{SERVER_NAME} serves its full tool list in one page and issued no cursor; "
   882	                f"got unexpected cursor {params.cursor!r}")
   883	        # Upstreams are listed CONCURRENTLY: each drain is independent, and the old
   884	        # sequential walk meant one slow upstream withheld every later upstream's tools
   885	        # for its whole timeout (panel: measured 23 seconds behind a single stalled stub).
   886	        results: dict[Upstream, types.ListToolsResult | None] = {}
   887	
   888	        async def _collect(u: Upstream) -> None:
   889	            results[u] = await u.list_tools(None)
   890	
   891	        async with anyio.create_task_group() as tg:
   892	            for u in upstreams:
   893	                tg.start_soon(_collect, u)
   894	
   895	        # THE EVALUATION ORDER IS FIXED AND THIS LOOP IS ITS DECLARATION (increment 2.3):
   896	        # per upstream — availability first (an unavailable upstream is reported, and its
   897	        # blocks are inert), then the source-qualified sieve while composing, then
   898	        # (Phase 3) renames and description rewrites, then global uniqueness, then
   899	        # publish. Blocks apply AFTER the availability check on purpose: the round-one
   900	        # colloquium's catastrophic case was the sieve meeting the old blank-on-missing
   901	        # logic and serving nothing from anywhere.
   902	        all_tools: list[types.Tool] = []
   903	        unavailable: list[str] = []
   904	        new_dispatch: dict[str, tuple[Upstream, str]] = {}
   905	        for u in upstreams:
   906	            result = results.get(u)
   907	            if result is None:
   908	                unavailable.append(u.name)
   909	                continue
   910	            prefix = prefix_of[u]
   911	            offered = set()
   912	            for t in result.tools:
   913	                bare = t.name
   914	                offered.add(bare)
   915	                if bare in u.blocks:
   916	                    continue  # sieved; the call path refuses it too, with the why
   917	                entry = u.maps.get(bare)
   918	                # The map (Phase 3): a mapped name is the FINAL exposed name, replacing
   919	                # prefix+bare. The description travels with the name and usually should
   920	                # not: an explicit override wins outright; otherwise the rename table
   921	                # mechanically rewrites whole-word references to renamed siblings, so
   922	                # every description goes un-stale in the same pass that renamed them.
   923	                exposed = entry.exposed if entry else f"{prefix}{bare}"
   924	                if entry and entry.description is not None:
   925	                    desc = entry.description
   926	                    leftover = u.rewrite_description(desc)
   927	                    if leftover != desc:
   928	                        log.warning("[%s] override description for '%s' still references "
   929	                                    "renamed tools by their OLD names — it will mislead "
   930	                                    "the model; fix it in the template", u.name, exposed)
   931	                else:
   932	                    desc = u.rewrite_description(t.description or "")
   933	                if exposed in new_dispatch:
   934	                    if entry:
   935	                        # A mapped name colliding with something already published is
   936	                        # increment 3.3's degraded state: drop the alias, keep serving
   937	                        # the tool under its prefixed original, report it.
   938	                        log.warning("[%s] mapped name '%s' collides with an already "
   939	                                    "published tool — dropping the alias and serving "
   940	                                    "'%s%s' instead", u.name, exposed, prefix, bare)
   941	                        exposed = f"{prefix}{bare}"
   942	                        if exposed in new_dispatch:
   943	                            continue
   944	                    else:
   945	                        # Reachable since 1.5: an upstream mutating its list between
   946	                        # drained pages can hand back the same tool twice.
   947	                        log.warning("list_tools: duplicate exposed name %r from upstream "
   948	                                    "%s — keeping the first occurrence", exposed, u.name)
   949	                        continue
   950	                t = t.model_copy(update={"name": exposed, "description": desc})
   951	                new_dispatch[exposed] = (u, bare)
   952	                all_tools.append(t)
   953	            # A decision naming a tool the upstream does not offer is a line that stopped
   954	            # meaning anything, and a version bump is exactly when that happens. Once per
   955	            # entry, so a 5-second poll loop does not turn staleness into log spam. A
   956	            # stale MAP entry is the harsher case: the surface promised a name that would
   957	            # fail on first use — drop the alias, keep serving, say so (3.3).
   958	            for stale in sorted(set(u.blocks) - offered - u._stale_blocks_reported):
   959	                u._stale_blocks_reported.add(stale)
   960	                log.warning("[%s] block entry for '%s' matched nothing the upstream "
   961	                            "offers — the decision it records no longer applies; "
   962	                            "fix or remove it in the template", u.name, stale)
   963	            for stale in sorted(set(u.maps) - offered - u._stale_maps_reported):
   964	                u._stale_maps_reported.add(stale)
   965	                log.warning("[%s] map entry for '%s' matched nothing the upstream offers "
   966	                            "— its exposed name '%s' is dropped from the surface; the "
   967	                            "upstream likely renamed or removed the tool. Fix the "
   968	                            "template, and consider re-running the collision comparison "
   969	                            "against this upstream's new version.",
   970	                            u.name, stale, u.maps[stale].exposed)
   971	        dispatch.clear()
   972	        dispatch.update(new_dispatch)
   973	        if unavailable:
   974	            log.warning("list_tools: serving %d tools WITHOUT unavailable upstream(s) %s — "
   975	                        "each reconnects on its own; calls to them return a per-upstream error",
   976	                        len(all_tools), ", ".join(unavailable))
   977	        return types.ListToolsResult(tools=all_tools)
   978	
   979	    async def _refresh_upstream_dispatch(u: Upstream) -> bool:
   980	        """Re-list ONE upstream and fold its tools into the dispatch table. Returns
   981	        False when the upstream is unavailable."""
   982	        result = await u.list_tools(None)
   983	        if result is None:
   984	            return False
   985	        prefix = prefix_of[u]
   986	        for t in result.tools:
   987	            if t.name in u.blocks:
   988	                continue  # the sieve applies on every path that builds dispatch entries
   989	            entry = u.maps.get(t.name)
   990	            exposed = entry.exposed if entry else f"{prefix}{t.name}"  # so does the map
   991	            dispatch[exposed] = (u, t.name)
   992	        return True
   993	
   994	    async def on_call_tool(ctx: ServerRequestContext, params: types.CallToolRequestParams) -> types.CallToolResult:
   995	        # ROUTING IS DISPATCH-FIRST AND NEVER FORWARDS ON FAITH. The old prefix fallback
   996	        # forwarded any dispatch miss to whichever upstream owned the prefix — which
   997	        # would quietly bypass Phase 2's deny list and keep Phase 3's renamed tools
   998	        # callable under their old names (panel, codex leg). A miss now refreshes that
   999	        # one upstream's catalogue once (covering a call that arrives before the first
  1000	        # tools/list) and refuses if the name still is not offered.
  1001	        name = params.name
  1002	        if name not in dispatch:
  1003	            candidate = None
  1004	            if passthrough is not None:
  1005	                candidate = passthrough
  1006	            else:
  1007	                # A mapped exposed name carries no prefix, so before the prefix walk,
  1008	                # recognise it from the static map tables — a call can legitimately
  1009	                # arrive before this daemon's first tools/list.
  1010	                for u in upstreams:
  1011	                    if any(e.exposed == name for e in u.maps.values()):
  1012	                        candidate = u
  1013	                        break
  1014	                else:
  1015	                    for prefix, u in upstream_by_prefix.items():
  1016	                        if prefix and name.startswith(prefix):
  1017	                            candidate = u
  1018	                            break
  1019	            if candidate is None:
  1020	                return types.CallToolResult(
  1021	                    content=[
  1022	                        types.TextContent(
  1023	                            type="text",
  1024	                            text=f"{SERVER_NAME}: tool name '{name}' doesn't match any known upstream prefix "
  1025	                            f"({', '.join(p for p in upstream_by_prefix if p)})",
  1026	                        )
  1027	                    ],
  1028	                    is_error=True,
  1029	                )
  1030	            if candidate is passthrough:
  1031	                # Env-var single mode serves the upstream's names verbatim, so there is
  1032	                # no daemon-side catalogue to enforce; the upstream answers for itself.
  1033	                result = await candidate.call_tool(name, params.arguments)
  1034	                if result is None:
  1035	                    return _not_connected_result(candidate)
  1036	                return result
  1037	            pfx = prefix_of[candidate]
  1038	            bare = name[len(pfx):] if pfx and name.startswith(pfx) else name
  1039	            if bare in candidate.blocks:
  1040	                # The sieve at tools/call (increment 2.1): hiding a tool from the listing
  1041	                # while leaving it callable would make the block decoration. The refusal
  1042	                # carries the recorded why — that is what the mandatory field is FOR.
  1043	                return types.CallToolResult(
  1044	                    content=[types.TextContent(
  1045	                        type="text",
  1046	                        text=(f"{SERVER_NAME}: '{bare}' on upstream '{candidate.name}' is "
  1047	                              f"blocked on this surface — {candidate.blocks[bare]}"))],
  1048	                    is_error=True,
  1049	                )
  1050	            if not await _refresh_upstream_dispatch(candidate):
  1051	                return _not_connected_result(candidate)
  1052	            if name not in dispatch:
  1053	                bare = name[len(prefix_of[candidate]):]
  1054	                return types.CallToolResult(
  1055	                    content=[
  1056	                        types.TextContent(
  1057	                            type="text",
  1058	                            text=(
  1059	                                f"{SERVER_NAME}: upstream '{candidate.name}' does not currently "
  1060	                                f"offer '{bare}' — re-list tools for the current surface."
  1061	                            ),
  1062	                        )
  1063	                    ],
  1064	                    is_error=True,
  1065	                )
  1066	
  1067	        target, tool_name = dispatch[name]
  1068	        result = await target.call_tool(tool_name, params.arguments)
  1069	        if result is None:
  1070	            return _not_connected_result(target)
  1071	        return result
  1072	
  1073	    # THE INSTRUCTIONS ARE DERIVED FROM THE CONFIG, NOT ASSUMED. The old text described
  1074	    # every surface as Apple's Xcode bridge — the panel booted a Python stub behind this
  1075	    # daemon and read initialize text claiming it was `xcrun mcpbridge`. The mcpbridge
  1076	    # guidance survives, but only when an upstream actually IS mcpbridge.
  1077	    fronts_mcpbridge = any(
  1078	        u.command == "xcrun" and "mcpbridge" in u.args for u in upstreams)
  1079	    mcpbridge_para = (
  1080	        "\n\nApple's own Xcode MCP bridge (`xcrun mcpbridge`) is one of the upstreams "
  1081	        "here. You will likely also see other Xcode-adjacent MCP servers configured "
  1082	        "alongside — commonly xcode-mcp-server (a third-party tool, Drew's) and "
  1083	        "XcodeBuildMCP. That overlap is INTENTIONAL, not a conflict to resolve. If a "
  1084	        "call here fails or behaves inconsistently, try the equivalent tool on one of "
  1085	        "the others instead of giving up — and if one consistently works better or "
  1086	        "worse for a task, say so out loud in your response; that is wanted "
  1087	        "information."
  1088	        if fronts_mcpbridge else "")
  1089	    if single:
  1090	        u0 = upstreams[0]
  1091	        shown = f"{u0.prefix}<tool>" if u0.prefix else "the upstream's own tool names, unprefixed"
  1092	        instructions = (
  1093	            f"This is a persistent HTTP proxy in front of one MCP server: {u0.name} "
  1094	            f"(`{u0.command} {' '.join(u0.args)}`), serving {shown}. One approved "
  1095	            "daemon stays up instead of each client spawning its own copy.\n\n"
  1096	            "If a call says 'not connected right now', this daemon is already retrying "
  1097	            "on its own every few seconds, so a short retry should work without any "
  1098	            f"manual action.{mcpbridge_para}"
  1099	        )
  1100	    else:
  1101	        roster = "; ".join(
  1102	            f"{u.name} (`{u.command} {' '.join(u.args)}`, tools prefixed `{u.prefix}`)"
  1103	            for u in upstreams)
  1104	        instructions = (
  1105	            f"This is a persistent proxy fronting MULTIPLE MCP servers behind one "
  1106	            f"endpoint: {roster}. Prefixes keep two upstreams' same-named tools from "
  1107	            "colliding — always use the prefixed name shown in the tool list.\n\n"
  1108	            "If a call says 'not connected right now', that specific upstream is "
  1109	            "reconnecting on its own — the others are unaffected, since each upstream "
  1110	            "has its own independent connection. A short retry should work.\n\n"
  1111	            "The tool list reflects the upstreams available AT THE MOMENT YOU LIST. If "
  1112	            "an upstream named above is missing from the list, it is reconnecting; "
  1113	            f"re-run tools/list to pick it up when it returns.{mcpbridge_para}"
  1114	        )
  1115	
  1116	    return Server(
  1117	        SERVER_NAME,
  1118	        version="0.4.0",
  1119	        instructions=instructions,
  1120	        on_list_tools=on_list_tools,
  1121	        on_call_tool=on_call_tool,
  1122	        lifespan=lambda app: _lifespan(app, upstreams),
  1123	    )
  1124	
  1125	
  1126	@contextlib.asynccontextmanager
  1127	async def _lifespan(app: Server, upstreams: list[Upstream]):
  1128	    async with anyio.create_task_group() as tg:
  1129	        for u in upstreams:
  1130	            tg.start_soon(u.connection_manager)
  1131	            tg.start_soon(u.stall_watchdog)
  1132	        try:
  1133	            yield {}
  1134	        finally:
  1135	            tg.cancel_scope.cancel()
  1136	
  1137	
  1138	def main() -> None:
  1139	    upstreams = _build_upstreams()
  1140	    server = build_server(upstreams)
  1141	    app = server.streamable_http_app(host=HOST)
  1142	    log.info("listening on http://%s:%s/mcp (upstreams: %s)", HOST, PORT, ", ".join(u.name for u in upstreams))
  1143	    uvicorn.run(app, host=HOST, port=PORT, log_level="info")
  1144	
  1145	
  1146	if __name__ == "__main__":
  1147	    main()

