   790	                            "; ".join(causes))
   791	
   792	            async with self.lock:
   793	                self.session = None
   794	            log.info("[%s] not connected, retrying in %ss", self.name, RECONNECT_POLL_SECONDS)
   795	            await anyio.sleep(RECONNECT_POLL_SECONDS)
