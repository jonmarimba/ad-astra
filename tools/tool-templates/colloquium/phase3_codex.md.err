   132	        raise ConfigError("server '%s': 'map' must be a list of objects" % name)
   133	    maps = {}
   134	    claimed = set()
   135	    for m in raw:
   136	        tool = m.get("tool")
   137	        if not isinstance(tool, str) or not tool:
   138	            raise ConfigError("map entry on server '%s' has no 'tool' name" % name)
   139	        for key in m:
   140	            if key not in ("tool", "name", "why", "description"):
   141	                raise ConfigError("unknown field '%s' in map entry for '%s' on server '%s'"
   142	                                  % (key, tool, name))
   143	        exposed = m.get("name")
   144	        if not isinstance(exposed, str) or not exposed:
   145	            raise ConfigError("map entry for '%s' on server '%s' has no 'name' (the "
   146	                              "exposed name it becomes)" % (tool, name))
   147	        why = m.get("why")
   148	        if not isinstance(why, str) or not why.strip():
   149	            msg = ("map entry for '%s' on server '%s' has no 'why' — every rename "
   150	                   "carries its stated reason, or the map outlives its cause"
   151	                   % (tool, name))
   152	            if strict:
   153	                raise ConfigError(msg)
   154	            print("mcp_config: WARNING: %s (applying the rename anyway; fix the template)"
   155	                  % msg, file=sys.stderr)
   156	            why = "(no reason recorded — fix the template)"
   157	        if tool in maps:
   158	            raise ConfigError("duplicate map entry for '%s' on server '%s'" % (tool, name))
   159	        if exposed in claimed:
   160	            raise ConfigError("exposed name '%s' is claimed twice on server '%s'"
   161	                              % (exposed, name))
   162	        claimed.add(exposed)
   163	        desc = m.get("description")
   164	        if desc is not None and not isinstance(desc, str):
   165	            raise ConfigError("map entry for '%s' on server '%s': 'description' must be "
   166	                              "a string" % (tool, name))
   167	        maps[tool] = MapEntry(exposed, why, desc)
   168	    return maps
