    68	
    69	# --- the rest of the rejection surface, each with its own message ---
    70	printf '{"mcpServers": {}}' > "$SB/empty.json"
    71	red "empty mcpServers must fail" 65 "no non-empty mcpServers" \
    72	  python3 "$LOADER" validate "$SB/empty.json"
    73	
    74	printf '{"mcpServers": {"x": {"args": ["a"]}}}' > "$SB/nocmd.json"
    75	red "server without a command must fail naming the server" 65 "server 'x' has no 'command'" \
    76	  python3 "$LOADER" validate "$SB/nocmd.json"
    77	
    78	printf '{"mcpServers": {"x": {"command": "c", "args": "not-a-list"}}}' > "$SB/badargs.json"
    79	red "args that are not a list of strings must fail" 65 "server 'x': 'args' must be a list of strings" \
    80	  python3 "$LOADER" validate "$SB/badargs.json"
