   127	def _parse_maps(name, raw, strict):
   128	    """Map entries: [{"tool", "name", "why", "description"?}] -> {bare tool: MapEntry}.
   129	    Same why policy as the sieve: hard error at authoring time, warn-and-apply at daemon
   130	    runtime (ROADMAP 2.2 applies to every decision field)."""
