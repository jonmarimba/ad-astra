   197	def _pid_is_alive(pid_str: str) -> bool:
   198	    """No history file needed: a dialog's PID is either us, or it's a live PID
   199	    that belongs to someone else's legitimate in-flight request (leave it
   200	    alone), or it's simply not in the process table anymore (nothing is
   201	    waiting on it — always safe to dismiss, regardless of whose it was).
