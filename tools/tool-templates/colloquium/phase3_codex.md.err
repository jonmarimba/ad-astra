   135	def _load_config_file() -> None:
   136	    """Reached via a wrapped .app under launchd in real deployment, which does
   137	    NOT reliably forward a launchd plist's EnvironmentVariables into the
   138	    launched app's process (a LaunchServices quirk, separate from the TCC one
   139	    this tool is already built around). A config file sidesteps that entirely:
   140	    it's read directly off disk, so it works regardless of how this process was
   141	    launched. Real env vars still win if both are set (checked with setdefault,
   142	    same layering as ollama-watch's config convention elsewhere in this repo)."""
   143	    conf = os.path.join(os.environ.get("XCODE_MCP_FRONT_HOME", os.path.expanduser("~/.xcode-mcp-front")), "config")
   144	    if not os.path.isfile(conf):
   145	        return
   146	    with open(conf) as f:
   147	        for line in f:
   148	            line = line.strip()
   149	            if not line or line.startswith("#") or "=" not in line:
   150	                continue
   151	            key, _, value = line.partition("=")
   152	            os.environ.setdefault(key.strip(), value.strip().strip("'\""))
   153	
