   206	        os.kill(int(pid_str), 0)
   207	        return True
   208	    except ProcessLookupError:
   209	        return False
   210	    except (ValueError, PermissionError):
   211	        # ValueError: not a real pid, treat as "can't tell" -> leave it alone.
   212	        # PermissionError: pid exists but isn't ours to signal -> still alive.
   213	        return True
