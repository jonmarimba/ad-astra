   640	    async def stall_watchdog(self) -> None:
   641	        """Exit the process if this upstream stops making progress entirely.
   642	
   643	        THE RECONNECT LOOP CAN GET STUCK AND GO PERMANENTLY SILENT. Observed live
   644	        2026-08-30: xcode-mcp-front logged "heartbeat list_tools failed, marking broken"
   645	        at 18:50:55 and then never logged again — no retry, no error, nothing — while its
   646	        HTTP endpoint kept answering and serving zero tools. The cause is the teardown, not
   647	        the loop: leaving `async with stdio_client(...)` waits for the child to exit, and a
   648	        wedged mcpbridge never does, so the task blocks inside __aexit__ where no `except`
   649	        and no retry can reach it. Every health signal this daemon has says "fine" in that
   650	        state, which is the worst possible failure shape.
   651	
   652	        There is no clean way to bound a hung context-manager exit from inside it. There IS
   653	        a supervisor: launchd, with KeepAlive true. So when an upstream has made no progress
   654	        for STALL_EXIT_SECONDS — no connect attempt, no successful heartbeat — say so loudly
   655	        and exit non-zero. That is the file's own stated philosophy: "a genuine crash is what
   656	        the process supervisor is for." A restart costs one new Xcode approval prompt, which
   657	        the clicker answers.
   658	
   659	        Deliberately generous, because a false positive here restarts a working daemon: the
   660	        default is many multiples of the heartbeat interval, and any progress at all resets it.
   661	        """
   662	        while True:
   663	            await anyio.sleep(RECONNECT_POLL_SECONDS)
   664	            if self.require_xcode_running and not _xcode_is_running():
   665	                # Waiting for Xcode is not a stall; that path logs and sleeps on purpose.
   666	                self.last_progress = time.monotonic()
   667	                continue
   668	            idle = time.monotonic() - getattr(self, "last_progress", time.monotonic())
   669	            if idle > STALL_EXIT_SECONDS:
   670	                log.error("[%s] no connect attempt and no successful heartbeat for %.0fs — the "
   671	                          "reconnect loop made no progress. Two known causes: stdio_client "
   672	                          "teardown waiting on a child that will not exit, or the loop waiting "
   673	                          "on this upstream's own lock behind a wedged call. Exiting so launchd "
   674	                          "restarts us; staying up would serve zero tools while every log line "
   675	                          "claimed we were connected.", self.name, idle)
   676	                os._exit(75)
   677	
   678	
   679	    async def connection_manager(self) -> None:
   680	        """Owns this upstream's connection for the daemon's whole life. Loops
   681	        forever: while not connected, check Xcode is running (if this upstream
   682	        needs it), best-effort click its approval prompt if showing, attempt a
   683	        fresh connect. Once connected, holds the session open — polling (and
   684	        clicking) on the same timer — until a call proves it's broken, then
   685	        goes back to reconnecting. In-process, never exits on its own; a
   686	        genuine crash is what the process supervisor (launchd) is for."""
   687	        # The config's env map is ADDITIVE over the SDK's safe default set (a six-variable
   688	        # allowlist) — matching Claude Code's semantics for the same file shape. Passing
   689	        # spec env alone would strip PATH and HOME from the child.
   690	        child_env = {**get_default_environment(), **self.env} if self.env else None
   691	        params = StdioServerParameters(command=self.command, args=self.args, env=child_env)
   692	        while True:
   693	            if self.require_xcode_running and not _xcode_is_running():
   694	                log.info("[%s] Xcode not running, waiting", self.name)
   695	                await anyio.sleep(RECONNECT_POLL_SECONDS)
   696	                continue
   697	
   698	            if AUTO_ALLOW:
   699	                await _click_allow_if_present()
   700	
   701	            log.info("[%s] attempting connect: %s %s", self.name, self.command, self.args)
   702	            self.last_progress = time.monotonic()
   703	            try:
   704	                async with stdio_client(params) as (read, write):
   705	                    async with ClientSession(read, write) as session:
   706	                        with anyio.fail_after(CONNECT_TIMEOUT_SECONDS):
   707	                            await session.initialize()
   708	                        async with self.lock:
   709	                            self.session = session
   710	                            self.known_broken = False
   711	                        log.info("[%s] connected — serving until this breaks", self.name)
   712	                        self.last_progress = time.monotonic()
   713	                        while not self.known_broken:
   714	                            await anyio.sleep(RECONNECT_POLL_SECONDS)
   715	                            # Health-check: a silent list_tools call catches a
   716	                            # dead upstream before any client discovers it.
   717	                            # Without this, a killed Xcode leaves the daemon
   718	                            # sitting "connected" until a real client call
   719	                            # fails — minutes of silently serving zero tools.
   720	                            # CLICK WHILE THE CALL IS BLOCKED, NOT AFTER IT RETURNS. This is
   721	                            # the deadlock that kept the suite at 6/10 and looked for a whole
   722	                            # night like Apple's bridge refusing to serve tools.
   723	                            #
   724	                            # Xcode raises "Allow <x> to access Xcode?" lazily, on the first real
   725	                            # list_tools rather than at the handshake — the comment below has
   726	                            # said so since 2026-08-14. So list_tools BLOCKS until that dialog is
   727	                            # answered. The clicker that answers it was placed after the await.
   728	                            # It therefore ran only once list_tools had already returned, and on
   729	                            # the timeout path the except branch marks the upstream broken and
   730	                            # breaks out before reaching it at all. The one thing that could
   731	                            # unblock the call was scheduled to run only after the call unblocked.
   732	                            #
   733	                            # Worse, the teardown withdraws the prompt: the dialog is bound to the
   734	                            # live connecting process, so killing the child on timeout retracts
   735	                            # the question. With a 5s reconnect loop the daemon spent all night
   736	                            # asking Xcode for permission and cancelling the request before anyone
   737	                            # could say yes — which is why no dialog was ever found on screen, and
   738	                            # why running a single bridge by hand and simply leaving it alive
   739	                            # produced the prompt immediately and 21 tools once it was answered.
   740	                            #
   741	                            # Two daemons made it twice as fast, which is the "do two bridges
   742	                            # interfere" question: they do, but only by doubling the churn. One
   743	                            # daemon alone reproduces it.
   744	                            try:
   745	                                with anyio.fail_after(CONNECT_TIMEOUT_SECONDS):
   746	                                    async with anyio.create_task_group() as _tg:
   747	                                        async def _click_while_blocked():
   748	                                            # Poll rather than click once: the dialog appears a
   749	                                            # moment AFTER the request goes out, so a single
   750	                                            # attempt at the start reliably finds nothing.
   751	                                            while True:
   752	                                                if AUTO_ALLOW:
   753	                                                    await _click_allow_if_present()
   754	                                                await anyio.sleep(ALLOW_CLICK_POLL_SECONDS)
   755	                                        _tg.start_soon(_click_while_blocked)
   756	                                        await session.list_tools()
   757	                                        _tg.cancel_scope.cancel()
   758	                                self.last_progress = time.monotonic()
   759	                            except Exception as e:
   760	                                log.warning("[%s] heartbeat list_tools failed, marking broken: %s", self.name, e)
   761	                                async with self.lock:
   762	                                    self.known_broken = True
   763	                                    # Drop the public reference NOW — stdio teardown can
   764	                                    # wedge (see stall_watchdog), and until it finishes
   765	                                    # the old session must not be callable.
   766	                                    self.session = None
