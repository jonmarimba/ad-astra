   458	class Upstream:
   459	    """One upstream MCP server this daemon fronts, and everything needed to
   460	    keep a persistent connection to it alive. In single-upstream mode there's
   461	    exactly one of these and its tools are forwarded unprefixed (unchanged
   462	    behavior from before multi-upstream support existed). In multi-upstream
   463	    mode there are several, and the aggregator (see build_server) prefixes
   464	    each one's tools with `self.name + "__"` so two upstreams that happen to
   465	    share a tool name can't collide."""
   466	
   467	    def __init__(self, name: str, command: str, args: list[str], require_xcode_running: bool,
   468	                 prefix: str = "", env: dict | None = None, blocks: dict | None = None,
   469	                 maps: dict | None = None):
   470	        self.name = name
   471	        # Exposed-name prefix, VERBATIM from the spec. The daemon used to force "" for a
   472	        # sole upstream regardless of what the config declared, so the validator printed
   473	        # prefix=solo__ while the daemon served bare names — and adding a second server
   474	        # silently renamed every tool the first one offered (round-one colloquium defect
   475	        # 2; the phase-1 panel measured it still live). The env-var single mode passes ""
   476	        # explicitly, which keeps the deployed passthrough unprefixed.
   477	        self.prefix = prefix
   478	        self.env = dict(env) if env else None
   479	        # The sieve (Phase 2): bare tool name -> the recorded reason it is withheld.
   480	        # Deny-list only, per Jonathan. Applied when the surface is composed AND at
   481	        # tools/call — a listing filter alone is decoration, because the model knows
   482	        # names from its own context and previous sessions.
   483	        self.blocks: dict[str, str] = dict(blocks) if blocks else {}
   484	        self._stale_blocks_reported: set[str] = set()
   485	        # The map (Phase 3): bare tool name -> mcp_config.MapEntry. The exposed name is
   486	        # FINAL — it replaces prefix+bare outright; the original is refused like any
   487	        # other name the upstream does not offer on this surface.
   488	        self.maps: dict = dict(maps) if maps else {}
   489	        self._stale_maps_reported: set[str] = set()
   490	        # One word-boundary pattern per upstream drives the mechanical description pass:
   491	        # every sibling description mentioning a renamed tool goes stale at the same
   492	        # moment, so the rename table itself substitutes them all (SPEC). A regex is
   493	        # used deliberately — whole-word replacement is the one job plain string
   494	        # scanning cannot do without reimplementing \b: the roadmap's own red case is a
   495	        # tool named 'read' mangling the word 'already'.
   496	        self._rename_pattern = (
   497	            re.compile(r"\b(" + "|".join(re.escape(old) for old in self.maps) + r")\b")
   498	            if self.maps else None)
   499	        # Watchdog input: bumped on every connect attempt and every successful heartbeat.
   500	        # Initialised here so the watchdog never reads a missing attribute on a slow start.
   501	        self.last_progress = time.monotonic()
   502	        self.command = command
   503	        self.args = args
   504	        self.require_xcode_running = require_xcode_running
   505	        self.lock = anyio.Lock()
   506	        self.session: ClientSession | None = None
   507	        self.known_broken = False
   508	
   509	    def rewrite_description(self, text: str) -> str:
   510	        if not text or self._rename_pattern is None:
   511	            return text
   512	        return self._rename_pattern.sub(lambda m: self.maps[m.group(1)].exposed, text)
   513	
   514	    async def _mark_broken(self, why: str) -> None:
   515	        """Set known_broken AND drop the public session reference immediately. The codex
   516	        leg of the phase-1 panel caught the gap: known_broken was set but the session
   517	        stayed visible until stdio teardown completed, and a wedged teardown (documented
   518	        below in stall_watchdog) let calls keep entering a session everyone knew was
   519	        dead."""
   520	        async with self.lock:
   521	            self.known_broken = True
   522	            self.session = None
   523	        log.warning("[%s] marking connection broken: %s", self.name, why)
   524	
   525	    async def list_tools(self, params: types.PaginatedRequestParams | None) -> types.ListToolsResult | None:
   526	        """Returns None when this upstream is DISCONNECTED or the call failed — which is a
   527	        different fact from a connected upstream answering with zero tools, and the two
   528	        must never be conflated (increment 1.4: conflating them is how one missing
   529	        upstream used to blank the entire aggregate surface).
   530	
   531	        CONCURRENCY, stated plainly (the phase-1 panel caught the old file claiming full
   532	        serialization while the heartbeat bypassed the lock): tools/call is serialized
   533	        through self.lock; tools/list runs WITHOUT the lock on a session snapshot. The
   534	        MCP session multiplexes concurrent requests by id, and the heartbeat has listed
   535	        concurrently with real calls in production since 2026-08-14. Holding the lock
   536	        here meant a client connecting during a 10-minute build got no tool list at all
   537	        until the build ended — measured live by the panel's claude leg."""
   538	        async with self.lock:
   539	            session = None if self.known_broken else self.session
   540	        if session is None:
   541	            return None
   542	        try:
   543	            # DRAIN EVERY PAGE (increment 1.5). Cursors are opaque, per-server tokens,
   544	            # so the downstream client's cursor cannot be forwarded here — this daemon
   545	            # aggregates several cursor spaces into one surface and therefore serves a
   546	            # complete snapshot instead. Ignoring nextCursor used to silently truncate
   547	            # any upstream that paginates.
   548	            #
   549	            # The drain is bounded STRUCTURALLY, not just by wall clock (panel, all
   550	            # three brands): a repeated cursor is a definite upstream bug, and the page
   551	            # ceiling catches the fresh-cursor-forever variant — the claude leg measured
   552	            # 48,075 pages accumulated in ten seconds from a cycling stub. Listing is
   553	            # discovery, so it gets the short connect timeout, not the 600-second budget
   554	            # that exists for real builds.
   555	            tools: list[types.Tool] = []
   556	            cursor: str | None = None
   557	            seen_cursors: set[str] = set()
   558	            pages = 0
   559	            with anyio.fail_after(CONNECT_TIMEOUT_SECONDS):
   560	                while True:
   561	                    page = await session.list_tools(
   562	                        params=types.PaginatedRequestParams(cursor=cursor) if cursor else None)
   563	                    tools.extend(page.tools)
   564	                    pages += 1
   565	                    cursor = page.next_cursor
   566	                    if not cursor:
   567	                        return types.ListToolsResult(tools=tools)
   568	                    if cursor in seen_cursors:
   569	                        raise RuntimeError(
   570	                            f"cursor {cursor!r} repeated after {pages} pages — the upstream's "
   571	                            f"pagination cycles and can never finish")
   572	                    if pages >= LIST_MAX_PAGES:
   573	                        raise RuntimeError(
   574	                            f"tools/list still paginating after {LIST_MAX_PAGES} pages — "
   575	                            f"refusing to follow further")
   576	                    seen_cursors.add(cursor)
   577	        except Exception as e:
   578	            # REPORT UNAVAILABILITY; NEVER ADJUDICATE THE CONNECTION FROM HERE. This
   579	            # ran _mark_broken for one afternoon and took the deployed daemon down:
   580	            # clients poll tools/list constantly, each poll's drain timed out against
   581	            # the approval-gated mcpbridge (its first list blocks until the dialog is
   582	            # answered), and every timeout tore the connection down — WITHDRAWING the
   583	            # approval prompt before the clicker could answer it. That is the exact
   584	            # 2026-08-30 cancel-your-own-approval pathology, reintroduced through a
   585	            # new door and reproduced against a stall-tools stub under client load.
   586	            # The heartbeat in connection_manager — which owns the click-while-blocked
   587	            # helper — is the SOLE authority on connection state; a client-triggered
   588	            # drain that fails only means "nothing to serve from here right now".
   589	            log.info("[%s] list_tools unavailable this round (connection state untouched): %s",
   590	                     self.name, e or type(e).__name__)
   591	            return None
   592	
   593	    async def call_tool(self, tool_name: str, arguments: dict) -> types.CallToolResult | None:
   594	        """Returns None if not connected — caller decides how to report that,
   595	        since the aggregator needs a slightly different message than the
   596	        single-upstream case (naming which upstream is down)."""
   597	        async with self.lock:
   598	            if self.session is None or self.known_broken:
   599	                return None
   600	            log.info("[%s] call_tool %s", self.name, tool_name)
   601	            try:
   602	                with anyio.fail_after(CALL_TIMEOUT_SECONDS):
   603	                    result = await self.session.call_tool(tool_name, arguments)
   604	            except MCPError as e:
   605	                # AN APPLICATION-LEVEL JSON-RPC ERROR IS THE CALLER'S ERROR, NOT A DEAD
   606	                # TRANSPORT. The codex leg of the phase-1 panel caught this: the upstream
   607	                # answering -32602 for an unknown tool proves the connection is HEALTHY,
   608	                # and the old blanket except tore the session down and told the client
   609	                # "not connected right now, retry" — for a call that would fail
   610	                # identically on every retry.
   611	                log.info("[%s] call_tool %s: upstream returned an error (connection kept): %s",
   612	                         self.name, tool_name, e.message)
   613	                return types.CallToolResult(
   614	                    content=[types.TextContent(
   615	                        type="text",
   616	                        text=f"[{self.name}] upstream error for {tool_name!r}: {e.message}")],
   617	                    is_error=True,
   618	                )
   619	            except Exception as e:
   620	                # See list_tools' comment — same missing-timeout bug, same fix.
   621	                self.known_broken = True
   622	                self.session = None
   623	                log.warning("[%s] call_tool %s failed, marking connection broken: %s", self.name, tool_name, e)
   624	                return None
   625	            if not isinstance(result, types.CallToolResult):
   626	                # upstream returned something this dumb proxy doesn't forward
   627	                # (e.g. InputRequiredResult) — surface as an error, don't crash.
   628	                return types.CallToolResult(
   629	                    content=[
   630	                        types.TextContent(
   631	                            type="text",
   632	                            text=f"xcode-mcp-front: [{self.name}] unsupported upstream result type "
   633	                            f"{type(result).__name__}",
   634	                        )
   635	                    ],
   636	                    is_error=True,
   637	                )
   638	            return result
