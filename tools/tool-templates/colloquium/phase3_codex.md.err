   171	def _parse_blocks(name, raw, strict):
   172	    """Sieve entries: [{"tool": ..., "why": ...}] -> {tool: why}.
   173	
   174	    `why` is DATA and it is REQUIRED — a jsonc comment cannot be enforced or read back,
   175	    and a block without a stated cause is the entry that outlives its reason and narrows
   176	    the surface forever. Enforcement lives at AUTHORING time (strict=True, the validate
   177	    CLI): the daemon's own load (strict=False) warns and applies the block anyway,
   178	    because failing a repo at daemon startup over a sentence someone forgot in astra is
   179	    the wrong place to hurt (ROADMAP 2.2)."""
   180	    if not isinstance(raw, list) or not all(isinstance(b, dict) for b in raw):
   181	        raise ConfigError("server '%s': 'block' must be a list of objects" % name)
   182	    blocks = {}
   183	    for b in raw:
   184	        tool = b.get("tool")
   185	        if not isinstance(tool, str) or not tool:
   186	            raise ConfigError("block entry on server '%s' has no 'tool' name" % name)
   187	        for key in b:
   188	            if key not in ("tool", "why"):
   189	                raise ConfigError("unknown field '%s' in block entry for '%s' on server '%s'"
   190	                                  % (key, tool, name))
   191	        why = b.get("why")
   192	        if not isinstance(why, str) or not why.strip():
   193	            msg = ("block entry for '%s' on server '%s' has no 'why' — every withheld "
   194	                   "tool carries its stated reason, or the block outlives its cause"
   195	                   % (tool, name))
   196	            if strict:
   197	                raise ConfigError(msg)
   198	            print("mcp_config: WARNING: %s (applying the block anyway; fix the template)"
   199	                  % msg, file=sys.stderr)
   200	            why = "(no reason recorded — fix the template)"
   201	        if tool in blocks:
   202	            raise ConfigError("duplicate block entry for '%s' on server '%s'" % (tool, name))
