   768	                            # The approval prompt has been observed appearing
   769	                            # AFTER a successful initialize() — requested
   770	                            # lazily, apparently on the first real list_tools
   771	                            # call rather than at the handshake. So keep
   772	                            # checking even once connected, not just while
   773	                            # reconnecting — safe every tick regardless, since
   774	                            # it only ever acts on our own pid or a dead one.
   775	                            if AUTO_ALLOW:
   776	                                await _click_allow_if_present()
   777	            except Exception as e:
   778	                # Unwrap ExceptionGroups: "unhandled errors in a TaskGroup (1 sub-exception)"
   779	                # names nothing and cost a live debugging session on 2026-08-31.
   780	                causes = []
   781	                stack = [e]
