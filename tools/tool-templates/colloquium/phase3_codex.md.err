     1	#!/usr/bin/env python3
     2	"""
     3	template.py — install a NAMED GROUP of astra tools into a repo.
     4	
     5	The middle layer Jonathan described on 2026-08-18: "templates for installing
     6	groups of these tools that are fit for a particular kind of project, a middle
     7	level where we can say the mhm project(s) has the swift and iOS stuff installed
     8	via a template for that along with the writing tools. Whereas the legal repos
     9	have the pdf to text stuff and the writing stuff."
    10	
    11	    template.py list
    12	    template.py show <name>
    13	    template.py install   <name> --into <repo>
    14	    template.py uninstall <name> --into <repo>
    15	    template.py status --into <repo>
    16	
    17	TWO PROPERTIES THAT ARE NOT NEGOTIABLE
    18	--------------------------------------
    19	NON-EXCLUSIVE. Installing a template ADDS its tools. It never removes anything
    20	another template put there, and two templates may overlap freely — the legal and
    21	Maharam sets both want the writing tools, and installing one after the other must
    22	leave both intact. Uninstall removes only what that template names, so a shared
    23	tool survives until the last template needing it is gone. Anything else would
    24	make the second install silently break the first.
    25	
    26	NEVER GLOBAL. Templates delegate to each tool's own install.sh --into <repo>,
    27	and those already refuse a target under $HOME, ~/.claude, ~/.agents, ~/.config or
    28	~/Library. The global installs that had accumulated were removed on 2026-08-18
    29	and nothing here may recreate one.
    30	
    31	Templates are DATA (templates.json), not code, so adding one is an edit rather
    32	than a patch. Every tool a template names must have its own install.sh and
    33	uninstall.sh — that is what made splitting the MCP bundle into seven small tools
    34	the prerequisite for this layer.
    35	"""
    36	import json
    37	import os
    38	import subprocess
    39	import sys
    40	from pathlib import Path
    41	
    42	ASTRA = Path(__file__).resolve().parent.parent.parent
    43	TOOLS = ASTRA / "tools"
    44	# ASTRA_TEMPLATES_JSON exists for the tests: they need a template whose member is
    45	# guaranteed to fail without editing the real catalogue. Tools still resolve from the
    46	# real tools/ tree either way.
    47	TEMPLATES = Path(os.environ.get("ASTRA_TEMPLATES_JSON") or (TOOLS / "lib" / "templates.json"))
    48	
    49	
    50	def load():
    51	    try:
    52	        return json.loads(TEMPLATES.read_text())
    53	    except FileNotFoundError:
    54	        return {"templates": {}}
    55	
    56	
    57	def tool_dir(name):
    58	    d = TOOLS / name
    59	    return d if d.is_dir() else None
    60	
    61	
    62	def run_tool(name, verb, repo):
    63	    """Delegate to the tool's own installer. Missing tools are LOUD.
    64	
    65	    A template that silently skips a tool it names would report success while
    66	    installing less than it claimed — the same shape as a test that passes
    67	    against a broken implementation."""
    68	    d = tool_dir(name)
    69	    if d is None:
    70	        return False, f"no such tool: tools/{name}"
    71	    script = d / f"{verb}.sh"
    72	    if not script.exists():
    73	        return False, f"tools/{name} has no {verb}.sh (every template member needs one)"
    74	    try:
    75	        r = subprocess.run([str(script), "--into", str(repo)],
    76	                           capture_output=True, text=True, timeout=300)
    77	        if r.returncode != 0:
    78	            tail = (r.stderr or r.stdout or "").strip().splitlines()
    79	            return False, (tail[-1] if tail else f"exit {r.returncode}")
    80	        return True, ""
    81	    except Exception as e:
    82	        return False, f"{e}"
    83	
    84	
    85	def state_path(repo):
    86	    """Template state lives in the SAME file as tool state.
    87	
    88	    It used to sit in its own .astra-templates.json at the repo root, which made
    89	    two files that had to agree about one repo and gave no reason they would.
    90	    Everything a repo knows about its astra install now lives in
    91	    .astra/manifest.json.
    92	    """
    93	    return Path(repo) / ".astra" / "manifest.json"
    94	
    95	
    96	def _read_state(repo):
    97	    p = state_path(repo)
    98	    try:
    99	        return json.loads(p.read_text())
   100	    except FileNotFoundError:
   101	        # Genuinely nothing installed. A legitimate empty answer.
   102	        legacy = Path(repo) / ".astra-templates.json"
   103	        if legacy.exists():
   104	            try:
   105	                old = json.loads(legacy.read_text()).get("installed", [])
   106	                return {"templates": sorted(old)}
   107	            except Exception:
   108	                pass
   109	        return {}
   110	    except Exception as e:
   111	        # NOT the same as "nothing installed", and the difference is the whole
   112	        # non-exclusive property. installed_templates() used to swallow every
   113	        # error into an empty list, so a corrupt or hand-edited state file made
   114	        # uninstall believe no other template claimed anything — and it would
   115	        # then remove tools a second, still-installed template needed. Refuse.
   116	        print(f"{p} is unreadable ({e}). Refusing to act on template state we "
   117	              f"cannot read, because reading it as empty would let uninstall "
   118	              f"remove tools another template still needs.", file=sys.stderr)
   119	        sys.exit(65)
   120	
   121	
   122	def installed_templates(repo):
   123	    return _read_state(repo).get("templates", [])
   124	
   125	
   126	def record_template(repo, name, add=True):
   127	    data = _read_state(repo)
   128	    cur = list(data.get("templates", []))
   129	    if add and name not in cur:
   130	        cur.append(name)
   131	    if not add and name in cur:
   132	        cur.remove(name)
   133	    data["templates"] = sorted(cur)
   134	    p = state_path(repo)
   135	    p.parent.mkdir(parents=True, exist_ok=True)
   136	    # Write beside and rename: a half-written manifest is exactly the corrupt
   137	    # state the refusal above exists to catch, and there is no reason to
   138	    # manufacture it ourselves.
   139	    tmp = p.with_suffix(".json.tmp")
   140	    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
   141	    os.replace(tmp, p)
   142	    # Retire the old sidecar file once its contents are safely carried over.
   143	    legacy = Path(repo) / ".astra-templates.json"
   144	    if legacy.exists():
   145	        legacy.unlink()
   146	
   147	
   148	def tools_still_claimed(repo, excluding):
   149	    """Tools that templates OTHER than `excluding` still need in this repo.
   150	
   151	    This is the whole non-exclusive property. Without it, uninstalling
   152	    kicker-dev removed mcp-xcode and mcp-mac-control-mcp — both still required
   153	    by swift-ios, which was installed and working. Caught by the overlap test on
   154	    2026-08-18, which is exactly what that test exists for."""
   155	    t = load()["templates"]
   156	    claimed = set()
   157	    for name in installed_templates(repo):
   158	        if name == excluding:
   159	            continue
   160	        claimed.update(t.get(name, {}).get("tools", []))
   161	    return claimed
   162	
   163	
   164	def cmd_list(_):
   165	    t = load()["templates"]
   166	    if not t:
   167	        print("no templates defined")
   168	        return 0
   169	    for name, meta in sorted(t.items()):
   170	        print(f"── {name}")
   171	        print(f"     {meta.get('description','')}")
   172	        print(f"     tools: {', '.join(meta.get('tools', []))}")
   173	    return 0
   174	
   175	
   176	def cmd_show(args):
   177	    name = args[0] if args else ""
   178	    meta = load()["templates"].get(name)
   179	    if not meta:
   180	        print(f"no such template: {name}")
   181	        return 66
   182	    print(json.dumps(meta, indent=2))
   183	    return 0
   184	
   185	
   186	def _target(args):
   187	    if "--into" not in args:
   188	        print("usage: template.py <cmd> <name> --into <repo>", file=sys.stderr)
   189	        sys.exit(64)
   190	    repo = Path(args[args.index("--into") + 1]).expanduser()
   191	    if not repo.is_dir():
   192	        print(f"no such directory: {repo}", file=sys.stderr)
   193	        sys.exit(66)
   194	    return repo
   195	
   196	
   197	def _apply(verb, args):
   198	    name = args[0] if args and not args[0].startswith("-") else ""
   199	    meta = load()["templates"].get(name)
   200	    if not meta:
   201	        print(f"no such template: {name}", file=sys.stderr)
   202	        return 66
   203	    repo = _target(args)
   204	
   205	    # UNINSTALL ONLY WHAT THE RECORD SAYS IS INSTALLED.
   206	    #
   207	    # tools_still_claimed() answers "what do the OTHER installed templates
   208	    # need" by reading the record. If the record has been deleted, truncated or
   209	    # hand-edited, that question comes back empty and uninstall happily removes
   210	    # tools a second, still-installed template depends on. The corrupt case is
   211	    # refused when the file is read; this catches the deleted one, and it does
   212	    # so without guessing at what is installed by inspecting the filesystem —
   213	    # which cannot work anyway, since MCP templates write .mcp.json rather than
   214	    # a directory of their own.
   215	    #
   216	    # Being asked to remove something no record mentions is suspicious on its
   217	    # own terms. Say so rather than acting on an empty list.
   218	    if verb == "uninstall" and name not in installed_templates(repo):
   219	        print(f"'{name}' is not recorded as installed in {repo}.", file=sys.stderr)
   220	        print(f"  Refusing, because deciding what to remove means asking which "
   221	              f"OTHER templates still need each tool, and that question cannot "
   222	              f"be answered from a record that does not list this one.",
   223	              file=sys.stderr)
   224	        print(f"  Recorded: {', '.join(installed_templates(repo)) or '(none)'}",
   225	              file=sys.stderr)
   226	        return 65
   227	
   228	    ok_n = fail_n = kept_n = 0
   229	    print(f"{verb}ing template '{name}' -> {repo}")
   230	    keep = tools_still_claimed(repo, name) if verb == "uninstall" else set()
   231	    for t in meta.get("tools", []):
   232	        if t in keep:
   233	            others = [n for n in installed_templates(repo) if n != name
   234	                      and t in load()["templates"].get(n, {}).get("tools", [])]
   235	            print(f"  KEPT    {t} — still required by: {', '.join(others)}")
   236	            kept_n += 1
   237	            continue
   238	        ok, why = run_tool(t, verb, repo)
   239	        if ok:
   240	            print(f"  {verb}ed  {t}")
   241	            ok_n += 1
   242	        else:
   243	            print(f"  FAILED  {t}: {why}")
   244	            fail_n += 1
   245	    # ONLY A CLEAN RUN CHANGES THE RECORD. Recording an install whose members failed
   246	    # would claim tools this template never placed; unrecording an uninstall whose
   247	    # members failed would orphan the tools that remain. Installers are idempotent
   248	    # re-runs, so the remedy for a partial failure is: fix the cause, run the same verb
   249	    # again, and the record changes when the run is clean. (Found by the round-one
   250	    # colloquium, codex leg — record_template ran unconditionally here.)
   251	    if fail_n == 0:
   252	        record_template(repo, name, add=(verb == "install"))
   253	    else:
   254	        print(f"NOT recording this {verb}: {fail_n} member(s) failed, and the record "
   255	              f"must describe what actually happened. Fix the failure and re-run "
   256	              f"(installers are idempotent).", file=sys.stderr)
   257	    extra = f", {kept_n} kept (shared with another template)" if kept_n else ""
   258	    print(f"\n{ok_n} ok, {fail_n} failed{extra}")
   259	    return 1 if fail_n else 0
   260	
   261	
   262	def cmd_install(args):
   263	    return _apply("install", args)
   264	
   265	
   266	def cmd_uninstall(args):
   267	    return _apply("uninstall", args)
   268	
   269	
   270	def cmd_status(args):
   271	    """Which templates are fully present in a repo?"""
   272	    repo = _target(args)
   273	    mcp = {}
   274	    f = repo / ".mcp.json"
   275	    if f.exists():
   276	        try:
   277	            mcp = json.loads(f.read_text()).get("mcpServers", {})
   278	        except Exception:
   279	            pass
   280	    print(f"repo: {repo}")
   281	    print(f"  MCP servers present: {', '.join(sorted(mcp)) or 'none'}")
   282	    for name, meta in sorted(load()["templates"].items()):
   283	        want = [t for t in meta.get("tools", []) if t.startswith("mcp-")]
   284	        have = [t for t in want if t.replace("mcp-", "", 1) in mcp]
   285	        if want:
   286	            state = "complete" if len(have) == len(want) else (
   287	                "partial" if have else "absent")
   288	            print(f"  {name:<14} {state:<9} ({len(have)}/{len(want)} mcp tools)")
   289	    return 0
   290	
   291	
   292	def main():
   293	    cmds = {"list": cmd_list, "show": cmd_show, "install": cmd_install,
   294	            "uninstall": cmd_uninstall, "status": cmd_status}
   295	    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
   296	        print(f"usage: template.py {{{'|'.join(cmds)}}} [name] [--into <repo>]")
   297	        return 64
   298	    return cmds[sys.argv[1]](sys.argv[2:])
   299	
   300	
   301	if __name__ == "__main__":
   302	    sys.exit(main())
     1	{
     2	  "_comment": "Named groups of astra tools fit for a KIND of project. Non-exclusive: installing one adds its tools and never removes another's, and two templates may overlap freely \u2014 swift-ios and legal-pdf both pull the writing tools, and installing one after the other must leave both intact.",
     3	  "templates": {
     4	    "swift-ios": {
     5	      "description": "Swift/iOS app work \u2014 the Maharam repos. Xcode both ways (Apple's bridge needs a one-time approval; XcodeBuildMCP is headless), plus simulator and device control.",
     6	      "tools": [
     7	        "mcp-xcode",
     8	        "mcp-XcodeBuildMCP",
     9	        "mcp-ios-simulator",
    10	        "mcp-mobile-mcp",
    11	        "mcp-mac-control-mcp"
    12	      ]
    13	    },
    14	    "legal-pdf": {
    15	      "description": "Legal repos \u2014 speedway, hoa, grandparentLegal. PDF to searchable text sidecars, OCR for scans, metadata provenance, plus the prose checker. NOTE: grandparentLegal wants `git config jsutils.metadataPolicy all` for every-PDF provenance; the default 'pattern' only does meeting-named files.",
    16	      "tools": [
    17	        "pdf-sidecars",
    18	        "check-prose"
    19	      ]
    20	    },
    21	    "kicker-dev": {
    22	      "description": "Working on kicker itself \u2014 its own daemon surface plus the mac and Xcode tooling.",
    23	      "tools": [
    24	        "mcp-kickerd",
    25	        "mcp-mac-control-mcp",
    26	        "mcp-xcode"
    27	      ]
    28	    },
    29	    "writing": {
    30	      "description": "Prose discipline \u2014 the ASD-STE100 standard plus the mechanical checker. Wanted by anything a human reads: the legal repos, the HOA site, client email drafts.",
    31	      "tools": [
    32	        "check-prose"
    33	      ]
    34	    }
    35	  }
    36	}
     1	#!/usr/bin/env bash
     2	# astra-install.sh — the one place that decides WHERE an astra tool lands in a
     3	# repo and what it records about itself. Every tool's install.sh sources this.
     4	#
     5	# WHY THIS EXISTS (Jonathan, 2026-08-18)
     6	# --------------------------------------
     7	# The first design copied tools into whatever directory each repo happened to
     8	# use — 13_Scripts, scripts, tools, pdf, one repo's root — and then kept a
     9	# central list in astra of where everything went. That list was built by
    10	# matching FILENAMES across the workspace, which meant any repo's own
    11	# rules.json or lib.sh was adopted as an astra install and overwritten by a
    12	# post-commit hook. Ownership was inferred, and inference is a guess.
    13	#
    14	# Two corrections, both his:
    15	#
    16	#   "Why wouldn't you be writing someplace you know isn't going to be touched?
    17	#    like .astra or whatever?"
    18	#
    19	# Everything lands in <repo>/.astra/<tool>/. Ownership stops being a guess and
    20	# becomes a fact: if it is in there, it is ours, and nothing else is. The
    21	# collision bug cannot occur rather than being guarded against.
    22	#
    23	#   "probably worth each .astra able to find where it was installed FROM and
    24	#    check for updates?"
    25	#
    26	# So the direction of the relationship flips. Astra no longer pushes into
    27	# repos it keeps a list of; each repo records where it was installed from and
    28	# pulls. That removes the blast radius entirely — nothing reaches into another
    29	# repo uninvited — and it survives the repo being cloned or moved, which a
    30	# central list of absolute paths does not.
    31	#
    32	# Usage from a tool's install.sh:
    33	#     . "$(dirname "$0")/../lib/astra-install.sh"
    34	#     astra_target "$@"                 # parses --into, validates, sets $TARGET
    35	#     astra_place check-prose check-prose.js rules.json
    36	#
    37	set -euo pipefail
    38	
    39	ASTRA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
    40	
    41	# Parse --into and refuse anywhere that is not a project checkout. Global
    42	# installs were removed on 2026-08-18 and nothing here may recreate one.
    43	astra_target() {
    44	  TARGET=""
    45	  while [ $# -gt 0 ]; do
    46	    case "$1" in
    47	      --into) TARGET="${2:-}"; shift 2 ;;
    48	      *) shift ;;
    49	    esac
    50	  done
    51	  [ -n "$TARGET" ] || { echo "usage: --into <repo>" >&2; exit 64; }
    52	  [ -d "$TARGET" ] || { echo "no such directory: $TARGET" >&2; exit 66; }
    53	  # -P resolves symlinks: js-hoa and js-speedway are symlinks into Dropbox.
    54	  TARGET="$(cd "$TARGET" && pwd -P)"
    55	  case "$TARGET" in
    56	    "$HOME"|"$HOME/.claude"*|"$HOME/.agents"*|"$HOME/.config"*|"$HOME/Library"*)
    57	      echo "REFUSING: $TARGET is a home/global location." >&2
    58	      echo "  Astra tools install per-repo only." >&2
    59	      exit 78 ;;
    60	  esac
    61	  export TARGET
    62	}
    63	
    64	# Copy a tool's files into <repo>/.astra/<tool>/ and record its origin.
    65	astra_place() {
    66	  local tool="$1"; shift
    67	  local src="$ASTRA_ROOT/tools/$tool"
    68	  local dest="$TARGET/.astra/$tool"
    69	  mkdir -p "$dest"
    70	
    71	  local f
    72	  for f in "$@"; do
    73	    [ -f "$src/$f" ] || { echo "missing source file: $src/$f" >&2; exit 65; }
    74	    # Write beside and rename. A plain cp truncates the destination before it
    75	    # copies, so an interrupted install leaves a zero-length tool where a
    76	    # working one used to be.
    77	    cp "$src/$f" "$dest/$f.astra-tmp"
    78	    mv -f "$dest/$f.astra-tmp" "$dest/$f"
    79	  done
    80	
    81	  astra_record "$tool" "$@"
    82	  astra_vendor_updater
    83	  echo "installed $tool -> $dest"
    84	}
    85	
    86	# The manifest is what makes a repo self-sufficient: it knows what it has,
    87	# where it came from, and what it looked like when it arrived. Local
    88	# divergence is therefore detectable without asking astra anything.
    89	astra_record() {
    90	  local tool="$1"; shift
    91	  local manifest="$TARGET/.astra/manifest.json"
    92	  local dest="$TARGET/.astra/$tool"
    93	  ASTRA_TOOL="$tool" ASTRA_SRC="$ASTRA_ROOT" ASTRA_DEST="$dest" \
    94	  ASTRA_MANIFEST="$manifest" ASTRA_FILES="$*" python3 - <<'PY'
    95	import hashlib, json, os, pathlib
    96	
    97	manifest = pathlib.Path(os.environ["ASTRA_MANIFEST"])
    98	tool = os.environ["ASTRA_TOOL"]
    99	dest = pathlib.Path(os.environ["ASTRA_DEST"])
   100	files = os.environ["ASTRA_FILES"].split()
   101	
   102	def sha(p):
   103	    return hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest()[:16]
   104	
   105	try:
   106	    data = json.loads(manifest.read_text())
   107	except Exception:
   108	    data = {}
   109	data.setdefault("tools", {})
   110	# The SOURCE is recorded per-install rather than once for the file, because a
   111	# repo may legitimately be fed by more than one astra checkout over its life.
   112	data["tools"][tool] = {
   113	    "source": os.environ["ASTRA_SRC"],
   114	    "files": {f: sha(dest / f) for f in files},
   115	}
   116	manifest.parent.mkdir(parents=True, exist_ok=True)
   117	tmp = manifest.with_suffix(".json.tmp")
   118	tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
   119	os.replace(tmp, manifest)
   120	PY
   121	}
   122	
   123	# Drop the puller into the repo so it can check itself without astra reaching in.
   124	astra_vendor_updater() {
   125	  local u="$TARGET/.astra/astra-update"
   126	  cp "$ASTRA_ROOT/tools/lib/astra-update" "$u.astra-tmp"
   127	  mv -f "$u.astra-tmp" "$u"
   128	  chmod +x "$u"
   129	}
   130	
   131	# Remove a tool and forget it. Leaves .astra/ itself alone if other tools remain.
   132	astra_remove() {
   133	  local tool="$1"
   134	  rm -rf "$TARGET/.astra/$tool"
   135	  ASTRA_TOOL="$tool" ASTRA_MANIFEST="$TARGET/.astra/manifest.json" python3 - <<'PY'
   136	import json, os, pathlib
   137	m = pathlib.Path(os.environ["ASTRA_MANIFEST"])
   138	try:
   139	    data = json.loads(m.read_text())
   140	except Exception:
   141	    raise SystemExit(0)
   142	data.get("tools", {}).pop(os.environ["ASTRA_TOOL"], None)
   143	tmp = m.with_suffix(".json.tmp")
   144	tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
   145	os.replace(tmp, m)
   146	PY
   147	  echo "removed $tool from $TARGET/.astra"
   148	}
     1	#!/usr/bin/env bash
     2	# Templates must be NON-EXCLUSIVE. Two templates sharing a tool must coexist, and
     3	# uninstalling one must not remove a tool the other still needs.
     4	#
     5	# This test caught the property failing on the day it was written: uninstalling
     6	# kicker-dev removed mcp-xcode and mcp-mac-control-mcp while swift-ios was
     7	# installed and using both. Keep it red-capable — it is the only thing standing
     8	# between "templates" and "the second install silently breaks the first".
     9	set -u
    10	A="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
    11	command -v jq >/dev/null || { echo "MISSING DEPENDENCY: jq"; exit 1; }
    12	T="$(mktemp -d)/repo"; git clone --quiet ~/svnCheckouts/js-llmKicker "$T" 2>/dev/null || { echo "clone failed"; exit 1; }
    13	fail=()
    14	
    15	python3 "$A/tools/lib/template.py" install swift-ios --into "$T" >/dev/null 2>&1
    16	python3 "$A/tools/lib/template.py" install kicker-dev --into "$T" >/dev/null 2>&1
    17	out="$(python3 "$A/tools/lib/template.py" uninstall kicker-dev --into "$T" 2>&1)"
    18	rc=$?
    19	after="$(jq -r '.mcpServers|keys|join(",")' "$T/.mcp.json" 2>/dev/null)"
    20	
    21	for need in xcode mac-control-mcp XcodeBuildMCP ios-simulator mobile-mcp; do
    22	  echo "$after" | grep -q "$need" || fail+=("swift-ios lost $need after uninstalling an overlapping template")
    23	done
    24	echo "$after" | grep -q kickerd && fail+=("kickerd survived its own template's uninstall")
    25	echo "$out" | grep -q "KEPT" || fail+=("shared tools were not reported as KEPT")
    26	[ $rc -eq 0 ] || fail+=("uninstall exited $rc on a successful run")
    27	
    28	
    29	# ── State-file integrity ────────────────────────────────────────────────────
    30	# The overlap property above is only as good as the record it reasons from.
    31	# installed_templates() used to swallow every read error into an empty list, so
    32	# a corrupt or hand-edited state file made uninstall believe nothing else
    33	# claimed a shared tool — and it would remove tools a still-installed template
    34	# needed. Reading "I cannot tell" as "nothing installed" is the bug.
    35	
    36	echo '{"templates": ["swift-ios"], "tools":' > "$T/.astra/manifest.json"   # truncated mid-write
    37	out="$(python3 "$A/tools/lib/template.py" uninstall kicker-dev --into "$T" 2>&1)"; rc=$?
    38	if [ "$rc" -eq 65 ] && echo "$out" | grep -q "unreadable"; then
    39	  echo "  corrupt state refused instead of read as empty"
    40	else
    41	  fail+=("a corrupt manifest did not stop uninstall (rc=$rc) — it would remove tools another template still needs")
    42	fi
    43	
    44	# A deleted record with the tools still present is the same class: the repo is
    45	# not empty, so an empty list is not the answer.
    46	rm -f "$T/.astra/manifest.json"
    47	out="$(python3 "$A/tools/lib/template.py" uninstall kicker-dev --into "$T" 2>&1)"; rc=$?
    48	if [ "$rc" -eq 65 ] && echo "$out" | grep -q "not recorded as installed"; then
    49	  echo "  deleted state refused rather than acted on as an empty list"
    50	else
    51	  fail+=("a deleted manifest let uninstall run from an empty list (rc=$rc)")
    52	fi
    53	
    54	# ── A failed install is not recorded as an install ──────────────────────────
    55	# _apply() used to call record_template unconditionally after the member loop, so a
    56	# template with failed member installs was recorded as installed and claimed tools it
    57	# never placed (found by the round-one colloquium, codex leg, verified at the call
    58	# site). Installers are idempotent re-runs, so the honest record after a partial
    59	# failure is "not installed": fix the cause, re-run, and only then record.
    60	T2="$(mktemp -d)/repo"; git clone --quiet ~/svnCheckouts/js-llmKicker "$T2" 2>/dev/null || { echo "clone failed"; exit 1; }
    61	BROKEN_TPL="$(mktemp -d)/templates.json"
    62	cat > "$BROKEN_TPL" <<'EOF'
    63	{"templates": {"half-broken": {"description": "test template with a member that cannot install",
    64	  "tools": ["check-prose", "no-such-tool-astra-test"]}}}
    65	EOF
    66	out="$(ASTRA_TEMPLATES_JSON="$BROKEN_TPL" python3 "$A/tools/lib/template.py" install half-broken --into "$T2" 2>&1)"; rc=$?
    67	recorded="$(python3 -c "import json,sys; print(','.join(json.load(open('$T2/.astra/manifest.json')).get('templates',[])))" 2>/dev/null)"
    68	[ "$rc" -ne 0 ] || fail+=("an install with a failed member exited 0")
    69	echo "$out" | grep -q "FAILED  no-such-tool-astra-test" || fail+=("the failed member was not named in the output")
    70	case ",$recorded," in
    71	  *,half-broken,*) fail+=("a template with a FAILED member was recorded as installed (manifest: '$recorded')") ;;
    72	  *) echo "  failed install left no false record (manifest: '${recorded:-empty}')" ;;
    73	esac
    74	echo "$out" | grep -qi "not record" || fail+=("the output does not say the record was withheld")
    75	rm -rf "$(dirname "$T2")" "$(dirname "$BROKEN_TPL")"
    76	
    77	rm -rf "$(dirname "$T")"
    78	if [ ${#fail[@]} -eq 0 ]; then echo "templates: non-exclusive overlap holds"; exit 0; fi
    79	printf 'FAIL: %s\n' "${fail[@]}"; exit 1

codex
Two concrete defects are emerging from the call-path trace: an empty-prefix file configuration is treated as unrestricted passthrough, and the refresh helper does not perform the composition loop’s collision or stale-entry handling. I am checking both against executable probes and the test harness before assigning severity.
