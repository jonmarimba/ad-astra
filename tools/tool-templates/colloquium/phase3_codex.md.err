   230	async def _run_osascript(script: str) -> bytes:
   231	    """Raises on a nonzero exit instead of returning empty bytes. Found by
   232	    convocation review, 2026-08-14: with stderr sent to DEVNULL and no
   233	    returncode check, a TCC grant getting revoked or dying (the documented
   234	    failure mode after any edit to the ad-hoc-signed wrapper .app — new hash,
   235	    dead grant) made osascript exit nonzero with an error, which this
   236	    previously returned as plain b"" — indistinguishable from "no dialog
   237	    showing". The click loop would then silently stop working with nothing in
   238	    the log naming the actual cause. Now surfaces it: caller's except-block
   239	    already logs at warning level, so a dead grant shows up as a real,
   240	    diagnosable log line instead of a silent no-op.
   241	
   242	    Also found LIVE the same day, the hard way: a real System Events hang
   243	    (osascript stuck talking to it, unrelated to the return-code fix above —
   244	    System Events itself was wedged) piled up one leaked orphan osascript
   245	    process EVERY poll tick, forever, because `asyncio.wait_for` timing out
   246	    only abandons Python's own wait — it does NOT kill the underlying
   247	    subprocess. Confirmed live: 30+ orphaned osascript processes accumulated
   248	    in under 10 minutes before this was caught, and System Events itself
   249	    became unresponsive to even a basic query as a result. Now explicitly
   250	    kills the process on timeout instead of leaving it to run forever."""
   251	    proc = await asyncio.create_subprocess_exec(
   252	        "osascript",
   253	        "-e",
   254	        script,
   255	        stdout=asyncio.subprocess.PIPE,
   256	        stderr=asyncio.subprocess.PIPE,
   257	    )
   258	    try:
   259	        out, err = await asyncio.wait_for(proc.communicate(), timeout=5)
   260	    except asyncio.TimeoutError:
   261	        proc.kill()
   262	        await proc.wait()  # reap it — don't leave a zombie behind either
   263	        raise RuntimeError("osascript timed out after 5s (System Events may be unresponsive)")
   264	    if proc.returncode != 0:
   265	        raise RuntimeError(f"osascript exited {proc.returncode}: {err.decode(errors='replace').strip()}")
   266	    return out
