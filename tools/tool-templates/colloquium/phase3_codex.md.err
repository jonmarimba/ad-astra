     1	#!/usr/bin/env bash
     2	# test-mcp-front-daemon.sh — the aggregator daemon itself, by effect over its real HTTP
     3	# endpoint, with STUB upstreams (stub_mcp_server.py) instead of live Xcode.
     4	#
     5	# This is the fast-tier counterpart of the slow test-xcode-mcp-front.sh: same daemon.py,
     6	# same transport, but the upstreams are dependency-free stubs, so it asserts the
     7	# aggregation contract (config file honoured, prefixes served, calls routed, unknown
     8	# names rejected) without launching Xcode or waiting on an approval dialog. Increment 1.2:
     9	# the _mcp_info.json file replaces the corrupting colon/comma env format.
    10	#
    11	# XCODE_MCP_FRONT_AUTO_ALLOW=0 always: the clicker path runs osascript against System
    12	# Events, and a test must never send Apple Events from an unstable shell identity
    13	# (test-xcode-mcp-front.sh documents the tmux-grant disease).
    14	set -uo pipefail
    15	HERE="$(cd "$(dirname "$0")" && pwd)"
    16	# shellcheck disable=SC1091
    17	. "$HERE/lib.sh"
    18	
    19	need uv "brew install uv"
    20	need curl "system-present"
    21	need python3 "xcode-select --install"
    22	
    23	DAEMON="$HERE/../xcode-mcp-front/daemon.py"
    24	STUB="$HERE/stub_mcp_server.py"
    25	PORT=8899
    26	
    27	cat > "$SB/_mcp_info.json" <<EOF
    28	{
    29	  "mcpServers": {
    30	    "alpha": {"command": "python3", "args": ["$STUB", "--name", "alpha", "--tool", "ping=alpha-pong", "--tool", "build=alpha-built", "--tool", "secret=env:ASTRA_STUB_SECRET", "--tool", "bad=error:kaboom-from-alpha", "--tool", "read=file-contents", "--tool", "helper=h", "--describe", "helper=already read the docs, then read again"],
    31	      "env": {"ASTRA_STUB_SECRET": "sekrit-env-value"},
    32	      "map": [{"tool": "read", "name": "fetch_file", "why": "surface vocabulary: bare 'read' is ambiguous beside beta's file tools"}]},
    33	    "beta":  {"command": "python3", "args": ["$STUB", "--name", "beta", "--tool", "ping=beta-pong", "--tool", "nudge=beta-nudged"],
    34	      "map": [
    35	        {"tool": "nudge", "name": "poke_beta", "why": "aggregate coherence: 'nudge' reads wrong beside alpha's verbs", "description": "Poke beta and await its pong."},
    36	        {"tool": "gone-tool", "name": "never_served", "why": "stale entry — the upstream never offered this; the degrade test wants it"}
    37	      ]},
    38	    "pager": {"command": "python3", "args": ["$STUB", "--name", "pager", "--page-size", "1", "--tool", "first=page-one", "--tool", "second=page-two"]},
    39	    "muzzled": {"command": "python3", "args": ["$STUB", "--name", "muzzled", "--tool", "a=muzzled-a", "--tool", "b=muzzled-b"],
    40	      "block": [
    41	        {"tool": "a", "why": "coherence: alpha owns this job on this surface"},
    42	        {"tool": "b", "why": "limiting: withheld on purpose"},
    43	        {"tool": "ghost-tool", "why": "stale entry — the upstream never offered this; the warning test wants it"}
    44	      ]}
    45	  }
    46	}
    47	EOF
    48	
    49	env -u XCODE_MCP_FRONT_UPSTREAMS \
    50	  XCODE_MCP_FRONT_MCP_INFO="$SB/_mcp_info.json" \
    51	  XCODE_MCP_FRONT_PORT="$PORT" \
    52	  XCODE_MCP_FRONT_HOME="$SB/home" \
    53	  XCODE_MCP_FRONT_AUTO_ALLOW=0 \
    54	  XCODE_MCP_FRONT_SERVER_NAME="astra-test-front" \
    55	  uv run --script "$DAEMON" >"$SB/daemon.log" 2>&1 &
    56	DPID=$!
    57	trap 'kill "$DPID" 2>/dev/null; wait "$DPID" 2>/dev/null; rm -rf "$SB"' EXIT
    58	
    59	mcp_call() { # usage: mcp_call <method> <params-json> -> raw SSE body on stdout
    60	  local method="$1" params="$2" init_resp session
    61	  init_resp="$(curl -s --max-time 10 -D - -X POST "http://127.0.0.1:$PORT/mcp" \
    62	    -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
    63	    -H "MCP-Protocol-Version: 2025-06-18" \
    64	    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"test","version":"0"}}}')"
    65	  session="$(printf '%s' "$init_resp" | grep -i "mcp-session-id" | tr -d '\r' | awk '{print $2}')"
    66	  [ -n "$session" ] || { echo "NO_SESSION"; return 1; }
    67	  curl -s --max-time 10 -X POST "http://127.0.0.1:$PORT/mcp" \
    68	    -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
    69	    -H "MCP-Protocol-Version: 2025-06-18" -H "Mcp-Session-Id: $session" \
    70	    -d "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"$method\",\"params\":$params}"
    71	}
    72	
    73	# Wait for the daemon to be up AND for both stub upstreams to be connected (the connection
    74	# managers connect asynchronously after uvicorn starts answering).
    75	waited=0
    76	until [ "$waited" -ge 30 ]; do
    77	  if ! kill -0 "$DPID" 2>/dev/null; then
    78	    fail "daemon exited during startup — its log:"; sed 's/^/        /' "$SB/daemon.log" >&2
    79	    finish; exit 1
    80	  fi
    81	  list="$(mcp_call tools/list '{}' 2>/dev/null || true)"
    82	  case "$list" in *alpha__*) break ;; esac
    83	  sleep 1; waited=$((waited+1))
    84	done
    85	
    86	printf '%s' "$list" > "$SB/list.out"
    87	assert_contains "$SB/list.out" "alpha__ping" "tools/list serves alpha's tools under the alpha__ prefix"
    88	assert_contains "$SB/list.out" "alpha__build" "tools/list serves alpha's second tool"
    89	assert_contains "$SB/list.out" "beta__ping" "tools/list serves beta's tools under the beta__ prefix"
    90	
    91	# Same tool name on both upstreams routes by prefix, not by luck.
    92	mcp_call tools/call '{"name":"alpha__ping","arguments":{}}' > "$SB/alpha.out"
    93	assert_contains "$SB/alpha.out" "alpha-pong" "alpha__ping routes to the alpha stub"
    94	mcp_call tools/call '{"name":"beta__ping","arguments":{}}' > "$SB/beta.out"
    95	assert_contains "$SB/beta.out" "beta-pong" "beta__ping routes to the beta stub, same bare name"
    96	
    97	# --- Phase 3, the map: renames replace, descriptions follow, stale entries degrade ---
    98	# The exposed name is FINAL and the original is gone: a rename is a decision about the
    99	# surface's vocabulary, not an alias (SPEC; codex leg — keeping the old name callable
   100	# would defeat the map exactly as the prefix fallback would have defeated the sieve).
   101	assert_contains "$SB/list.out" "fetch_file" "a mapped tool is listed under its exposed name"
   102	assert_not_contains "$SB/list.out" "alpha__read" "and its prefixed original is gone from the listing"
   103	mcp_call tools/call '{"name":"fetch_file","arguments":{}}' > "$SB/mapped.out"
   104	assert_contains "$SB/mapped.out" "file-contents" "the exposed name routes to the upstream's real tool"
   105	mcp_call tools/call '{"name":"alpha__read","arguments":{}}' > "$SB/oldname.out"
   106	assert_contains "$SB/oldname.out" "does not currently offer" \
   107	  "the replaced original name is refused, not quietly honoured"
   108	
   109	# The rename table drives a MECHANICAL description pass across the same upstream's other
   110	# tools — whole words only. The roadmap's own red case: a tool named 'read' renames, and
   111	# the word 'already' must survive untouched.
   112	assert_contains "$SB/list.out" "already fetch_file the docs, then fetch_file again" \
   113	  "sibling descriptions now speak the exposed name, with 'already' intact"
   114	
   115	# An explicit description override wins outright.
   116	assert_contains "$SB/list.out" "Poke beta and await its pong." \
   117	  "a map entry's description override replaces the upstream's text"
   118	mcp_call tools/call '{"name":"poke_beta","arguments":{}}' > "$SB/poke.out"
   119	assert_contains "$SB/poke.out" "beta-nudged" "the overridden tool still routes by its exposed name"
   120	
   121	# A stale map entry degrades: drop the alias, keep serving, report (increment 3.3 —
   122	# 'Don't be stupid': an upstream rename must never take the whole surface down).
   123	assert_not_contains "$SB/list.out" "never_served" "a stale map entry's exposed name is not served"
   124	assert_contains "$SB/daemon.log" "map entry for 'gone-tool'" "the stale map entry is reported by name"
   125	
   126	# --- Phase 2, the sieve: blocked tools are neither listed nor callable ---
   127	# Blocking EVERY tool on one upstream empties only that upstream — the round-one
   128	# colloquium's catastrophic case was the sieve meeting the old blank-on-missing logic
   129	# and serving nothing from anywhere.
   130	assert_not_contains "$SB/list.out" "muzzled__a" "a blocked tool is absent from the listing"
   131	assert_not_contains "$SB/list.out" "muzzled__b" "blocking every tool on one upstream empties that upstream"
   132	assert_contains "$SB/list.out" "alpha__ping" "and the other upstreams keep serving through it"
   133	
   134	# A listing filter alone is decoration: the model knows names from its own context and
   135	# previous sessions, so the call path must refuse too, and say WHY — the recorded reason
   136	# is the whole point of the mandatory why field.
   137	mcp_call tools/call '{"name":"muzzled__a","arguments":{}}' > "$SB/muzzled.out"
   138	assert_contains "$SB/muzzled.out" "blocked on this surface" \
   139	  "a blocked tool is refused at tools/call, not just hidden from tools/list"
   140	assert_contains "$SB/muzzled.out" "alpha owns this job" "the refusal carries the recorded why"
   141	assert_not_contains "$SB/muzzled.out" "muzzled-a" "the blocked call never reached the upstream"
   142	
   143	# A block naming a tool the upstream does not offer is a line protecting nothing, and a
   144	# version bump is exactly when that happens: it surfaces in the log rather than rotting.
   145	assert_contains "$SB/daemon.log" "block entry for 'ghost-tool'" \
   146	  "a stale block entry is reported by name"
   147	
   148	# --- increment 1.5: a paginating upstream is drained into a full snapshot ---
   149	# Cursors are per-server opaque tokens, so the one downstream cursor used to be handed
   150	# to EVERY upstream verbatim; the pager stub serves one tool per page, and only draining
   151	# its pages produces both tools.
   152	assert_contains "$SB/list.out" "pager__first" "page one of a paginating upstream is served"
   153	assert_contains "$SB/list.out" "pager__second" "page two is served as well — the upstream was drained, not truncated"
   154	mcp_call tools/call '{"name":"pager__second","arguments":{}}' > "$SB/pager.out"
   155	assert_contains "$SB/pager.out" "page-two" "a tool from a drained later page is callable"
   156	
   157	# A downstream cursor this daemon never issued is refused, not forwarded to upstreams
   158	# whose cursor spaces it cannot belong to — with the spec's INVALID_PARAMS code and the
   159	# daemon's own diagnostic, so a generic 500 cannot satisfy this (panel: the bare "error"
   160	# substring passed for any failure at all).
   161	mcp_call tools/list '{"cursor":"bogus-cursor"}' > "$SB/cursor.out"
   162	assert_contains "$SB/cursor.out" "-32602" \
   163	  "an unissued cursor is refused with the spec's INVALID_PARAMS code"
   164	assert_contains "$SB/cursor.out" "unexpected cursor" \
   165	  "and the refusal carries the daemon's own diagnostic, not a generic internal error"
   166	
   167	# An unrecognised exposed name is a real error, not a silent success or a misroute.
   168	mcp_call tools/call '{"name":"NotARealTool","arguments":{}}' > "$SB/unknown.out"
   169	assert_contains "$SB/unknown.out" "doesn't match any known upstream prefix" \
   170	  "an unknown exposed name returns the routing error"
   171	assert_contains "$SB/unknown.out" '"isError":true' "and it is marked as an error result"
   172	
   173	# --- Phase 1 hardening: env pass-through, application errors, no blind forwarding ---
   174	# The config's env map must reach the child by EFFECT: the SDK's default child
   175	# environment is a six-variable allowlist, so this value arrives only if the daemon
   176	# passes it deliberately.
   177	mcp_call tools/call '{"name":"alpha__secret","arguments":{}}' > "$SB/secret.out"
   178	assert_contains "$SB/secret.out" "sekrit-env-value" \
   179	  "the config env map reaches the upstream child process"
   180	
   181	# An upstream's application-level JSON-RPC error is the CALLER'S error, not a dead
   182	# transport (codex leg: the old path marked the connection broken and reported 'not
   183	# connected right now', tearing down a healthy session).
   184	mcp_call tools/call '{"name":"alpha__bad","arguments":{}}' > "$SB/bad.out"
   185	assert_contains "$SB/bad.out" "kaboom-from-alpha" \
   186	  "an upstream JSON-RPC error is forwarded with its own message"
   187	assert_not_contains "$SB/bad.out" "not connected right now" \
   188	  "and is not misreported as a disconnection"
   189	mcp_call tools/call '{"name":"alpha__ping","arguments":{}}' > "$SB/after-bad.out"
   190	assert_contains "$SB/after-bad.out" "alpha-pong" \
   191	  "the session survives the upstream error — no teardown, no reconnect gap"
   192	
   193	# A prefixed name the upstream does not offer is refused after a refresh, never
   194	# forwarded blind (the prefix fallback would bypass Phase 2's sieve).
   195	mcp_call tools/call '{"name":"alpha__enoexist","arguments":{}}' > "$SB/enoexist.out"
   196	assert_contains "$SB/enoexist.out" "does not currently offer" \
   197	  "a prefixed-but-unknown tool is refused by the daemon, not forwarded on faith"
   198	
   199	# --- increment 1.4: a dead upstream must not blank the others, and connected-but-empty
   200	# --- is not the same thing as disconnected ---
   201	# All three colloquium brands found this independently: on_list_tools served ZERO tools
   202	# for every upstream when any one was missing, so during an Xcode reconnect Drew's tools
   203	# — which need no Xcode — vanished too. gamma's command dies instantly (never connects);
   204	# delta connects fine and genuinely has zero tools. alpha must keep serving through both.
   205	cat > "$SB/_mcp_degraded.json" <<EOF
   206	{
   207	  "mcpServers": {
   208	    "alpha": {"command": "python3", "args": ["$STUB", "--name", "alpha", "--tool", "ping=alpha-pong"]},
   209	    "gamma": {"command": "python3", "args": ["-c", "import sys; sys.exit(1)"], "block": [{"tool": "anything", "why": "a block on a DEAD upstream must be inert — the sieve applies after the availability check"}]},
   210	    "delta": {"command": "python3", "args": ["$STUB", "--name", "delta"]},
   211	    "looper": {"command": "python3", "args": ["$STUB", "--name", "looper", "--page-loop", "--tool", "trap=x"]}
   212	  }
   213	}
   214	EOF
   215	PORT=8901
   216	env -u XCODE_MCP_FRONT_UPSTREAMS \
   217	  XCODE_MCP_FRONT_MCP_INFO="$SB/_mcp_degraded.json" \
   218	  XCODE_MCP_FRONT_PORT="$PORT" \
   219	  XCODE_MCP_FRONT_HOME="$SB/home2" \
   220	  XCODE_MCP_FRONT_AUTO_ALLOW=0 \
   221	  XCODE_MCP_FRONT_SERVER_NAME="astra-test-degraded" \
   222	  uv run --script "$DAEMON" >"$SB/daemon2.log" 2>&1 &
   223	DPID2=$!
   224	trap 'kill "$DPID" "$DPID2" 2>/dev/null; wait "$DPID" "$DPID2" 2>/dev/null; rm -rf "$SB"' EXIT
   225	
   226	# Wait only for the daemon's HTTP to answer at all — waiting for alpha__ would make the
   227	# assertion its own precondition and turn the old blank-everything defect into a timeout.
   228	waited=0
   229	until [ "$waited" -ge 20 ]; do
   230	  if ! kill -0 "$DPID2" 2>/dev/null; then
   231	    fail "degraded daemon exited during startup — its log:"; sed 's/^/        /' "$SB/daemon2.log" >&2
   232	    finish; exit 1
   233	  fi
   234	  dlist="$(mcp_call tools/list '{}' 2>/dev/null || true)"
   235	  case "$dlist" in *'"tools"'*) break ;; esac
   236	  sleep 1; waited=$((waited+1))
   237	done
   238	# Give the connection managers a few extra ticks: alpha needs to be connected AND listed.
   239	for _ in 1 2 3 4 5 6 7 8; do
   240	  case "$dlist" in *alpha__ping*) break ;; esac
   241	  sleep 1
   242	  dlist="$(mcp_call tools/list '{}' 2>/dev/null || true)"
   243	done
   244	printf '%s' "$dlist" > "$SB/dlist.out"
   245	assert_contains "$SB/dlist.out" "alpha__ping" \
   246	  "a dead upstream (gamma) does not blank the healthy one's tools"
   247	assert_not_contains "$SB/dlist.out" "gamma__" "the dead upstream contributes nothing"
   248	assert_not_contains "$SB/dlist.out" "delta__" \
   249	  "a connected upstream with zero tools contributes zero tools, and is not treated as missing"
   250	
   251	mcp_call tools/call '{"name":"alpha__ping","arguments":{}}' > "$SB/alpha2.out"
   252	assert_contains "$SB/alpha2.out" "alpha-pong" "calls to the healthy upstream still route while gamma is down"
   253	
   254	mcp_call tools/call '{"name":"gamma__something","arguments":{}}' > "$SB/gamma.out"
   255	assert_contains "$SB/gamma.out" "[gamma] not connected right now" \
   256	  "a call to the dead upstream names IT as the unavailable one"
   257	assert_contains "$SB/gamma.out" '"isError":true' "and is an error result, not a silent success"
   258	
   259	# --- an upstream whose cursor loops is bounded and reported, not followed forever ---
   260	# The looper answers instantly with the same nextCursor every page; an unbounded drain
   261	# accumulates pages until timeout or memory death, and every upstream listed after it
   262	# waits the whole time (panel, all three brands; the claude leg measured 48k pages in
   263	# 10 seconds).
   264	assert_not_contains "$SB/dlist.out" "looper__" \
   265	  "a cursor-cycling upstream contributes nothing rather than wedging the list"
   266	
   267	# --- the log tells the degraded story precisely (panel: the list alone cannot
   268	# --- distinguish connected-but-empty from disconnected, so the test must read it) ---
   269	grep "WITHOUT unavailable" "$SB/daemon2.log" > "$SB/unavail-lines" || : > "$SB/unavail-lines"
   270	assert_contains "$SB/unavail-lines" "gamma" "the unavailable warning names the dead upstream"
   271	assert_not_contains "$SB/unavail-lines" "delta" \
   272	  "the connected-but-empty upstream is NOT reported unavailable"
   273	assert_contains "$SB/daemon2.log" "[gamma] attempting connect" \
   274	  "gamma was genuinely attempted, not silently dropped from the config"
   275	assert_contains "$SB/daemon2.log" "[delta] connected" \
   276	  "delta genuinely connected — its absence from the list means empty, not missing"
   277	
   278	# --- a single-upstream FILE config honours its declared prefix ---
   279	# The validator prints prefix=solo__ and the daemon used to serve the tool bare; the
   280	# two disagreed about the same file, and adding a second server silently renamed every
   281	# tool the first offered (the roadmap's own defect 2, measured live by the claude leg).
   282	cat > "$SB/_mcp_solo.json" <<EOF
   283	{"mcpServers": {"solo": {"command": "python3", "args": ["$STUB", "--name", "solo", "--tool", "ping=solo-pong"]}}}
   284	EOF
   285	PORT=8905
   286	env -u XCODE_MCP_FRONT_UPSTREAMS \
   287	  XCODE_MCP_FRONT_MCP_INFO="$SB/_mcp_solo.json" \
   288	  XCODE_MCP_FRONT_PORT="$PORT" \
   289	  XCODE_MCP_FRONT_HOME="$SB/home3" \
   290	  XCODE_MCP_FRONT_AUTO_ALLOW=0 \
   291	  XCODE_MCP_FRONT_SERVER_NAME="astra-test-solo" \
   292	  uv run --script "$DAEMON" >"$SB/daemon3.log" 2>&1 &
   293	DPID3=$!
   294	trap 'kill "$DPID" "$DPID2" "$DPID3" 2>/dev/null; wait "$DPID" "$DPID2" "$DPID3" 2>/dev/null; rm -rf "$SB"' EXIT
   295	waited=0
   296	until [ "$waited" -ge 20 ]; do
   297	  slist="$(mcp_call tools/list '{}' 2>/dev/null || true)"
   298	  case "$slist" in *solo__ping*|*'"ping"'*) break ;; esac
   299	  sleep 1; waited=$((waited+1))
   300	done
   301	printf '%s' "$slist" > "$SB/solo.out"
   302	assert_contains "$SB/solo.out" "solo__ping" \
   303	  "a one-upstream file config serves the prefix its validator printed"
   304	mcp_call tools/call '{"name":"solo__ping","arguments":{}}' > "$SB/solo-call.out"
   305	assert_contains "$SB/solo-call.out" "solo-pong" "and the prefixed name routes"
   306	
   307	# --- RED control: the replaced env format is a startup death, not a fallback ---
   308	red "a set XCODE_MCP_FRONT_UPSTREAMS kills the daemon at startup naming the replacement" 1 "replaced by _mcp_info.json" \
   309	  env XCODE_MCP_FRONT_UPSTREAMS="xcode:1:xcrun:mcpbridge" XCODE_MCP_FRONT_PORT=8907 \
   310	      XCODE_MCP_FRONT_HOME="$SB/home4" XCODE_MCP_FRONT_AUTO_ALLOW=0 \
   311	      uv run --script "$DAEMON"
   312	
   313	finish

exec
