    97	# --- env is implemented, not rejected (Phase 1 hardening, claude-leg finding 9) ---
    98	# The daemon's own docstring names XCODEMCP_ALLOWED_FOLDERS as Drew's auth mechanism,
    99	# and the SDK's default child environment is a six-variable allowlist, so with env
   100	# rejected there was NO way to configure it at all.
   101	envcfg="$SB/envcfg.json"
   102	cat > "$envcfg" <<'EOF'
   103	{"mcpServers": {"withenv": {"command": "c", "env": {"ASTRA_TEST_VAL": "sekrit"}}}}
   104	EOF
   105	out="$SB/envcfg.out"
   106	python3 "$LOADER" validate "$envcfg" >"$out" 2>&1
   107	assert_eq "0" "$?" "a server with an env map validates"
   108	assert_contains "$out" "ASTRA_TEST_VAL" "the env keys are shown in the validation listing"
   109	
   110	printf '{"mcpServers": {"x": {"command": "c", "env": {"A": 1}}}}' > "$SB/badenv.json"
   111	red "env values that are not strings are rejected" 65 "'env' must be an object of string values" \
   112	  python3 "$LOADER" validate "$SB/badenv.json"
   113	
   114	# --- unknown TOP-LEVEL keys are rejected too (all three phase-1 panel brands) ---
   115	# Phase 2's sieve and Phase 3's map land at top level; a typo'd stanza that validates
   116	# silently is a limiting policy that never applies.
   117	printf '{"mcpServers": {"x": {"command": "c"}}, "denyLisp": []}' > "$SB/topkey.json"
   118	red "an unknown top-level key is rejected by name" 65 "unknown top-level field 'denyLisp'" \
   119	  python3 "$LOADER" validate "$SB/topkey.json"
   120	
   121	# --- the prefix set must compose into an unambiguous surface (increment 1.3) ---
   122	# Two upstreams sharing a prefix would collide exposed names; a prefix that is a prefix
   123	# of another ('a__' and 'a__b__') makes routing 'a__b__tool' order-dependent. Both are
   124	# config mistakes and both are rejected at load, when the author can still fix them —
   125	# not at call time, when they surface as a misroute.
   126	printf '{"mcpServers": {"one": {"command": "c", "prefix": "x__"}, "two": {"command": "c", "prefix": "x__"}}}' > "$SB/dup-prefix.json"
   127	red "two upstreams with the same prefix are rejected" 65 "same prefix 'x__'" \
   128	  python3 "$LOADER" validate "$SB/dup-prefix.json"
   129	
   130	printf '{"mcpServers": {"a": {"command": "c"}, "abi": {"command": "c", "prefix": "a__b__"}}}' > "$SB/nested-prefix.json"
   131	red "a prefix that is a prefix of another is rejected as order-dependent" 65 "prefix of" \
   132	  python3 "$LOADER" validate "$SB/nested-prefix.json"
   133	
   134	printf '{"mcpServers": {"a": {"command": "c", "prefix": ""}, "b": {"command": "c"}}}' > "$SB/empty-prefix.json"
   135	red "an empty prefix beside another upstream is rejected (bare names would be unroutable)" 65 "empty prefix" \
   136	  python3 "$LOADER" validate "$SB/empty-prefix.json"
   137	
   138	# --- the sieve: per-server block lists (Phase 2; deny-list only, per Jonathan) ---
   139	blockcfg="$SB/blockcfg.json"
   140	cat > "$blockcfg" <<'EOF'
   141	{"mcpServers": {"x": {"command": "c", "block": [
   142	  {"tool": "SwitchScheme", "why": "scheme switching is owned by drews per the 2026-08-31 decision"}
   143	]}}}
   144	EOF
   145	out="$SB/blockcfg.out"
   146	python3 "$LOADER" validate "$blockcfg" >"$out" 2>&1
   147	assert_eq "0" "$?" "a block entry with tool and why validates"
   148	assert_contains "$out" "SwitchScheme" "the blocked tool is shown in the validation listing"
   149	
   150	# why is DATA and it is REQUIRED at authoring time: a jsonc comment cannot be enforced,
   151	# and a block without a stated cause is the entry that outlives its reason and narrows
   152	# the surface forever (SPEC, 'the config records decisions').
   153	printf '{"mcpServers": {"x": {"command": "c", "block": [{"tool": "T"}]}}}' > "$SB/nowhy.json"
   154	red "validate rejects a block entry without a why" 65 "block entry for 'T' on server 'x' has no 'why'" \
   155	  python3 "$LOADER" validate "$SB/nowhy.json"
   156	
   157	printf '{"mcpServers": {"x": {"command": "c", "block": [{"tool": "T", "why": ""}]}}}' > "$SB/emptywhy.json"
   158	red "validate rejects an empty why the same way" 65 "block entry for 'T' on server 'x' has no 'why'" \
   159	  python3 "$LOADER" validate "$SB/emptywhy.json"
   160	
   161	printf '{"mcpServers": {"x": {"command": "c", "block": [{"why": "w"}]}}}' > "$SB/notool.json"
   162	red "a block entry without a tool name is rejected" 65 "block entry on server 'x' has no 'tool'" \
   163	  python3 "$LOADER" validate "$SB/notool.json"
   164	
   165	# At daemon RUNTIME the same missing why is a warning, not a startup death: rejecting at
   166	# load would fail the repo, at startup, for a sentence someone forgot in astra
   167	# (ROADMAP 2.2). The block still applies.
   168	out="$SB/lenient.out"
   169	env -u XCODE_MCP_FRONT_UPSTREAMS XCODE_MCP_FRONT_MCP_INFO="$SB/nowhy.json" \
   170	  python3 "$LOADER" resolve >"$out" 2>&1
   171	assert_eq "0" "$?" "resolve accepts the missing-why config instead of failing the repo at startup"
   172	assert_contains "$out" "no 'why'" "and it says out loud what the authoring check would have rejected"
   173	
   174	# --- the map: source-qualified renames (Phase 3) ---
   175	mapcfg="$SB/mapcfg.json"
   176	cat > "$mapcfg" <<'EOF'
   177	{"mcpServers": {"x": {"command": "c", "map": [
   178	  {"tool": "window_close", "name": "close_current_window", "why": "surface vocabulary: neither vendor's name reads right in the aggregate"}
   179	]}}}
   180	EOF
   181	out="$SB/mapcfg.out"
   182	python3 "$LOADER" validate "$mapcfg" >"$out" 2>&1
   183	assert_eq "0" "$?" "a map entry with tool, name and why validates"
   184	assert_contains "$out" "close_current_window" "the exposed name is shown in the listing"
   185	
   186	printf '{"mcpServers": {"x": {"command": "c", "map": [{"tool": "t", "name": "n"}]}}}' > "$SB/mapnowhy.json"
   187	red "validate rejects a map entry without a why" 65 "map entry for 't' on server 'x' has no 'why'" \
   188	  python3 "$LOADER" validate "$SB/mapnowhy.json"
   189	
   190	printf '{"mcpServers": {"x": {"command": "c", "map": [{"tool": "t", "why": "w"}]}}}' > "$SB/mapnoname.json"
   191	red "a map entry without an exposed name is rejected" 65 "map entry for 't' on server 'x' has no 'name'" \
   192	  python3 "$LOADER" validate "$SB/mapnoname.json"
   193	
   194	printf '{"mcpServers": {"x": {"command": "c", "map": [{"tool": "a", "name": "same", "why": "w"}, {"tool": "b", "name": "same", "why": "w"}]}}}' > "$SB/mapdup.json"
   195	red "two map entries claiming one exposed name are rejected" 65 "exposed name 'same' is claimed twice" \
   196	  python3 "$LOADER" validate "$SB/mapdup.json"
   197	
   198	printf '{"mcpServers": {"x": {"command": "c", "block": [{"tool": "t", "why": "w"}], "map": [{"tool": "t", "name": "n", "why": "w"}]}}}' > "$SB/mapblock.json"
   199	red "a tool both blocked and renamed is a contradiction, rejected" 65 "'t' on server 'x' is both blocked and mapped" \
   200	  python3 "$LOADER" validate "$SB/mapblock.json"
   201	
   202	printf '{"mcpServers": {"one": {"command": "c", "map": [{"tool": "a", "name": "shared", "why": "w"}]}, "two": {"command": "c", "map": [{"tool": "b", "name": "shared", "why": "w"}]}}}' > "$SB/mapxserver.json"
   203	red "two SERVERS claiming one exposed name are rejected at load" 65 "exposed name 'shared' is claimed by both" \
   204	  python3 "$LOADER" validate "$SB/mapxserver.json"
   205	
   206	# --- resolve: how the daemon picks its upstreams (increment 1.2) ---
   207	# The colon/comma env format is REPLACED, not deprecated: a set XCODE_MCP_FRONT_UPSTREAMS
   208	# is a hard error pointing at the file, because the old parser silently corrupted a colon
   209	# in a command path and a comma in an argument, and a daemon that half-honoured both
   210	# mechanisms would hide which one won.
   211	out="$SB/resolve-file.out"
   212	env -u XCODE_MCP_FRONT_UPSTREAMS XCODE_MCP_FRONT_MCP_INFO="$ok_cfg" \
   213	  python3 "$LOADER" resolve >"$out" 2>&1
   214	assert_eq "0" "$?" "resolve honours XCODE_MCP_FRONT_MCP_INFO"
   215	assert_contains "$out" "xcode__" "resolve keeps the xcode__ prefix from the file"
   216	assert_contains "$out" "drews__" "resolve keeps the drews__ prefix from the file"
   217	
   218	red "a set XCODE_MCP_FRONT_UPSTREAMS is refused, pointing at the file" 65 "replaced by _mcp_info.json" \
   219	  env XCODE_MCP_FRONT_UPSTREAMS="xcode:1:xcrun:mcpbridge" python3 "$LOADER" resolve
   220	
   221	red "UPSTREAMS set alongside the file is still refused — one mechanism must win visibly" 65 "replaced by _mcp_info.json" \
   222	  env XCODE_MCP_FRONT_UPSTREAMS="x:1:c" XCODE_MCP_FRONT_MCP_INFO="$ok_cfg" python3 "$LOADER" resolve
   223	
   224	# With neither set, the deployed single-upstream daemon's env contract is unchanged:
   225	# default xcrun mcpbridge, Xcode required, served unprefixed.
   226	out="$SB/resolve-single.out"
   227	env -u XCODE_MCP_FRONT_UPSTREAMS -u XCODE_MCP_FRONT_MCP_INFO \
   228	  python3 "$LOADER" resolve >"$out" 2>&1
   229	assert_eq "0" "$?" "resolve with no env keeps the single-upstream default"
   230	assert_contains "$out" "xcrun mcpbridge" "single-upstream default is still xcrun mcpbridge"
   231	assert_contains "$out" "require_xcode" "single-upstream default still waits for Xcode"
   232	
   233	out="$SB/resolve-drews.out"
   234	env -u XCODE_MCP_FRONT_UPSTREAMS -u XCODE_MCP_FRONT_MCP_INFO \
   235	  XCODE_MCP_FRONT_UPSTREAM_CMD=uvx XCODE_MCP_FRONT_UPSTREAM_ARGS=drews-xcode-mcp \
   236	  XCODE_MCP_FRONT_REQUIRE_XCODE=0 python3 "$LOADER" resolve >"$out" 2>&1
   237	assert_eq "0" "$?" "single-upstream env overrides still resolve"
   238	assert_contains "$out" "uvx drews-xcode-mcp" "single-upstream CMD/ARGS overrides survive"
   239	assert_not_contains "$out" "require_xcode" "REQUIRE_XCODE=0 drops the quirk"
   240	
   241	finish
     1	#!/usr/bin/env python3
     2	"""stub_mcp_server — a minimal, dependency-free stdio MCP server for tests.
     3	
     4	Speaks just enough newline-delimited JSON-RPC for the aggregator's client to connect:
     5	initialize, notifications/initialized, tools/list, tools/call, ping. Every knob is an
     6	argument so any test (or any other agent's harness) can shape it without editing it:
     7	
     8	    stub_mcp_server.py --name alpha --tool ping=alpha-pong --tool build=done
     9	    stub_mcp_server.py --name empty                       # connects fine, zero tools
    10	    stub_mcp_server.py --name chatty --banner "starting"  # spec-illegal stdout banner line
    11	    stub_mcp_server.py --name pager --tool a=1 --tool b=2 --page-size 1   # paginates
    12	
    13	--tool NAME=REPLY declares one tool; calling it returns REPLY as text content. Two REPLY
    14	  prefixes change the behaviour: "env:VAR" answers with os.environ[VAR] resolved at call
    15	  time (proves an env pass-through by effect), and "error:MSG" answers with a JSON-RPC
    16	  ERROR response (an application-level error a proxy must forward, not treat as a dead
    17	  transport).
    18	--banner LINE prints LINE to stdout before serving (reproduces the class of server that
    19	  breaks naive next-line readers).
    20	--notify-before-reply emits a spec-legal notification line immediately before every
    21	  response (a next-line reader misreads the notification as the answer).
    22	--stall-tools answers initialize normally and then never answers tools/list (reproduces
    23	  the approval-dialog gate that must read as a timeout, never as an empty tool list).
    24	--page-size N makes tools/list return N tools per page with a nextCursor, exercising
    25	  per-upstream cursors.
    26	--page-loop makes every tools/list page carry nextCursor "0" forever (a cursor cycle,
    27	  the upstream bug a drain must bound rather than follow to memory exhaustion).
    28	Python 3.9-compatible; no third-party imports.
    29	"""
    30	import argparse
    31	import json
    32	import os
    33	import sys
    34	
    35	
    36	def main():
    37	    ap = argparse.ArgumentParser()
    38	    ap.add_argument("--name", required=True)
    39	    ap.add_argument("--version", default="1.0-stub")
    40	    ap.add_argument("--tool", action="append", default=[], metavar="NAME=REPLY")
    41	    ap.add_argument("--describe", action="append", default=[], metavar="NAME=TEXT",
    42	                    help="override a tool's description (for description-rewrite tests)")
    43	    ap.add_argument("--banner", default=None)
    44	    ap.add_argument("--notify-before-reply", action="store_true")
    45	    ap.add_argument("--stall-tools", action="store_true")
    46	    ap.add_argument("--page-size", type=int, default=0)
    47	    ap.add_argument("--page-loop", action="store_true")
    48	    a = ap.parse_args()
    49	
    50	    tools = {}
    51	    for spec in a.tool:
    52	        name, _, reply = spec.partition("=")
    53	        tools[name] = reply
    54	    described = {}
    55	    for spec in a.describe:
    56	        n, _, text = spec.partition("=")
    57	        described[n] = text
    58	    tool_list = [{"name": n,
    59	                  "description": described.get(n, "stub tool %s on %s" % (n, a.name)),
    60	                  "inputSchema": {"type": "object"}}
    61	                 for n in tools]
    62	
    63	    def send(obj):
    64	        if a.notify_before_reply and "id" in obj:
    65	            sys.stdout.write(json.dumps({"jsonrpc": "2.0",
    66	                                         "method": "notifications/message",
    67	                                         "params": {"level": "info",
    68	                                                    "data": "stub %s chatter" % a.name}}) + "\n")
    69	        sys.stdout.write(json.dumps(obj) + "\n")
    70	        sys.stdout.flush()
    71	
    72	    if a.banner is not None:
    73	        sys.stdout.write(a.banner + "\n")
    74	        sys.stdout.flush()
    75	
    76	    for line in sys.stdin:
    77	        line = line.strip()
    78	        if not line:
    79	            continue
    80	        msg = json.loads(line)
    81	        method = msg.get("method")
    82	        mid = msg.get("id")
    83	        if mid is None:
    84	            continue  # a notification; nothing to answer
    85	        if method == "initialize":
    86	            send({"jsonrpc": "2.0", "id": mid, "result": {
    87	                "protocolVersion": msg.get("params", {}).get("protocolVersion", "2025-06-18"),
    88	                "capabilities": {"tools": {"listChanged": True}},
    89	                "serverInfo": {"name": a.name, "version": a.version}}})
    90	        elif method == "tools/list" and a.stall_tools:
    91	            continue  # never answer — the approval-dialog gate, as a stub
    92	        elif method == "tools/list":
    93	            if a.page_loop:
    94	                send({"jsonrpc": "2.0", "id": mid, "result": {
    95	                    "tools": tool_list, "nextCursor": "0"}})
    96	            elif a.page_size > 0:
    97	                cursor = msg.get("params") or {}
    98	                start = int(cursor.get("cursor") or 0)
    99	                page = tool_list[start:start + a.page_size]
   100	                result = {"tools": page}
   101	                if start + a.page_size < len(tool_list):
   102	                    result["nextCursor"] = str(start + a.page_size)
   103	                send({"jsonrpc": "2.0", "id": mid, "result": result})
   104	            else:
   105	                send({"jsonrpc": "2.0", "id": mid, "result": {"tools": tool_list}})
   106	        elif method == "tools/call":
   107	            params = msg.get("params") or {}
   108	            name = params.get("name")
   109	            if name in tools:
   110	                reply = tools[name]
   111	                if reply.startswith("env:"):
   112	                    reply = os.environ.get(reply[4:], "<unset:%s>" % reply[4:])
   113	                if reply.startswith("error:"):
   114	                    send({"jsonrpc": "2.0", "id": mid, "error": {
   115	                        "code": -32050, "message": reply[6:]}})
   116	                    continue
   117	                send({"jsonrpc": "2.0", "id": mid, "result": {
   118	                    "content": [{"type": "text", "text": reply}], "isError": False}})
   119	            else:
   120	                send({"jsonrpc": "2.0", "id": mid, "error": {
   121	                    "code": -32602, "message": "unknown tool %r on stub %s" % (name, a.name)}})
   122	        elif method == "ping":
   123	            send({"jsonrpc": "2.0", "id": mid, "result": {}})
   124	        else:
   125	            send({"jsonrpc": "2.0", "id": mid, "error": {
   126	                "code": -32601, "message": "stub %s does not implement %s" % (a.name, method)}})
   127	
   128	
   129	if __name__ == "__main__":
   130	    main()

