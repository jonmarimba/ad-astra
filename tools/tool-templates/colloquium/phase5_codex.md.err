   446	
   447	async def serve_connection(
   448	    server: Server[LifespanT],
   449	    dispatcher: Dispatcher[Any],
   450	    *,
   451	    connection: Connection,
   452	    lifespan_state: LifespanT,
   453	    init_options: InitializationOptions | None = None,
   454	    task_status: anyio.abc.TaskStatus[None] = anyio.TASK_STATUS_IGNORED,
   455	) -> None:
   456	    """Drive ``dispatcher`` until the underlying channel closes.
   457	
   458	    The loop-mode driver: builds the kernel, hands `on_request`/`on_notify`
   459	    to `dispatcher.run()`, and tears down `connection.exit_stack` (shielded)
   460	    on the way out. The entry constructs the `Connection`; this only consumes
   461	    it.
   462	    """
   463	    runner = ServerRunner(server, connection, lifespan_state, init_options=init_options)
   464	    try:
   465	        await dispatcher.run(runner.on_request, runner.on_notify, task_status=task_status)
   466	    finally:
   467	        await aclose_shielded(connection)
   468	
   469	
   470	async def serve_loop(
   471	    server: Server[LifespanT],
   472	    read_stream: ReadStream[SessionMessage | Exception],
   473	    write_stream: WriteStream[SessionMessage],
   474	    *,
   475	    lifespan_state: LifespanT,
   476	    session_id: str | None = None,
   477	    init_options: InitializationOptions | None = None,
   478	    raise_exceptions: bool = False,
   479	) -> None:
   480	    """Drive ``server`` in handshake-only loop mode over a stream pair until the channel closes.
   481	
   482	    Builds the loop-mode `JSONRPCDispatcher` + `Connection` and hands them to
   483	    `serve_connection`. The streamable-HTTP manager (which owns its lifespan
   484	    and serves the modern era on the single-exchange entry instead) calls
   485	    this; `Server.run` drives `serve_dual_era_loop`, which extends the same
   486	    dispatcher recipe (notably the `inline_methods={"initialize"}` rule) with
   487	    era routing.
   488	    """
   489	    dispatcher: JSONRPCDispatcher[TransportContext] = JSONRPCDispatcher(
   490	        read_stream,
   491	        write_stream,
   492	        raise_handler_exceptions=raise_exceptions,
   493	        # Handle `initialize` inline so a client that pipelines it with the
   494	        # next request (spec: SHOULD NOT, not MUST NOT) sees the initialized
   495	        # state instead of failing the init-gate.
   496	        inline_methods=frozenset({"initialize"}),
   497	    )
   498	    connection = Connection.for_loop(dispatcher, session_id=session_id)
   499	    await serve_connection(
   500	        server, dispatcher, connection=connection, lifespan_state=lifespan_state, init_options=init_options
   501	    )
   502	
   503	
   504	def _has_modern_envelope(params: Mapping[str, Any] | None) -> bool:
   505	    """Whether `params._meta` carries the reserved protocol-version key.
   506	
   507	    The `io.modelcontextprotocol/protocolVersion` key exists only in
   508	    2026-07-28+ envelopes and its prefix is spec-reserved, so legacy traffic
   509	    never mints it (a bare `_meta` is not evidence - legacy requests carry
   510	    `progressToken` there). The version key alone is the signal, not the full
   511	    required pair, so a half-built envelope still routes modern and gets the
   512	    classifier's INVALID_PARAMS naming the missing key.
   513	    """
   514	    if not params:
   515	        return False
   516	    meta = params.get("_meta")
   517	    return isinstance(meta, Mapping) and PROTOCOL_VERSION_META_KEY in meta
   518	
   519	
   520	def _initialize_after_modern_data(params: Mapping[str, Any] | None) -> dict[str, Any]:
   521	    """Error data for an `initialize` arriving on a modern-locked connection.
   522	
   523	    The typed -32022 payload when the client's proposed version is parseable;
   524	    otherwise just the supported list (the point is naming what we serve).
   525	    """
   526	    requested = (params or {}).get("protocolVersion")
   527	    if isinstance(requested, str):
   528	        return UnsupportedProtocolVersionErrorData(
   529	            supported=list(MODERN_PROTOCOL_VERSIONS), requested=requested
   530	        ).model_dump(mode="json")
     1	"""`ServerSession`: server-to-client requests and notifications.
     2	
     3	A per-request proxy built by the kernel for each inbound request. Exposes the
     4	request-scoped outbound channel and the connection's standalone channel.
     5	Handlers reach it as `ctx.session` and use the typed helpers (`elicit_form`,
     6	`send_log_message`, ...) to call back to the client.
     7	"""
     8	
     9	import logging
    10	from typing import Any, TypeVar, overload
    11	
    12	import mcp_types as types
    13	from mcp_types import methods as _methods
    14	from mcp_types.version import MODERN_PROTOCOL_VERSIONS
    15	from pydantic import AnyUrl, BaseModel
    16	from typing_extensions import deprecated
    17	
    18	from mcp.server.connection import Connection, allowed_log_levels
    19	from mcp.server.validation import validate_sampling_tools, validate_tool_use_result_messages, wants_sampling_tools
    20	from mcp.shared.dispatcher import CallOptions, DispatchContext, ProgressFnT
    21	from mcp.shared.exceptions import MCPDeprecationWarning
    22	from mcp.shared.message import ServerMessageMetadata
    23	
    24	__all__ = ["ServerSession"]
    25	
    26	logger = logging.getLogger(__name__)
    27	# `send_log_message`'s `logger` parameter (public API, the spec's logger-name
    28	# field) shadows the module logger inside that method; this alias keeps it
    29	# reachable there.
    30	_logger = logger
    31	
    32	ResultT = TypeVar("ResultT", bound=BaseModel)
    33	
    34	
    35	class ServerSession:
    36	    """Per-request proxy for server-to-client requests and notifications.
    37	
    38	    Built once per inbound request by the kernel's `_make_context`. Holds two
    39	    `Outbound` channels: the request-scoped one (the per-request
    40	    `DispatchContext`, which on streamable HTTP routes onto the originating
    41	    POST's response stream) and the connection's standalone channel
    42	    (`connection.outbound`). `related_request_id` on the public methods is the
    43	    selector — present means request-scoped, absent means standalone — and
    44	    never crosses the `Outbound` Protocol.
    45	    """
    46	
    47	    def __init__(
    48	        self,
    49	        request_outbound: DispatchContext[Any],
    50	        connection: Connection,
    51	        *,
    52	        request_meta: types.RequestParamsMeta | None = None,
    53	    ) -> None:
    54	        self._request_outbound = request_outbound
    55	        self._connection = connection
    56	        # The per-request log-delivery contract, fixed at construction: on
    57	        # 2026-07-28+ the inbound request's `_meta` log-level opt-in decides
    58	        # which `notifications/message` levels may be sent for this request
    59	        # (and they ride this request's stream only); on handshake versions
    60	        # every level may be sent (`logging/setLevel`-era semantics).
    61	        self._log_is_request_scoped = connection.protocol_version in MODERN_PROTOCOL_VERSIONS
    62	        self._allowed_log_levels = allowed_log_levels(connection.protocol_version, request_meta)
    63	
    64	    @property
    65	    def client_params(self) -> types.InitializeRequestParams | None:
    66	        """The client's `initialize` request params; `None` when no client info was supplied."""
    67	        return self._connection.client_params
    68	
    69	    @property
    70	    def client_capabilities(self) -> types.ClientCapabilities | None:
    71	        """The capabilities the client declared; `None` when none were declared.
    72	
    73	        Prefer this over `client_params.capabilities`: on 2026-07-28+ the
    74	        request envelope declares capabilities while client info stays
    75	        optional, so capabilities can be present without `client_params`.
    76	        """
    77	        return self._connection.client_capabilities
    78	
    79	    @property
    80	    def can_send_request(self) -> bool:
    81	        """Whether this request's channel can currently deliver a server-initiated request."""
    82	        return self._request_outbound.can_send_request
    83	
    84	    @property
    85	    def protocol_version(self) -> str:
    86	        """The protocol version this connection speaks.
    87	
    88	        Populated at `Connection` construction and overwritten once the
    89	        handshake commits on the loop path; never `None`.
    90	        """
    91	        return self._connection.protocol_version
    92	
    93	    async def send_request(
    94	        self,
    95	        request: types.ServerRequest,
    96	        result_type: type[ResultT],
    97	        request_read_timeout_seconds: float | None = None,
    98	        metadata: ServerMessageMetadata | None = None,
    99	        progress_callback: ProgressFnT | None = None,
   100	    ) -> ResultT:
   101	        """Send a typed server-to-client request and validate the result.
   102	
