   460	class Upstream:
   461	    """One upstream MCP server this daemon fronts, and everything needed to
   462	    keep a persistent connection to it alive. In single-upstream mode there's
   463	    exactly one of these and its tools are forwarded unprefixed (unchanged
   464	    behavior from before multi-upstream support existed). In multi-upstream
   465	    mode there are several, and the aggregator (see build_server) prefixes
   466	    each one's tools with `self.name + "__"` so two upstreams that happen to
   467	    share a tool name can't collide."""
   468	
   469	    def __init__(self, name: str, command: str, args: list[str], require_xcode_running: bool,
   470	                 prefix: str = "", env: dict | None = None, blocks: dict | None = None,
   471	                 maps: dict | None = None, from_env: bool = False,
   472	                 expected_version: str | None = None):
   473	        # The recorded compatible serverInfo.version, advisory only: a mismatch warns
   474	        # (in-band via instructions, once-persisted for the human) and NEVER refuses —
   475	        # an Xcode update taking the whole surface down is the worse failure (SPEC).
   476	        self.expected_version = expected_version
   477	        self.name = name
   478	        # Exposed-name prefix, VERBATIM from the spec. The daemon used to force "" for a
   479	        # sole upstream regardless of what the config declared, so the validator printed
   480	        # prefix=solo__ while the daemon served bare names — and adding a second server
   481	        # silently renamed every tool the first one offered (round-one colloquium defect
   482	        # 2; the phase-1 panel measured it still live). The env-var single mode passes ""
   483	        # explicitly, which keeps the deployed passthrough unprefixed.
   484	        self.prefix = prefix
   485	        self.env = dict(env) if env else None
   486	        # The sieve (Phase 2): bare tool name -> the recorded reason it is withheld.
   487	        # Deny-list only, per Jonathan. Applied when the surface is composed AND at
   488	        # tools/call — a listing filter alone is decoration, because the model knows
   489	        # names from its own context and previous sessions.
   490	        self.blocks: dict[str, str] = dict(blocks) if blocks else {}
   491	        self._stale_blocks_reported: set[str] = set()
   492	        # The map (Phase 3): bare tool name -> mcp_config.MapEntry. The exposed name is
   493	        # FINAL — it replaces prefix+bare outright; the original is refused like any
   494	        # other name the upstream does not offer on this surface.
   495	        self.maps: dict = dict(maps) if maps else {}
   496	        self._stale_maps_reported: set[str] = set()
   497	        # True only for the legacy env-var single-upstream contract — the one spec the
   498	        # bare-name passthrough is allowed for, because an env spec cannot carry blocks
   499	        # or maps (phase-3 panel: the passthrough let a FILE config's blocked tools be
   500	        # called by name).
   501	        self.from_env = from_env
   502	        # Watchdog input: bumped on every connect attempt and every successful heartbeat.
   503	        # Initialised here so the watchdog never reads a missing attribute on a slow start.
   504	        self.last_progress = time.monotonic()
   505	        self.command = command
   506	        self.args = args
   507	        self.require_xcode_running = require_xcode_running
   508	        self.lock = anyio.Lock()
   509	        self.session: ClientSession | None = None
   510	        self.known_broken = False
   511	
   512	
   513	    async def _on_upstream_message(self, message) -> None:
   514	        """The upstream notification tap (4.1): the protocol says the tool list is a
   515	        moving target and offers listChanged when it moves — a relay that drops it
   516	        leaves every downstream cache stale."""
   517	        if isinstance(message, types.ToolListChangedNotification):
   518	            log.info("[%s] upstream announced tools/list_changed — relaying downstream",
   519	                     self.name)
   520	            _fire_surface_changed(f"{self.name} listChanged")
   521	
   522	    async def _mark_broken(self, why: str) -> None:
   523	        """Set known_broken AND drop the public session reference immediately. The codex
   524	        leg of the phase-1 panel caught the gap: known_broken was set but the session
   525	        stayed visible until stdio teardown completed, and a wedged teardown (documented
   526	        below in stall_watchdog) let calls keep entering a session everyone knew was
   527	        dead."""
   528	        async with self.lock:
   529	            self.known_broken = True
   530	            self.session = None
   531	        log.warning("[%s] marking connection broken: %s", self.name, why)
   532	        _fire_surface_changed(f"{self.name} broken")
   533	
   534	    async def list_tools(self, params: types.PaginatedRequestParams | None) -> types.ListToolsResult | None:
   535	        """Returns None when this upstream is DISCONNECTED or the call failed — which is a
   536	        different fact from a connected upstream answering with zero tools, and the two
   537	        must never be conflated (increment 1.4: conflating them is how one missing
   538	        upstream used to blank the entire aggregate surface).
   539	
   540	        CONCURRENCY, stated plainly (the phase-1 panel caught the old file claiming full
   541	        serialization while the heartbeat bypassed the lock): tools/call is serialized
   542	        through self.lock; tools/list runs WITHOUT the lock on a session snapshot. The
   543	        MCP session multiplexes concurrent requests by id, and the heartbeat has listed
   544	        concurrently with real calls in production since 2026-08-14. Holding the lock
   545	        here meant a client connecting during a 10-minute build got no tool list at all
   546	        until the build ended — measured live by the panel's claude leg."""
   547	        async with self.lock:
   548	            session = None if self.known_broken else self.session
   549	        if session is None:
   550	            return None
   551	        try:
   552	            # DRAIN EVERY PAGE (increment 1.5). Cursors are opaque, per-server tokens,
   553	            # so the downstream client's cursor cannot be forwarded here — this daemon
   554	            # aggregates several cursor spaces into one surface and therefore serves a
   555	            # complete snapshot instead. Ignoring nextCursor used to silently truncate
   556	            # any upstream that paginates.
   557	            #
   558	            # The drain is bounded STRUCTURALLY, not just by wall clock (panel, all
   559	            # three brands): a repeated cursor is a definite upstream bug, and the page
   560	            # ceiling catches the fresh-cursor-forever variant — the claude leg measured
   561	            # 48,075 pages accumulated in ten seconds from a cycling stub. Listing is
   562	            # discovery, so it gets the short connect timeout, not the 600-second budget
   563	            # that exists for real builds.
   564	            tools: list[types.Tool] = []
   565	            cursor: str | None = None
   566	            seen_cursors: set[str] = set()
   567	            pages = 0
   568	            with anyio.fail_after(CONNECT_TIMEOUT_SECONDS):
   569	                while True:
   570	                    page = await session.list_tools(
   571	                        params=types.PaginatedRequestParams(cursor=cursor) if cursor else None)
   572	                    tools.extend(page.tools)
   573	                    pages += 1
   574	                    cursor = page.next_cursor
   575	                    if not cursor:
   576	                        return types.ListToolsResult(tools=tools)
   577	                    if cursor in seen_cursors:
   578	                        raise RuntimeError(
   579	                            f"cursor {cursor!r} repeated after {pages} pages — the upstream's "
   580	                            f"pagination cycles and can never finish")
   581	                    if pages >= LIST_MAX_PAGES:
   582	                        raise RuntimeError(
   583	                            f"tools/list still paginating after {LIST_MAX_PAGES} pages — "
   584	                            f"refusing to follow further")
   585	                    seen_cursors.add(cursor)
   586	        except Exception as e:
   587	            # REPORT UNAVAILABILITY; NEVER ADJUDICATE THE CONNECTION FROM HERE. This
   588	            # ran _mark_broken for one afternoon and took the deployed daemon down:
   589	            # clients poll tools/list constantly, each poll's drain timed out against
   590	            # the approval-gated mcpbridge (its first list blocks until the dialog is
   591	            # answered), and every timeout tore the connection down — WITHDRAWING the
   592	            # approval prompt before the clicker could answer it. That is the exact
   593	            # 2026-08-30 cancel-your-own-approval pathology, reintroduced through a
   594	            # new door and reproduced against a stall-tools stub under client load.
   595	            # The heartbeat in connection_manager — which owns the click-while-blocked
   596	            # helper — is the SOLE authority on connection state; a client-triggered
   597	            # drain that fails only means "nothing to serve from here right now".
   598	            log.info("[%s] list_tools unavailable this round (connection state untouched): %s",
   599	                     self.name, e or type(e).__name__)
   600	            return None
   601	
   602	    async def call_tool(self, tool_name: str, arguments: dict) -> types.CallToolResult | None:
   603	        """Returns None if not connected — caller decides how to report that,
   604	        since the aggregator needs a slightly different message than the
   605	        single-upstream case (naming which upstream is down)."""
   606	        async with self.lock:
   607	            if self.session is None or self.known_broken:
   608	                return None
   609	            log.info("[%s] call_tool %s", self.name, tool_name)
   610	            try:
   611	                with anyio.fail_after(CALL_TIMEOUT_SECONDS):
   612	                    result = await self.session.call_tool(tool_name, arguments)
   613	            except MCPError as e:
   614	                # AN APPLICATION-LEVEL JSON-RPC ERROR IS THE CALLER'S ERROR, NOT A DEAD
   615	                # TRANSPORT. The codex leg of the phase-1 panel caught this: the upstream
   616	                # answering -32602 for an unknown tool proves the connection is HEALTHY,
   617	                # and the old blanket except tore the session down and told the client
   618	                # "not connected right now, retry" — for a call that would fail
   619	                # identically on every retry.
   620	                log.info("[%s] call_tool %s: upstream returned an error (connection kept): %s",
   621	                         self.name, tool_name, e.message)
   622	                return types.CallToolResult(
   623	                    content=[types.TextContent(
   624	                        type="text",
   625	                        text=f"[{self.name}] upstream error for {tool_name!r}: {e.message}")],
   626	                    is_error=True,
   627	                )
   628	            except Exception as e:
   629	                # See list_tools' comment — same missing-timeout bug, same fix.
   630	                self.known_broken = True
   631	                self.session = None
   632	                log.warning("[%s] call_tool %s failed, marking connection broken: %s", self.name, tool_name, e)
   633	                return None
   634	            if not isinstance(result, types.CallToolResult):
   635	                # upstream returned something this dumb proxy doesn't forward
   636	                # (e.g. InputRequiredResult) — surface as an error, don't crash.
   637	                return types.CallToolResult(
   638	                    content=[
   639	                        types.TextContent(
   640	                            type="text",
   641	                            text=f"xcode-mcp-front: [{self.name}] unsupported upstream result type "
   642	                            f"{type(result).__name__}",
   643	                        )
   644	                    ],
   645	                    is_error=True,
   646	                )
   647	            return result
   648	
   649	    async def stall_watchdog(self) -> None:
   650	        """Exit the process if this upstream stops making progress entirely.
   651	
   652	        THE RECONNECT LOOP CAN GET STUCK AND GO PERMANENTLY SILENT. Observed live
   653	        2026-08-30: xcode-mcp-front logged "heartbeat list_tools failed, marking broken"
   654	        at 18:50:55 and then never logged again — no retry, no error, nothing — while its
   655	        HTTP endpoint kept answering and serving zero tools. The cause is the teardown, not
   656	        the loop: leaving `async with stdio_client(...)` waits for the child to exit, and a
   657	        wedged mcpbridge never does, so the task blocks inside __aexit__ where no `except`
   658	        and no retry can reach it. Every health signal this daemon has says "fine" in that
   659	        state, which is the worst possible failure shape.
   660	
   661	        There is no clean way to bound a hung context-manager exit from inside it. There IS
   662	        a supervisor: launchd, with KeepAlive true. So when an upstream has made no progress
   663	        for STALL_EXIT_SECONDS — no connect attempt, no successful heartbeat — say so loudly
   664	        and exit non-zero. That is the file's own stated philosophy: "a genuine crash is what
   665	        the process supervisor is for." A restart costs one new Xcode approval prompt, which
   666	        the clicker answers.
   667	
   668	        Deliberately generous, because a false positive here restarts a working daemon: the
   669	        default is many multiples of the heartbeat interval, and any progress at all resets it.
   670	        """
   671	        while True:
   672	            await anyio.sleep(RECONNECT_POLL_SECONDS)
   673	            if self.require_xcode_running and not _xcode_is_running():
   674	                # Waiting for Xcode is not a stall; that path logs and sleeps on purpose.
   675	                self.last_progress = time.monotonic()
   676	                continue
   677	            idle = time.monotonic() - getattr(self, "last_progress", time.monotonic())
   678	            if idle > STALL_EXIT_SECONDS:
   679	                log.error("[%s] no connect attempt and no successful heartbeat for %.0fs — the "
   680	                          "reconnect loop made no progress. Two known causes: stdio_client "
   681	                          "teardown waiting on a child that will not exit, or the loop waiting "
   682	                          "on this upstream's own lock behind a wedged call. Exiting so launchd "
   683	                          "restarts us; staying up would serve zero tools while every log line "
   684	                          "claimed we were connected.", self.name, idle)
   685	                os._exit(75)
   686	
   687	
   688	    async def connection_manager(self) -> None:
   689	        """Owns this upstream's connection for the daemon's whole life. Loops
   690	        forever: while not connected, check Xcode is running (if this upstream
   691	        needs it), best-effort click its approval prompt if showing, attempt a
   692	        fresh connect. Once connected, holds the session open — polling (and
   693	        clicking) on the same timer — until a call proves it's broken, then
   694	        goes back to reconnecting. In-process, never exits on its own; a
   695	        genuine crash is what the process supervisor (launchd) is for."""
   696	        # The config's env map is ADDITIVE over the SDK's safe default set (a six-variable
   697	        # allowlist) — matching Claude Code's semantics for the same file shape. Passing
   698	        # spec env alone would strip PATH and HOME from the child.
   699	        child_env = {**get_default_environment(), **self.env} if self.env else None
   700	        params = StdioServerParameters(command=self.command, args=self.args, env=child_env)

