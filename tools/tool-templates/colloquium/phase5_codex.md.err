   821	def _build_upstreams() -> list[Upstream]:
   822	    """All selection and validation logic lives in mcp_config.resolve_specs (tested fast,
   823	    without this file's mcp/uvicorn dependencies); this is only the Upstream construction.
   824	    A bad config is a loud startup death for launchd to report, never a half-configured
   825	    daemon."""
   826	    try:
   827	        specs = mcp_config.resolve_specs(os.environ)
   828	    except (mcp_config.ConfigError, OSError) as e:
   829	        raise SystemExit(f"{SERVER_NAME}: {e}")
   830	    return [
   831	        Upstream(name=s.name, command=s.command, args=s.args,
   832	                 require_xcode_running=s.require_xcode, prefix=s.prefix, env=s.env,
   833	                 blocks=s.blocks, maps=s.maps, from_env=s.from_env,
   834	                 expected_version=s.version)
   835	        for s in specs
   836	    ]
   837	
   838	
   839	# Phase 4 plumbing: Upstream instances announce surface changes (connect, break, an
   840	# upstream's own listChanged) and version mismatches through these hooks; build_server
   841	# registers the consumers. Module-level because Upstream predates the server object.
   842	_surface_changed_callbacks: list = []
   843	_version_mismatch_callbacks: list = []
   844	
   845	
   846	def _fire_surface_changed(reason: str) -> None:
   847	    for cb in list(_surface_changed_callbacks):
   848	        cb(reason)
   849	
   850	
   851	def _fire_version_mismatch(name: str, expected: str, found: str) -> None:
   852	    for cb in list(_version_mismatch_callbacks):
   853	        cb(name, expected, found)
