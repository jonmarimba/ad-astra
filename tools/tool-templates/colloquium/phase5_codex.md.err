   520	    # flags, and experimental_capabilities as a separate dict. Consider deriving capabilities
   521	    # entirely from server state (e.g. constructor params for list_changed) instead of
   522	    # requiring callers to assemble them at create_initialization_options() time.
   523	    def create_initialization_options(
   524	        self,
   525	        notification_options: NotificationOptions | None = None,
   526	        experimental_capabilities: dict[str, dict[str, Any]] | None = None,
   527	        extensions: dict[str, dict[str, Any]] | None = None,
   528	    ) -> InitializationOptions:
   529	        """Create initialization options from this server instance.
   530	
   531	        `extensions` advertises SEP-2133 extension support under
   532	        `ServerCapabilities.extensions`; keys are extension identifiers (e.g.
   533	        `io.modelcontextprotocol/ui`), values are per-extension settings.
   534	        Defaults to `self.extensions`, which higher layers populate.
   535	        """
   536	        return InitializationOptions(
   537	            server_name=self.name,
   538	            server_version=self.version,
   539	            title=self.title,
   540	            description=self.description,
   541	            capabilities=self.get_capabilities(
   542	                notification_options or NotificationOptions(),
   543	                experimental_capabilities or {},
   544	                extensions if extensions is not None else self.extensions,
   545	            ),
   546	            instructions=self.instructions,
   547	            website_url=self.website_url,
   548	            icons=self.icons,
   549	        )
   550	
   551	    def get_capabilities(
   552	        self,
   553	        notification_options: NotificationOptions | None = None,
   554	        experimental_capabilities: dict[str, dict[str, Any]] | None = None,
   555	        extensions: dict[str, dict[str, Any]] | None = None,
   556	        *,
   557	        protocol_version: str | None = None,
   558	    ) -> types.ServerCapabilities:
   559	        """Convert existing handlers to a ServerCapabilities object.
   560	
   561	        `extensions` is the SEP-2133 extension map (identifier -> settings)
   562	        advertised under `ServerCapabilities.extensions`; it defaults to
   563	        `self.extensions`.
   564	
   565	        `protocol_version` makes the subscription-delivered bits era-honest:
   566	        at 2026-07-28+ versions, change notifications are delivered only on
   567	        `subscriptions/listen` streams, so the `listChanged` flags and
   568	        `resources.subscribe` derive from whether that method is served -
   569	        `notification_options` and the legacy `resources/subscribe` handler
   570	        (which the modern wire cannot dispatch) are ignored. When omitted, the
   571	        handshake-era derivation applies unchanged.
   572	        """
   573	        notification_options = notification_options or NotificationOptions()
   574	        prompts_capability = None
   575	        resources_capability = None
   576	        tools_capability = None
   577	        logging_capability = None
   578	        completions_capability = None
   579	
   580	        if protocol_version in MODERN_PROTOCOL_VERSIONS:
   581	            listen_served = "subscriptions/listen" in self._request_handlers
   582	            prompts_changed = tools_changed = resources_changed = subscribe = listen_served
   583	        else:
   584	            prompts_changed = notification_options.prompts_changed
   585	            tools_changed = notification_options.tools_changed
   586	            resources_changed = notification_options.resources_changed
   587	            subscribe = "resources/subscribe" in self._request_handlers
   588	
   589	        # Set prompt capabilities if handler exists
   590	        if "prompts/list" in self._request_handlers:
   591	            prompts_capability = types.PromptsCapability(list_changed=prompts_changed)
   592	
   593	        # Set resource capabilities if handler exists
   594	        if "resources/list" in self._request_handlers:
   595	            resources_capability = types.ResourcesCapability(
   596	                subscribe=subscribe,
   597	                list_changed=resources_changed,
   598	            )
   599	
   600	        # Set tool capabilities if handler exists
   601	        if "tools/list" in self._request_handlers:
   602	            tools_capability = types.ToolsCapability(list_changed=tools_changed)
   603	
   604	        # Set logging capabilities if handler exists
   605	        if "logging/setLevel" in self._request_handlers:
   606	            logging_capability = types.LoggingCapability()
   607	
   608	        # Set completions capabilities if handler exists
   609	        if "completion/complete" in self._request_handlers:
   610	            completions_capability = types.CompletionsCapability()
   611	
   612	        capabilities = types.ServerCapabilities(
   613	            prompts=prompts_capability,
   614	            resources=resources_capability,
   615	            tools=tools_capability,
   616	            logging=logging_capability,
   617	            experimental=experimental_capabilities,
   618	            extensions=extensions if extensions is not None else (self.extensions or None),
   619	            completions=completions_capability,
   620	        )
   621	        return capabilities
   622	
   623	    @property
   624	    def server_info(self) -> types.Implementation:
   625	        """The `serverInfo` block describing this implementation.
   626	
   627	        Derived from the constructor's identity fields. An unversioned server
   628	        reports an empty `version`; the SDK never substitutes its own.
   629	        """
   630	        return types.Implementation(
   631	            name=self.name,
   632	            version=self.version,
   633	            title=self.title,
   634	            description=self.description,
   635	            website_url=self.website_url,
   636	            icons=self.icons,
   637	        )
   638	
   639	    @cached_property
   640	    def _server_info_stamp_source(self) -> dict[str, Any]:
   641	        # Identity is fixed at construction, so the dump is computed once per
   642	        # server instead of per request. Never handed out directly: nested
   643	        # values (`icons`) would alias the cache into stamped responses.
   644	        return self.server_info.model_dump(by_alias=True, mode="json", exclude_none=True)
   645	
   646	    @property
   647	    def server_info_stamp(self) -> dict[str, Any]:
   648	        """A fresh wire dump of `server_info`; callers own the returned dict.
   649	
   650	        Each access materializes a deep copy of the once-per-server dump, so
   651	        a caller mutating a stamped response can never corrupt the identity
   652	        stamped into later responses.
   653	        """
   654	        return copy.deepcopy(self._server_info_stamp_source)
   655	
   656	    async def _handle_discover(
   657	        self, ctx: ServerRequestContext[LifespanResultT], params: types.RequestParams | None
   658	    ) -> types.DiscoverResult:
   659	        """Default `server/discover` handler.
   660	
   661	        Auto-derived from server state at call time, so capabilities reflect
   662	        whatever has been registered (constructor `on_*` kwargs and later
   663	        `add_request_handler` calls). Operators can replace it wholesale via
   664	        `add_request_handler("server/discover", ...)`. Reachability for legacy
   665	        peers is decided at the boundary (`types.methods`), not here.
   666	        """
   667	        return types.DiscoverResult(
   668	            supported_versions=list(MODERN_PROTOCOL_VERSIONS),
   669	            capabilities=self.get_capabilities(protocol_version=ctx.protocol_version),
   670	            instructions=self.instructions,
   671	        )
   672	
   673	    @property
   674	    def session_manager(self) -> StreamableHTTPSessionManager:
   675	        """Get the StreamableHTTP session manager.
   676	
   677	        Raises:
   678	            RuntimeError: If called before streamable_http_app() has been called.
   679	        """
   680	        if self._session_manager is None:
   681	            raise RuntimeError(  # pragma: no cover
   682	                "Session manager can only be accessed after calling streamable_http_app(). "
   683	                "The session manager is created lazily to avoid unnecessary initialization."
   684	            )
   685	        return self._session_manager
   686	
   687	    async def run(
   688	        self,
   689	        read_stream: ReadStream[SessionMessage | Exception],
   690	        write_stream: WriteStream[SessionMessage],
   691	        initialization_options: InitializationOptions,
   692	        # When False, exceptions are returned as messages to the client.
   693	        # When True, exceptions are raised, which will cause the server to shut down
   694	        # but also make tracing exceptions much easier during testing and when using
   695	        # in-process servers.
   696	        raise_exceptions: bool = False,
   697	    ) -> None:
   698	        """Serve a single connection over the given streams until the read side closes.
   699	
   700	        Thin wrapper over `serve_dual_era_loop`: enters the server lifespan,
   701	        then drives the loop, serving the legacy handshake era and the modern
   702	        per-request-envelope era (the client's first request decides which).
   703	        Transports with their own lifespan owner (the streamable-HTTP manager)
   704	        call `serve_loop` directly instead.
   705	        """
   706	        async with self.lifespan(self) as lifespan_context:
   707	            await serve_dual_era_loop(
   708	                self,
   709	                read_stream,
   710	                write_stream,
   711	                lifespan_state=lifespan_context,
   712	                init_options=initialization_options,
   713	                raise_exceptions=raise_exceptions,
   714	            )
   715	
   716	    def streamable_http_app(
   717	        self,
   718	        *,
   719	        streamable_http_path: str = "/mcp",
   720	        json_response: bool = False,
   721	        stateless_http: bool = False,
   722	        event_store: EventStore | None = None,
   723	        retry_interval: int | None = None,
   724	        max_request_body_size: int = DEFAULT_MAX_REQUEST_BODY_SIZE,
   725	        transport_security: TransportSecuritySettings | None = None,
   726	        host: str = "127.0.0.1",
   727	        auth: AuthSettings | None = None,
   728	        token_verifier: TokenVerifier | None = None,
   729	        auth_server_provider: OAuthAuthorizationServerProvider[Any, Any, Any] | None = None,
   730	        custom_starlette_routes: list[Route] | None = None,
   731	        debug: bool = False,
   732	    ) -> Starlette:
   733	        """Return an instance of the StreamableHTTP server app."""
   734	        # Auto-enable DNS rebinding protection for localhost (IPv4 and IPv6)
   735	        if transport_security is None and host in ("127.0.0.1", "localhost", "::1"):
   736	            transport_security = TransportSecuritySettings(
   737	                enable_dns_rebinding_protection=True,
   738	                allowed_hosts=["127.0.0.1:*", "localhost:*", "[::1]:*"],
   739	                allowed_origins=["http://127.0.0.1:*", "http://localhost:*", "http://[::1]:*"],
   740	            )
   741	
   742	        session_manager = StreamableHTTPSessionManager(
   743	            app=self,
   744	            event_store=event_store,
   745	            retry_interval=retry_interval,
   746	            json_response=json_response,
   747	            stateless=stateless_http,
   748	            security_settings=transport_security,
   749	            max_request_body_size=max_request_body_size,
   750	        )
   751	        self._session_manager = session_manager
   752	
   753	        # Create the ASGI handler
   754	        streamable_http_app = StreamableHTTPASGIApp(session_manager)
   755	
   756	        # Create routes
   757	        routes: list[Route | Mount] = []
   758	        middleware: list[Middleware] = []
   759	        required_scopes: list[str] = []
   760	
   761	        # Set up auth if configured
   762	        if auth:
   763	            required_scopes = auth.required_scopes or []
   764	
   765	            # Add auth middleware if token verifier is available
   766	            if token_verifier:
   767	                middleware = [
   768	                    Middleware(
   769	                        AuthenticationMiddleware,
   770	                        backend=BearerAuthBackend(token_verifier),
   771	                    ),
   772	                    Middleware(AuthContextMiddleware),
   773	                ]
   774	
   775	            # Add auth endpoints if auth server provider is configured
   776	            if auth_server_provider:
   777	                routes.extend(
   778	                    create_auth_routes(
   779	                        provider=auth_server_provider,
   780	                        issuer_url=auth.issuer_url,
   781	                        service_documentation_url=auth.service_documentation_url,
   782	                        client_registration_options=auth.client_registration_options,
   783	                        revocation_options=auth.revocation_options,
   784	                        identity_assertion_enabled=auth.identity_assertion_enabled,
   785	                    )
   786	                )
   787	
   788	        # Set up routes with or without auth
   789	        if token_verifier:
   790	            # Determine resource metadata URL
   791	            resource_metadata_url = None
   792	            if auth and auth.resource_server_url:  # pragma: no branch
   793	                # Build compliant metadata URL for WWW-Authenticate header
   794	                resource_metadata_url = build_resource_metadata_url(auth.resource_server_url)
   795	
   796	            routes.append(
   797	                Route(
   798	                    streamable_http_path,
   799	                    endpoint=RequireAuthMiddleware(streamable_http_app, required_scopes, resource_metadata_url),
   800	                )
   801	            )
   802	        else:
   803	            # Auth is disabled, no wrapper needed
   804	            routes.append(
   805	                Route(
   806	                    streamable_http_path,
   807	                    endpoint=streamable_http_app,
   808	                )
   809	            )
   810	
   811	        # Add protected resource metadata endpoint if configured as RS
   812	        if auth and auth.resource_server_url:
   813	            routes.extend(
   814	                create_protected_resource_routes(
   815	                    resource_url=auth.resource_server_url,
   816	                    authorization_servers=[auth.issuer_url],
   817	                    scopes_supported=auth.required_scopes,
   818	                )
   819	            )
   820	
   400	        is stamped over, mirroring the request-side `clientInfo` posture (a
   401	        `null` is not a valid `Implementation`, so presence means a value). A
   402	        non-mapping `_meta` is the handler's to own, and handshake-era results
   403	        are never stamped. `result` is
   404	        pipeline-owned (`_dump_result` copies dicts; the spec-method sieve
   405	        re-dumps), but `_meta` may still be the handler's object, so the stamp
   406	        replaces it rather than writing into it. `server_info_stamp` is a
   407	        fresh dict per access, so the response never aliases server state.
   408	        """
   409	        if version not in MODERN_PROTOCOL_VERSIONS:
   410	            return result
   411	        raw_meta = result.get("_meta")
   412	        if raw_meta is None:
   413	            result["_meta"] = {SERVER_INFO_META_KEY: self.server.server_info_stamp}
   414	        elif isinstance(raw_meta, dict):
   415	            meta = cast("dict[str, Any]", raw_meta)
   416	            if meta.get(SERVER_INFO_META_KEY) is None:
   417	                result["_meta"] = {**meta, SERVER_INFO_META_KEY: self.server.server_info_stamp}
   418	        return result
