   856	def _rewrite_refs(text: str, table: dict) -> str:
   857	    """Whole-word substitution of old tool names with their PUBLISHED names — the
   858	    mechanical description pass (SPEC): every sibling description mentioning a renamed
   859	    tool goes stale at the same moment, so the rename table substitutes them all. The
   860	    table maps old bare name -> the name actually published this composition, so a
   861	    degraded alias rewrites to its prefixed fallback, never to a name that is not on
   862	    the surface. A regex is deliberate — whole-word replacement is the one job plain
   863	    scanning cannot do without reimplementing \\b (the roadmap's red case: a tool named
   864	    'read' mangling 'already'). Alternatives sorted longest-first, because Python's
   865	    alternation is first-match: with 'foo' before 'foo-bar', the phase-3 panel measured
   866	    'use foo-bar' rewriting as 'use <mapped>-bar'."""
   867	    if not text or not table:
   868	        return text
   869	    pattern = re.compile(
   870	        r"\b(" + "|".join(re.escape(k) for k in sorted(table, key=len, reverse=True)) + r")\b")
   871	    return pattern.sub(lambda m: table[m.group(1)], text)
   872	
   873	
   874	def _not_connected_result(u: "Upstream") -> types.CallToolResult:
   875	    # The retry text is derived from the upstream's own quirks: telling a client that
   876	    # Xcode is being checked and its dialog clicked, for an upstream that has nothing to
   877	    # do with Xcode, is a lie the phase-1 panel reproduced verbatim.
   878	    if u.require_xcode_running:
   879	        how = ("checking Xcode is running and clicking its approval prompt if one is "
   880	               "showing")
   881	    else:
   882	        how = "restarting its child process"
   883	    return types.CallToolResult(
   884	        content=[
   885	            types.TextContent(
   886	                type="text",
   887	                text=(
   888	                    f"{SERVER_NAME}: [{u.name}] not connected right now. This daemon "
   889	                    f"retries on its own every few seconds ({how}) — a retry shortly "
   890	                    "should work without any manual action."
   891	                ),
   892	            )
   893	        ],
   894	        is_error=True,
   895	    )
