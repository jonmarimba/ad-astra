   898	def build_server(upstreams: list[Upstream]) -> Server:
   899	    single = len(upstreams) == 1
   900	    # Prefixes are honoured VERBATIM — the single-upstream override that forced "" here
   901	    # made the daemon and the validator disagree about the same file, and made adding a
   902	    # second server silently rename the first one's entire surface.
   903	    prefix_of = {u: u.prefix for u in upstreams}
   904	    upstream_by_prefix = {prefix_of[u]: u for u in upstreams}
   905	    # Bare-name passthrough exists ONLY for the deployed env-var single mode: an env
   906	    # spec cannot carry blocks or maps, so nothing is bypassed there. A FILE config —
   907	    # even single-server, even with an empty prefix — goes through the catalogued path,
   908	    # or its sieve would filter the listing while leaving the tools callable by name
   909	    # (phase-3 panel, all three brands).
   910	    passthrough = (upstreams[0]
   911	                   if single and upstreams[0].prefix == "" and upstreams[0].from_env
   912	                   else None)
   913	
   914	    # Standing warnings (collisions, stale override descriptions) are logged once per
   915	    # distinct key: clients poll tools/list every few seconds, and a warning repeated
   916	    # forever stops being read (phase-3 panel, claude leg).
   917	    reported_warnings: set = set()
   918	
   919	    def warn_once(key, msg, *args):
   920	        if key in reported_warnings:
   921	            return
   922	        reported_warnings.add(key)
   923	        log.warning(msg, *args)
   924	
   925	    # EXPLICIT DISPATCH TABLE (increment 1.3): exposed name -> (upstream, bare upstream
   926	    # name), rebuilt every time the surface is composed in on_list_tools. Consulted
   927	    # FIRST on tools/call; the startswith() prefix walk below survives only as a
   928	    # fallback for a name that has not been listed yet in this daemon's lifetime.
   929	    # Prefix routing alone cannot survive the tool map (Phase 3): a mapped name that
   930	    # drops the prefix would be advertised and then rejected as unknown. The config
   931	    # loader already rejects the prefix sets that would make this table ambiguous
   932	    # (duplicates, prefixes of each other).
   933	    dispatch: dict[str, tuple[Upstream, str]] = {}
   934	
   935	    # Downstream notification registry (4.1). ServerSession is a per-request proxy over
   936	    # a stable per-client Connection whose standalone channel carries server-initiated
   937	    # notifications; remembering the latest proxy per connection lets the broadcaster
   938	    # reach every client that has ever made a request. The `_connection` read is the one
   939	    # private attribute this daemon touches — the SDK offers no public registry, and the
   940	    # alternative was shipping no relay at all.
   941	    downstream_sessions: dict = {}
   942	
   943	    def _remember_downstream(ctx: ServerRequestContext) -> None:
   944	        conn = getattr(ctx.session, "_connection", None)
   945	        if conn is not None:
   946	            downstream_sessions[id(conn)] = ctx.session
   947	
   948	    async def broadcast_list_changed() -> None:
   949	        for key, session in list(downstream_sessions.items()):
   950	            try:
   951	                # A client that never opens its standalone GET stream never drains this
   952	                # channel; the timeout keeps one such client from wedging the broadcast.
   953	                with anyio.move_on_after(1):
   954	                    await session.send_tool_list_changed()
   955	            except Exception:
   956	                downstream_sessions.pop(key, None)  # connection gone; forget it
   957	
   958	    async def on_list_tools(
