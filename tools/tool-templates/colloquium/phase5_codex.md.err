   248	    async def _handle_stateful_request(self, scope: Scope, receive: Receive, send: Send) -> None:
   249	        """Process request in stateful mode - maintaining session state between requests."""
   250	        request = Request(scope, receive)
   251	        request_mcp_session_id = request.headers.get(MCP_SESSION_ID_HEADER)
   252	
   253	        user = scope.get("user")
   254	        requestor = authorization_context(user) if isinstance(user, AuthenticatedUser) else None
   255	
   256	        # Existing session case
   257	        if request_mcp_session_id is not None and request_mcp_session_id in self._server_instances:
   258	            transport = self._server_instances[request_mcp_session_id]
   259	            if requestor != self._session_owners.get(request_mcp_session_id):
   260	                # A session can only be used with the credential that created
   261	                # it. Respond exactly as if the session did not exist.
   262	                logger.warning(
   263	                    "Rejecting request for session %s: credential does not match the one that created the session",
   264	                    request_mcp_session_id[:64],
   265	                )
   266	                body = JSONRPCError(
   267	                    jsonrpc="2.0", id=None, error=ErrorData(code=INVALID_REQUEST, message="Session not found")
   268	                )
   269	                response = Response(
   270	                    body.model_dump_json(by_alias=True, exclude_unset=True),
   271	                    status_code=404,
   272	                    media_type="application/json",
   273	                )
   274	                await response(scope, receive, send)
   275	                return
   276	            logger.debug("Session already exists, handling request directly")
   277	            # Push back idle deadline on activity
   278	            if transport.idle_scope is not None and self.session_idle_timeout is not None:
   279	                transport.idle_scope.deadline = anyio.current_time() + self.session_idle_timeout  # pragma: no cover
   280	            await transport.handle_request(scope, receive, send)
   281	            return
   282	
   283	        if request_mcp_session_id is None:
   284	            # New session case
   285	            logger.debug("Creating new transport")
   286	            async with self._session_creation_lock:
   287	                new_session_id = uuid4().hex
   288	                http_transport = StreamableHTTPServerTransport(
   289	                    mcp_session_id=new_session_id,
   290	                    is_json_response_enabled=self.json_response,
   291	                    event_store=self.event_store,  # May be None (no resumability)
   292	                    security_settings=self.security_settings,
   293	                    retry_interval=self.retry_interval,
   294	                )
   295	
   296	                assert http_transport.mcp_session_id is not None
   297	                if requestor is not None:
   298	                    self._session_owners[http_transport.mcp_session_id] = requestor
   299	                self._server_instances[http_transport.mcp_session_id] = http_transport
   300	                logger.info(f"Created new transport with session ID: {new_session_id}")
   301	
   302	                # Define the server runner
   303	                async def run_server(*, task_status: TaskStatus[None] = anyio.TASK_STATUS_IGNORED) -> None:
   304	                    async with http_transport.connect() as streams:
   305	                        read_stream, write_stream = streams
   306	                        task_status.started()
   307	                        try:
   308	                            # Use a cancel scope for idle timeout — when the
   309	                            # deadline passes the scope cancels the loop and
   310	                            # execution continues after the ``with`` block.
   311	                            # Incoming requests push the deadline forward.
   312	                            idle_scope = anyio.CancelScope()
   313	                            if self.session_idle_timeout is not None:
   314	                                idle_scope.deadline = anyio.current_time() + self.session_idle_timeout
   315	                                http_transport.idle_scope = idle_scope
   316	
   317	                            with idle_scope:
   318	                                # Drive via `serve_loop` (not `Server.run()`) so the
   319	                                # manager's already-entered lifespan is reused
   320	                                # rather than re-entered per session.
   321	                                await serve_loop(
   322	                                    self.app,
   323	                                    read_stream,
   324	                                    write_stream,
   325	                                    lifespan_state=self._lifespan_state,
   326	                                    session_id=http_transport.mcp_session_id,
   327	                                )
   328	
   329	                            if idle_scope.cancelled_caught:
   330	                                assert http_transport.mcp_session_id is not None
   331	                                logger.info(f"Session {http_transport.mcp_session_id} idle timeout")
   332	                                self._server_instances.pop(http_transport.mcp_session_id, None)
   333	                                self._session_owners.pop(http_transport.mcp_session_id, None)
   334	                                await http_transport.terminate()
   335	                        except Exception:
   336	                            logger.exception(f"Session {http_transport.mcp_session_id} crashed")
   337	                        finally:
   338	                            if (  # pragma: no branch
   339	                                http_transport.mcp_session_id
   340	                                and http_transport.mcp_session_id in self._server_instances
   341	                                and not http_transport.is_terminated
   342	                            ):
   343	                                logger.info(
   344	                                    "Cleaning up crashed session "
   345	                                    f"{http_transport.mcp_session_id} from active instances."
   346	                                )
   347	                                del self._server_instances[http_transport.mcp_session_id]
   348	                                self._session_owners.pop(http_transport.mcp_session_id, None)
