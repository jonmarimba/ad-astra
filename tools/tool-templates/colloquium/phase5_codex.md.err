     1	#!/usr/bin/env python3
     2	"""mcp_config — load and validate the aggregator's upstream config (_mcp_info.json).
     3	
     4	The shape is Claude Code's own — {"mcpServers": {"<name>": {"command": ..., "args": [...]}}} —
     5	because Jonathan already reads and writes that shape, and an entry can then move between this
     6	file and a real .mcp.json by copy and paste. Two additive fields belong to the wrapper:
     7	
     8	  prefix  exposed-name prefix for this upstream's tools, defaulting to "<name>__"
     9	  quirks  list of named per-upstream behaviours; today only "require_xcode" (wait for a live
    10	          Xcode before connecting). Keeping quirks per-upstream is the point: the old parser
    11	          made require-Xcode a positional boolean every upstream had to answer, so every
    12	          server was described in Xcode's terms whether or not it had anything to do with it.
    13	
    14	EVERYTHING ELSE IS REJECTED BY NAME. Claude Code's format also carries env, cwd and url; the
    15	daemon passes only command and args to the child, so accepting those fields would drop them
    16	silently and the failure would surface later, at the first call, pointing at nothing. A field
    17	we do not implement is an error naming the field and the server, at load — the same policy for
    18	keys we have never heard of. (tool-templates increment 1.1; roadmap: "red when a config with
    19	url is accepted silently".)
    20	
    21	Runs on python3 >= 3.9 (the tests use the system interpreter, which is 3.9.6 on this machine;
    22	scheduled jobs get the same one).
    23	
    24	CLI, used by test-mcp-front-config.sh and handy for a human:
    25	    mcp_config.py validate <file>     rc 0 and one line per upstream, or a named rejection
    26	Exit codes: 65 (EX_DATAERR) config invalid, 66 (EX_NOINPUT) unreadable file.
    27	"""
    28	import json
    29	import sys
    30	
    31	KNOWN_QUIRKS = frozenset({"require_xcode"})
    32	# Claude Code fields the daemon does not pass through yet. Named individually so the error
    33	# can say "unimplemented" — which invites implementing — rather than "unknown", which reads
    34	# as a typo. type/transport/headers travel with url in real .mcp.json files. env moved to
    35	# the implemented set in the Phase 1 hardening: the SDK's default child environment is a
    36	# six-variable allowlist, and Drew's server is configured through XCODEMCP_ALLOWED_FOLDERS,
    37	# so rejecting env left that mechanism unreachable.
    38	UNIMPLEMENTED_FIELDS = ("cwd", "url", "type", "transport", "headers")
    39	IMPLEMENTED_FIELDS = frozenset({"command", "args", "prefix", "quirks", "env", "block", "map",
    40	                                "version"})
    41	TOP_LEVEL_FIELDS = frozenset({"mcpServers"})
    42	
    43	
    44	class ConfigError(ValueError):
    45	    """A named rejection. str() is the full user-facing message."""
    46	
    47	
    48	class UpstreamSpec:
    49	    def __init__(self, name, command, args, prefix, quirks, env=None, blocks=None, maps=None,
    50	                 from_env=False, version=None):
    51	        # The recorded COMPATIBLE version (serverInfo.version at authoring time), and it
    52	        # is ADVISORY (SPEC: "a version mismatch warns; it never refuses"). Exact string
    53	        # comparison only — serverInfo.version is opaque, so 'newer'/'older' cannot be
    54	        # classified without a per-upstream comparator (ROADMAP 4.2).
    55	        self.version = version
    56	        # from_env marks the legacy single-upstream env contract, the ONLY spec allowed
    57	        # the daemon's bare-name passthrough: env specs cannot carry blocks or maps, so
    58	        # the passthrough cannot bypass them there. A FILE config with an empty prefix
    59	        # goes through the catalogued path like everyone else (phase-3 panel, all three
    60	        # brands: the passthrough made a file config's blocked tools callable by name).
    61	        self.from_env = from_env
    62	        self.name = name
    63	        self.command = command
    64	        self.args = args
    65	        self.prefix = prefix
    66	        self.quirks = quirks
    67	        self.env = dict(env) if env else {}
    68	        # The sieve (Phase 2): bare upstream tool name -> the stated reason it is
    69	        # withheld. Deny-list only, per Jonathan: "KISS it. I'd rather have a collision
    70	        # or a little less safety than miss features."
    71	        self.blocks = dict(blocks) if blocks else {}
    72	        # The map (Phase 3): bare upstream tool name -> MapEntry. The exposed name is
    73	        # FINAL — it replaces prefix+bare outright, because a curated surface gets its
    74	        # own vocabulary rather than the vendor's (SPEC: window_close can be exposed as
    75	        # close_current_window, a name neither server uses).
    76	        self.maps = dict(maps) if maps else {}
    77	
    78	    @property
    79	    def require_xcode(self):
    80	        return "require_xcode" in self.quirks
    81	
    82	
    83	def _parse_server(name, spec, strict=True):
    84	    if not isinstance(spec, dict):
    85	        raise ConfigError("server %r must be an object, got %s" % (name, type(spec).__name__))
    86	    for field in UNIMPLEMENTED_FIELDS:
    87	        if field in spec:
    88	            raise ConfigError(
    89	                "unimplemented field '%s' on server '%s' — the wrapper passes only command "
    90	                "and args to the child; remove it or implement it, but do not expect it to "
    91	                "take effect" % (field, name))
    92	    for field in spec:
    93	        if field not in IMPLEMENTED_FIELDS:
    94	            raise ConfigError("unknown field '%s' on server '%s'" % (field, name))
    95	
    96	    command = spec.get("command")
    97	    if not isinstance(command, str) or not command:
    98	        raise ConfigError("server '%s' has no 'command' (non-empty string required)" % name)
    99	
   100	    args = spec.get("args", [])
   101	    if not isinstance(args, list) or not all(isinstance(a, str) for a in args):
   102	        raise ConfigError("server '%s': 'args' must be a list of strings" % name)
   103	
   104	    prefix = spec.get("prefix", name + "__")
   105	    if not isinstance(prefix, str):
   106	        raise ConfigError("server '%s': 'prefix' must be a string" % name)
   107	
   108	    quirks = spec.get("quirks", [])
   109	    if not isinstance(quirks, list) or not all(isinstance(q, str) for q in quirks):
   110	        raise ConfigError("server '%s': 'quirks' must be a list of strings" % name)
   111	    for q in quirks:
   112	        if q not in KNOWN_QUIRKS:
   113	            raise ConfigError("unknown quirk '%s' on server '%s' (known: %s)"
   114	                              % (q, name, ", ".join(sorted(KNOWN_QUIRKS))))
   115	
   116	    env = spec.get("env", {})
   117	    if not isinstance(env, dict) or not all(
   118	            isinstance(k, str) and isinstance(v, str) for k, v in env.items()):
   119	        raise ConfigError("server '%s': 'env' must be an object of string values" % name)
   120	
   121	    version = spec.get("version")
   122	    if version is not None and not isinstance(version, str):
   123	        raise ConfigError("server '%s': 'version' must be a string (serverInfo.version "
   124	                          "is opaque text, not a number)" % name)
   125	
   126	    blocks = _parse_blocks(name, spec.get("block", []), strict)
   127	    maps = _parse_maps(name, spec.get("map", []), strict)
   128	    for tool in maps:
   129	        if tool in blocks:
   130	            raise ConfigError(
   131	                "'%s' on server '%s' is both blocked and mapped — a tool cannot be "
   132	                "withheld and renamed at once; pick one decision" % (tool, name))
   133	    for entry in maps.values():
   134	        if entry.exposed in blocks:
   135	            # Otherwise the call path resolves the contradiction by TIMING: before the
   136	            # first list the name is refused with the block's why, after it the map
   137	            # routes it (phase-3 panel, claude leg).
   138	            raise ConfigError(
   139	                "exposed name '%s' on server '%s' shadows a blocked tool — the same "
   140	                "name cannot be both refused and served" % (entry.exposed, name))
   141	
   142	    return UpstreamSpec(name, command, list(args), prefix, frozenset(quirks), env, blocks,
   143	                        maps, version=version)
   144	
   145	
   146	class MapEntry:
   147	    def __init__(self, exposed, why, description=None):
   148	        self.exposed = exposed          # the FINAL exposed name; replaces prefix+bare
   149	        self.why = why
   150	        self.description = description  # optional outright override; None = mechanical pass only
   151	
   152	
   153	def _parse_maps(name, raw, strict):
   154	    """Map entries: [{"tool", "name", "why", "description"?}] -> {bare tool: MapEntry}.
   155	    Same why policy as the sieve: hard error at authoring time, warn-and-apply at daemon
   156	    runtime (ROADMAP 2.2 applies to every decision field)."""
   157	    if not isinstance(raw, list) or not all(isinstance(m, dict) for m in raw):
   158	        raise ConfigError("server '%s': 'map' must be a list of objects" % name)
   159	    maps = {}
   160	    claimed = set()
   161	    for m in raw:
   162	        tool = m.get("tool")
   163	        if not isinstance(tool, str) or not tool:
   164	            raise ConfigError("map entry on server '%s' has no 'tool' name" % name)
   165	        for key in m:
   166	            if key not in ("tool", "name", "why", "description"):
   167	                raise ConfigError("unknown field '%s' in map entry for '%s' on server '%s'"
   168	                                  % (key, tool, name))
   169	        exposed = m.get("name")
   170	        if not isinstance(exposed, str) or not exposed:
   171	            raise ConfigError("map entry for '%s' on server '%s' has no 'name' (the "
   172	                              "exposed name it becomes)" % (tool, name))
   173	        why = m.get("why")
   174	        if not isinstance(why, str) or not why.strip():
   175	            msg = ("map entry for '%s' on server '%s' has no 'why' — every rename "
   176	                   "carries its stated reason, or the map outlives its cause"
   177	                   % (tool, name))
   178	            if strict:
   179	                raise ConfigError(msg)
   180	            print("mcp_config: WARNING: %s (applying the rename anyway; fix the template)"
   181	                  % msg, file=sys.stderr)
   182	            why = "(no reason recorded — fix the template)"
   183	        if tool in maps:
   184	            raise ConfigError("duplicate map entry for '%s' on server '%s'" % (tool, name))
   185	        if exposed in claimed:
   186	            raise ConfigError("exposed name '%s' is claimed twice on server '%s'"
   187	                              % (exposed, name))
   188	        claimed.add(exposed)
   189	        desc = m.get("description")
   190	        if desc is not None and not isinstance(desc, str):
   191	            raise ConfigError("map entry for '%s' on server '%s': 'description' must be "
   192	                              "a string" % (tool, name))
   193	        maps[tool] = MapEntry(exposed, why, desc)
   194	    return maps
   195	
   196	
   197	def _parse_blocks(name, raw, strict):
   198	    """Sieve entries: [{"tool": ..., "why": ...}] -> {tool: why}.
   199	
   200	    `why` is DATA and it is REQUIRED — a jsonc comment cannot be enforced or read back,
   201	    and a block without a stated cause is the entry that outlives its reason and narrows
   202	    the surface forever. Enforcement lives at AUTHORING time (strict=True, the validate
   203	    CLI): the daemon's own load (strict=False) warns and applies the block anyway,
   204	    because failing a repo at daemon startup over a sentence someone forgot in astra is
   205	    the wrong place to hurt (ROADMAP 2.2)."""
   206	    if not isinstance(raw, list) or not all(isinstance(b, dict) for b in raw):
   207	        raise ConfigError("server '%s': 'block' must be a list of objects" % name)
   208	    blocks = {}
   209	    for b in raw:
   210	        tool = b.get("tool")
   211	        if not isinstance(tool, str) or not tool:
   212	            raise ConfigError("block entry on server '%s' has no 'tool' name" % name)
   213	        for key in b:
   214	            if key not in ("tool", "why"):
   215	                raise ConfigError("unknown field '%s' in block entry for '%s' on server '%s'"
   216	                                  % (key, tool, name))
   217	        why = b.get("why")
   218	        if not isinstance(why, str) or not why.strip():
   219	            msg = ("block entry for '%s' on server '%s' has no 'why' — every withheld "
   220	                   "tool carries its stated reason, or the block outlives its cause"
   221	                   % (tool, name))
   222	            if strict:
   223	                raise ConfigError(msg)
   224	            print("mcp_config: WARNING: %s (applying the block anyway; fix the template)"
   225	                  % msg, file=sys.stderr)
   226	            why = "(no reason recorded — fix the template)"
   227	        if tool in blocks:
   228	            raise ConfigError("duplicate block entry for '%s' on server '%s'" % (tool, name))
   229	        blocks[tool] = why
   230	    return blocks
   231	
   232	
   233	def load(path, strict=True):
   234	    """-> list of UpstreamSpec, in the file's order. Raises ConfigError (bad content) or
   235	    OSError (unreadable file); the caller chooses the exit code.
   236	
   237	    strict=True is the AUTHORING contract (the validate CLI, template checks): a sieve
   238	    entry without a why is a hard error. strict=False is the DAEMON contract
   239	    (resolve_specs): the same omission warns on stderr and the block still applies,
   240	    because failing a repo at daemon startup over a sentence someone forgot in astra is
   241	    the wrong place to hurt (ROADMAP 2.2)."""
   242	    try:
   243	        raw = open(path, encoding="utf-8").read()
   244	    except OSError as e:
   245	        raise OSError("mcp_config: cannot read %s (%s)" % (path, e))
   246	    try:
   247	        cfg = json.loads(raw)
   248	    except ValueError as e:
   249	        # A jsonc human file lands here. Say so: the difference between a typo and a
   250	        # deliberate comment is the whole remedy. Same wording as mcp_tools.py on purpose.
   251	        raise ConfigError(
   252	            "%s is not strict JSON (%s). If this is the commented human-owned file, point "
   253	            "at the generated one instead — comments are only allowed there." % (path, e))
   254	    servers = cfg.get("mcpServers") if isinstance(cfg, dict) else None
   255	    if not isinstance(servers, dict) or not servers:
   256	        raise ConfigError("%s has no non-empty mcpServers object" % path)
   257	    # Same policy as per-server keys, at the root: Phase 2's sieve and Phase 3's map land
   258	    # here, and a typo'd stanza that validates silently is a limiting policy that never
   259	    # applies (all three phase-1 panel brands flagged this gap).
   260	    for key in cfg:
   261	        if key not in TOP_LEVEL_FIELDS:
   262	            raise ConfigError("unknown top-level field '%s' in %s" % (key, path))
   263	    specs = [_parse_server(name, spec, strict) for name, spec in servers.items()]
   264	    _check_prefixes(specs)
   265	    _check_exposed_names(specs)
   266	    return specs
   267	
   268	
   269	def _check_exposed_names(specs):
   270	    """Two servers claiming one exposed name is a static contradiction, caught at load.
   271	    (A mapped name colliding with another upstream's LIVE prefixed tool is dynamic — the
   272	    daemon degrades by dropping the alias at composition, per increment 3.3.)"""
   273	    owner = {}
   274	    for s in specs:
   275	        for entry in s.maps.values():
   276	            if entry.exposed in owner:
   277	                raise ConfigError(
   278	                    "exposed name '%s' is claimed by both server '%s' and server '%s'"
   279	                    % (entry.exposed, owner[entry.exposed], s.name))
   280	            owner[entry.exposed] = s.name
   281	
   282	
   283	def _check_prefixes(specs):
   284	    """The prefix set must compose into an unambiguous surface (increment 1.3).
   285	
   286	    Two upstreams sharing a prefix collide exposed names. A prefix that is a prefix of
   287	    another — 'a__' and 'a__b__' — makes routing 'a__b__tool' depend on iteration order.
   288	    An empty prefix beside another upstream exposes bare names that cannot be routed
   289	    back. All three are author mistakes; reject them at load, when the author can still
   290	    fix them, never at call time as a misroute."""
   291	    if len(specs) < 2:
   292	        return
   293	    seen = {}
   294	    for s in specs:
   295	        if s.prefix == "":
   296	            raise ConfigError(
   297	                "server '%s' has an empty prefix beside other upstreams — its bare tool "
   298	                "names could not be routed back to it" % s.name)
   299	        if s.prefix in seen:
   300	            raise ConfigError("servers '%s' and '%s' have the same prefix '%s' — their "
   301	                              "exposed names would collide" % (seen[s.prefix], s.name, s.prefix))
   302	        seen[s.prefix] = s.name
   303	    ordered = sorted(specs, key=lambda s: s.prefix)
   304	    for a, b in zip(ordered, ordered[1:]):
   305	        if b.prefix.startswith(a.prefix):
   306	            raise ConfigError(
   307	                "server '%s' prefix '%s' is a prefix of server '%s' prefix '%s' — routing "
   308	                "a name under the longer one would be order-dependent"
   309	                % (a.name, a.prefix, b.name, b.prefix))
   310	
   311	
   312	def resolve_specs(environ):
   313	    """How the daemon picks its upstreams (increment 1.2). One mechanism wins, visibly:
   314	
   315	    - XCODE_MCP_FRONT_UPSTREAMS set: HARD ERROR. The colon/comma format silently corrupted
   316	      a colon in a command path and a comma in an argument; it is replaced, not deprecated,
   317	      because a daemon half-honouring both mechanisms would hide which one won.
   318	    - XCODE_MCP_FRONT_MCP_INFO set: load that _mcp_info.json.
   319	    - neither: the deployed single-upstream env contract, unchanged — UPSTREAM_CMD
   320	      (default xcrun), UPSTREAM_ARGS (default mcpbridge), REQUIRE_XCODE (default 1),
   321	      served unprefixed exactly as before.
   322	    """
   323	    if environ.get("XCODE_MCP_FRONT_UPSTREAMS"):
   324	        raise ConfigError(
   325	            "XCODE_MCP_FRONT_UPSTREAMS has been replaced by _mcp_info.json — set "
   326	            "XCODE_MCP_FRONT_MCP_INFO=<path> instead. The colon/comma format corrupts a "
   327	            "command path containing ':' and an argument containing ',', silently.")
   328	    info = environ.get("XCODE_MCP_FRONT_MCP_INFO")
   329	    if info:
   330	        return load(info, strict=False)  # daemon runtime: warn on a missing why, still serve
   331	    quirks = frozenset({"require_xcode"}) if environ.get(
   332	        "XCODE_MCP_FRONT_REQUIRE_XCODE", "1") == "1" else frozenset()
   333	    return [UpstreamSpec(
   334	        name="default",
   335	        command=environ.get("XCODE_MCP_FRONT_UPSTREAM_CMD", "xcrun"),
   336	        args=environ.get("XCODE_MCP_FRONT_UPSTREAM_ARGS", "mcpbridge").split(),
   337	        prefix="",
   338	        quirks=quirks,
   339	        from_env=True,
   340	    )]
   341	
   342	
   343	def _print_specs(upstreams):
   344	    for u in upstreams:
   345	        quirks = ",".join(sorted(u.quirks)) or "-"
   346	        env = " env=" + ",".join(sorted(u.env)) if u.env else ""
   347	        ver = " version=" + u.version if u.version else ""
   348	        print("%s  prefix=%s  quirks=%s%s%s  %s %s" % (u.name, u.prefix, quirks, env, ver,
   349	                                                       u.command, " ".join(u.args)))
   350	        for tool, why in sorted(u.blocks.items()):
   351	            print("    blocked: %s — %s" % (tool, why))
   352	        for tool, entry in sorted(u.maps.items()):
   353	            print("    mapped:  %s -> %s — %s" % (tool, entry.exposed, entry.why))
   354	
   355	
   356	def main(argv):
   357	    import os
   358	    if len(argv) == 2 and argv[1] == "resolve":
   359	        try:
   360	            upstreams = resolve_specs(os.environ)
   361	        except ConfigError as e:
   362	            print("mcp_config: %s" % e, file=sys.stderr)
   363	            return 65
   364	        except OSError as e:
   365	            print(str(e), file=sys.stderr)
   366	            return 66
   367	        _print_specs(upstreams)
   368	        return 0
   369	    if len(argv) != 3 or argv[1] != "validate":
   370	        print("usage: mcp_config.py validate <file> | resolve", file=sys.stderr)
   371	        return 64
   372	    try:
   373	        upstreams = load(argv[2])
   374	    except ConfigError as e:
   375	        print("mcp_config: %s" % e, file=sys.stderr)
   376	        return 65
   377	    except OSError as e:
   378	        print(str(e), file=sys.stderr)
   379	        return 66
   380	    _print_specs(upstreams)
   381	    return 0
   382	
   383	
   384	if __name__ == "__main__":
   385	    sys.exit(main(sys.argv))
     1	#!/usr/bin/env bash
     2	# test-mcp-front-config.sh — the aggregator's config loader (tool-templates increment 1.1).
     3	#
     4	# The loader reads a Claude-Code-shaped _mcp_info.json — {"mcpServers": {name: {command,
     5	# args}}} plus the wrapper's additive fields (prefix, quirks) — and REJECTS anything it
     6	# would otherwise silently drop. The spec advertises the full Claude Code shape while the
     7	# daemon passes only command and args to the child, so an ignored `env` or `url` is a
     8	# late failure waiting for the first real call; rejection with the field's name is the
     9	# contract. Exercised through the module's own CLI (validate <file>), asserting by effect
    10	# on stdout, stderr and exit codes.
    11	set -uo pipefail
    12	HERE="$(cd "$(dirname "$0")" && pwd)"
    13	# shellcheck disable=SC1091
    14	. "$HERE/lib.sh"
    15	
    16	need python3 "xcode-select --install or brew install python3"
    17	LOADER="$HERE/../xcode-mcp-front/mcp_config.py"
    18	assert_file "$LOADER" "mcp_config.py exists next to the daemon"
    19	
    20	ok_cfg="$SB/good.json"
    21	cat > "$ok_cfg" <<'EOF'
    22	{
    23	  "mcpServers": {
    24	    "xcode": {"command": "xcrun", "args": ["mcpbridge"], "quirks": ["require_xcode"]},
    25	    "drews": {"command": "uvx", "args": ["drews-xcode-mcp"]}
    26	  }
    27	}
    28	EOF
    29	
    30	# --- the happy path: both upstreams parsed, prefixes defaulted from the server name ---
    31	out="$SB/good.out"
    32	python3 "$LOADER" validate "$ok_cfg" >"$out" 2>&1
    33	assert_eq "0" "$?" "a valid two-upstream config validates"
    34	assert_contains "$out" "xcode" "validate lists the first upstream"
    35	assert_contains "$out" "drews" "validate lists the second upstream"
    36	assert_contains "$out" "xcode__" "prefix defaults to the server name plus __"
    37	
    38	# --- a command path containing a colon and an argument containing a comma survive ---
    39	# Both are silently corrupted by the env-var format this file replaces (split(':') and
    40	# split(',')); the JSON path must round-trip them intact.
    41	tricky="$SB/tricky.json"
    42	cat > "$tricky" <<'EOF'
    43	{
    44	  "mcpServers": {
    45	    "odd": {"command": "/opt/we:ird/bin/serve", "args": ["--label", "a,b,c"]}
    46	  }
    47	}
    48	EOF
    49	out="$SB/tricky.out"
    50	python3 "$LOADER" validate "$tricky" >"$out" 2>&1
    51	assert_eq "0" "$?" "colon-in-command and comma-in-arg config validates"
    52	assert_contains "$out" "/opt/we:ird/bin/serve" "a colon inside the command path survives parsing"
    53	assert_contains "$out" "a,b,c" "a comma inside one argument stays one argument"
    54	
    55	# --- unimplemented Claude Code fields are REJECTED BY NAME, never ignored ---
    56	# (env graduated to implemented in the Phase 1 hardening and has its own tests below)
    57	for field in cwd url; do
    58	  bad="$SB/has-$field.json"
    59	  python3 - "$ok_cfg" "$bad" "$field" <<'PY'
    60	import json, sys
    61	cfg = json.load(open(sys.argv[1]))
    62	cfg["mcpServers"]["xcode"][sys.argv[3]] = {"A": "1"} if sys.argv[3] == "env" else "somewhere"
    63	json.dump(cfg, open(sys.argv[2], "w"))
    64	PY
    65	  red "config with '$field' is rejected naming the field and the server" 65 "unimplemented field '$field' on server 'xcode'" \
    66	    python3 "$LOADER" validate "$bad"
    67	done
    68	
    69	# --- the rest of the rejection surface, each with its own message ---
    70	printf '{"mcpServers": {}}' > "$SB/empty.json"
    71	red "empty mcpServers must fail" 65 "no non-empty mcpServers" \
    72	  python3 "$LOADER" validate "$SB/empty.json"
    73	
    74	printf '{"mcpServers": {"x": {"args": ["a"]}}}' > "$SB/nocmd.json"
    75	red "server without a command must fail naming the server" 65 "server 'x' has no 'command'" \
    76	  python3 "$LOADER" validate "$SB/nocmd.json"
    77	
    78	printf '{"mcpServers": {"x": {"command": "c", "args": "not-a-list"}}}' > "$SB/badargs.json"
    79	red "args that are not a list of strings must fail" 65 "server 'x': 'args' must be a list of strings" \
    80	  python3 "$LOADER" validate "$SB/badargs.json"
    81	
    82	printf '{"mcpServers": {"x": {"command": "c", "quirks": ["click_the_moon"]}}}' > "$SB/badquirk.json"
    83	red "unknown quirk must fail naming it" 65 "unknown quirk 'click_the_moon' on server 'x'" \
    84	  python3 "$LOADER" validate "$SB/badquirk.json"
    85	
    86	printf '{"mcpServers": {"x": {"command": "c", "transporter": "beam"}}}' > "$SB/unknownkey.json"
    87	red "an unrecognised key must fail, not be dropped" 65 "unknown field 'transporter' on server 'x'" \
    88	  python3 "$LOADER" validate "$SB/unknownkey.json"
    89	
    90	printf '{\n  // a jsonc comment\n  "mcpServers": {"x": {"command": "c"}}\n}' > "$SB/jsonc.json"
    91	red "jsonc gets the point-at-the-generated-file message, not a bare parse error" 65 "not strict JSON" \
    92	  python3 "$LOADER" validate "$SB/jsonc.json"
    93	
    94	red "missing config file must fail as a missing file" 66 "cannot read" \
    95	  python3 "$LOADER" validate "$SB/does-not-exist.json"
    96	
    97	# --- env is implemented, not rejected (Phase 1 hardening, claude-leg finding 9) ---
    98	# The daemon's own docstring names XCODEMCP_ALLOWED_FOLDERS as Drew's auth mechanism,
    99	# and the SDK's default child environment is a six-variable allowlist, so with env
   100	# rejected there was NO way to configure it at all.
   101	envcfg="$SB/envcfg.json"
   102	cat > "$envcfg" <<'EOF'
   103	{"mcpServers": {"withenv": {"command": "c", "env": {"ASTRA_TEST_VAL": "sekrit"}}}}
   104	EOF
   105	out="$SB/envcfg.out"
   106	python3 "$LOADER" validate "$envcfg" >"$out" 2>&1
   107	assert_eq "0" "$?" "a server with an env map validates"
   108	assert_contains "$out" "ASTRA_TEST_VAL" "the env keys are shown in the validation listing"
   109	
   110	printf '{"mcpServers": {"x": {"command": "c", "env": {"A": 1}}}}' > "$SB/badenv.json"
   111	red "env values that are not strings are rejected" 65 "'env' must be an object of string values" \
   112	  python3 "$LOADER" validate "$SB/badenv.json"
   113	
   114	# --- unknown TOP-LEVEL keys are rejected too (all three phase-1 panel brands) ---
   115	# Phase 2's sieve and Phase 3's map land at top level; a typo'd stanza that validates
   116	# silently is a limiting policy that never applies.
   117	printf '{"mcpServers": {"x": {"command": "c"}}, "denyLisp": []}' > "$SB/topkey.json"
   118	red "an unknown top-level key is rejected by name" 65 "unknown top-level field 'denyLisp'" \
   119	  python3 "$LOADER" validate "$SB/topkey.json"
   120	
   121	# --- the prefix set must compose into an unambiguous surface (increment 1.3) ---
   122	# Two upstreams sharing a prefix would collide exposed names; a prefix that is a prefix
   123	# of another ('a__' and 'a__b__') makes routing 'a__b__tool' order-dependent. Both are
   124	# config mistakes and both are rejected at load, when the author can still fix them —
   125	# not at call time, when they surface as a misroute.
   126	printf '{"mcpServers": {"one": {"command": "c", "prefix": "x__"}, "two": {"command": "c", "prefix": "x__"}}}' > "$SB/dup-prefix.json"
   127	red "two upstreams with the same prefix are rejected" 65 "same prefix 'x__'" \
   128	  python3 "$LOADER" validate "$SB/dup-prefix.json"
   129	
   130	printf '{"mcpServers": {"a": {"command": "c"}, "abi": {"command": "c", "prefix": "a__b__"}}}' > "$SB/nested-prefix.json"
   131	red "a prefix that is a prefix of another is rejected as order-dependent" 65 "prefix of" \
   132	  python3 "$LOADER" validate "$SB/nested-prefix.json"
   133	
   134	printf '{"mcpServers": {"a": {"command": "c", "prefix": ""}, "b": {"command": "c"}}}' > "$SB/empty-prefix.json"
   135	red "an empty prefix beside another upstream is rejected (bare names would be unroutable)" 65 "empty prefix" \
   136	  python3 "$LOADER" validate "$SB/empty-prefix.json"
   137	
   138	# --- the sieve: per-server block lists (Phase 2; deny-list only, per Jonathan) ---
   139	blockcfg="$SB/blockcfg.json"
   140	cat > "$blockcfg" <<'EOF'
   141	{"mcpServers": {"x": {"command": "c", "block": [
   142	  {"tool": "SwitchScheme", "why": "scheme switching is owned by drews per the 2026-08-31 decision"}
   143	]}}}
   144	EOF
   145	out="$SB/blockcfg.out"
   146	python3 "$LOADER" validate "$blockcfg" >"$out" 2>&1
   147	assert_eq "0" "$?" "a block entry with tool and why validates"
   148	assert_contains "$out" "SwitchScheme" "the blocked tool is shown in the validation listing"
   149	
   150	# why is DATA and it is REQUIRED at authoring time: a jsonc comment cannot be enforced,
   151	# and a block without a stated cause is the entry that outlives its reason and narrows
   152	# the surface forever (SPEC, 'the config records decisions').
   153	printf '{"mcpServers": {"x": {"command": "c", "block": [{"tool": "T"}]}}}' > "$SB/nowhy.json"
   154	red "validate rejects a block entry without a why" 65 "block entry for 'T' on server 'x' has no 'why'" \
   155	  python3 "$LOADER" validate "$SB/nowhy.json"
   156	
   157	printf '{"mcpServers": {"x": {"command": "c", "block": [{"tool": "T", "why": ""}]}}}' > "$SB/emptywhy.json"
   158	red "validate rejects an empty why the same way" 65 "block entry for 'T' on server 'x' has no 'why'" \
   159	  python3 "$LOADER" validate "$SB/emptywhy.json"
   160	
   161	printf '{"mcpServers": {"x": {"command": "c", "block": [{"why": "w"}]}}}' > "$SB/notool.json"
   162	red "a block entry without a tool name is rejected" 65 "block entry on server 'x' has no 'tool'" \
   163	  python3 "$LOADER" validate "$SB/notool.json"
   164	
   165	# At daemon RUNTIME the same missing why is a warning, not a startup death: rejecting at
   166	# load would fail the repo, at startup, for a sentence someone forgot in astra
   167	# (ROADMAP 2.2). The block still applies.
   168	out="$SB/lenient.out"
   169	env -u XCODE_MCP_FRONT_UPSTREAMS XCODE_MCP_FRONT_MCP_INFO="$SB/nowhy.json" \
   170	  python3 "$LOADER" resolve >"$out" 2>&1
   171	assert_eq "0" "$?" "resolve accepts the missing-why config instead of failing the repo at startup"
   172	assert_contains "$out" "no 'why'" "and it says out loud what the authoring check would have rejected"
   173	
   174	# --- version recording (Phase 4.2): advisory, exact-string, optional ---
   175	printf '{"mcpServers": {"x": {"command": "c", "version": "24952"}}}' > "$SB/ver.json"
   176	out="$SB/ver.out"
   177	python3 "$LOADER" validate "$SB/ver.json" >"$out" 2>&1
   178	assert_eq "0" "$?" "a recorded compatible version validates"
   179	assert_contains "$out" "24952" "the recorded version is shown in the listing"
   180	printf '{"mcpServers": {"x": {"command": "c", "version": 24952}}}' > "$SB/badver.json"
   181	red "a non-string version is rejected" 65 "'version' must be a string" \
   182	  python3 "$LOADER" validate "$SB/badver.json"
   183	
   184	# --- the map: source-qualified renames (Phase 3) ---
   185	mapcfg="$SB/mapcfg.json"
   186	cat > "$mapcfg" <<'EOF'
   187	{"mcpServers": {"x": {"command": "c", "map": [
   188	  {"tool": "window_close", "name": "close_current_window", "why": "surface vocabulary: neither vendor's name reads right in the aggregate"}
   189	]}}}
   190	EOF
   191	out="$SB/mapcfg.out"
   192	python3 "$LOADER" validate "$mapcfg" >"$out" 2>&1
   193	assert_eq "0" "$?" "a map entry with tool, name and why validates"
   194	assert_contains "$out" "close_current_window" "the exposed name is shown in the listing"
   195	
   196	printf '{"mcpServers": {"x": {"command": "c", "map": [{"tool": "t", "name": "n"}]}}}' > "$SB/mapnowhy.json"
   197	red "validate rejects a map entry without a why" 65 "map entry for 't' on server 'x' has no 'why'" \
   198	  python3 "$LOADER" validate "$SB/mapnowhy.json"
   199	
   200	printf '{"mcpServers": {"x": {"command": "c", "map": [{"tool": "t", "why": "w"}]}}}' > "$SB/mapnoname.json"
   201	red "a map entry without an exposed name is rejected" 65 "map entry for 't' on server 'x' has no 'name'" \
   202	  python3 "$LOADER" validate "$SB/mapnoname.json"
   203	
   204	printf '{"mcpServers": {"x": {"command": "c", "map": [{"tool": "a", "name": "same", "why": "w"}, {"tool": "b", "name": "same", "why": "w"}]}}}' > "$SB/mapdup.json"
   205	red "two map entries claiming one exposed name are rejected" 65 "exposed name 'same' is claimed twice" \
   206	  python3 "$LOADER" validate "$SB/mapdup.json"
   207	
   208	printf '{"mcpServers": {"x": {"command": "c", "block": [{"tool": "t", "why": "w"}], "map": [{"tool": "t", "name": "n", "why": "w"}]}}}' > "$SB/mapblock.json"
   209	red "a tool both blocked and renamed is a contradiction, rejected" 65 "'t' on server 'x' is both blocked and mapped" \
   210	  python3 "$LOADER" validate "$SB/mapblock.json"
   211	
   212	printf '{"mcpServers": {"one": {"command": "c", "map": [{"tool": "a", "name": "shared", "why": "w"}]}, "two": {"command": "c", "map": [{"tool": "b", "name": "shared", "why": "w"}]}}}' > "$SB/mapxserver.json"
   213	red "two SERVERS claiming one exposed name are rejected at load" 65 "exposed name 'shared' is claimed by both" \
   214	  python3 "$LOADER" validate "$SB/mapxserver.json"
   215	
   216	# An exposed name equal to a BLOCKED tool on the same server is a contradiction the
   217	# call path would otherwise resolve by timing: before the first list the name would be
   218	# refused with the block's why; after it, it would route (phase-3 panel, claude leg).
   219	printf '{"mcpServers": {"x": {"command": "c", "block": [{"tool": "a", "why": "w"}], "map": [{"tool": "z", "name": "a", "why": "w"}]}}}' > "$SB/mapshadow.json"
   220	red "an exposed name shadowing a blocked tool on the same server is rejected" 65 "exposed name 'a' on server 'x' shadows a blocked tool" \
   221	  python3 "$LOADER" validate "$SB/mapshadow.json"
   222	
   223	# --- resolve: how the daemon picks its upstreams (increment 1.2) ---
   224	# The colon/comma env format is REPLACED, not deprecated: a set XCODE_MCP_FRONT_UPSTREAMS
   225	# is a hard error pointing at the file, because the old parser silently corrupted a colon
   226	# in a command path and a comma in an argument, and a daemon that half-honoured both
   227	# mechanisms would hide which one won.
   228	out="$SB/resolve-file.out"
   229	env -u XCODE_MCP_FRONT_UPSTREAMS XCODE_MCP_FRONT_MCP_INFO="$ok_cfg" \
   230	  python3 "$LOADER" resolve >"$out" 2>&1
   231	assert_eq "0" "$?" "resolve honours XCODE_MCP_FRONT_MCP_INFO"
   232	assert_contains "$out" "xcode__" "resolve keeps the xcode__ prefix from the file"
   233	assert_contains "$out" "drews__" "resolve keeps the drews__ prefix from the file"
   234	
   235	red "a set XCODE_MCP_FRONT_UPSTREAMS is refused, pointing at the file" 65 "replaced by _mcp_info.json" \
   236	  env XCODE_MCP_FRONT_UPSTREAMS="xcode:1:xcrun:mcpbridge" python3 "$LOADER" resolve
   237	
   238	red "UPSTREAMS set alongside the file is still refused — one mechanism must win visibly" 65 "replaced by _mcp_info.json" \
   239	  env XCODE_MCP_FRONT_UPSTREAMS="x:1:c" XCODE_MCP_FRONT_MCP_INFO="$ok_cfg" python3 "$LOADER" resolve
   240	
   241	# With neither set, the deployed single-upstream daemon's env contract is unchanged:
   242	# default xcrun mcpbridge, Xcode required, served unprefixed.
   243	out="$SB/resolve-single.out"
   244	env -u XCODE_MCP_FRONT_UPSTREAMS -u XCODE_MCP_FRONT_MCP_INFO \
   245	  python3 "$LOADER" resolve >"$out" 2>&1
   246	assert_eq "0" "$?" "resolve with no env keeps the single-upstream default"
   247	assert_contains "$out" "xcrun mcpbridge" "single-upstream default is still xcrun mcpbridge"
   248	assert_contains "$out" "require_xcode" "single-upstream default still waits for Xcode"
   249	
   250	out="$SB/resolve-drews.out"
   251	env -u XCODE_MCP_FRONT_UPSTREAMS -u XCODE_MCP_FRONT_MCP_INFO \
   252	  XCODE_MCP_FRONT_UPSTREAM_CMD=uvx XCODE_MCP_FRONT_UPSTREAM_ARGS=drews-xcode-mcp \
   253	  XCODE_MCP_FRONT_REQUIRE_XCODE=0 python3 "$LOADER" resolve >"$out" 2>&1
   254	assert_eq "0" "$?" "single-upstream env overrides still resolve"
   255	assert_contains "$out" "uvx drews-xcode-mcp" "single-upstream CMD/ARGS overrides survive"
   256	assert_not_contains "$out" "require_xcode" "REQUIRE_XCODE=0 drops the quirk"
   257	
   258	finish

