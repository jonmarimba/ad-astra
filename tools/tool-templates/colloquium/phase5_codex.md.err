  1109	    async def _refresh_upstream_dispatch(u: Upstream) -> bool:
  1110	        """Re-list ONE upstream and fold its tools into the dispatch table. Returns
  1111	        False when the upstream is unavailable."""
  1112	        result = await u.list_tools(None)
