index 38507af..74b65a9 100755
--- a/tools/tests/test-mcp-front-daemon.sh
+++ b/tools/tests/test-mcp-front-daemon.sh
@@ -29,8 +29,9 @@ cat > "$SB/_mcp_info.json" <<EOF
