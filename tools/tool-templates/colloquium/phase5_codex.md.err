   266	mcp_call tools/call '{"name":"alpha__enoexist","arguments":{}}' > "$SB/enoexist.out"
   267	assert_contains "$SB/enoexist.out" "does not currently offer" \
   268	  "a prefixed-but-unknown tool is refused by the daemon, not forwarded on faith"
   269	
   270	# --- increment 1.4: a dead upstream must not blank the others, and connected-but-empty
   271	# --- is not the same thing as disconnected ---
   272	# All three colloquium brands found this independently: on_list_tools served ZERO tools
   273	# for every upstream when any one was missing, so during an Xcode reconnect Drew's tools
   274	# — which need no Xcode — vanished too. gamma's command dies instantly (never connects);
   275	# delta connects fine and genuinely has zero tools. alpha must keep serving through both.
   276	cat > "$SB/_mcp_degraded.json" <<EOF
   277	{
   278	  "mcpServers": {
   279	    "alpha": {"command": "python3", "args": ["$STUB", "--name", "alpha", "--tool", "ping=alpha-pong"]},
   280	    "gamma": {"command": "python3", "args": ["-c", "import sys; sys.exit(1)"], "block": [{"tool": "anything", "why": "a block on a DEAD upstream must be inert — the sieve applies after the availability check"}]},
   281	    "delta": {"command": "python3", "args": ["$STUB", "--name", "delta"]},
   282	    "looper": {"command": "python3", "args": ["$STUB", "--name", "looper", "--page-loop", "--tool", "trap=x"]}
   283	  }
   284	}
   285	EOF
