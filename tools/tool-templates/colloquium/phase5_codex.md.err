    72	class SubscriptionBus(Protocol):
    73	    """Fan-out seam between event publishers and open listen streams.
    74	
    75	    Implement this over an external pub/sub backend (Redis, NATS, ...) to fan
    76	    events out across replicas: `publish` forwards the event to the backend,
    77	    and each replica's bus invokes its local listeners for events arriving
    78	    from the backend. The same instance can be shared across servers.
    79	
    80	    `publish` is async so backend implementations can do network I/O.
    81	    `subscribe` is synchronous local registration. Listeners are synchronous,
    82	    must not raise, and are invoked on the server's event loop.
    83	    """
    84	
    85	    async def publish(self, event: ServerEvent) -> None:
    86	        """Deliver `event` to every subscribed listener."""
    87	        ...
    88	
    89	    def subscribe(self, listener: Callable[[ServerEvent], None]) -> Callable[[], None]:
    90	        """Register `listener` and return an idempotent unsubscribe callable."""
    91	        ...
    92	
    93	
    94	class InMemorySubscriptionBus:
    95	    """In-process `SubscriptionBus`: synchronous fan-out to listeners in subscription order."""
    96	
    97	    def __init__(self) -> None:
    98	        # Keyed by a per-subscription token so the same callable can be
    99	        # registered more than once (bound methods compare equal).
   100	        self._listeners: dict[object, Callable[[ServerEvent], None]] = {}
   101	
   102	    async def publish(self, event: ServerEvent) -> None:
   103	        """Deliver `event` to every subscribed listener.
   104	
   105	        A raising listener is logged and skipped: one bad listener must not
   106	        starve the others or fail the publishing handler. Ends with a
   107	        checkpoint so a burst of publishes from one task lets listen streams
   108	        drain between events instead of overflowing their buffers unread.
   109	        """
   110	        for listener in list(self._listeners.values()):
   111	            try:
   112	                listener(event)
   113	            except Exception:  # fan-out boundary: isolate listeners from each other
   114	                logger.exception("subscription listener raised; continuing")
   115	        await anyio.lowlevel.checkpoint()
   116	
   117	    def subscribe(self, listener: Callable[[ServerEvent], None]) -> Callable[[], None]:
   118	        """Register `listener` and return an idempotent unsubscribe callable."""
   119	        token = object()
   120	        self._listeners[token] = listener
   121	
   122	        def unsubscribe() -> None:
   123	            self._listeners.pop(token, None)
   124	
   125	        return unsubscribe
   126	
   127	
   128	def _safe_unsubscribe(unsubscribe: Callable[[], None]) -> None:
   129	    """Run a bus's unsubscribe callable, isolating the stream from it raising.
   130	
   131	    The callable comes from a custom `SubscriptionBus`; a raising one is
   132	    logged and skipped so it cannot stop the stream's own cleanup from
   133	    releasing its subscription slot.
   134	    """
   135	    try:
   136	        unsubscribe()
   137	    except Exception:  # fan-out boundary: a raising bus must not skip stream cleanup
   138	        logger.exception("bus unsubscribe raised; continuing stream cleanup")
   139	
   140	
   141	def _honored_subset(requested: SubscriptionFilter) -> SubscriptionFilter:
   142	    """The subset of `requested` the server will deliver, for the ack.
   143	
   144	    Every requested kind is honored - whether an event kind ever fires
   145	    depends on what the server publishes, exactly as a subscription to a
   146	    nonexistent resource URI is honored and never fires. Non-true flags and
   147	    an empty URI list are dropped rather than echoed as falsy values.
   148	    """
   149	    return SubscriptionFilter(
   150	        tools_list_changed=True if requested.tools_list_changed else None,
   151	        prompts_list_changed=True if requested.prompts_list_changed else None,
   152	        resources_list_changed=True if requested.resources_list_changed else None,
   153	        resource_subscriptions=list(requested.resource_subscriptions) if requested.resource_subscriptions else None,
   154	    )
   155	
   156	
   157	class ListenHandler:
   158	    """Serves `subscriptions/listen`: one call is one subscription stream.
   159	
   160	    Register on a lowlevel `Server` via `on_subscriptions_listen=` (or
   161	    `add_request_handler`); `MCPServer` does so automatically. Each call
   162	    acknowledges the honored filter first, then forwards matching bus events
   163	    onto the request's response stream until the client disconnects (which
   164	    cancels the handler; the stream just ends, per the spec's abrupt-close
   165	    contract) or `close` ends all streams gracefully.
   166	
   167	    Served on any transport that can carry the request's response stream:
   168	    streamable HTTP's SSE mode, or a duplex stream pair such as stdio.
   169	
   170	    `max_subscriptions` bounds concurrent streams (further listen requests are
   171	    rejected with `INTERNAL_ERROR`, before the ack). `max_buffered_events`
   172	    bounds each stream's event backlog: a stream whose client has stopped
   173	    reading is ended at the cap (the client re-listens and refetches - there
   174	    is no replay, so ending the stream loses nothing the backlog wasn't
   175	    already losing).
   176	    """
