  1279	    # VERSION MISMATCH consumer (4.2). In-band: instructions are re-read at every new
  1280	    # session's initialize, so updating them reaches each fresh model with no new
  1281	    # mechanism. Human: one log line per distinct (upstream, expected, found), persisted
  1282	    # so a launchd restart does not re-raise it — the 2026-08-30 lesson is that a
  1283	    # warning per reconnect tick is twenty-one modals in an evening.
  1284	    base_instructions = instructions
  1285	    mismatch_notes: dict = {}
  1286	    persisted_path = os.path.join(
  1287	        os.environ.get("XCODE_MCP_FRONT_HOME", os.path.expanduser("~/.xcode-mcp-front")),
  1288	        "version-mismatches.json")
  1289	    try:
  1290	        with open(persisted_path, encoding="utf-8") as f:
  1291	            seen_mismatches = json.load(f)
  1292	    except (OSError, ValueError):
  1293	        seen_mismatches = {}
  1294	
  1295	    def _on_version_mismatch(name: str, expected: str, found: str) -> None:
  1296	        mismatch_notes[name] = (
  1297	            f"NOTE: upstream '{name}' was verified against version '{expected}' but is "
  1298	            f"running '{found}'. Blocks and renames may reference tools that moved — "
  1299	            f"consider having a human run the collision comparison "
  1300	            f"(tools/tool-templates/mcp_tools.py compare) against the new version.")
  1301	        server.instructions = base_instructions + "\n\n" + "\n".join(
  1302	            mismatch_notes[k] for k in sorted(mismatch_notes))
  1303	        key = f"{name}:{expected}:{found}"
  1304	        if key in seen_mismatches:
  1305	            return
  1306	        seen_mismatches[key] = True
  1307	        log.warning("[%s] expected version '%s' but the upstream reports '%s' — serving "
  1308	                    "anyway (a mismatch warns, never refuses). Recorded in %s so this "
  1309	                    "warns once.", name, expected, found, persisted_path)
  1310	        try:
  1311	            os.makedirs(os.path.dirname(persisted_path), exist_ok=True)
  1312	            with open(persisted_path, "w", encoding="utf-8") as f:
  1313	                json.dump(seen_mismatches, f, indent=2, sort_keys=True)
  1314	        except OSError as e:
  1315	            log.warning("could not persist the version-mismatch record: %s", e)
  1316	
  1317	    _version_mismatch_callbacks.append(_on_version_mismatch)
  1318	
  1319	    return server
  1320	
  1321	
  1322	@contextlib.asynccontextmanager
  1323	async def _lifespan(app: Server, upstreams: list[Upstream], broadcast):
  1324	    async with anyio.create_task_group() as tg:
  1325	        # The notification relay's downstream half (4.1): surface-change events from the
  1326	        # Upstreams (connect, break, upstream listChanged) wake this task, which
  1327	        # debounces a burst and pushes tools/list_changed to every known client.
  1328	        changed = {"event": anyio.Event()}
  1329	
  1330	        def _wake(reason: str) -> None:
  1331	            changed["event"].set()
  1332	
  1333	        _surface_changed_callbacks.append(_wake)
  1334	
  1335	        async def _broadcaster() -> None:
  1336	            while True:
  1337	                await changed["event"].wait()
  1338	                changed["event"] = anyio.Event()
  1339	                await anyio.sleep(0.5)  # a reconnect burst becomes one notification
  1340	                await broadcast()
  1341	
  1342	        for u in upstreams:
  1343	            tg.start_soon(u.connection_manager)
  1344	            tg.start_soon(u.stall_watchdog)
  1345	        tg.start_soon(_broadcaster)
  1346	        try:
  1347	            yield {}
  1348	        finally:
  1349	            _surface_changed_callbacks.remove(_wake)
  1350	            tg.cancel_scope.cancel()
  1351	
  1352	
  1353	def main() -> None:
  1354	    upstreams = _build_upstreams()
  1355	    server = build_server(upstreams)
  1356	    app = server.streamable_http_app(host=HOST)
  1357	    log.info("listening on http://%s:%s/mcp (upstreams: %s)", HOST, PORT, ", ".join(u.name for u in upstreams))
  1358	    uvicorn.run(app, host=HOST, port=PORT, log_level="info")
  1359	
  1360	
  1361	if __name__ == "__main__":
  1362	    main()

