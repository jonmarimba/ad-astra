   326	assert_contains "$SB/gamma.out" "[gamma] not connected right now" \
   327	  "a call to the dead upstream names IT as the unavailable one"
   328	assert_contains "$SB/gamma.out" '"isError":true' "and is an error result, not a silent success"
   329	
