   340	grep "WITHOUT unavailable" "$SB/daemon2.log" > "$SB/unavail-lines" || : > "$SB/unavail-lines"
   341	assert_contains "$SB/unavail-lines" "gamma" "the unavailable warning names the dead upstream"
