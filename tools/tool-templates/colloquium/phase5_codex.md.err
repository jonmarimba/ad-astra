     1	#!/bin/bash
     2	# repo-daemon-install.sh — install an AUTONOMOUS per-repo copy of the MCP front daemon.
     3	#
     4	# Phase 5 of the tool-template roadmap, per Jonathan's design (2026-08-31), which
     5	# overrides the panel's shared-broker recommendation: "I'd strongly prefer each install
     6	# in a given repo to be autonomous. That way, one thing failing doesn't fuck all my
     7	# projects at once." Each repo gets its own clone of the wrapper under .astra/mcp-front
     8	# — APFS clones (cp -c), like a gentleman — its own launchd plist, and a run script
     9	# that resolves port collisions at launch (see repo-daemon-run.sh).
    10	#
    11	# What this does NOT automate: TCC. A config whose upstream carries the require_xcode
    12	# quirk needs the approval clicker, which needs a wrapped .app with Automation grants a
    13	# human adds in System Settings (see wrap-in-app). Non-Xcode upstreams need none of
    14	# that and run as installed here. The plist is GENERATED but not loaded; load it with:
    15	#   launchctl bootstrap gui/$(id -u) <repo>/.astra/mcp-front/launchd.plist
    16	#
    17	# Usage: repo-daemon-install.sh --into <repo>
    18	set -uo pipefail
    19	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
    20	HERE="$(cd "$(dirname "$0")" && pwd)"
    21	
    22	REPO=""
    23	while [ $# -gt 0 ]; do
    24	  case "$1" in
    25	    --into) REPO="${2:-}"; shift 2 ;;
    26	    *) echo "repo-daemon-install: unknown flag '$1'" >&2; exit 64 ;;
    27	  esac
    28	done
    29	[ -n "$REPO" ] || { echo "usage: repo-daemon-install.sh --into <repo>" >&2; exit 64; }
    30	REPO="$(cd "$REPO" 2>/dev/null && pwd)" || { echo "repo-daemon-install: no such repo directory" >&2; exit 66; }
    31	
    32	# The astra cardinal rule: never global. A per-repo daemon belongs in a repo.
    33	case "$REPO" in
    34	  "$HOME"|"$HOME/"|"$HOME/.claude"*|"$HOME/.agents"*|"$HOME/.config"*|"$HOME/Library"*)
    35	    echo "repo-daemon-install: refusing target '$REPO' — per-repo means a repo, never HOME or a global config dir" >&2
    36	    exit 64 ;;
    37	esac
    38	[ -d "$REPO/.git" ] || { echo "repo-daemon-install: '$REPO' is not a git repo (no .git)" >&2; exit 65; }
    39	
    40	DEST="$REPO/.astra/mcp-front"
    41	mkdir -p "$DEST"
    42	
    43	clone() { # APFS clone with plain-copy fallback for non-APFS filesystems
    44	  cp -c "$1" "$2" 2>/dev/null || cp "$1" "$2"
    45	}
    46	clone "$HERE/daemon.py"           "$DEST/daemon.py"
    47	clone "$HERE/mcp_config.py"       "$DEST/mcp_config.py"
    48	clone "$HERE/repo-daemon-run.sh"  "$DEST/run.sh"
    49	chmod +x "$DEST/run.sh"
    50	
    51	# The machine-owned config placeholder (mogenerator convention: the template layer
    52	# overwrites this on every update; the sibling mcp_info.json stays human-owned). The
    53	# placeholder is deliberately INVALID-to-serve — a daemon launched before a template
    54	# writes real upstreams should die loudly at startup, not serve an empty surface.
    55	if [ ! -f "$DEST/_mcp_info.json" ]; then
    56	  printf '{"mcpServers": {}}\n' > "$DEST/_mcp_info.json"
    57	fi
    58	
    59	LABEL="com.jonathansaggau.astra-mcp-front.$(printf '%s' "$REPO" | cksum | cut -d' ' -f1)"
    60	# KeepAlive is BARE true on purpose: {SuccessfulExit:false} reads a clean
    61	# exit-on-EADDRINUSE as "finished on purpose" and the daemon silently stays dead
    62	# (found live 2026-08-14, asserted ever since in test-xcode-mcp-front.sh).
    63	cat > "$DEST/launchd.plist" <<PLIST
    64	<?xml version="1.0" encoding="UTF-8"?>
    65	<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    66	<plist version="1.0">
    67	<dict>
    68	  <key>Label</key><string>$LABEL</string>
    69	  <key>ProgramArguments</key>
    70	  <array>
    71	    <string>/bin/bash</string>
    72	    <string>$DEST/run.sh</string>
    73	  </array>
    74	  <key>RunAtLoad</key><true/>
    75	  <key>KeepAlive</key><true/>
    76	  <key>StandardOutPath</key><string>$DEST/daemon.log</string>
    77	  <key>StandardErrorPath</key><string>$DEST/daemon.log</string>
    78	</dict>
    79	</plist>
    80	PLIST
    81	
    82	echo "repo-daemon-install: installed into $DEST (label $LABEL)"
    83	echo "  next: have the template write $DEST/_mcp_info.json, then"
    84	echo "  launchctl bootstrap gui/\$(id -u) $DEST/launchd.plist"
    85	exit 0
     1	#!/bin/bash
     2	# repo-daemon-run.sh — launch THIS repo's autonomous MCP front daemon.
     3	#
     4	# Installed into <repo>/.astra/mcp-front/run.sh by repo-daemon-install.sh; everything is
     5	# derived from its own location, so the same file works in every repo (portability
     6	# doctrine: no hardcoded paths, no baked-in identity).
     7	#
     8	# PORT POLICY, per Jonathan's Phase 5 answer ("detect port collisions and fix them at
     9	# launch"): the BASE port is deterministic from the repo path, so a repo keeps the same
    10	# port across launches and .mcp.json stays put. At launch: first self-preempt any stale
    11	# copy of OUR OWN daemon (matched by this exact daemon.py path — never anything else),
    12	# then step past any FOREIGN listener one port at a time. A foreign listener is left
    13	# alone; it is somebody's live service. The resolved port is written to ./port and into
    14	# the repo's .mcp.json, which is how clients find the daemon.
    15	set -uo pipefail
    16	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
    17	HERE="$(cd "$(dirname "$0")" && pwd)"                 # <repo>/.astra/mcp-front
    18	REPO_ROOT="$(cd "$HERE/../.." && pwd)"
    19	
    20	BASE_PORT=$(( 21000 + $(printf '%s' "$REPO_ROOT" | cksum | cut -d' ' -f1) % 3000 ))
    21	if [ "${1:-}" = "--print-port" ]; then
    22	  echo "$BASE_PORT"
    23	  exit 0
    24	fi
    25	
    26	# Self-preempt: only a process running THIS repo's daemon.py. Matching the full path
    27	# keeps this from ever touching another repo's daemon or an unrelated python.
    28	for pid in $(pgrep -f "$HERE/daemon.py" 2>/dev/null); do
    29	  [ "$pid" = "$$" ] && continue
    30	  echo "repo-daemon: preempting stale daemon (pid $pid) for $REPO_ROOT"
    31	  kill "$pid" 2>/dev/null || true
    32	done
    33	sleep 1
    34	
    35	PORT=$BASE_PORT
    36	while lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; do
    37	  PORT=$((PORT + 1))
    38	done
    39	echo "$PORT" > "$HERE/port"
    40	
    41	# Record the resolved endpoint where clients look. jq writes beside-and-rename so a
    42	# crash mid-write cannot corrupt the repo's .mcp.json.
    43	MCP_JSON="$REPO_ROOT/.mcp.json"
    44	[ -f "$MCP_JSON" ] || printf '{"mcpServers": {}}\n' > "$MCP_JSON"
    45	jq --arg url "http://127.0.0.1:$PORT/mcp" \
    46	   '.mcpServers["astra-front"] = {"type": "http", "url": $url}' \
    47	   "$MCP_JSON" > "$MCP_JSON.tmp" && mv "$MCP_JSON.tmp" "$MCP_JSON"
    48	
    49	export XCODE_MCP_FRONT_MCP_INFO="$HERE/_mcp_info.json"
    50	export XCODE_MCP_FRONT_PORT="$PORT"
    51	export XCODE_MCP_FRONT_HOME="$HERE/home"
    52	export XCODE_MCP_FRONT_SERVER_NAME="astra-front-$(basename "$REPO_ROOT")"
    53	mkdir -p "$XCODE_MCP_FRONT_HOME"
    54	
    55	exec uv run --script "$HERE/daemon.py"
     1	#!/usr/bin/env bash
     2	# test-mcp-front-repo-daemon.sh — Phase 5: per-repo autonomous daemons.
     3	#
     4	# Jonathan's design, overriding the panel's shared-broker answer: "I'd strongly prefer
     5	# each install in a given repo to be autonomous. That way, one thing failing doesn't
     6	# fuck all my projects at once." A repo gets its own APFS-cloned copy of the wrapper
     7	# under .astra/mcp-front, its own launchd-able run script, a DETERMINISTIC port derived
     8	# from the repo path, and collision resolution at launch. The chosen port lands in the
     9	# repo's .mcp.json, which is how clients find the daemon.
    10	set -uo pipefail
    11	HERE="$(cd "$(dirname "$0")" && pwd)"
    12	# shellcheck disable=SC1091
    13	. "$HERE/lib.sh"
    14	
    15	need uv "brew install uv"
    16	need jq "brew install jq"
    17	need python3 "xcode-select --install"
    18	
    19	INSTALLER="$HERE/../xcode-mcp-front/repo-daemon-install.sh"
    20	STUB="$HERE/stub_mcp_server.py"
    21	
    22	REPO="$SB/fakerepo"
    23	mkdir -p "$REPO"
    24	git -C "$REPO" init -q
    25	
    26	# --- the installer places an autonomous copy under .astra/mcp-front ---
    27	assert_rc 0 "installer succeeds into a scratch repo" bash "$INSTALLER" --into "$REPO"
    28	assert_file "$REPO/.astra/mcp-front/daemon.py" "daemon.py is cloned into the repo"
    29	assert_file "$REPO/.astra/mcp-front/mcp_config.py" "mcp_config.py travels with it"
    30	assert_file "$REPO/.astra/mcp-front/run.sh" "the per-repo run script is installed"
    31	assert_file "$REPO/.astra/mcp-front/launchd.plist" "a launchd plist is generated"
    32	plutil -lint "$REPO/.astra/mcp-front/launchd.plist" >/dev/null 2>&1 \
    33	  && pass "the generated plist parses" || fail "the generated plist does not parse"
    34	assert_contains "$REPO/.astra/mcp-front/launchd.plist" "<true/>" \
    35	  "KeepAlive is bare true (the SuccessfulExit variant silently stays dead on EADDRINUSE)"
    36	
    37	red "the installer refuses a target under HOME itself" 64 "refusing" \
    38	  bash "$INSTALLER" --into "$HOME"
    39	
    40	# --- launch: deterministic port, recorded in .mcp.json, real daemon serving ---
    41	cat > "$REPO/.astra/mcp-front/_mcp_info.json" <<EOF
    42	{"mcpServers": {"alpha": {"command": "python3", "args": ["$STUB", "--name", "alpha", "--tool", "ping=repo-pong"]}}}
    43	EOF
    44	bash "$REPO/.astra/mcp-front/run.sh" >"$SB/run1.log" 2>&1 &
    45	RPID=$!
    46	trap 'kill "$RPID" "$RPID2" 2>/dev/null; wait "$RPID" "$RPID2" 2>/dev/null; kill "$OCCUPY" 2>/dev/null; rm -rf "$SB"' EXIT
    47	waited=0
    48	until [ -f "$REPO/.astra/mcp-front/port" ] || [ "$waited" -ge 10 ]; do sleep 1; waited=$((waited+1)); done
    49	assert_file "$REPO/.astra/mcp-front/port" "the launcher records its chosen port"
    50	PORT="$(cat "$REPO/.astra/mcp-front/port" 2>/dev/null)"
    51	assert_contains "$REPO/.mcp.json" "127.0.0.1:$PORT/mcp" \
    52	  ".mcp.json points at the chosen port — clients find the daemon through it"
    53	
    54	mcp_probe() { # <port> -> tools/list body
    55	  local port="$1" init_resp session
    56	  init_resp="$(curl -s --max-time 10 -D - -X POST "http://127.0.0.1:$port/mcp" \
    57	    -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
    58	    -H "MCP-Protocol-Version: 2025-06-18" \
    59	    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"repo-test","version":"0"}}}')"
    60	  session="$(printf '%s' "$init_resp" | grep -i "mcp-session-id" | tr -d '\r' | awk '{print $2}')"
    61	  [ -n "$session" ] || return 1
    62	  curl -s --max-time 10 -X POST "http://127.0.0.1:$port/mcp" \
    63	    -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
    64	    -H "MCP-Protocol-Version: 2025-06-18" -H "Mcp-Session-Id: $session" \
    65	    -d '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}'
    66	}
    67	waited=0; body=""
    68	until [ "$waited" -ge 15 ]; do
    69	  body="$(mcp_probe "$PORT" 2>/dev/null || true)"
    70	  case "$body" in *alpha__ping*) break ;; esac
    71	  sleep 1; waited=$((waited+1))
    72	done
    73	printf '%s' "$body" > "$SB/repo-list.out"
    74	assert_contains "$SB/repo-list.out" "alpha__ping" "the per-repo daemon serves its own configured surface"
    75	
    76	# --- a SECOND repo resolves the port collision at launch and both serve ---
    77	# Same repo path cloned elsewhere would hash differently; to force a collision we
    78	# occupy this repo's NEXT deterministic launch: keep daemon 1 running, install into a
    79	# second repo, and pin the second repo's base port to the first one's by occupying
    80	# nothing — instead, occupy is proven the direct way: a foreign listener squats the
    81	# second repo's deterministic base port, and the launcher must step past it without
    82	# killing it.
    83	REPO2="$SB/fakerepo2"
