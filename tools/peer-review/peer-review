#!/usr/bin/env bash
# peer-review — hand each new commit to the OTHER assistant for review, and surface what it finds.
#
# WHY THIS SHAPE. A cross-brand panel on 2026-08-27 was asked how to make an idle second
# assistant useful without the busy one having to think about it. Two brands converged:
#
#   * The trigger must be a SIDE EFFECT of something that already happens. Committing already
#     happens. Nobody has to remember a convention.
#   * State lives in the WORLD, not in an agent. A git ref survives a session death, a
#     compaction, and a restart; an agent's memory of "I last reviewed X" survives none of them.
#   * The reviewer must not be able to accumulate a silent backlog. Both brands predicted the
#     same failure: the reviewer reports into a channel nobody is responsible for clearing, and
#     a week later there are fifteen findings and three fixes. So findings go to STDOUT, which
#     the scheduler turns into a poke at the busy assistant, rather than into a file.
#
# The reviewer is invoked headlessly (`openclaw agent --message-file`), so it never needs its
# interactive session to be free, and the busy assistant never has to decide whether it is.
#
#   peer-review [--repo DIR]... [--dry-run] [--limit N]
#
# Silent when there is nothing new or nothing found. That silence is the healthy state, and it
# is NOT an approval — a review that finds nothing says nothing, exactly like a passing test.
set -uo pipefail

REVIEWER_BIN="${REVIEWER_BIN:-/opt/homebrew/bin/openclaw}"
REVIEWER_NAME="${REVIEWER_NAME:-ghost-openclaw}"
# --agent is REQUIRED. Without it the CLI prints "No target session selected" and EXITS 0
# while doing it, so a run would look successful and review nothing.
REVIEWER_AGENT="${REVIEWER_AGENT:-main}"
# --session-key is equally load-bearing, and the reviewer itself caught its absence on the
# very first live review of this script: without it the turn lands in the reviewer's MAIN
# session and interleaves with whatever conversation is happening there. Verified in the
# probe output — sessionKey came back as "agent:main:main". A dedicated key keeps review
# turns out of the reviewer's own context.
REVIEWER_SESSION="${REVIEWER_SESSION:-agent:main:peer-review}"
SELF_NAME="${SELF_NAME:-ghost-claude}"
WORKLOG="${WORKLOG_BIN:-$HOME/svnCheckouts/js-project-GhOST/tools/worklog}"
# The ref is per-repo and lives in the repo. Nothing here remembers anything between runs.
REF="${PEER_REVIEW_REF:-refs/peer-review/last}"
LIMIT="${PEER_REVIEW_LIMIT:-3}"
DRY=0
REPOS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPOS+=("$2"); shift 2;;
    --dry-run) DRY=1; shift;;
    --limit) LIMIT="$2"; shift 2;;
    -h|--help) sed -n '2,25p' "$0"; exit 0;;
    *) echo "peer-review: unknown argument '$1'" >&2; exit 64;;
  esac
done
[ ${#REPOS[@]} -gt 0 ] || REPOS=("$HOME/svnCheckouts/js-db-ad-astra" "$HOME/svnCheckouts/js-project-GhOST")

[ -x "$REVIEWER_BIN" ] || { echo "peer-review: reviewer binary $REVIEWER_BIN is not executable — no review ran" >&2; exit 2; }

for repo in "${REPOS[@]}"; do
  [ -d "$repo/.git" ] || { echo "peer-review: $repo is not a git repo — skipped" >&2; continue; }
  cd "$repo" || continue
  head_sha="$(git rev-parse HEAD 2>/dev/null)" || continue

  # FIRST RUN RECORDS THE BASELINE AND REVIEWS NOTHING. Without this, installing the tool
  # would dump every commit in history at the reviewer, which is the "historical flood" the
  # panel warned about and the same shape as ollama-watch's first-run silence, inverted.
  if ! last_sha="$(git rev-parse -q --verify "$REF" 2>/dev/null)"; then
    git update-ref "$REF" "$head_sha"
    echo "peer-review: baseline set for $(basename "$repo") at ${head_sha:0:8} — nothing reviewed on a first run" >&2
    continue
  fi
  [ "$last_sha" = "$head_sha" ] && continue

  # Oldest first, so a run that dies partway leaves the ref on a real reviewed commit rather
  # than skipping the ones it never got to.
  # SAY WHEN THE NET IS FALLING BEHIND. The whole review-after-commit premise — commit freely,
  # the reviewer catches what you missed — assumes review keeps PACE with committing. On
  # 2026-08-28 it did not: 34 commits accumulated in this repo against a limit of 3 per run, so
  # the guarantee had quietly weakened by a factor of about four and nothing anywhere said so.
  # A backlog is invisible by construction: every individual run looks like it worked.
  #
  # Threshold is three runs' worth, because anything clearable inside a couple of hours is
  # ordinary catch-up and anything beyond it means the author is outrunning the reviewer.
  backlog="$(git rev-list --count "$last_sha..$head_sha")"
  # ONLY WHEN IT IS NOT ALREADY DRAINING. Warning on every run would have produced a dozen
  # overnight pokes counting a backlog down to zero — the cry-wolf failure this repo has spent
  # the day removing from other checks, and I nearly shipped it here within minutes of writing
  # the warning. A queue that is shrinking is being handled; the thing worth saying is that the
  # author is outrunning the reviewer, which shows up as a backlog that holds or grows.
  # JUDGE THE TREND, NOT ONE INTERVAL. Comparing against the immediately previous run made a
  # queue that had fallen from 38 to 16 overnight report "NOT draining" the moment one cycle
  # happened to break even — three reviewed, three committed. A reader would conclude it was
  # stuck while it had more than halved. The warning I wrote to stop crying wolf was crying wolf
  # within twelve hours.
  #
  # Three runs of history, and it speaks only when the backlog is no better than it was three
  # runs ago. That is roughly two hours at this cadence: long enough that ordinary
  # commit-and-review interleaving cancels out, short enough to catch a genuine runaway.
  prev_ref="refs/peer-review/backlog/$(basename "$repo")"
  hist="$(git cat-file -p "$prev_ref" 2>/dev/null | head -1)"
  oldest="${hist%% *}"
  case "$oldest" in ''|*[!0-9]*) oldest=-1;; esac
  if [ "$backlog" -gt $(( LIMIT * 3 )) ] && [ "$oldest" -ge 0 ] && [ "$backlog" -ge "$oldest" ]; then
    echo "peer-review: $(basename "$repo") is $backlog commits behind review and has not improved over the last three runs (was $oldest), clearing $LIMIT per run — commits are arriving faster than they are being reviewed, so the review-after-commit guarantee is weaker than it looks."
  fi
  # Keep the last three counts, oldest first.
  newhist="$(printf '%s %s' "${hist#* }" "$backlog" | awk '{n=NF; s=""; for(i=(n>3?n-2:1);i<=n;i++) s=s $i " "; print s}')"
  printf '%s\n' "$newhist" | git hash-object -w --stdin 2>/dev/null | xargs -I{} git update-ref "$prev_ref" {} 2>/dev/null || true
  commits="$(git rev-list --reverse "$last_sha..$head_sha" | head -n "$LIMIT")"
  [ -z "$commits" ] && continue

  for sha in $commits; do
    subject="$(git log -1 --format=%s "$sha")"
    task="$(mktemp)"
    {
      echo "You are reviewing one commit written by another AI assistant on a shared machine. Find DEFECTS."
      echo
      echo "Report ONLY defects you can point at a specific line for, each with a concrete failure: the input or state that triggers it and what goes wrong. If you find none, reply with exactly NO DEFECTS FOUND and nothing else — silence is the expected result and is not approval."
      echo
      echo "Do not comment on style, naming, or comment density. Do not suggest refactors. The author has context you do not, so a design choice that looks odd is probably deliberate; a missing quote or an unchecked exit code is not."
      echo
      echo "Repository: $(basename "$repo")"
      echo "Commit: $sha"
      echo "Subject: $subject"
      echo
      echo "--- diff ---"
      git show --format="" --unified=5 "$sha" | head -c 60000

      # WHICH OF THESE FILES HAVE MOVED ON SINCE. Review necessarily runs behind the author, and
      # on 2026-08-28 several findings landed against code that had already been fixed or a file
      # that had been deleted hours earlier — accurate about the commit, spent on nothing. The
      # reviewer cannot know that unless it is told, so tell it, and let it decide whether the
      # finding is still worth raising. This does NOT ask it to review current state: the commit
      # is still the subject, because reviewing a moving tree is how you get findings nobody can
      # reproduce.
      echo
      echo "--- staleness of this commit, as of now ---"
      moved="$(mktemp)"
      # READ THE NAMES, DO NOT WORD-SPLIT THEM. `for f in $(git show --name-only)` breaks any
      # committed path containing a space into pieces, so a commit touching "docs/review notes.md"
      # would be reported as two files, both missing, and the reviewer told a confident lie about
      # what had changed. Peer review caught it on the commit that added this.
      # -z, because git C-QUOTES any path containing a tab, a newline or a non-ASCII byte when
      # it prints one per line — "docs/tab\tname" arrives with literal backslash-t and quotes,
      # and the existence check on that display text fails, so a file that is still there is
      # reported deleted. NUL-separated output is the raw pathname with no escaping at all.
      # Found by peer review on the commit that fixed the whitespace splitting, which is the
      # same bug one layer deeper.
      git show --format="" --name-only -z "$sha" | while IFS= read -r -d "" f; do
        [ -n "$f" ] || continue
        # PRINT THE NAME ON ONE LINE. NUL parsing preserves a pathname containing a NEWLINE, and
        # then echo splits it back into two staleness lines — so the reviewer sees "b.md —
        # CHANGED" and cannot tell which file that is, or whether it is a file at all. Reading it
        # correctly and printing it carelessly loses exactly what the -z fix bought. Third
        # correction to this section today, each one finding the previous insufficient.
        # FOURTH correction to these lines today, and the first three each fixed the reported
        # case and left the class: word-splitting, then git's C-quoting, then a newline splitting
        # the echo, and then mapping tabs and newlines to "?" — which made docs/a?b.md and
        # docs/a<TAB>b.md render identically, so a reviewer could not tell which file moved.
        #
        # printf %q rather than a fifth substitution: one line, unambiguous, and REVERSIBLE, so a
        # tab becomes $'\t' and stays distinct from a literal question mark.
        show="$(printf '%q' "$f")"
        if [ ! -e "$repo/$f" ]; then
          echo "  $show — DELETED since this commit"
        elif ! git diff --quiet "$sha" HEAD -- "$f" 2>/dev/null; then
          echo "  $show — CHANGED since this commit ($(git rev-list --count "$sha..HEAD" -- "$f") later commit(s) touch it)"
        fi
      done > "$moved"
      # The loop above runs in a subshell because of the pipe, so a flag set inside it would be
      # lost. Count the lines it produced instead — the file is the only thing that survives.
      if [ -s "$moved" ]; then cat "$moved"; else echo "  every file in this commit is unchanged at HEAD"; fi
      echo
      echo "If a file above is deleted or changed, the defect you find may already be fixed. Say so if you believe it is, and skip it — a finding against code that no longer exists costs the author a lookup and returns nothing. If you cannot tell, raise it anyway and note the uncertainty."
    } > "$task"
    rm -f "$moved"

    if [ "$DRY" -eq 1 ]; then
      echo "[dry-run] would send $(basename "$repo") ${sha:0:8} ($subject) to $REVIEWER_NAME"
      rm -f "$task"; continue
    fi

    out="$(timeout 600 "$REVIEWER_BIN" agent --agent "$REVIEWER_AGENT" \
             --session-key "$REVIEWER_SESSION" --message-file "$task" --json 2>/dev/null)"
    rc=$?
    rm -f "$task"

    if [ $rc -ne 0 ] || [ -z "$out" ]; then
      # A reviewer that could not run must NOT advance the ref, or the commit is silently
      # never reviewed. Loud, and the ref stays put so the next run retries it.
      echo "peer-review: $REVIEWER_NAME failed on $(basename "$repo") ${sha:0:8} (rc=$rc) — NOT advancing the ref, will retry"
      break
    fi

    body="$(printf '%s' "$out" | python3 -c "
import json,sys
# The real shape, confirmed against the live binary rather than guessed:
#   {'status':'ok','result':{'payloads':[{'text': ...}]}}
# The first version looked for top-level text/reply/message/content and found none of them,
# so every review produced an empty body — which this script reads as 'nothing found'. A
# parser that cannot find the answer has to say so; silence is a verdict here.
try:
    d = json.load(sys.stdin)
except Exception:
    print('PARSE-ERROR: reviewer output was not JSON')
    raise SystemExit
if d.get('status') not in (None, 'ok'):
    print('REVIEWER-STATUS: ' + str(d.get('status')))
    raise SystemExit
# result may be null or a non-object on a failed run. .get('payloads') on that raises,
# stderr is discarded, body comes back EMPTY, and an empty body reads as a clean review
# while the ref advances — the commit is lost with no trace. Found by the reviewer itself.
res = d.get('result')
payloads = res.get('payloads') if isinstance(res, dict) else None
texts = [p.get('text','') for p in (payloads or []) if isinstance(p, dict) and p.get('text')]
print('\n'.join(t.strip() for t in texts) if texts
      else 'PARSE-ERROR: no result.payloads[].text in reviewer output')
" 2>/dev/null)"

    case "$body" in
      # A parse failure is NOT a clean review. Say so, and say the commit went unchecked —
      # the ref has already advanced, so nothing else will look at it again.
      PARSE-ERROR*|REVIEWER-STATUS*)
        # DO NOT ADVANCE. Reporting "not reviewed" while moving the ref past the commit means
        # nothing ever looks at it again — the rule in AGENTS.md says review-after replaces
        # ask-before, and a commit silently dropped here makes that guarantee false. The
        # reviewer itself caught this contradiction between the rule and the code.
        echo "peer-review: could not read $REVIEWER_NAME's answer for $(basename "$repo") ${sha:0:8} — $body. NOT advancing the ref; it will be retried."
        break
        ;;
      *"NO DEFECTS FOUND"*|"") git update-ref "$REF" "$sha" ;;
      *)
        # STDOUT on purpose: the scheduler pokes the busy assistant when this is non-empty,
        # so a finding lands in its next turn instead of in a file nobody opens.
        echo "peer-review — $REVIEWER_NAME on $(basename "$repo") ${sha:0:8} \"$subject\":"
        printf '%s\n' "$body"
        git update-ref "$REF" "$sha"
        [ -x "$WORKLOG" ] && "$WORKLOG" append --agent "$REVIEWER_NAME" --quiet \
          --project "$(basename "$repo")" --commit "$sha" \
          "Peer review found something on ${sha:0:8}: $subject" --note "$(printf '%s' "$body" | head -c 900)" 2>/dev/null
        ;;
    esac
  done
done
