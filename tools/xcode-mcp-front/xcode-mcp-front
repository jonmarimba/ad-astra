#!/usr/bin/env bash
# xcode-mcp-front — start/stop/status wrapper around daemon.py.
#
# Why this exists: Xcode's MCP "Allow" popup is keyed per connecting PID. Every
# separate process that execs `xcrun mcpbridge` re-triggers it. kicker runs many
# concurrent nodes, so today that's many concurrent popups for the same tool. This
# daemon holds ONE mcpbridge connection for its whole life and fronts it over
# Streamable HTTP so every client connects to the daemon instead of spawning its
# own mcpbridge. Point kicker nodes' MCP client config at http://127.0.0.1:8765/mcp
# (an HTTP-transport server entry) instead of a stdio spawn of mcpbridge directly.
#
#   xcode-mcp-front start    # spawn the daemon in the background, write pidfile+log
#   xcode-mcp-front stop     # stop it
#   xcode-mcp-front restart
#   xcode-mcp-front status   # running? since when? listening where?
#   xcode-mcp-front logs     # tail the daemon log
#   xcode-mcp-front spike [N]  # run spike.py in the foreground (validation, not the daemon)
#
# NOT YET VALIDATED: run `spike.py` against a live Xcode before trusting this for
# real kicker traffic — see daemon.py's header for what's unconfirmed.
set -uo pipefail
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
HERE="$(cd "$(dirname "$0")" && pwd)"
STATE="${XCODE_MCP_FRONT_HOME:-$HOME/.xcode-mcp-front}"
PIDFILE="$STATE/daemon.pid"
LOGFILE="$STATE/daemon.log"
PORT="${XCODE_MCP_FRONT_PORT:-8765}"
mkdir -p "$STATE"

# Xcode's MCP-connection approval is a normal in-app AXButton titled exactly
# "Allow" (confirmed live, 2026-08-14 — not a hardened system TCC prompt, a
# regular accessible button in Xcode's own window). Poll for it for a few
# seconds after spawning and click it if it shows up, so a fresh daemon PID
# doesn't sit there waiting on a human. Scoped tight on purpose: only ever
# clicks a button whose title is the exact literal string "Allow", only in
# Xcode's own process — this is the one dialog this tool exists to eat, not
# a general click-any-prompt macro.
auto_allow() {
  local tries=0
  while [ "$tries" -lt 10 ]; do
    if osascript -e 'tell application "System Events" to tell process "Xcode"
      if exists (button "Allow" of window 1) then
        click (button "Allow" of window 1)
        return "clicked"
      end if
    end tell' 2>/dev/null | grep -q "clicked"; then
      echo "auto-allow: clicked Xcode's connection-approval prompt"
      return 0
    fi
    tries=$((tries + 1))
    sleep 1
  done
  return 1
}

running_pid() {
  [ -f "$PIDFILE" ] || return 1
  local pid; pid="$(cat "$PIDFILE" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    echo "$pid"
    return 0
  fi
  rm -f "$PIDFILE"  # stale pidfile from a crashed/killed daemon — self-heal, don't leave it lying around
  return 1
}

cmd_start() {
  local pid
  if pid="$(running_pid)"; then
    echo "already running (pid $pid), listening on http://127.0.0.1:$PORT/mcp"
    return 0
  fi
  echo "starting xcode-mcp-front on port $PORT, log: $LOGFILE"
  nohup uv run --script "$HERE/daemon.py" >>"$LOGFILE" 2>&1 &
  local newpid=$!
  echo "$newpid" > "$PIDFILE"
  auto_allow || true  # best-effort; if no prompt shows (already approved, or Xcode not running) this just no-ops
  sleep 1  # auto_allow already spent up to ~10s polling, so a short settle is enough here
  if kill -0 "$newpid" 2>/dev/null; then
    echo "started (pid $newpid)"
  else
    echo "FAILED to start — check $LOGFILE" >&2
    rm -f "$PIDFILE"
    return 1
  fi
}

cmd_stop() {
  local pid
  if ! pid="$(running_pid)"; then
    echo "not running"
    rm -f "$PIDFILE"
    return 0
  fi
  echo "stopping (pid $pid)"
  kill "$pid" 2>/dev/null
  for _ in 1 2 3 4 5; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
  rm -f "$PIDFILE"
  echo "stopped"
}

cmd_status() {
  local pid
  if pid="$(running_pid)"; then
    local since; since="$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^ *//')"
    echo "running: pid $pid, since $since, listening on http://127.0.0.1:$PORT/mcp"
  else
    echo "not running"
  fi
}

case "${1:-status}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  logs) tail -f "$LOGFILE" ;;
  spike) shift; uv run --script "$HERE/spike.py" "$@" ;;
  *) echo "usage: xcode-mcp-front {start|stop|restart|status|logs|spike [N]}" >&2; exit 1 ;;
esac
