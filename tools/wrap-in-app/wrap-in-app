#!/usr/bin/env bash
# wrap-in-app — wrap a shell script in an Automator .app so scheduled runs get macOS TCC
# permissions (Full Disk Access etc). launchd command jobs get silent EPERM on protected
# data (Mail, Messages, Notes containers); an app bundle is the thing TCC can grant.
#
#   wrap-in-app <script> --log <logfile> [--name AppName] [--outdir DIR]
#
# Produces: DIR/AppName.app + DIR/appname_launch.sh (the schd-facing shim).
#
# THE LOAD-BEARING DESIGN DECISIONS (from the 2026-08-12 HOA/ingest wrappers):
#   1. The app REFERENCES the script by absolute path — the script never lives inside the
#      bundle. Edit the script all you want: the app's hash, ad-hoc signature, and its FDA
#      grant survive. Editing the .app itself (or re-running this tool over it) changes the
#      hash and SILENTLY kills the grant — re-add it in the Full Disk Access pane after.
#   2. Automator apps swallow stdout, so the app's command redirects EVERYTHING the script
#      prints into --log, bracketed by run start/end markers. The script needs no
#      self-logging discipline; the log is where you debug a failed run.
#   3. The launch shim restores schd's poke-on-stdout convention: it snapshots the log,
#      waits for the app (-W), then prints only the NEW non-marker lines — a silent script
#      run stays silent, so a timer job only pokes when something actually happened.
set -uo pipefail
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"
HERE="$(cd "$(dirname "$0")" && pwd)"

SCRIPT=""; LOG=""; NAME=""; OUTDIR="."
while [ $# -gt 0 ]; do case "$1" in
  --log)    [ -n "${2:-}" ] || { echo "wrap-in-app: --log needs a value" >&2; exit 64; }; LOG="$2"; shift 2 ;;
  --name)   [ -n "${2:-}" ] || { echo "wrap-in-app: --name needs a value" >&2; exit 64; }; NAME="$2"; shift 2 ;;
  --outdir) [ -n "${2:-}" ] || { echo "wrap-in-app: --outdir needs a value" >&2; exit 64; }; OUTDIR="$2"; shift 2 ;;
  --*) echo "wrap-in-app: unknown flag '$1'" >&2; exit 64 ;;
  *) [ -z "$SCRIPT" ] && SCRIPT="$1" || { echo "wrap-in-app: one script only (got '$1' too)" >&2; exit 64; }; shift ;;
esac; done
[ -n "$SCRIPT" ] || { echo "usage: wrap-in-app <script> --log <logfile> [--name AppName] [--outdir DIR]" >&2; exit 64; }
[ -n "$LOG" ] || { echo "wrap-in-app: --log is required — Automator apps swallow stdout, the log is the only place output goes" >&2; exit 64; }
[ -f "$SCRIPT" ] || { echo "wrap-in-app: no such script: $SCRIPT" >&2; exit 1; }
[ -x "$SCRIPT" ] || { echo "wrap-in-app: $SCRIPT is not executable (chmod +x it)" >&2; exit 1; }

# The ONE edit that ever forces re-touching a wrapper app (and re-granting FDA) is macOS
# removing the runtime the wrapped script depends on: /usr/bin/{python,python2,perl,ruby}
# have carried the "will be removed in a future version of macOS" deprecation since Catalina
# (python2 is already gone as of macOS 26). Warn if the script's shebang leans on one — pin
# a Homebrew interpreter (/opt/homebrew/bin/…) instead so Apple can't orphan the app.
shebang="$(head -1 "$SCRIPT")"
case "$shebang" in
  "#!/usr/bin/python"*|"#!/usr/bin/perl"*|"#!/usr/bin/ruby"*)
    echo "wrap-in-app: WARNING — $SCRIPT runs on a macOS-bundled runtime ($shebang) that Apple has" >&2
    echo "  deprecated and will remove; the app will break on that macOS and need a re-grant. Point the" >&2
    echo "  shebang at a Homebrew interpreter (e.g. #!/opt/homebrew/bin/python3) before it bites." >&2 ;;
  "#!/usr/bin/env "*)
    echo "wrap-in-app: note — $SCRIPT uses '#!/usr/bin/env' (first-on-PATH). launchd/Automator PATH is" >&2
    echo "  minimal, so this may resolve to a deprecated /usr/bin runtime. Prefer an absolute Homebrew path." >&2 ;;
esac

SCRIPT="$(cd "$(dirname "$SCRIPT")" && pwd)/$(basename "$SCRIPT")"   # absolute — the app runs from /
mkdir -p "$OUTDIR" "$(dirname "$LOG")"
LOG="$(cd "$(dirname "$LOG")" && pwd)/$(basename "$LOG")"
[ -n "$NAME" ] || { NAME="$(basename "$SCRIPT")"; NAME="${NAME%.*}_wrapper"; }
slug="$(printf '%s' "$NAME" | tr ' _' '--' | tr -cd 'A-Za-z0-9-')"
APP="$OUTDIR/$NAME.app"
[ -e "$APP" ] && { echo "wrap-in-app: $APP already exists — refusing to overwrite (an existing app may hold an FDA grant; delete it yourself first)" >&2; exit 1; }

cp -R "$HERE/template.app" "$APP"

APP="$APP" SCRIPT="$SCRIPT" LOG="$LOG" NAME="$NAME" SLUG="$slug" /opt/homebrew/bin/python3 - <<'PY'
import os, plistlib
app, script, log, name, slug = (os.environ[k] for k in ("APP", "SCRIPT", "LOG", "NAME", "SLUG"))
wf = f"{app}/Contents/document.wflow"
d = plistlib.load(open(wf, "rb"))
cmd = f"{{ echo \"=== run start $(date '+%Y-%m-%d %H:%M:%S')\"; {script}; echo \"=== run end $(date '+%Y-%m-%d %H:%M:%S') status $?\"; }} >> {log} 2>&1"
n = 0
for act in d.get("actions", []):
    params = act.get("action", {}).get("ActionParameters", {})
    if "COMMAND_STRING" in params:
        params["COMMAND_STRING"] = cmd
        n += 1
assert n == 1, f"expected exactly one COMMAND_STRING in template, found {n}"
plistlib.dump(d, open(wf, "wb"), fmt=plistlib.FMT_XML)
ip = f"{app}/Contents/Info.plist"
d = plistlib.load(open(ip, "rb"))
d["CFBundleIdentifier"] = f"com.apple.automator.{slug}"   # Automator's own applet convention
d["CFBundleName"] = name
plistlib.dump(d, open(ip, "wb"), fmt=plistlib.FMT_XML)
print(f"app command -> {script}\napp log     -> {log}")
PY

xattr -cr "$APP"
# --deep: codesign treats document.wflow as a nested code object and refuses a shallow
# sign ("code object is not signed at all"); deep-signing seals it along with the bundle
codesign --force --deep -s - "$APP" || { echo "wrap-in-app: codesign failed (see error above)" >&2; exit 1; }

SHIM="$OUTDIR/$(printf '%s' "$NAME" | tr 'A-Z ' 'a-z_')_launch.sh"
cat > "$SHIM" <<SHIMEOF
#!/bin/bash
# $(basename "$SHIM") — schd-facing launcher for $NAME.app (generated by wrap-in-app).
# The app holds the TCC grant; this shim restores the poke-on-stdout convention the app
# swallows: print only NEW non-marker log lines from this run. LOG: $LOG
APP="\$(cd "\$(dirname "\$0")" && pwd)/$NAME.app"
LOG="$LOG"
before=0
[ -f "\$LOG" ] && before=\$(wc -l < "\$LOG")
open -g -W -a "\$APP" || { echo "$NAME: FAILED to launch \$APP"; exit 1; }
tail -n +\$((before + 1)) "\$LOG" | grep -v '^=== run '
exit 0
SHIMEOF
chmod +x "$SHIM"

echo "wrote $APP (ad-hoc signed, id com.apple.automator.$slug)"
echo "wrote $SHIM (point the scheduler at THIS, not the app or the script)"
echo ""
echo "NEXT STEPS:"
echo "  1. System Settings -> Privacy & Security -> Full Disk Access -> add $APP"
echo "  2. Schedule the shim (schd/launchd/cron) — it prints only what the script printed"
echo "  3. Edit $SCRIPT freely (grant survives). NEVER edit the .app — that kills the grant silently."
