#!/usr/bin/env bash
# convoke — run one round of a convocation: the same task file to N agents, isolated,
# each writing to its own output file. Rounds 1 and 2 are both "a task file fanned out";
# only the task file's CONTENT differs (round 2's includes the others' round-1 outputs).
# See ../../skills/convocation/SKILL.md for the full process.
#
#   convoke TASK.md --out outdir [--agents claude,codex,qwen] [--tag round1]
set -uo pipefail
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$HOME/.local/bin:$PATH"
TASK="${1:?usage: convoke TASK.md --out DIR [--agents claude,codex,qwen] [--tag round1]}"; shift
OUT="convocation-out"; AGENTS="claude,codex,qwen"; TAG="round1"
while [ $# -gt 0 ]; do case "$1" in
  --out) OUT="$2"; shift 2;; --agents) AGENTS="$2"; shift 2;; --tag) TAG="$2"; shift 2;; *) shift;;
esac; done
[ -f "$TASK" ] || { echo "no task file: $TASK"; exit 1; }
mkdir -p "$OUT"
PROMPT="$(cat "$TASK")"
CLAUDE_BIN="${CLAUDE_BIN:-/opt/homebrew/bin/claude}"
CODEX_BIN="${CODEX_BIN:-/opt/homebrew/bin/codex}"
QWEN_BIN="${QWEN_BIN:-/opt/homebrew/bin/qwen}"
# validate EVERY requested agent before launching ANY — a convocation missing a voice is not
# a convocation, and a silent skip would let a two-voice round masquerade as a three-voice one
bad=0
for a in $(echo "$AGENTS" | tr ',' ' '); do
  case "$a" in
    claude) [ -x "$CLAUDE_BIN" ] || { echo "convoke: agent 'claude' requested but $CLAUDE_BIN is not executable" >&2; bad=1; } ;;
    codex)  [ -x "$CODEX_BIN" ]  || { echo "convoke: agent 'codex' requested but $CODEX_BIN is not executable" >&2; bad=1; } ;;
    qwen)   [ -x "$QWEN_BIN" ]   || { echo "convoke: agent 'qwen' requested but $QWEN_BIN is not executable" >&2; bad=1; } ;;
    *) echo "convoke: unknown agent '$a' (claude|codex|qwen)" >&2; bad=1 ;;
  esac
done
[ "$bad" -eq 0 ] || { echo "convoke: aborting — every requested voice must be able to run" >&2; exit 1; }
pids=()
for a in $(echo "$AGENTS" | tr ',' ' '); do
  o="$OUT/${TAG}_${a}.md"
  case "$a" in
    claude) ( "$CLAUDE_BIN" -p "$PROMPT" > "$o" 2>"$o.err"; echo "done: $a" ) & pids+=($!) ;;
    codex)  ( "$CODEX_BIN" exec --skip-git-repo-check "$PROMPT" > "$o" 2>"$o.err"; echo "done: $a" ) & pids+=($!) ;;
    qwen)   ( "$QWEN_BIN" -p "$PROMPT"  > "$o" 2>"$o.err"; echo "done: $a" ) & pids+=($!) ;;
  esac
done
for p in "${pids[@]}"; do wait "$p"; done
echo "--- $TAG outputs in $OUT/:"
ls -la "$OUT/${TAG}_"*.md 2>/dev/null
