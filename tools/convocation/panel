#!/usr/bin/env bash
# panel — run one round of a convocation: the same task file to N agents, isolated,
# each writing to its own output file. Rounds 1 and 2 are both "a task file fanned out";
# only the task file's CONTENT differs (round 2's includes the others' round-1 outputs).
# See ../../skills/convocation/SKILL.md for the full process.
#
#   panel TASK.md --out outdir [--agents claude,codex,qwen] [--tag round1]
set -uo pipefail
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$HOME/.local/bin:$PATH"
TASK="${1:?usage: panel TASK.md --out DIR [--agents claude,codex,qwen] [--tag round1]}"; shift
OUT="convocation-out"; AGENTS="claude,codex,qwen"; TAG="round1"
while [ $# -gt 0 ]; do case "$1" in
  --out) OUT="$2"; shift 2;; --agents) AGENTS="$2"; shift 2;; --tag) TAG="$2"; shift 2;;
  # a typo'd flag silently running with defaults overwrites the PREVIOUS round's outputs
  *) echo "panel: unknown argument '$1'" >&2; exit 64;;
esac; done
[ -f "$TASK" ] || { echo "no task file: $TASK"; exit 1; }
mkdir -p "$OUT"
STATUS="$OUT/${TAG}_STATUS"
: > "$STATUS"
PROMPT="$(cat "$TASK")"
CLAUDE_BIN="${CLAUDE_BIN:-/opt/homebrew/bin/claude}"
CODEX_BIN="${CODEX_BIN:-/opt/homebrew/bin/codex}"
QWEN_BIN="${QWEN_BIN:-/opt/homebrew/bin/qwen}"
# PIN THE MODEL. Without -m, qwen uses whatever `.model.name` happens to be in
# ~/.qwen/settings.json, which on 2026-08-19 was an LM Studio model on the M5 laptop.
# The M5 sleeps, so the third voice of every convocation silently depended on whether a
# laptop was awake — it failed that day with "No models loaded", after the round had
# already been dispatched. And when the M5 IS awake that model is NVIDIA-brand and local,
# so the "brand diversity" the doctrine is built on was whatever the picker was last set
# to rather than a deliberate choice. Pinned to an ollama-cloud route through OmniRoute,
# verified serving the same morning. Override with QWEN_MODEL for a different third brand.
#   -y is load-bearing too (doctrine): without it any prompt that trips qwen's tool-calling
#   dies with "requires user approval but cannot execute in non-interactive mode".
QWEN_MODEL="${QWEN_MODEL:-ollamacloud/glm-5.2}"
# Shortest thing that could be a review. 200 is a judgement, not a measurement: it is well
# above an error string like "Execution error" (15 bytes) and well below any real answer.
# Overridable so tests can dispatch stub agents that legitimately answer in one line.
MIN_ANSWER_BYTES="${MIN_ANSWER_BYTES:-200}"
# validate EVERY requested agent before launching ANY — a convocation missing a voice is not
# a convocation, and a silent skip would let a two-voice round masquerade as a three-voice one
bad=0
for a in $(echo "$AGENTS" | tr ',' ' '); do
  case "$a" in
    claude) [ -x "$CLAUDE_BIN" ] || { echo "panel: agent 'claude' requested but $CLAUDE_BIN is not executable" >&2; bad=1; } ;;
    codex)  [ -x "$CODEX_BIN" ]  || { echo "panel: agent 'codex' requested but $CODEX_BIN is not executable" >&2; bad=1; } ;;
    qwen)   if [ -x "$QWEN_BIN" ]; then
              # A binary that exists is not a voice that answers. The 2026-08-19 failure got
              # past the executable check and died on the model, after the other two brands
              # had already been launched and their tokens spent. One cheap round-trip here
              # turns that into a refusal to start.
              #
              # ONCE A DAY, not once a round. Which models serve changes on the scale of
              # days — a plan changing, a route being added — not on the scale of the six
              # panels you run in an evening. Re-probing every round spent 90 seconds of
              # wall time and a request to say the same thing it said twenty minutes
              # earlier. The stamp is per model and per day, so switching QWEN_MODEL still
              # probes, and a model that broke overnight is still caught tomorrow morning.
              #
              # PANEL_FORCE_PROBE=1 re-probes now, for when a route has just been fixed and
              # you do not want to wait for midnight.
              probe_dir="${XDG_CACHE_HOME:-$HOME/.cache}/convocation"
              probe_stamp="$probe_dir/ready-$(echo "$QWEN_MODEL" | tr '/:' '__')-$(date +%Y%m%d)"
              if [ "${PANEL_FORCE_PROBE:-0}" = "1" ] || [ ! -f "$probe_stamp" ]; then
                if timeout 90 "$QWEN_BIN" -m "$QWEN_MODEL" -y -p 'Reply with exactly: READY' 2>/dev/null | grep -q READY; then
                  mkdir -p "$probe_dir" && : > "$probe_stamp"
                  # Yesterday's stamps for this model are noise; keep the directory small.
                  find "$probe_dir" -name "ready-*" -mtime +2 -delete 2>/dev/null || true
                else
                  echo "panel: agent 'qwen' requested but model '$QWEN_MODEL' did not answer a trivial prompt." >&2
                  echo "         Check OmniRoute is up (curl -s localhost:20128/v1/models) and that the model serves." >&2
                  bad=1
                fi
              fi
            else
              echo "panel: agent 'qwen' requested but $QWEN_BIN is not executable" >&2; bad=1
            fi ;;
    *) echo "panel: unknown agent '$a' (claude|codex|qwen)" >&2; bad=1 ;;
  esac
done
[ "$bad" -eq 0 ] || { echo "panel: aborting — every requested voice must be able to run" >&2; exit 1; }
# each subshell exits with ITS AGENT'S status — an agent that crashes must fail the round,
# not leave a 0-byte answer file behind a cheery "done" (a round missing a voice is invalid)
run_agent(){ # run_agent <name> <outfile> <cmd...>
  local a="$1" o="$2"; shift 2
  if "$@" > "$o" 2>"$o.err"; then
    echo "done: $a"
    # A zero exit is not an answer. `claude -p` returned the 15-byte string "Execution error"
    # in that same round and was recorded as ok, which is how a panel reports three voices and
    # carries one. Anything too short to be a review is a failure with its content quoted.
    # An agent that answers into a sidecar file (codex -o) has its answer moved into place
    # before the size check, or the check would reject a perfectly good review.
    [ -s "$o.last" ] && { cat "$o.last" >> "$o"; rm -f "$o.last"; }
    local bytes; bytes="$(wc -c < "$o" | tr -d ' ')"
    if [ "$bytes" -lt "$MIN_ANSWER_BYTES" ]; then
      printf 'FAIL  %s  answered %s bytes: %s\n' "$a" "$bytes" "$(tr '\n' ' ' < "$o")" >> "$STATUS"
      echo "panel: agent '$a' returned $bytes bytes, too short to be an answer: $(tr '\n' ' ' < "$o")" >&2
      return 1
    fi
    printf 'ok    %s  %s bytes\n' "$a" "$bytes" >> "$STATUS"
  else
    local rc=$?
    printf '\n\nFAIL: %s exited %s; stderr is in %s.err\n' "$a" "$rc" "$o" >> "$o"
    printf 'FAIL  %s  exit %s\n' "$a" "$rc" >> "$STATUS"
    echo "panel: agent '$a' FAILED rc=$rc (stderr in $o.err)" >&2
    return "$rc"
  fi
}
pids=()
for a in $(echo "$AGENTS" | tr ',' ' '); do
  o="$OUT/${TAG}_${a}.md"
  case "$a" in
    claude) run_agent claude "$o" "$CLAUDE_BIN" -p "$PROMPT" & pids+=($!) ;;
    # </dev/null is LOAD-BEARING and its absence is why the 2026-08-26 22:00 round produced
    # three empty files. Without it codex prints "Reading additional input from stdin..." and
    # waits forever, so the round does not fail, it HANGS — and every other agent's tokens are
    # already spent by then. The doctrine has said this since 2026-08-19; this dispatcher
    # simply never did it.
    # -o writes the FINAL MESSAGE to a file. Without it codex exec puts its transcript on
    # stderr and leaves stdout empty, so the 2026-08-26 22:05 round recorded codex as a
    # zero-byte answer while its stderr held a real review — it had queried the live database
    # and everything. Capturing stdout is simply the wrong seam for this CLI.
    # -c mcp_servers={} STOPS EVERY CODEX PANELIST FROM KNOCKING ON XCODE'S DOOR.
    # ~/.codex/config.toml declares [mcp_servers.xcode] = `xcrun mcpbridge`, so a plain
    # `codex exec` opens a connection to Xcode on startup and Xcode raises an
    # "Allow 'Codex' to access Xcode?" prompt keyed to that codex PID. A convocation spawns
    # one codex per round, the codex exits when the round ends, and the prompt it raised
    # stays on screen forever with nobody left to answer it. Xcode's dialogs do not stack,
    # so each orphan sits in front of the next and the pile only grows — on 2026-08-30
    # Jonathan closed 21 of them by hand, and one of those orphans was also blocking the
    # xcode-mcp-front daemons from connecting at all.
    #
    # A review panelist has no business driving Xcode. It reads files natively in read-only
    # sandbox mode, which does not go through MCP, so dropping the servers costs the round
    # nothing. Verified both directions on 2026-08-30: with the flag, codex answers normally
    # and no dialog appears; without it, a dialog appears every time.
    #
    # CONVOCATION_CODEX_MCP=1 restores the configured servers for a round that genuinely
    # needs them. Nothing does today.
    codex)
      codex_mcp_args=(-c 'mcp_servers={}')
      [ "${CONVOCATION_CODEX_MCP:-0}" = "1" ] && codex_mcp_args=()
      run_agent codex  "$o" "$CODEX_BIN" exec --skip-git-repo-check "${codex_mcp_args[@]}" -o "$o.last" "$PROMPT" </dev/null & pids+=($!) ;;
    # ONE RETRY, BECAUSE THE KNOWN QWEN FAILURE IS TRANSIENT AND COSTS THE WHOLE PANEL.
    # OmniRoute's documented provider-wide lockout: one uncovered model returns 402, the
    # ollama-cloud connection flips to credits_exhausted, and EVERY ollamacloud model reports
    # "no active credentials" for about two minutes — including ones that answered seconds
    # earlier. The daily readiness probe cannot see this, since it may have passed hours
    # before the lockout began. GhOST-OpenClaw raised the consequence: Claude and Codex are
    # already launched and their tokens spent, and the round then completes a voice short.
    # Waiting out the lockout once is far cheaper than discarding a panel, and a second
    # failure is a real failure that still gets reported by run_agent.
    qwen)   ( run_agent qwen "$o" "$QWEN_BIN" -m "$QWEN_MODEL" -y -p "$PROMPT" \
              || { echo "panel: qwen failed; waiting out a possible OmniRoute lockout (130s) and retrying once" >&2
                   sleep 130
                   run_agent qwen "$o" "$QWEN_BIN" -m "$QWEN_MODEL" -y -p "$PROMPT"; } ) & pids+=($!) ;;
  esac
done
failed=0
for p in "${pids[@]}"; do wait "$p" || failed=1; done
echo "--- $TAG outputs in $OUT/:"
ls -la "$OUT/${TAG}_"*.md 2>/dev/null
sort "$STATUS"
[ "$failed" -eq 0 ] || { echo "panel: round INCOMPLETE — at least one voice failed" >&2; exit 1; }
