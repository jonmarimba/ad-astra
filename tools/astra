#!/usr/bin/env bash
# astra — the one front door for putting astra tools into a repo.
#
#   astra add    <tool-or-set>...   install into the current repo (or --into <repo>)
#   astra remove <tool-or-set>...   uninstall; nothing brings it back automatically
#   astra status                    what this repo asked for, what it has, hooks wired?
#   astra list                      the named sets (templates.json) and every tool
#   astra new <name> --kind <kind>  scaffold a new tool (skill, repo, repo-config, machine or
#                                   run-in-place) with its uninstaller and test; see CONTRIBUTING.md
#   astra tree [set]                how sets nest: which sets hold which sets and tools, and which
#                                   tools live above the repo ([machine], [repo-config])
#   astra doctor [dir...]           one report across the machine: the prerequisites astra needs, then
#                                   every repo beside this checkout (or under the dirs given) that has
#                                   astra tools, with its sets, update state and hook wiring
#   astra upgrade [--list] [tool...]  refresh machine software without touching any repo: runs each
#                                   tool's deps.sh (software only; never an install.sh)
#   astra sync [dir...]             once per machine or fresh clone: wire the hooks
#                                   and pull updates in every repo beside this astra
#                                   checkout (or under the dirs given) that has astra
#                                   tools. Git does
#                                   not clone hooks, so a new checkout needs this once.
#
# A name is either a set from tools/lib/templates.json (writing, legal-pdf,
# swift-ios, ...) or a single tool (check-prose, humanizer, ...). Both are
# recorded in the repo's .astra/manifest.json the same way. Removing a set
# keeps any tool another installed set still needs.
#
# After `add`, there is nothing else to manage: the post-commit and post-merge
# hooks pull updates for exactly what is installed, and nothing else.
set -euo pipefail
A="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
T="$A/tools/lib/template.py"
cmd="${1:-}"; [ $# -gt 0 ] && shift
repo=""; names=(); plan_only=0; kind=""
while [ $# -gt 0 ]; do case "$1" in
  --into) repo="${2:-}"; shift 2 ;;
  --list) plan_only=1; shift ;;
  --kind) kind="${2:-}"; shift 2 ;;
  -*) echo "astra: unknown flag $1" >&2; exit 64 ;;
  *) names+=("$1"); shift ;;
esac; done
# sync and list work from anywhere; every other command acts on one repo.
case "$cmd" in
  sync|list|tree|doctor|upgrade|new) ;;
  *) [ -n "$repo" ] || repo="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "astra: not in a git repo; pass --into <repo>" >&2; exit 64; } ;;
esac
case "$cmd" in
  add|install)
    [ ${#names[@]} -gt 0 ] || { echo "usage: astra add <tool-or-set>..." >&2; exit 64; }
    rc=0; for n in "${names[@]}"; do python3 "$T" install "$n" --into "$repo" || rc=1; done; exit $rc ;;
  remove|uninstall)
    [ ${#names[@]} -gt 0 ] || { echo "usage: astra remove <tool-or-set>..." >&2; exit 64; }
    rc=0; for n in "${names[@]}"; do python3 "$T" uninstall "$n" --into "$repo" || rc=1; done; exit $rc ;;
  status)
    python3 "$A/tools/lib/astra_manifest.py" status "$repo"
    [ -x "$repo/.astra/astra-update" ] && "$repo/.astra/astra-update" || true ;;
  sync|doctor)
    roots=("${names[@]+"${names[@]}"}"); [ ${#roots[@]} -gt 0 ] || roots=("$(dirname "$A")")   # the directory astra sits in, not a fixed home path
    seen=" "; total=0; bad=0
    if [ "$cmd" = doctor ]; then
      echo "── this machine"
      for tool in git python3 jq; do
        if command -v "$tool" >/dev/null 2>&1; then echo "  ok       $tool  ($(command -v "$tool"))"; else echo "  MISSING  $tool"; bad=$((bad+1)); fi
      done
      if python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then echo "  ok       python3 is 3.9 or newer"; else echo "  TOO OLD  python3 must be 3.9 or newer"; bad=$((bad+1)); fi
      if command -v brew >/dev/null 2>&1; then echo "  ok       brew  ($(command -v brew))"; else echo "  absent   brew (only the machine-level tools need it; 'astra upgrade --list' names them)"; fi
    fi
    for root in "${roots[@]}"; do
      while IFS= read -r m; do
        r="$(cd "$(dirname "$m")/.." && pwd -P)"
        case "$seen" in *" $r "*) continue ;; esac; seen="$seen$r "
        git -C "$r" rev-parse --git-dir >/dev/null 2>&1 || continue
        total=$((total+1))
        if [ "$cmd" = doctor ]; then
          echo; echo "── $r"
          python3 "$A/tools/lib/astra_manifest.py" status "$r" | sed 's/^/  /'
          if [ -x "$r/.astra/astra-update" ]; then
            "$r/.astra/astra-update" 2>&1 | sed 's/^/  /'
            [ "${PIPESTATUS[0]}" -eq 0 ] || bad=$((bad+1))
          else
            echo "  MISSING  .astra/astra-update (run: astra sync)"; bad=$((bad+1))
          fi
        else
          # Say what went wrong. This used to discard every error and print "synced" regardless.
          # Wiring the hooks failing is a failure. The updater exiting nonzero is not: it means a
          # file was edited by hand and kept, so show its notes under the repo and carry on.
          if out="$(python3 "$A/tools/lib/astra_manifest.py" finish "$r" 2>&1)"; then
            echo "synced $r"
            if ! upd="$("$r/.astra/astra-update" --pull 2>&1)"; then printf '%s\n' "$upd" | sed 's/^/    /'; fi
          else
            echo "astra sync: FAILED $r" >&2; printf '%s\n' "$out" | sed 's/^/    /' >&2; bad=$((bad+1))
          fi
        fi
      done < <(find -L "$root" -maxdepth 4 -path '*/.astra/manifest.json' -not -path '*/node_modules/*' -not -path '*/tmp/*')
    done
    echo; echo "astra $cmd: $total repo(s), $bad problem(s)"
    [ "$bad" -eq 0 ] ;;
  new)
    exec bash "$A/tools/lib/new-tool.sh" "${names[0]:-}" "$kind" ;;
  tree)
    python3 "$T" tree "${names[@]+"${names[@]}"}" ;;
  upgrade)
    # The machine half of an update. Re-running a repo install already upgrades a tool's dependencies,
    # but it also rewrites the repo, and software on the machine belongs to no repo. So this runs each
    # tool's deps.sh and NOTHING else. It never runs an install.sh: several of those also reload launchd
    # jobs, rewrite schedules, or rebuild a signed app wrapper, none of which an upgrade may do.
    plan=()
    for d in "$A"/tools/*/; do
      n="$(basename "$d")"
      [ -x "$d/deps.sh" ] && plan+=("$n:deps.sh")
    done
    if [ ${#names[@]} -gt 0 ]; then
      picked=()
      for n in "${names[@]}"; do
        [ -d "$A/tools/$n" ] || { echo "astra upgrade: no such tool: $n" >&2; exit 64; }
        found=0; for e in "${plan[@]+"${plan[@]}"}"; do [ "${e%%:*}" = "$n" ] && { picked+=("$e"); found=1; }; done
        [ "$found" = 1 ] || { echo "astra upgrade: $n has nothing to upgrade (no deps.sh)" >&2; exit 64; }
      done
      plan=("${picked[@]}")
    fi
    if [ "$plan_only" = 1 ]; then
      for e in "${plan[@]+"${plan[@]}"}"; do echo "  ${e%%:*}  (runs ${e#*:})"; done
      exit 0
    fi
    ok=0; failed=0; failures=()
    for e in "${plan[@]+"${plan[@]}"}"; do
      n="${e%%:*}"; script="${e#*:}"
      echo "── $n"
      if "$A/tools/$n/$script"; then ok=$((ok+1)); else failed=$((failed+1)); failures+=("$n"); echo "  FAILED: $n" >&2; fi
    done
    echo; echo "astra upgrade: $ok ok, $failed failed${failures[*]:+ (${failures[*]})}"
    [ "$failed" -eq 0 ] ;;
  list)
    python3 "$T" list
    echo; echo "── single tools (repo-level):"
    grep -l '^# astra-scope: repo' "$A"/tools/*/install.sh | sed -E 's#.*/tools/([^/]+)/install.sh#     \1#' ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 64 ;;
esac
