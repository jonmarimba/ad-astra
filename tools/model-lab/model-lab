#!/usr/bin/env bash
# model-lab — the front door on macOS and Linux. It runs model_lab.py with the first Python that is 3.8 or newer.
# On Windows, run `model-lab.cmd`, or `py -3 model_lab.py` from this folder.
set -euo pipefail
export PATH="${ASTRA_PATH:-/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
for cand in python3 python3.14 python3.13 python3.12 python3.11 python3.10 python3.9 python; do
  py="$(command -v "$cand" 2>/dev/null)" || continue
  if "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' 2>/dev/null; then
    exec "$py" "$HERE/model_lab.py" "$@"
  fi
done
echo "model-lab: needs Python 3.8 or newer, and none was found on PATH. Install one (macOS: brew install python)." >&2
exit 69
