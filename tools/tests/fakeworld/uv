#!/usr/bin/env bash
# fakeworld/uv — a stand-in uv for `uv tool install|upgrade|uninstall` and `uv self update`.
set -uo pipefail
: "${FAKE_WORLD:?fakeworld/uv needs FAKE_WORLD}"
S="$FAKE_WORLD/uv"; mkdir -p "$S" "$HOME/.local/bin"
echo "uv $*" >> "$FAKE_WORLD/uv.log"
binname() { case "$1" in graphifyy) echo graphify ;; marker-pdf) echo marker_single ;; *) echo "$1" ;; esac; }
case "${1:-}" in
  --version) echo "uv 0.0-fake" ;;
  self) [ "${2:-}" = update ] || { echo "fakeworld/uv: unsupported: $*" >&2; exit 99; } ;;
  tool)
    verb="${2:-}"; shift 2
    case "$verb" in
      install)
        for a in "$@"; do case "$a" in -*|3.*) continue ;; esac
          [ -f "$S/$a" ] && continue
          echo 1 > "$S/$a"
          printf '#!/bin/sh\necho "%s fake"\n' "$a" > "$HOME/.local/bin/$(binname "$a")"
          chmod +x "$HOME/.local/bin/$(binname "$a")"
        done ;;
      upgrade)
        for a in "$@"; do case "$a" in -*) continue ;; esac
          [ -f "$S/$a" ] || { echo "error: $a is not installed" >&2; exit 1; }
          echo $(( $(cat "$S/$a") + 1 )) > "$S/$a"
        done ;;
      uninstall)
        for a in "$@"; do case "$a" in -*) continue ;; esac
          rm -f "$S/$a" "$HOME/.local/bin/$(binname "$a")"
        done ;;
      *) echo "fakeworld/uv: unsupported: tool $verb" >&2; exit 99 ;;
    esac ;;
  *) echo "fakeworld/uv: unsupported verb: $*" >&2; exit 99 ;;
esac
