# CLI
# --------------------------------------------------------------------------- #

def _output_path(text: str) -> Path:
    # curl and most tools read "-" as stdout; silently creating a file named "-" would surprise.
    if text == "-":
        raise argparse.ArgumentTypeError("'-' (stdout) is not supported; omit -o to write to stdout")
    return Path(text)


class OrderedPart(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        parts = getattr(namespace, "parts", None)
        if parts is None:
            parts = []
            setattr(namespace, "parts", parts)
        kind = {"--text": "text", "--image": "image", "--file": "file"}[option_string]
        parts.append((kind, values if kind == "text" else Path(values)))


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Attach files and build/extend Jira comments or the description.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Setup: `jira-attach --configure` (Jira site, account email, API token).\n"
               "See the module docstring for full examples.",
    )
    parser.add_argument("issue", nargs="?", help="Issue key, e.g. MHMAPPS-1")
    parser.add_argument("files", nargs="*", type=Path,
                        help="Files to attach (trailing images/files in build/append modes)")
    parser.add_argument("--text", metavar="T", action=OrderedPart, dest="parts",
                        help="Text block (wiki in rich modes, plain in append modes)")
    parser.add_argument("--image", metavar="F", action=OrderedPart, dest="parts",
                        help="Image file, embedded inline")
    parser.add_argument("--file", metavar="F", action=OrderedPart, dest="parts",
                        help="Any file, embedded as a file card")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--comment", action="store_true", help="Create a new comment")
    mode.add_argument("--replace-comment", metavar="ID", dest="replace_comment",
                      help="Replace an existing comment (full overwrite)")
    mode.add_argument("--append-comment", metavar="ID", dest="append_comment",
                      help="Append to an existing comment (byte-safe; plain text + media)")
    mode.add_argument("--replace-description", action="store_true", dest="replace_description",
                      help="Replace the description (full overwrite)")
    mode.add_argument("--append-description", action="store_true", dest="append_description",
                      help="Append to the description (byte-safe; plain text + media)")
    parser.add_argument("--site", metavar="URL",
                        help="Jira site for this run, e.g. https://your-team.atlassian.net")
    parser.add_argument("--email", metavar="ADDRESS",
                        help="Atlassian account email for this run")
    parser.add_argument("--configure", action="store_true",
                        help=f"Prompt for site and email, save them to {CONFIG_PATH}, "
                             "and store an API token if none is held")
    parser.add_argument("--reset-token", action="store_true",
                        help="Prompt for a new API token and replace the stored one")
    parser.add_argument("--fetch-url", metavar="URL", dest="fetch_url",
                        help="GET a Jira site or api.atlassian.com URL with the stored token "
                             "and write the response body to stdout (or to --output)")
    parser.add_argument("-o", "--output", metavar="FILE", type=_output_path,
                        help="With --fetch-url: write the body to this new file instead of "
                             "stdout (never overwrites an existing file)")
    # A bare run is someone asking what this is, not a usage error: show the full help
    # and where setup stands, rather than a one-line "issue key is required".
    if len(sys.argv) == 1:
        parser.print_help()
        print(f"\n{describe_setup()}")
        return

    args = parser.parse_args()

    if args.output is not None and args.fetch_url is None:
        parser.error("--output only applies to --fetch-url")
    setup_only = args.configure or args.reset_token
    if args.fetch_url is not None:
        if _issue_work_requested(args) or setup_only:
            parser.error("--fetch-url only fetches, so it must be run without an issue, "
                         "content, a build/append mode, --configure, or --reset-token")
        # Caught here so a mistake costs no network round trip; the exclusive create in
        # _save_to_new_file is what actually guarantees no overwrite. lstat() rather than
        # pathlib's exists()/is_dir(): a dangling symlink still blocks the exclusive create,
        # and an unreachable path is an error on every Python version, where those checks
        # raise on some versions and silently answer False on others.
        if args.output is not None:
            try:
                args.output.lstat()
            except FileNotFoundError:
                pass
            except OSError as error:
                parser.error(f"--output {args.output} cannot be created: {error.strerror}")
            else:
                if os.path.isdir(args.output):
                    parser.error(f"--output {args.output} is a directory; give a file path")
                parser.error(f"--output {args.output} already exists; not overwriting it")
            if not os.path.isdir(args.output.parent):
                parser.error(f"--output directory {args.output.parent} does not exist")
        # stdout carries only the fetched bytes; any first-run prompts or status lines
        # from settings/token resolution go to stderr instead.
        with contextlib.redirect_stdout(sys.stderr):
            settings = resolve_settings(args.site, args.email, reconfigure=False)
            try:
                target = gateway_url_for_fetch(args.fetch_url, settings)
            except ValueError as error:
                parser.error(str(error))
            credentials = obtain_credentials(settings)
        size = fetch(target, credentials, args.output)
        if args.output is not None:
            print(f"Saved {args.output}  ({size / 1024:.0f} KB)")
        return

    if setup_only:
        if _issue_work_requested(args):
            parser.error("--configure and --reset-token only change stored settings, "
                         "so they must be run without an issue or content")
        settings = resolve_settings(args.site, args.email, reconfigure=args.configure)
        if args.reset_token or read_token_from_keychain(settings) is None:
            obtain_credentials(settings, force_new=args.reset_token)
        else:
            print(f"An API token is already stored for {settings.email} "
                  f"(keychain service '{settings.keychain_service}'). "
                  "Use --reset-token to replace it.")
        return

    if not args.issue:
        parser.error("an issue key is required (first time here? run `jira-attach --configure`)")
    issue = args.issue.upper()
    if not ISSUE_KEY_PATTERN.match(issue):
        parser.error(f"'{args.issue}' does not look like an issue key (e.g. MHMAPPS-1)")
    for cid in (args.replace_comment, args.append_comment):
        if cid is not None and not COMMENT_ID_PATTERN.match(cid):
            parser.error(f"comment id must be numeric (Jira comment ids are digits), got '{cid}'")

    rich = bool(args.comment or args.replace_comment or args.replace_description)
    appending = bool(args.append_comment or args.append_description)
    embedding = rich or appending

    ordered = list(getattr(args, "parts", None) or [])
    trailing = [("image" if is_image(p) else "file", p) for p in args.files]
    parts = ordered + trailing

    file_parts = [value for kind, value in parts if kind in ("image", "file")]
    _require_files(parser, file_parts)

    # All usage errors are raised before anything can prompt or hit the network.
    if not embedding:
        if any(kind == "text" for kind, _ in parts):
            parser.error("--text requires a build/append mode")
        if not file_parts:
            parser.error("at least one file is required")
    else:
        if not parts:
            parser.error("a build/append mode needs at least one --text/--image/--file (or a file)")
        if appending:
            offenders = [str(v)[:50] for k, v in parts
                         if k == "text" and WIKI_FORMATTING.search(str(v))]
            if offenders:
                parser.error(
                    "append supports PLAIN TEXT + images/files only, but a --text part contains "
                    "wiki/markdown formatting:\n    " + "\n    ".join(offenders) +
                    "\nAppend is byte-safe precisely because it does not reconvert content, so it "
                    "cannot render formatting. Post a NEW comment (--comment) or replace the "
                    "description (--replace-description) for formatted content.")

    settings = resolve_settings(args.site, args.email, reconfigure=False)
    credentials = obtain_credentials(settings)
    cloud_id = get_cloud_id(settings)
    base3 = f"{GATEWAY}/{cloud_id}/rest/api/3"
    base2 = f"{GATEWAY}/{cloud_id}/rest/api/2"

    if not embedding:
        _print_attached(issue, [attach_one(base3, credentials, issue, path) for path in file_parts])
        print(f"  {settings.site}/browse/{issue}")
        return

    # All post-attach work runs under a rollback, constructed BEFORE any upload so a
    # failure can never escape before cleanup exists. A definitive failure undoes
    # partial work; an ambiguous one (a mutating request with no response) is left in
    # place and reported, since the write may have committed. Output is deferred past
    # the transactional region so a broken pipe on success can't trigger a rollback.
    rollback = Rollback(base3, credentials, issue)
    try:
        attachments: list[dict] = []
        for path in file_parts:
            attachment = attach_one(base3, credentials, issue, path)
            rollback.attachment_ids.append(attachment["id"])
            attachments.append(attachment)

        if rich:
            # Each image/file part gets a unique plain-text placeholder token; post
            # the wiki (Jira converts text server-side), then splice real media nodes
            # in place of the tokens via v3 — so embedding is filename-independent.
            nonce = uuid.uuid4().hex[:8]
            tokens: dict[int, str] = {}
            node_for: dict[str, dict] = {}
            media_index = 0
            for index, (kind, value) in enumerate(parts):
                if kind == "text":
                    continue
                media_uuid = resolve_media_id(base3, credentials, attachments[media_index]["id"])
                media_index += 1
                tok = f"JATTACHx{nonce}x{index}xEND"
                tokens[index] = tok
                node_for[tok] = (media_single_node(media_uuid, image_size(value) if is_image(value) else None)
                                 if kind == "image" else media_group_node(media_uuid))
            wiki = assemble_wiki(parts, tokens)

            if args.comment:
                created = _require_json(
                    api("POST", f"{base2}/issue/{issue}/comment", credentials,
                        json_body={"body": wiki}),
                    "the created comment")
                rollback.delete_comment_id = created["id"]
                target, outcome = ("comment", created["id"]), f"Created comment {created['id']}."
            elif args.replace_comment:
                cid = args.replace_comment
                url3 = f"{base3}/issue/{issue}/comment/{cid}"
                old = _require_json(api("GET", url3, credentials), "the comment")["body"]
                rollback.restore = (url3, {"body": old})
                api("PUT", f"{base2}/issue/{issue}/comment/{cid}", credentials,
                    json_body={"body": wiki})
                target, outcome = ("comment", cid), f"Replaced comment {cid}."
            else:
                old = _require_json(api("GET", f"{base3}/issue/{issue}?fields=description", credentials),
                                    "the description")["fields"].get("description")
                rollback.restore = (f"{base3}/issue/{issue}", {"fields": {"description": old}})
                api("PUT", f"{base2}/issue/{issue}", credentials,
                    json_body={"fields": {"description": wiki}})
                target, outcome = ("description", None), "Replaced the description."

            if node_for:
                splice_media(base3, credentials, issue, target, node_for)
        else:
            # Append: resolve media in part order, build ADF nodes, concatenate onto
            # the existing ADF, PUT via v3 (byte-safe).
            resolved = [
                (resolve_media_id(base3, credentials, attachment["id"]),
                 image_size(path) if is_image(path) else None)
                for path, attachment in zip(file_parts, attachments)
            ]
            media_iter = iter(resolved)
            new_nodes: list[dict] = []
            for kind, value in parts:
                if kind == "text":
                    new_nodes.extend(plain_paragraphs(str(value)))
                elif kind == "image":
                    media_uuid, size = next(media_iter)
                    new_nodes.append(media_single_node(media_uuid, size))
                else:
                    media_uuid, _ = next(media_iter)
                    new_nodes.append(media_group_node(media_uuid))
            if not new_nodes:
                sys.exit("Nothing to append — the content was empty.")

            if args.append_comment:
                cid = args.append_comment
                url3 = f"{base3}/issue/{issue}/comment/{cid}"
                existing = _require_json(api("GET", url3, credentials), "the comment")["body"]
                existing["content"] = existing.get("content", []) + new_nodes
                api("PUT", url3, credentials, json_body={"body": existing})
                outcome = f"Appended {len(new_nodes)} node(s) to comment {cid}."
            else:
                data = _require_json(api("GET", f"{base3}/issue/{issue}?fields=description", credentials),
                                     "the description")
                existing = data["fields"].get("description")
                if isinstance(existing, dict) and isinstance(existing.get("content"), list):
                    existing["content"] = existing["content"] + new_nodes
                else:
                    existing = {"type": "doc", "version": 1, "content": new_nodes}
                api("PUT", f"{base3}/issue/{issue}", credentials,
                    json_body={"fields": {"description": existing}})
                outcome = f"Appended {len(new_nodes)} node(s) to the description."
    except _Ambiguous as error:
        rollback.run(destructive=False)
        sys.exit(str(error))
    except BaseException:
        rollback.run(destructive=True)
        raise

    if attachments:
        _print_attached(issue, attachments)
    print(outcome)
    print(f"  {settings.site}/browse/{issue}")


def _issue_work_requested(args: argparse.Namespace) -> bool:
    """True when the command line names an issue, content, or a build/append mode. Every
    standalone mode must reject all of these, so the list lives here once and a new
    content option or mode cannot slip past one mode's check."""
    return bool(args.issue or args.files or args.parts
                or args.comment or args.replace_comment or args.append_comment
                or args.replace_description or args.append_description)


def _require_files(parser: argparse.ArgumentParser, paths: list[Path]) -> None:
    missing = [str(p) for p in paths if not p.is_file()]
    if missing:
        parser.error("file not found: " + ", ".join(missing))


def _print_attached(issue: str, attachments: list[dict]) -> None:
    print(f"Attached {len(attachments)} file(s) to {issue}:")
    for attachment in attachments:
        print(f"  {attachment['filename']}  ({attachment.get('size', 0) / 1024:.0f} KB)")


if __name__ == "__main__":
    main()
