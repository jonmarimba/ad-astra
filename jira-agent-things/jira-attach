class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


class _StripAuthCrossOrigin(urllib.request.HTTPRedirectHandler):
    """Follow redirects, but never carry the Authorization header to a different
    origin — otherwise a redirect off api.atlassian.com would leak the token. Any
    redirect to a non-https URL is refused: on the same host it would send the token
    in plaintext, on another host the content; nothing legitimate here leaves https."""
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        target = urlsplit(newurl)
        if target.scheme != "https":
            raise urllib.error.HTTPError(req.full_url, code, f"{msg}; refusing redirect to "
                                         f"non-https URL {newurl}", headers, fp)
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None and target.netloc.lower() != urlsplit(req.full_url).netloc.lower():
            new.remove_header("Authorization")
        return new


_no_redirect_opener = urllib.request.build_opener(_NoRedirect)
_opener = urllib.request.build_opener(_StripAuthCrossOrigin)


def _opener_for(method: str) -> urllib.request.OpenerDirector:
    """Only reads follow redirects. urllib re-sends a redirected POST as a GET of the
    new URL and hands back that body as if it were the write's response, and a
    redirect on a write says nothing certain about whether it committed."""
    return _opener if method == "GET" else _no_redirect_opener


def _write_outcome_unknown(status: int) -> bool:
    """Whether a write answered with this status may or may not have committed. A 5xx
    can follow a commit, and a 3xx (303 See Other above all) can report one; only a
    4xx is a definite rejection."""
    return 300 <= status < 400 or status >= 500


def get_cloud_id(settings: Settings) -> str:
    override = os.environ.get("JIRA_CLOUD_ID")
    if override:
        return override
    try:
        with urllib.request.urlopen(f"{settings.site}/_edge/tenant_info",
                                    timeout=HTTP_TIMEOUT) as response:
            return json.loads(response.read())["cloudId"]
    except (urllib.error.URLError, KeyError, json.JSONDecodeError) as error:
        sys.exit(f"Could not fetch cloudId from {settings.site}/_edge/tenant_info: {error}")


def api(method: str, url: str, credentials: Credentials, *, json_body=None) -> dict | list | None:
    data = json.dumps(json_body).encode() if json_body is not None else None
    headers = {"Authorization": credentials.auth_header, "Accept": "application/json"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with _opener_for(method).open(request, timeout=HTTP_TIMEOUT) as response:
            raw = response.read()
            return json.loads(raw) if raw else None
    except urllib.error.HTTPError as error:
        # Ambiguous like a lost connection, so rollback must not delete anything.
        if method in ("POST", "PUT") and _write_outcome_unknown(error.code):
            body = error.read().decode(errors="replace")
            raise _Ambiguous(f"Jira returned {error.code} {error.reason}{_redirect_note(error)} to a "
                             f"{method} ({url}); the write may or may not have committed — verify "
                             f"the issue.\n{body}")
        _die_http(error, url)
    except urllib.error.URLError as error:
        # A GET that never reached the server is a safe, definitive failure. A POST/PUT
        # with no response may or may not have committed — surface that ambiguity.
        if method in ("POST", "PUT"):
            raise _Ambiguous(f"Network error during a {method} to {url} ({error.reason}); "
                             "the write may or may not have committed — verify the issue.")
        sys.exit(f"Could not reach the Jira gateway: {error.reason}")


def _redirect_note(error: urllib.error.HTTPError) -> str:
    location = error.headers.get("Location") if error.headers else None
    return f" (redirect to {location})" if location else ""


def _die_http(error: urllib.error.HTTPError, url: str) -> None:
    detail = error.read().decode(errors="replace")
    if error.code == 401 and "scope does not match" in detail:
        detail += ("\n\nThe stored token is valid but lacks a scope this endpoint needs. "
                   f"Create a token with that scope, or a classic (unscoped) one, at {TOKEN_URL}, "
                   "then re-run with --reset-token.")
    elif error.code == 401:
        detail += "\n\nThe stored token may be revoked. Re-run with --reset-token."
    elif error.code == 404:
        # Jira answers 404, not 403, when the token lacks permission to see a resource,
        # so "missing" and "hidden" are indistinguishable here.
        detail += ("\n\nEither it does not exist or the stored token can't see it. If it "
                   "exists, the token likely lacks the coarse 'read:jira-work' scope. Create "
                   f"one with that scope, or a classic (unscoped) one, at {TOKEN_URL}, then "
                   "re-run with --reset-token.")
    sys.exit(f"Jira returned {error.code} {error.reason} for {url}\n{detail}")


def _require_json(result, what: str):
    if result is None:
        sys.exit(f"Unexpected empty response from Jira where {what} was expected.")
    return result


def _best_effort(method: str, url: str, credentials: Credentials, json_body=None) -> bool:
    """A DELETE/PUT used only for rollback cleanup; never raises. Returns whether
    the request appeared to succeed (2xx)."""
    data = json.dumps(json_body).encode() if json_body is not None else None
    headers = {"Authorization": credentials.auth_header}
    if data is not None:
        headers["Content-Type"] = "application/json"
    try:
        with _opener_for(method).open(urllib.request.Request(url, data=data, method=method,
                                                             headers=headers),
                                      timeout=HTTP_TIMEOUT) as response:
            return 200 <= response.status < 300
    except Exception:
        return False


class Rollback:
    """Undo partial work when an embed/append fails, so an automated retry stays
    clean: restore replaced content, delete a just-created comment, and remove the
    attachments uploaded this run.

    Order matters for safety: content (a replaced comment/description or a just-
    created comment) is cleaned up FIRST, and the uploaded attachments are removed
    only if that succeeded — otherwise the attachments may still be referenced, so
    they are left in place and the failure is reported truthfully."""

    def __init__(self, base3: str, credentials: Credentials, issue: str):
        self.base3, self.credentials, self.issue = base3, credentials, issue
        self.attachment_ids: list[str] = []
        self.delete_comment_id: str | None = None
        self.restore: tuple[str, dict] | None = None

    def run(self, destructive: bool = True) -> None:
        if not destructive:
            if self.attachment_ids or self.delete_comment_id or self.restore:
                print(f"Left partial work in place ({len(self.attachment_ids)} attachment(s)) "
                      "because the outcome is uncertain — verify the issue and clean up if needed.",
                      file=sys.stderr)
            return

        actions: list[str] = []
        content_ok = True
        if self.restore:
            ok = _best_effort("PUT", self.restore[0], self.credentials, self.restore[1])
            content_ok = content_ok and ok
            actions.append("restored prior content" if ok else "FAILED to restore prior content")
        if self.delete_comment_id:
            ok = _best_effort("DELETE", f"{self.base3}/issue/{self.issue}/comment/{self.delete_comment_id}", self.credentials)
            content_ok = content_ok and ok
            actions.append(f"deleted comment {self.delete_comment_id}" if ok
                           else f"FAILED to delete comment {self.delete_comment_id}")
        if self.attachment_ids:
            if content_ok:
                removed = sum(_best_effort("DELETE", f"{self.base3}/attachment/{aid}", self.credentials)
                              for aid in self.attachment_ids)
                actions.append(f"removed {removed}/{len(self.attachment_ids)} attachment(s)")
            else:
                actions.append(f"LEFT {len(self.attachment_ids)} attachment(s) in place "
                               "(content cleanup failed; remove manually if orphaned)")
        if actions:
            print("Rollback: " + "; ".join(actions) + ".", file=sys.stderr)


# --------------------------------------------------------------------------- #
# Fetch a URL to stdout
# --------------------------------------------------------------------------- #

def has_dot_segment(path: str) -> bool:
    """Whether path holds a "." or ".." segment, including encoded forms (%2e%2e,
    ..%2F, ..%5C) and Tomcat-style ";parameters" (..;x), all of which servers resolve."""
    segments = PATH_SEPARATOR_PATTERN.split(unquote(path))
    return any(segment.split(";", 1)[0] in DOT_SEGMENTS for segment in segments)


def gateway_url_for_fetch(url: str, settings: Settings) -> str:
    """The api.atlassian.com URL to GET for a user-supplied site or gateway URL.

    Hosts are matched exactly (no userinfo, no port) because the request carries the
    API token: anything other than the configured site or the gateway is refused.
    Site URLs are rewritten because scoped tokens are only accepted by the gateway."""
    parts = urlsplit(url.strip())
    # A hand-typed URL often holds raw spaces or non-ASCII (e.g. JQL), which http.client
    # rejects outright. Escape them the way a browser would before building the target.
    path = quote(parts.path, safe=URL_LEGAL_CHARACTERS)
    query = quote(parts.query, safe=URL_LEGAL_CHARACTERS)
    if parts.scheme != "https":
        raise ValueError(f"'{url}' is not an https URL")
    host = parts.netloc.lower()
    site_host = urlsplit(settings.site).netloc.lower()
    if host not in (GATEWAY_HOST, site_host):
        raise ValueError(f"refusing to send the Jira API token to '{parts.netloc}'; only "
                         f"{site_host} and {GATEWAY_HOST} URLs can be fetched")
    if has_dot_segment(path):
        # The gateway resolves "." and ".." (RFC 3986 section 5.2.4), so one could climb
        # out of the /ex/jira/ or /rest/ prefix checked below into another product's API.
        raise ValueError(f"'{url}' has a '.' or '..' path segment; give the resolved URL")
    if host == GATEWAY_HOST:
        if not path.startswith("/ex/jira/"):
            raise ValueError(f"'{url}' is not a Jira gateway URL (expected "
                             f"https://{GATEWAY_HOST}/ex/jira/<cloudId>/...)")
        return f"https://{GATEWAY_HOST}{path}" + (f"?{query}" if query else "")
    attachment = ATTACHMENT_PAGE_PATH.match(path)
    if attachment:
        path, query = f"/rest/api/3/attachment/content/{attachment.group(1)}", ""
    elif not path.startswith("/rest/"):
        raise ValueError(f"'{url}' is not a Jira REST or attachment URL (expected "
                         f"{settings.site}/rest/... or {settings.site}/secure/attachment/<id>/...)")
    return f"{GATEWAY}/{get_cloud_id(settings)}{path}" + (f"?{query}" if query else "")


def fetch(url: str, credentials: Credentials, destination: Path | None) -> int | None:
    """Stream the response body as raw bytes (so binary attachments survive) to a new
    file at destination, or to stdout when there is none. Returns the byte count
    written to the file. Redirects (e.g. attachment content -> media host) are
    followed without carrying the token off-origin.

    The file is only created once the server has answered with success, so an HTTP
    error never leaves an empty file behind. A body cut short of its Content-Length, or
    an interruption, fails the fetch instead of passing as complete."""
    request = urllib.request.Request(
        url, headers={"Authorization": credentials.auth_header, "Accept": "*/*"})
    incomplete = (f"nothing was saved to {destination}" if destination is not None
                  else "any output written is incomplete")
    replaced_handlers = _raise_on_termination_signals()
    try:
        with _opener_for("GET").open(request, timeout=HTTP_TIMEOUT) as response:
            if destination is not None:
                return _save_to_new_file(response, destination)
            # Like curl: binary written to a terminal garbles it, so refuse before any
            # byte is written. Pipes and redirects are never inspected or altered.
            if sys.stdout.isatty():
                head = response.read(TERMINAL_SNIFF_BYTES)
                if _looks_binary(head):
                    sys.exit(f"{url} returned binary or non-UTF-8 data; not writing it to "
                             "the terminal. Save it with -o FILE or > FILE.")
                sys.stdout.buffer.write(head)
            _copy_whole_body(response, sys.stdout.buffer)
            sys.stdout.buffer.flush()
            return None
    except urllib.error.HTTPError as error:
        _die_http(error, url)
    except urllib.error.URLError as error:
        sys.exit(f"Could not fetch {url}: {error.reason}")
    except BrokenPipeError:
        # The reader went away early (e.g. `| head`). Point stdout at /dev/null so the
        # interpreter's final flush can't raise a second BrokenPipeError at exit.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)
    except (TimeoutError, socket.timeout):
        # socket.timeout only became an alias of TimeoutError in Python 3.10.
        sys.exit(f"Timed out fetching {url}; {incomplete}.")
    except (OSError, http.client.HTTPException) as error:
        # A dropped connection, a body short of its Content-Length, or a failed write.
        sys.exit(f"Fetching {url} failed: {error!r}; {incomplete}.")
    except (KeyboardInterrupt, _TerminationSignal) as interruption:
        print(f"Interrupted; {incomplete}.", file=sys.stderr)
        _die_by_signal(interruption.signum if isinstance(interruption, _TerminationSignal)
                       else signal.SIGINT)
    finally:
        for signum, handler in replaced_handlers.items():
            signal.signal(signum, handler)


def _looks_binary(head: bytes) -> bool:
    """curl's test (a NUL byte) plus invalid UTF-8, which also catches the PDFs and
    other binaries whose opening bytes hold no NUL. The decoder is left non-final so a
    multibyte character cut off at the end of head is not mistaken for binary."""
    if b"\0" in head:
        return True
    try:
        codecs.getincrementaldecoder("utf-8")().decode(head)
    except UnicodeDecodeError:
        return True
    return False


def _copy_whole_body(response: http.client.HTTPResponse, sink) -> None:
    shutil.copyfileobj(response, sink)
    # http.client ends a body cut short of its Content-Length with a quiet EOF and
    # leaves the missing byte count in .length. It is None when the body isn't framed
    # by Content-Length: chunked raises IncompleteRead itself, and read-to-close has
    # nothing to check against.
    if response.length:
        raise http.client.HTTPException(
            f"body ended {response.length} byte(s) short of its Content-Length")


class _TerminationSignal(BaseException):
    """Raised by the SIGTERM/SIGHUP handler so a fetch unwinds through its cleanup
    instead of the process vanishing mid-write. A BaseException, like
    KeyboardInterrupt, so no `except Exception` swallows it."""
    def __init__(self, signum: int):
        super().__init__(signum)
        self.signum = signum


def _raise_termination_signal(signum: int, frame) -> None:
    raise _TerminationSignal(signum)


def _raise_on_termination_signals() -> dict:
    """Route SIGTERM and SIGHUP (e.g. the terminal closing) through _TerminationSignal
    and return the handlers replaced. A signal the parent set to be ignored (nohup)
    stays ignored."""
    replaced = {}
    for signum in TERMINATION_SIGNALS:
        if signal.getsignal(signum) is signal.SIG_DFL:
            replaced[signum] = signal.signal(signum, _raise_termination_signal)
    return replaced


def _die_by_signal(signum: int) -> None:
    """Exit the way the signal itself would have, now that cleanup has run. Shells
    check for this: a bash loop stops on a child killed by SIGINT, but carries on
    after a plain exit status of 130."""
    signal.signal(signum, signal.SIG_DFL)
    os.kill(os.getpid(), signum)
    raise SystemExit(128 + signum)  # the default action terminates before this line


def _save_to_new_file(source: http.client.HTTPResponse, destination: Path) -> int:
    """Copy source into destination, which must not exist yet. Exclusive creation
    claims the name atomically, so a file that appears after the up-front check is
    still never overwritten. A failed copy removes the partial file (which this call
    created) so a retry starts clean."""
    try:
        file = open(destination, "xb")
    except FileExistsError:
        sys.exit(f"{destination} already exists; not overwriting it.")
    except OSError as error:
        sys.exit(f"Could not create {destination}: {error.strerror}")
    try:
        with file:
            _copy_whole_body(source, file)
            return file.tell()
    except BaseException:
        destination.unlink(missing_ok=True)
        raise


# --------------------------------------------------------------------------- #
# Attach + media-id resolution
# --------------------------------------------------------------------------- #

def _header_filename(name: str) -> str:
    """RFC 6266 quoted-string safety: drop CR/LF (which would inject header lines)
    and escape backslash and double-quote so the Content-Disposition can't break."""
    return name.replace("\r", "").replace("\n", "").replace("\\", "\\\\").replace('"', '\\"')


def build_multipart_body(paths: list[Path]) -> tuple[bytes, str]:
    boundary = f"----jira-attach-{uuid.uuid4().hex}"
    parts: list[bytes] = []
    for path in paths:
        content_type = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
        parts.append(
            f"--{boundary}\r\n"
            f'Content-Disposition: form-data; name="file"; filename="{_header_filename(path.name)}"\r\n'
            f"Content-Type: {content_type}\r\n\r\n".encode()
        )
        parts.append(path.read_bytes())
        parts.append(b"\r\n")
    parts.append(f"--{boundary}--\r\n".encode())
    return b"".join(parts), boundary


def attach_one(base3: str, credentials: Credentials, issue: str, path: Path) -> dict:
    """Upload a SINGLE file and return its attachment record. Uploading one file per
    request makes each response unambiguously that file's — no reliance on multi-file
    response ordering (which Jira does not guarantee), so duplicate basenames or a
    reordered batch can never bind media to the wrong content part."""
    body, boundary = build_multipart_body([path])
    request = urllib.request.Request(
        f"{base3}/issue/{issue}/attachments", data=body, method="POST",
        headers={
            "Authorization": credentials.auth_header,
            "X-Atlassian-Token": "no-check",
            "Content-Type": f"multipart/form-data; boundary={boundary}",
            "Accept": "application/json",
        },
    )
    try:
        with _opener_for("POST").open(request, timeout=HTTP_TIMEOUT) as response:
            records = json.loads(response.read())
    except urllib.error.HTTPError as error:
        # Still a definitive failure for rollback (no content references this run's
        # uploads yet), but the message must not claim the file was not stored.
        if _write_outcome_unknown(error.code):
            body = error.read().decode(errors="replace")
            sys.exit(f"Jira returned {error.code} {error.reason}{_redirect_note(error)} uploading "
                     f"{path.name}; it may or may not have been attached — verify {issue}'s "
                     f"attachments.\n{body}")
        _die_http(error, f"{base3}/issue/{issue}/attachments")
    except urllib.error.URLError as error:
        # An attachment is not referenced by any content yet, so cleanup of the other
        # confirmed uploads is safe — treat this as a definitive failure.
        sys.exit(f"Could not reach the Jira gateway uploading {path.name}: {error.reason}")
    if len(records) != 1:
        sys.exit(f"Uploading {path.name} returned {len(records)} record(s); expected 1.")
    return records[0]


def resolve_media_id(base3: str, credentials: Credentials, attachment_id: str) -> str:
    request = urllib.request.Request(
        f"{base3}/attachment/content/{attachment_id}",
        headers={"Authorization": credentials.auth_header},
    )
    try:
        _no_redirect_opener.open(request, timeout=HTTP_TIMEOUT)
    except urllib.error.HTTPError as error:
        if error.code in (301, 302, 303, 307, 308):
            match = UUID_IN_MEDIA_URL.search(error.headers.get("Location", ""))
            if match:
                return match.group(1)
            sys.exit(f"No media id in redirect for attachment {attachment_id}.")
        _die_http(error, f"{base3}/attachment/content/{attachment_id}")
    except urllib.error.URLError as error:
        sys.exit(f"Could not reach the Jira gateway: {error.reason}")
    sys.exit(f"Expected a redirect resolving media id for attachment {attachment_id}.")


# --------------------------------------------------------------------------- #
# Image dimensions (png / jpeg / gif)
# --------------------------------------------------------------------------- #

def image_size(path: Path) -> tuple[int, int] | None:
    """Best-effort width/height from the header. Returns None (embed at natural
    size) for unknown formats or unreadable/truncated files — never raises."""
    try:
        with open(path, "rb") as handle:
            head = handle.read(26)
        if len(head) >= 24 and head[:8] == b"\x89PNG\r\n\x1a\n" and head[12:16] == b"IHDR":
            return struct.unpack(">II", head[16:24])
        if len(head) >= 10 and head[:6] in (b"GIF87a", b"GIF89a"):
            return struct.unpack("<HH", head[6:10])
        if head[:2] == b"\xff\xd8":
            return _jpeg_size(path)
    except (struct.error, OSError):
        return None
    return None


def _jpeg_size(path: Path) -> tuple[int, int] | None:
    with open(path, "rb") as handle:
        handle.read(2)
        while True:
            marker = handle.read(2)
            if len(marker) < 2 or marker[0] != 0xFF:
                return None
            kind = marker[1]
            if 0xC0 <= kind <= 0xCF and kind not in (0xC4, 0xC8, 0xCC):
                handle.read(3)
                height, width = struct.unpack(">HH", handle.read(4))
                return width, height
            length = handle.read(2)
            if len(length) < 2:
                return None
            handle.seek(struct.unpack(">H", length)[0] - 2, 1)


def is_image(path: Path) -> bool:
    guessed = mimetypes.guess_type(path.name)[0] or ""
    return guessed.startswith("image/")


