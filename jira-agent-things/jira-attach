# ADF construction (append path)
# --------------------------------------------------------------------------- #

def plain_paragraphs(text: str) -> list[dict]:
    """Plain text -> paragraph nodes: blank lines split paragraphs, single
    newlines become hardBreaks. Empty input yields nothing."""
    nodes: list[dict] = []
    for block in re.split(r"\n\s*\n", text.strip()):
        block = block.strip("\n")
        if not block:
            continue
        content: list[dict] = []
        for i, line in enumerate(block.split("\n")):
            if i:
                content.append({"type": "hardBreak"})
            if line:
                content.append({"type": "text", "text": line})
        nodes.append({"type": "paragraph", "content": content or [{"type": "text", "text": ""}]})
    return nodes


def media_single_node(media_uuid: str, size: tuple[int, int] | None) -> dict:
    attrs = {"type": "file", "id": media_uuid, "collection": ""}
    if size:
        attrs["width"], attrs["height"] = size
    return {"type": "mediaSingle", "attrs": {"layout": "center"},
            "content": [{"type": "media", "attrs": attrs}]}


def media_group_node(media_uuid: str) -> dict:
    return {"type": "mediaGroup",
            "content": [{"type": "media", "attrs": {"type": "file", "id": media_uuid, "collection": ""}}]}


# --------------------------------------------------------------------------- #
# Parts -> wiki (rich path)
# --------------------------------------------------------------------------- #

def assemble_wiki(parts: list[tuple[str, object]], tokens: dict[int, str]) -> str:
    """Wiki string: text parts verbatim; each image/file part is emitted as its
    plain-text placeholder token (spliced to a media node afterward), so no
    filename ever appears in the wiki and any filename is safe."""
    blocks = [str(value) if kind == "text" else tokens[index]
              for index, (kind, value) in enumerate(parts)]
    return "\n\n".join(blocks)


def _paragraph_text(node: dict) -> str | None:
    if node.get("type") != "paragraph":
        return None
    return "".join(c.get("text", "") for c in node.get("content", [])
                   if c.get("type") == "text").strip()


def _splice_nodes(content: list[dict], node_for: dict[str, dict]) -> list[dict]:
    """Replace each standalone-placeholder paragraph with its media node. Aborts
    if any placeholder is missing, rather than leaving a broken/partial embed."""
    remaining = set(node_for)
    out: list[dict] = []
    for node in content:
        text = _paragraph_text(node)
        if text is not None and text in node_for:
            out.append(node_for[text])
            remaining.discard(text)
        else:
            out.append(node)
    if remaining:
        sys.exit("Media placeholder(s) not found after wiki conversion — aborting to "
                 "avoid a broken embed. Missing: " + ", ".join(sorted(remaining)))
    return out


def splice_media(base3: str, credentials: Credentials, issue: str,
                 target: tuple[str, str | None], node_for: dict[str, dict]) -> None:
    kind, cid = target
    if kind == "comment":
        url = f"{base3}/issue/{issue}/comment/{cid}"
        doc = _require_json(api("GET", url, credentials), "the comment")["body"]
        doc["content"] = _splice_nodes(doc.get("content", []), node_for)
        api("PUT", url, credentials, json_body={"body": doc})
    else:
        data = _require_json(api("GET", f"{base3}/issue/{issue}?fields=description", credentials),
                             "the description")
        doc = data["fields"]["description"]
        doc["content"] = _splice_nodes(doc.get("content", []), node_for)
        api("PUT", f"{base3}/issue/{issue}", credentials, json_body={"fields": {"description": doc}})


