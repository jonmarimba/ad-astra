GATEWAY_HOST = "api.atlassian.com"
GATEWAY = f"https://{GATEWAY_HOST}/ex/jira"
DEFAULT_KEYCHAIN_SERVICE = "atlassian-api-token"
CONFIG_PATH = Path(os.environ.get("JIRA_ATTACH_CONFIG")
                   or Path.home() / ".config" / "jira-attach" / "config.json")
TOKEN_URL = "https://id.atlassian.com/manage-profile/security/api-tokens"

HTTP_TIMEOUT = 60          # seconds, per network request
# How much of a fetched body is inspected for binary before any of it reaches a terminal.
TERMINAL_SNIFF_BYTES = 64 * 1024
KEYCHAIN_TIMEOUT = 15      # seconds, per `security` invocation

ISSUE_KEY_PATTERN = re.compile(r"^[A-Z][A-Z0-9]*-\d+$")
COMMENT_ID_PATTERN = re.compile(r"^\d+$")
UUID_IN_MEDIA_URL = re.compile(r"/file/([0-9a-fA-F-]{36})")
ATTACHMENT_PAGE_PATH = re.compile(r"^/secure/attachment/(\d+)(/|$)")
# Every character that is legal in a URL path or query; quote() escapes everything
# else (spaces, control characters, non-ASCII) and leaves existing %XX escapes alone.
URL_LEGAL_CHARACTERS = "%!$&'()*+,/:;=?@[]~"
# What lenient servers treat as a path separator once %XX escapes are decoded.
PATH_SEPARATOR_PATTERN = re.compile(r"[/\\]")
DOT_SEGMENTS = (".", "..")
TERMINATION_SIGNALS = (signal.SIGTERM, signal.SIGHUP)


class _Ambiguous(Exception):
    """A mutating request failed with no server response, so it may or may not have
    committed. Destructive rollback is unsafe (it could delete a committed write's
    attachment), so these are handled without deleting."""

# Conservative detector for wiki/markdown formatting that append cannot honor.
# Deliberately targets clear intent (headings, macros, lists, tables, links,
# paired emphasis) and leaves genuinely ambiguous punctuation alone.
WIKI_FORMATTING = re.compile(
    r"""(^\s*h[1-6]\.\s)             # h1. .. h6. headings
      | (^\s*bq\.\s)                 # bq. blockquote
      | (^\s{0,3}[-*#]+\s+\S)        # * - # list items (wiki + markdown)
      | (^\s{0,3}\d+\.\s+\S)         # markdown 1. ordered list
      | (^\s*>\s+\S)                 # markdown > blockquote
      | (^\s*\|\|?)                  # || table header / | table row
      | (\{(code|noformat|panel|quote|color|expand|tip|note|info|warning|section|column)[:}\s])  # wiki macros
      | (\{\{.+?\}\})                # {{monospaced}}
      | (`[^`\n]+`)                  # `inline code`
      | (\[[^\]|]*\|[^\]]*\])        # [text|url] wiki links
      | (\[[^\]]*://[^\]]*\])        # [http://url] bracketed link
      | ((?<![\w*])\*[^\s*./][^*\n]*\*(?![\w*]))  # *bold* (excludes *.glob paths)
      | ((?<![\w_])_[^\s_][^_\n]*_(?![\w_]))    # _italic_
      | (\*\*[^\s*][^*\n]*\*\*)      # markdown **bold**
      | (\[[^\]]*\]\([^)]*\))        # markdown [text](url)
    """,
    re.MULTILINE | re.VERBOSE,
)


# --------------------------------------------------------------------------- #
# Settings (site / email / keychain service)
# --------------------------------------------------------------------------- #

@dataclass(frozen=True)
class Settings:
    """Who we are and where we talk to. Resolved once, then passed explicitly."""
    site: str
    email: str
    keychain_service: str


@dataclass(frozen=True)
class Credentials:
    """An authenticated identity: the email the token belongs to, and the token."""
    email: str
    token: str

    @property
    def auth_header(self) -> str:
        return "Basic " + base64.b64encode(f"{self.email}:{self.token}".encode()).decode()


CONFIG_KEYS = ("site", "email", "keychain_service")


def load_config() -> dict[str, str]:
    """Read the saved settings. A missing file is normal (first run); a malformed one
    is an error rather than a silent reset, so a typo is never mistaken for 'unset'."""
    try:
        raw = CONFIG_PATH.read_text()
    except FileNotFoundError:
        return {}
    except OSError as error:
        sys.exit(f"Could not read {CONFIG_PATH}: {error}")
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as error:
        sys.exit(f"{CONFIG_PATH} is not valid JSON ({error}). Fix or delete it, "
                 "then re-run with --configure.")
    if not isinstance(data, dict):
        sys.exit(f"{CONFIG_PATH} must contain a JSON object. Fix or delete it, "
                 "then re-run with --configure.")
    bad = [key for key in CONFIG_KEYS if key in data and not isinstance(data[key], str)]
    if bad:
        sys.exit(f"{CONFIG_PATH} has non-string value(s) for: {', '.join(bad)}. "
                 "Fix or delete it, then re-run with --configure.")
    return {key: data[key] for key in CONFIG_KEYS if key in data}


def save_config(settings: Settings) -> None:
    """Persist settings for later runs. Written user-only and replaced atomically, so
    a crash mid-write cannot leave a half-written config behind."""
    data = {"site": settings.site, "email": settings.email}
    if settings.keychain_service != DEFAULT_KEYCHAIN_SERVICE:
        data["keychain_service"] = settings.keychain_service
    temporary = CONFIG_PATH.with_name(CONFIG_PATH.name + f".{os.getpid()}.tmp")
    try:
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        temporary.write_text(json.dumps(data, indent=2) + "\n")
        temporary.chmod(0o600)
        os.replace(temporary, CONFIG_PATH)
    except OSError as error:
        temporary.unlink(missing_ok=True)
        sys.exit(f"Could not write {CONFIG_PATH}: {error}")
    print(f"Saved settings to {CONFIG_PATH}")


def normalize_site(raw: str) -> str:
    """'enharmonichq.atlassian.net', with or without scheme or trailing path, becomes
    'https://enharmonichq.atlassian.net'."""
    site = raw.strip().rstrip("/")
    if "://" not in site:
        site = "https://" + site
    parts = urlsplit(site)
    if parts.scheme not in ("http", "https") or not parts.netloc:
        raise ValueError(f"'{raw}' is not a site URL (expected https://your-team.atlassian.net)")
    if "." not in parts.netloc:
        raise ValueError(f"'{raw}' is missing a domain (expected https://your-team.atlassian.net)")
    return f"{parts.scheme}://{parts.netloc}"


def validate_email(raw: str) -> str:
    email = raw.strip()
    if "@" not in email or email.split("@")[-1].count(".") < 1 or any(c.isspace() for c in email):
        raise ValueError(f"'{raw}' is not an email address (the Atlassian account's login email)")
    return email


def _ask(label: str, current: str | None, validate, example: str) -> str:
    # A current value demonstrates the format on its own, so the example is only shown
    # when there is nothing to default to.
    prompt = f"{label} [{current}]: " if current else f"{label} (e.g. {example}): "
    while True:
        try:
            answer = input(prompt).strip() or (current or "")
        except (EOFError, OSError):
            sys.exit("Setup needs an interactive terminal. Run `jira-attach --configure` from a "
                     "terminal, or pass --site/--email (or set JIRA_SITE/JIRA_EMAIL).")
        if not answer:
            print("  A value is required.")
            continue
        try:
            return validate(answer)
        except ValueError as error:
            print(f"  {error}")


def describe_setup() -> str:
    """One line on whether this machine is set up, for the no-arguments help."""
    stored = load_config()
    site = os.environ.get("JIRA_SITE") or stored.get("site")
    email = os.environ.get("JIRA_EMAIL") or stored.get("email")
    if site and email:
        return f"Set up for {email} at {site} — run `jira-attach --configure` to change it."
    return "Not set up yet — run `jira-attach --configure` to get started."


def _first_provided(*candidates: tuple[str | None, str]) -> tuple[str | None, str | None]:
    """The highest-precedence value that was actually provided, with the name of where
    it came from — so an invalid value can be reported against its real source."""
    for value, origin in candidates:
        if value:
            return value, origin
    return None, None


def resolve_settings(site_option: str | None, email_option: str | None,
                     *, reconfigure: bool) -> Settings:
    """Settings come from (in order) the command line, the environment, the config
    file, then a prompt. Prompted values — and only those — are saved, so --site and
    --email stay one-run overrides."""
    stored = load_config()
    site, site_origin = _first_provided((site_option, "--site"),
                                        (os.environ.get("JIRA_SITE"), "JIRA_SITE"),
                                        (stored.get("site"), str(CONFIG_PATH)))
    email, email_origin = _first_provided((email_option, "--email"),
                                          (os.environ.get("JIRA_EMAIL"), "JIRA_EMAIL"),
                                          (stored.get("email"), str(CONFIG_PATH)))
    service = (os.environ.get("JIRA_KEYCHAIN_SERVICE") or stored.get("keychain_service")
               or DEFAULT_KEYCHAIN_SERVICE)

    # Outside --configure a bad value is fatal: silently prompting past it would hide
    # a typo in the config or the environment. --configure is how you fix one.
    if not reconfigure:
        for value, origin, normalize in ((site, site_origin, normalize_site),
                                         (email, email_origin, validate_email)):
            if value is None:
                continue
            try:
                normalize(value)
            except ValueError as error:
                sys.exit(f"Invalid value from {origin}: {error}\n"
                         "Re-run with --configure to set it, or override with --site/--email.")
        if site and email:
            return Settings(site=normalize_site(site), email=validate_email(email),
                            keychain_service=service)
        print("First run — jira-attach needs to know which Jira site and account to use.")
    settings = Settings(
        site=_ask("Jira site URL", site, normalize_site, "https://your-team.atlassian.net"),
        email=_ask("Atlassian account email", email, validate_email, "you@your-team.com"),
        keychain_service=service,
    )
    save_config(settings)
    return settings


# --------------------------------------------------------------------------- #
# Token / keychain
# --------------------------------------------------------------------------- #

def read_token_from_keychain(settings: Settings) -> str | None:
    try:
        result = subprocess.run(
            ["security", "find-generic-password",
             "-a", settings.email, "-s", settings.keychain_service, "-w"],
            capture_output=True, text=True, timeout=KEYCHAIN_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        sys.exit("Timed out reading the token from the keychain.")
    return result.stdout.strip() or None if result.returncode == 0 else None


def store_token_in_keychain(settings: Settings, token: str) -> None:
    try:
        result = subprocess.run(
            ["security", "add-generic-password",
             "-a", settings.email, "-s", settings.keychain_service, "-w", token, "-U"],
            capture_output=True, text=True, timeout=KEYCHAIN_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        sys.exit("Timed out storing the token in the keychain.")
    if result.returncode != 0:
        sys.exit(f"Could not store token in keychain: {result.stderr.strip()}")


def prompt_for_token(settings: Settings, *, replacing: bool = False) -> str:
    lead = "Replacing the API token stored for" if replacing else "No API token stored for"
    print(f"{lead} {settings.email} (keychain service '{settings.keychain_service}').")
    print(f"Create one at {TOKEN_URL}")
    try:
        token = getpass.getpass("Paste the API token (input hidden): ").strip()
    except (EOFError, OSError):
        sys.exit("A token is required — run this interactively so it can be entered.")
    if not token:
        sys.exit("No token entered.")
    store_token_in_keychain(settings, token)
    print("Token stored in keychain.")
    return token


def obtain_credentials(settings: Settings, force_new: bool = False) -> Credentials:
    token = (prompt_for_token(settings, replacing=True) if force_new
             else (read_token_from_keychain(settings) or prompt_for_token(settings)))
    return Credentials(email=settings.email, token=token)


