.DS_Store
notes/.obsidian

# Scratch and generated output, not source.
.convocation/
.agents/
skills/humanizer
tools/handlebars/handlebars.log
tools/lib/installed.json

# Agent CLI scratch dirs created by convocation panelists in this working tree.
.codex/
.qwen/
__pycache__/

# Panel stderr dumps and scratch: logs, never source (removed from git 2026-10-04).
*.err
tmp/
*.pyc

# >>> astra (managed) >>>
# Per-machine log of automatic tool updates; not shared state.
.astra/update.log
# <<< astra <<<

# Per-machine wrapper apps and their launch shims, generated by wrap-in-app at
# install time: each holds this checkout's absolute path and its own TCC grant.
tools/xcode-mcp-front/*.app/
tools/xcode-mcp-front/*_launch.sh
tools/handlebars/Handlebars.app/
tools/handlebars/handlebars_launch.sh
tools/agent-sync/AgentSync.app/
tools/agent-sync/agentsync_launch.sh
